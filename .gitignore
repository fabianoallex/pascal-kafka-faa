# test script logs
tests/*/fpc/build.log
tests/*/fpc/run.log
samples/*/build.log
samples/*/run.log

# NUnit report produced by the DUnitX runner
dunitx-results.xml

# session/IDE files
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/

# written by lazbuild in the working folder (a copy of the Lazarus user package links)
packagefiles.xml

# local scratch (CI downloads, probes, captures in progress)
.ci/

# the broker's TLS material is generated from the common's tests/pki CA
# (tools/gen_broker_certs.sh)
docker/certs/
__pycache__/
