    LWriter.Free;
  end;
end;

procedure TKafkaOffsetCommitResponse.FromBytes(const AData: TBytes; AVersion: Int16);
var
  LReader: TKafkaReader;
begin
  LReader := TKafkaReader.Create(AData);
  try
    Decode(LReader, AVersion);
    if not LReader.AtEnd then
      KafkaProtocolError('OffsetCommitResponse v%d: %d bytes left after the message',
        [AVersion, LReader.Remaining]);
  finally
    LReader.Free;
  end;
end;

end.
