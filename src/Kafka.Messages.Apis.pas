unit Kafka.Messages.Apis;

{$I kafka.inc}

{ The APIs this library has codecs for, and the versions of each.

  GENERATED by tools/gen_messages.py from Apache Kafka 4.4.0's message
  definitions. Do not edit by hand.

  Kafka.Connection negotiates against this table: for each API, the highest
  version that both this table and the broker's ApiVersions answer allow.
  The flexible version decides the header versions
  (Kafka.Protocol.Envelope). }

interface

uses
  SysUtils,
  Kafka.Types;

type
  TKafkaApiInfo = record
    ApiKey: Int16;
    Name: string;
    MinVersion: Int16;
    MaxVersion: Int16;
    /// -1 when no version is flexible.
    FirstFlexibleVersion: Int16;
  end;

const
  KAFKA_API_KEY_API_VERSIONS = 18;
  KAFKA_API_KEY_METADATA = 3;
  KAFKA_API_KEY_PRODUCE = 0;
  KAFKA_API_KEY_FETCH = 1;
  KAFKA_API_KEY_LIST_OFFSETS = 2;
  KAFKA_API_KEY_SASL_HANDSHAKE = 17;
  KAFKA_API_KEY_SASL_AUTHENTICATE = 36;
  KAFKA_API_KEY_FIND_COORDINATOR = 10;
  KAFKA_API_KEY_CONSUMER_GROUP_HEARTBEAT = 68;
  KAFKA_API_KEY_OFFSET_COMMIT = 8;
  KAFKA_API_KEY_OFFSET_FETCH = 9;
  KAFKA_API_KEY_CONSUMER_GROUP_DESCRIBE = 69;

  KAFKA_SUPPORTED_APIS: array[0..11] of TKafkaApiInfo = (
    (ApiKey: 0; Name: 'Produce'; MinVersion: 3; MaxVersion: 13; FirstFlexibleVersion: 9),
    (ApiKey: 1; Name: 'Fetch'; MinVersion: 4; MaxVersion: 18; FirstFlexibleVersion: 12),
    (ApiKey: 2; Name: 'ListOffsets'; MinVersion: 1; MaxVersion: 11; FirstFlexibleVersion: 6),
    (ApiKey: 3; Name: 'Metadata'; MinVersion: 0; MaxVersion: 13; FirstFlexibleVersion: 9),
    (ApiKey: 8; Name: 'OffsetCommit'; MinVersion: 2; MaxVersion: 10; FirstFlexibleVersion: 8),
    (ApiKey: 9; Name: 'OffsetFetch'; MinVersion: 1; MaxVersion: 10; FirstFlexibleVersion: 6),
    (ApiKey: 10; Name: 'FindCoordinator'; MinVersion: 0; MaxVersion: 6; FirstFlexibleVersion: 3),
    (ApiKey: 17; Name: 'SaslHandshake'; MinVersion: 0; MaxVersion: 1; FirstFlexibleVersion: -1),
    (ApiKey: 18; Name: 'ApiVersions'; MinVersion: 0; MaxVersion: 5; FirstFlexibleVersion: 3),
    (ApiKey: 36; Name: 'SaslAuthenticate'; MinVersion: 0; MaxVersion: 2; FirstFlexibleVersion: 2),
    (ApiKey: 68; Name: 'ConsumerGroupHeartbeat'; MinVersion: 0; MaxVersion: 1; FirstFlexibleVersion: 0),
    (ApiKey: 69; Name: 'ConsumerGroupDescribe'; MinVersion: 0; MaxVersion: 1; FirstFlexibleVersion: 0)
  );

/// The entry for AApiKey; False when the library has no codec for it.
function KafkaFindApi(AApiKey: Int16; out AInfo: TKafkaApiInfo): Boolean;
/// The API's name, or 'ApiKey(n)' for one the library doesn't know.
function KafkaApiName(AApiKey: Int16): string;
/// Whether AVersion of the API is flexible; EKafkaUnsupportedVersion for an
/// API the library doesn't know.
function KafkaApiIsFlexible(AApiKey, AVersion: Int16): Boolean;

implementation

function KafkaFindApi(AApiKey: Int16; out AInfo: TKafkaApiInfo): Boolean;
var
  I: Integer;
begin
  for I := Low(KAFKA_SUPPORTED_APIS) to High(KAFKA_SUPPORTED_APIS) do
    if KAFKA_SUPPORTED_APIS[I].ApiKey = AApiKey then
    begin
      AInfo := KAFKA_SUPPORTED_APIS[I];
      Exit(True);
    end;
  AInfo := Default(TKafkaApiInfo);
  Result := False;
end;

function KafkaApiName(AApiKey: Int16): string;
var
  LInfo: TKafkaApiInfo;
begin
  if KafkaFindApi(AApiKey, LInfo) then
    Result := LInfo.Name
  else
    Result := Format('ApiKey(%d)', [AApiKey]);
end;

function KafkaApiIsFlexible(AApiKey, AVersion: Int16): Boolean;
var
  LInfo: TKafkaApiInfo;
begin
  if not KafkaFindApi(AApiKey, LInfo) then
    raise EKafkaUnsupportedVersion.CreateFmt('API key %d has no codec in this library',
      [AApiKey]);
  Result := (LInfo.FirstFlexibleVersion >= 0) and (AVersion >= LInfo.FirstFlexibleVersion);
end;

end.
