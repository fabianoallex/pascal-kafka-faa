function KafkaErrorDescription(ACode: Int16): string;
begin
  case ACode of
    -1: Result := 'The server experienced an unexpected error when processing the request.';
    1: Result := 'The requested offset is not within the range of offsets maintained by the ' +
        'server.';
    2: Result := 'This message has failed its CRC checksum, exceeds the valid size, has a null ' +
        'key for a compacted topic, or is otherwise corrupt.';
    3: Result := 'This server does not host this topic-partition.';
    4: Result := 'The requested fetch size is invalid.';
    5: Result := 'There is no leader for this topic-partition as we are in the middle of a ' +
        'leadership election.';
    6: Result := 'For requests intended only for the leader, this error indicates that the broker ' +
        'is not the current leader. For requests intended for any replica, this error ' +
        'indicates that the broker is not a replica of the topic partition.';
    7: Result := 'The request timed out.';
    8: Result := 'The broker is not available.';
    9: Result := 'The replica is not available for the requested topic-partition. Produce/Fetch ' +
        'requests and other requests intended only for the leader or follower return ' +
        'NOT_LEADER_OR_FOLLOWER if the broker is not a replica of the topic-partition.';
    10: Result := 'The request included a message larger than the max message size the server will ' +
        'accept.';
    11: Result := 'The controller moved to another broker.';
    12: Result := 'The metadata field of the offset request was too large.';
    13: Result := 'The server disconnected before a response was received.';
    14: Result := 'The coordinator is loading and hence can''t process requests.';
    15: Result := 'The coordinator is not available.';
    16: Result := 'This is not the correct coordinator.';
    17: Result := 'The request attempted to perform an operation on an invalid topic.';
    18: Result := 'The request included message batch larger than the configured segment size on ' +
        'the server.';
    19: Result := 'Messages are rejected since there are fewer in-sync replicas than required.';
    20: Result := 'Messages are written to the log, but to fewer in-sync replicas than required.';
    21: Result := 'Produce request specified an invalid value for required acks.';
    22: Result := 'Specified group generation id is not valid.';
    23: Result := 'The group member''s supported protocols are incompatible with those of existing ' +
        'members or first group member tried to join with empty protocol type or empty ' +
        'protocol list.';
    24: Result := 'The group id is invalid.';
    25: Result := 'The coordinator is not aware of this member.';
    26: Result := 'The session timeout is not within the range allowed by the broker (as ' +
        'configured by group.min.session.timeout.ms and group.max.session.timeout.ms).';
    27: Result := 'The group is rebalancing, so a rejoin is needed.';
    28: Result := 'The committing offset data size is not valid.';
    29: Result := 'Topic authorization failed.';
    30: Result := 'Group authorization failed.';
    31: Result := 'Cluster authorization failed.';
    32: Result := 'The timestamp of the message is out of acceptable range.';
    33: Result := 'The broker does not support the requested SASL mechanism.';
    34: Result := 'Request is not valid given the current SASL state.';
    35: Result := 'The version of API is not supported.';
    36: Result := 'Topic with this name already exists.';
    37: Result := 'Number of partitions is below 1.';
    38: Result := 'Replication factor is below 1 or larger than the number of available brokers.';
    39: Result := 'Replica assignment is invalid.';
    40: Result := 'Configuration is invalid.';
    41: Result := 'This is not the correct controller for this cluster.';
    42: Result := 'This most likely occurs because of a request being malformed by the client ' +
        'library or the message was sent to an incompatible broker. See the broker logs ' +
        'for more details.';
    43: Result := 'The message format version on the broker does not support the request.';
    44: Result := 'Request parameters do not satisfy the configured policy.';
    45: Result := 'The broker received an out of order sequence number.';
    46: Result := 'The broker received a duplicate sequence number.';
    47: Result := 'Producer attempted to produce with an old epoch.';
    48: Result := 'The producer attempted a transactional operation in an invalid state.';
