procedure TKafkaFetchResponseNodeEndpoint.Encode(AWriter: TKafkaWriter; AVersion: Int16);
var
  LFlex: Boolean;
  LRaw: Integer;
  LTagCount: Cardinal;
begin
  LFlex := AVersion >= 12;
