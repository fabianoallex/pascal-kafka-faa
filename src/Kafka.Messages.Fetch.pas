  else
  begin
    if NodeId <> 0 then
      raise EKafkaUnsupportedVersion.CreateFmt('KafkaFetchResponseNodeEndpoint.NodeId can''t be written in version %d', [AVersion]);
  end;
  if AVersion >= 16 then
  begin
    AWriter.WriteString(Host, LFlex);
  end
  else
  begin
    if Host <> '' then
      raise EKafkaUnsupportedVersion.CreateFmt('KafkaFetchResponseNodeEndpoint.Host can''t be written in version %d', [AVersion]);
  end;
  if AVersion >= 16 then
  begin
    AWriter.WriteInt32(Port);
  end
  else
  begin
    if Port <> 0 then
      raise EKafkaUnsupportedVersion.CreateFmt('KafkaFetchResponseNodeEndpoint.Port can''t be written in version %d', [AVersion]);
  end;
  if AVersion >= 16 then
  begin
    if AVersion >= 16 then
    begin
      AWriter.WriteNullableString(Rack, RackIsNull, LFlex);
    end
    else
    begin
      if RackIsNull then
        raise EKafkaUnsupportedVersion.CreateFmt('KafkaFetchResponseNodeEndpoint.Rack can''t be null in version %d', [AVersion]);
      AWriter.WriteString(Rack, LFlex);
