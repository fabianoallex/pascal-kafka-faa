  if AVersion >= 8 then
  begin
    TopicAuthorizedOperations := AReader.ReadInt32;
  end;
  if LFlex then
  begin
    LTagCount := AReader.ReadUnsignedVarint;
    LTagIndex := 0;
    while LTagIndex < LTagCount do
    begin
      LTag := AReader.ReadUnsignedVarint;
      LSize := AReader.ReadUnsignedVarint;
      if Int64(LSize) > AReader.Remaining then
        KafkaProtocolError('Tagged field %d of %d bytes with only %d bytes left',
          [Int64(LTag), Int64(LSize), AReader.Remaining]);
      KafkaAddRawTaggedField(UnknownTaggedFields, LTag, AReader.ReadRaw(Integer(LSize)));
      Inc(LTagIndex);
    end;
  end;
end;

{ TKafkaMetadataResponse }

procedure TKafkaMetadataResponse.Init;
begin
  Self := Default(TKafkaMetadataResponse);
  ClusterIdIsNull := True;
  ControllerId := -1;
  ClusterAuthorizedOperations := Low(Int32);
end;

function TKafkaMetadataResponse.IsDefault: Boolean;
begin
  Result := not (
    (ThrottleTimeMs <> 0) or
    (System.Length(Brokers) > 0) or
    (not ClusterIdIsNull) or
    (ControllerId <> -1) or
    (System.Length(Topics) > 0) or
    (ClusterAuthorizedOperations <> Low(Int32)) or
    (ErrorCode <> 0) or
    (System.Length(UnknownTaggedFields) > 0));
end;

procedure TKafkaMetadataResponse.Encode(AWriter: TKafkaWriter; AVersion: Int16);
var
  LFlex: Boolean;
  LI: Integer;
  LRaw: Integer;
  LTagCount: Cardinal;
begin
  if (AVersion < KAFKA_METADATA_RESPONSE_MIN_VERSION) or (AVersion > KAFKA_METADATA_RESPONSE_MAX_VERSION) then
    raise EKafkaUnsupportedVersion.CreateFmt('MetadataResponse version %d is not supported (%d-%d)',
      [AVersion, KAFKA_METADATA_RESPONSE_MIN_VERSION, KAFKA_METADATA_RESPONSE_MAX_VERSION]);
  LFlex := AVersion >= 9;
  if AVersion >= 3 then
  begin
    AWriter.WriteInt32(ThrottleTimeMs);
  end;
  AWriter.WriteArrayLength(System.Length(Brokers), LFlex);
  for LI := 0 to System.Length(Brokers) - 1 do
    Brokers[LI].Encode(AWriter, AVersion);
  if AVersion >= 2 then
  begin
    if AVersion >= 2 then
    begin
      AWriter.WriteNullableString(ClusterId, ClusterIdIsNull, LFlex);
    end
    else
    begin
      if ClusterIdIsNull then
        raise EKafkaUnsupportedVersion.CreateFmt('KafkaMetadataResponse.ClusterId can''t be null in version %d', [AVersion]);
      AWriter.WriteString(ClusterId, LFlex);
    end;
  end;
  if AVersion >= 1 then
  begin
    AWriter.WriteInt32(ControllerId);
  end;
  AWriter.WriteArrayLength(System.Length(Topics), LFlex);
  for LI := 0 to System.Length(Topics) - 1 do
    Topics[LI].Encode(AWriter, AVersion);
  if (AVersion >= 8) and (AVersion <= 10) then
  begin
    AWriter.WriteInt32(ClusterAuthorizedOperations);
  end
  else
  begin
    if ClusterAuthorizedOperations <> Low(Int32) then
      raise EKafkaUnsupportedVersion.CreateFmt('KafkaMetadataResponse.ClusterAuthorizedOperations can''t be written in version %d', [AVersion]);
  end;
  if AVersion >= 13 then
  begin
    AWriter.WriteInt16(ErrorCode);
  end;
  if LFlex then
  begin
    LTagCount := Cardinal(System.Length(UnknownTaggedFields));
    AWriter.WriteUnsignedVarint(LTagCount);
    LRaw := 0;
    AWriter.WriteRawTaggedFieldsBelow(UnknownTaggedFields, LRaw, High(Int64));
  end;
end;

procedure TKafkaMetadataResponse.Decode(AReader: TKafkaReader; AVersion: Int16);
var
  LFlex: Boolean;
  LI: Integer;
  LN: Integer;
  LTagCount: Cardinal;
  LTagIndex: Cardinal;
  LTag: Cardinal;
  LSize: Cardinal;
begin
  if (AVersion < KAFKA_METADATA_RESPONSE_MIN_VERSION) or (AVersion > KAFKA_METADATA_RESPONSE_MAX_VERSION) then
    raise EKafkaUnsupportedVersion.CreateFmt('MetadataResponse version %d is not supported (%d-%d)',
      [AVersion, KAFKA_METADATA_RESPONSE_MIN_VERSION, KAFKA_METADATA_RESPONSE_MAX_VERSION]);
  LFlex := AVersion >= 9;
  Init;
  if AVersion >= 3 then
  begin
    ThrottleTimeMs := AReader.ReadInt32;
  end;
  LN := AReader.ReadNonNullArrayLength(LFlex);
  SetLength(Brokers, LN);
  for LI := 0 to LN - 1 do
  begin
    Brokers[LI].Init;
    Brokers[LI].Decode(AReader, AVersion);
  end;
  if AVersion >= 2 then
  begin
    if AVersion >= 2 then
    begin
      ClusterId := AReader.ReadNullableString(LFlex, ClusterIdIsNull);
    end
    else
    begin
      ClusterId := AReader.ReadString(LFlex);
      ClusterIdIsNull := False;
    end;
  end;
  if AVersion >= 1 then
  begin
    ControllerId := AReader.ReadInt32;
  end;
  LN := AReader.ReadNonNullArrayLength(LFlex);
  SetLength(Topics, LN);
  for LI := 0 to LN - 1 do
  begin
    Topics[LI].Init;
    Topics[LI].Decode(AReader, AVersion);
  end;
  if (AVersion >= 8) and (AVersion <= 10) then
  begin
    ClusterAuthorizedOperations := AReader.ReadInt32;
  end;
  if AVersion >= 13 then
  begin
    ErrorCode := AReader.ReadInt16;
  end;
  if LFlex then
  begin
    LTagCount := AReader.ReadUnsignedVarint;
    LTagIndex := 0;
    while LTagIndex < LTagCount do
    begin
      LTag := AReader.ReadUnsignedVarint;
      LSize := AReader.ReadUnsignedVarint;
      if Int64(LSize) > AReader.Remaining then
        KafkaProtocolError('Tagged field %d of %d bytes with only %d bytes left',
          [Int64(LTag), Int64(LSize), AReader.Remaining]);
      KafkaAddRawTaggedField(UnknownTaggedFields, LTag, AReader.ReadRaw(Integer(LSize)));
      Inc(LTagIndex);
    end;
  end;
end;

function TKafkaMetadataResponse.ToBytes(AVersion: Int16): TBytes;
var
  LWriter: TKafkaWriter;
begin
  LWriter := TKafkaWriter.Create;
  try
    Encode(LWriter, AVersion);
    Result := LWriter.ToBytes;
  finally
    LWriter.Free;
  end;
end;

procedure TKafkaMetadataResponse.FromBytes(const AData: TBytes; AVersion: Int16);
var
  LReader: TKafkaReader;
begin
  LReader := TKafkaReader.Create(AData);
  try
    Decode(LReader, AVersion);
    if not LReader.AtEnd then
      KafkaProtocolError('MetadataResponse v%d: %d bytes left after the message',
        [AVersion, LReader.Remaining]);
  finally
    LReader.Free;
  end;
end;

end.
