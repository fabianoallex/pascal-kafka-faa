<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_kafka_faa"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Native Apache Kafka client for Delphi and Free Pascal/Lazarus (dual-compiler), with no external dependency: the protocol codecs generated from Kafka's message definitions, and a broker connection over TCP or TLS (SChannel or OpenSSL, from pascal-common-faa)."/>
    <License Value="MIT"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="..\src\kafka.inc"/>
        <Type Value="Include"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Types.pas"/>
        <UnitName Value="Kafka.Types"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Protocol.Crc32c.pas"/>
        <UnitName Value="Kafka.Protocol.Crc32c"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Protocol.Primitives.pas"/>
        <UnitName Value="Kafka.Protocol.Primitives"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Protocol.Envelope.pas"/>
        <UnitName Value="Kafka.Protocol.Envelope"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Compression.pas"/>
        <UnitName Value="Kafka.Compression"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Protocol.RecordBatch.pas"/>
        <UnitName Value="Kafka.Protocol.RecordBatch"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Errors.pas"/>
        <UnitName Value="Kafka.Errors"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.Apis.pas"/>
        <UnitName Value="Kafka.Messages.Apis"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.ApiVersions.pas"/>
        <UnitName Value="Kafka.Messages.ApiVersions"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.Metadata.pas"/>
        <UnitName Value="Kafka.Messages.Metadata"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.Produce.pas"/>
        <UnitName Value="Kafka.Messages.Produce"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.Fetch.pas"/>
        <UnitName Value="Kafka.Messages.Fetch"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.ListOffsets.pas"/>
        <UnitName Value="Kafka.Messages.ListOffsets"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.SaslHandshake.pas"/>
        <UnitName Value="Kafka.Messages.SaslHandshake"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.SaslAuthenticate.pas"/>
        <UnitName Value="Kafka.Messages.SaslAuthenticate"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.FindCoordinator.pas"/>
        <UnitName Value="Kafka.Messages.FindCoordinator"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.ConsumerGroupHeartbeat.pas"/>
        <UnitName Value="Kafka.Messages.ConsumerGroupHeartbeat"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.OffsetCommit.pas"/>
        <UnitName Value="Kafka.Messages.OffsetCommit"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.OffsetFetch.pas"/>
        <UnitName Value="Kafka.Messages.OffsetFetch"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.ConsumerGroupDescribe.pas"/>
        <UnitName Value="Kafka.Messages.ConsumerGroupDescribe"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Messages.InitProducerId.pas"/>
        <UnitName Value="Kafka.Messages.InitProducerId"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Transport.pas"/>
        <UnitName Value="Kafka.Transport"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Sasl.pas"/>
        <UnitName Value="Kafka.Sasl"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Connection.pas"/>
        <UnitName Value="Kafka.Connection"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Partitioner.pas"/>
        <UnitName Value="Kafka.Partitioner"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Cluster.pas"/>
        <UnitName Value="Kafka.Cluster"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Producer.pas"/>
        <UnitName Value="Kafka.Producer"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Consumer.pas"/>
        <UnitName Value="Kafka.Consumer"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Group.pas"/>
        <UnitName Value="Kafka.Group"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Group.Coordinator.pas"/>
        <UnitName Value="Kafka.Group.Coordinator"/>
      </Item>
      <Item>
        <Filename Value="..\src\Kafka.Group.Consumer.pas"/>
        <UnitName Value="Kafka.Group.Consumer"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <!-- By name only, with no DefaultFilename: the application provides the
           one copy of pascal-common-faa (one registered pascal_common_faa.lpk).
           A DefaultFilename into external/ would let Lazarus fall back to this
           library's private copy, the diamond pascal-common-faa forbids. The
           test .lpi files point at external/ with Prefer="True". -->
      <Item>
        <PackageName Value="pascal_common_faa"/>
        <MinVersion Major="1" Minor="27" Release="1" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
