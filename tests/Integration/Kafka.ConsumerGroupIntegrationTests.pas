unit Kafka.ConsumerGroupIntegrationTests;

{ The consumer in a consumer group (Kafka.Consumer, Subscribe) against the
  real Apache Kafka 4.4.0 broker of docker/docker-compose.yml (plaintext
  9092): K2's criterion (docs/design.md, section 7), two consumers sharing a
  topic and rebalancing without loss and with no duplicate beyond
  at-least-once.

  - Two consumers: A reads the topic alone; B joins while records keep
    coming, the broker moves partitions from A to B (A's revoke commits
    first), both read; then B closes (its commit, its leave) and A takes
    every partition back. Every record produced is read, and none twice:
    at-least-once would allow a duplicate after a failed commit, and with
    the revoke's commit there is none to allow.
  - A consumer closes (the auto-commit) and a new one of the same group
    starts after what the first read, not from the beginning that
    AutoOffsetReset earliest would give.

  The Java consumer in the same group as this one is tools/interop.py's
  (--group), not a fixture: it runs through docker exec.

  Each run has a topic and a group of its own (KafkaTestUniqueId). The topic
  is auto-created by the producer's Metadata (3 partitions, the compose
  file's default). A rebalance takes up to two heartbeat intervals of the
  broker (5 s each), so the waits are generous; they are the consumers'
  Polls, never a Sleep.

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Classes,
  Generics.Collections,
  PascalCommon.Threading,
  PascalCommon.Utf8,
  Kafka.Types,
  Kafka.Cluster,
  Kafka.Group,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaConsumerGroupIntegrationTests = class
  private
    FTopic: string;
    FGroup: string;
    FMarker: string;
    FProducer: TKafkaProducer;
    FConsumers: array[0..2] of TKafkaConsumer;
    FSent: Integer;
    /// Record number -> times read.
    FSeen: TDictionary<Integer, Integer>;
    FDuplicates: Integer;
    FForeign: Integer;
    FAssigned: array[0..2] of Integer;
    FRevoked: array[0..2] of Integer;
    FLost: array[0..2] of Integer;
    procedure OpenProducer;
    procedure SendRecords(ACount: Integer);
    function NewConsumer(AWhich: Integer): TKafkaConsumer;
    function Which(ASender: TKafkaConsumer): Integer;
    procedure Assigned_(ASender: TKafkaConsumer; const APartitions: TKafkaTopicPartitionArray);
    procedure Revoked(ASender: TKafkaConsumer; const APartitions: TKafkaTopicPartitionArray);
    procedure Lost(ASender: TKafkaConsumer; const APartitions: TKafkaTopicPartitionArray);
    procedure PollOnce(AWhich: Integer; ATimeoutMs: Cardinal);
    /// Polls consumers 0 and, when ABoth, 1 until every record sent was read.
    function PollUntilAllSeen(ABoth: Boolean): Boolean;
    function Missing: Integer;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure TwoConsumers_Rebalance_NoLossNoDuplicate;
    [Test] procedure NewConsumer_StartsAfterTheClosedOnesCommit;
  end;

implementation

const
  WAIT_MS = 60000;

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function Bootstrap: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost') + ':' + EnvOr('KAFKA_TEST_PORT', '9092');
end;

{ TKafkaConsumerGroupIntegrationTests }

procedure TKafkaConsumerGroupIntegrationTests.Setup;
var
  I: Integer;
begin
  FMarker := KafkaTestUniqueId;
  FTopic := 'pascal-kafka-faa-it-cgroup-' + FMarker;
  FGroup := 'pascal-kafka-faa-it-cgroup-' + FMarker;
  FProducer := nil;
  for I := 0 to 2 do
  begin
    FConsumers[I] := nil;
    FAssigned[I] := 0;
    FRevoked[I] := 0;
    FLost[I] := 0;
  end;
  FSent := 0;
  FSeen := TDictionary<Integer, Integer>.Create;
  FDuplicates := 0;
  FForeign := 0;
end;

procedure TKafkaConsumerGroupIntegrationTests.TearDown;
var
  I: Integer;
begin
  for I := 0 to 2 do
    FreeAndNil(FConsumers[I]);
  FreeAndNil(FProducer);
  FSeen.Free;
end;

procedure TKafkaConsumerGroupIntegrationTests.OpenProducer;
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams(Bootstrap);
  P.Cluster.Connection.ClientId := 'pascal-kafka-faa-cgroup-it';
  P.Cluster.MaxBlockMs := WAIT_MS;
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
  // The broker creates the topic for this Metadata request; the cluster
  // waits for its leaders.
  TAssert.AssertEquals('the compose file''s partitions', 3,
    Length(FProducer.PartitionsFor(FTopic)));
end;

procedure TKafkaConsumerGroupIntegrationTests.SendRecords(ACount: Integer);
var
  I: Integer;
begin
  // Keyed by number: murmur2 spreads them over the three partitions.
  for I := 1 to ACount do
  begin
    FProducer.Send(KafkaProducerRecord(FTopic, PcStringToUtf8Bytes(IntToStr(FSent)),
      PcStringToUtf8Bytes(FMarker + ' ' + IntToStr(FSent))));
    Inc(FSent);
  end;
end;

function TKafkaConsumerGroupIntegrationTests.NewConsumer(AWhich: Integer): TKafkaConsumer;
var
  P: TKafkaConsumerParams;
begin
  P := KafkaConsumerParams(Bootstrap);
  P.Cluster.Connection.ClientId := 'pascal-kafka-faa-cgroup-it-' + IntToStr(AWhich);
  P.Cluster.MaxBlockMs := WAIT_MS;
  P.GroupId := FGroup;
  P.AutoOffsetReset := korEarliest;
  P.FetchMaxWaitMs := 200;
  Result := TKafkaConsumer.Create(P);
  FConsumers[AWhich] := Result;
  Result.OnPartitionsAssigned := Assigned_;
  Result.OnPartitionsRevoked := Revoked;
  Result.OnPartitionsLost := Lost;
  Result.Open;
  Result.Subscribe([FTopic]);
end;

function TKafkaConsumerGroupIntegrationTests.Which(ASender: TKafkaConsumer): Integer;
var
  I: Integer;
begin
  for I := 0 to 2 do
    if FConsumers[I] = ASender then
      Exit(I);
  Result := 0;
end;

procedure TKafkaConsumerGroupIntegrationTests.Assigned_(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
begin
  if Length(APartitions) > 0 then
    Inc(FAssigned[Which(ASender)]);
end;

procedure TKafkaConsumerGroupIntegrationTests.Revoked(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Inc(FRevoked[Which(ASender)]);
end;

procedure TKafkaConsumerGroupIntegrationTests.Lost(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Inc(FLost[Which(ASender)]);
end;

procedure TKafkaConsumerGroupIntegrationTests.PollOnce(AWhich: Integer; ATimeoutMs: Cardinal);
var
  R: TKafkaConsumerRecordArray;
  I, N, LNumber: Integer;
  LText: string;
begin
  R := FConsumers[AWhich].Poll(ATimeoutMs);
  for I := 0 to High(R) do
  begin
    if not PcTryUtf8BytesToString(R[I].Value, LText) or
      (Copy(LText, 1, Length(FMarker) + 1) <> FMarker + ' ') or
      not TryStrToInt(Copy(LText, Length(FMarker) + 2, MaxInt), LNumber) then
    begin
      Inc(FForeign);
      Continue;
    end;
    if FSeen.TryGetValue(LNumber, N) then
    begin
      Inc(FDuplicates);
      FSeen[LNumber] := N + 1;
    end
    else
      FSeen.Add(LNumber, 1);
  end;
end;

function TKafkaConsumerGroupIntegrationTests.PollUntilAllSeen(ABoth: Boolean): Boolean;
var
  LDeadline: UInt64;
begin
  TAssert.AssertTrue('flushed', FProducer.Flush(WAIT_MS));
  LDeadline := PcTickMs + WAIT_MS;
  while FSeen.Count < FSent do
  begin
    if PcTickMs >= LDeadline then
      Exit(False);
    PollOnce(0, 200);
    if ABoth then
      PollOnce(1, 200);
  end;
  Result := True;
end;

function TKafkaConsumerGroupIntegrationTests.Missing: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to FSent - 1 do
    if not FSeen.ContainsKey(I) then
      Inc(Result);
end;

procedure TKafkaConsumerGroupIntegrationTests.TwoConsumers_Rebalance_NoLossNoDuplicate;
var
  A, B: TKafkaConsumer;
  LDeadline: UInt64;
  LSplit: Boolean;
begin
  OpenProducer;
  SendRecords(30);
  A := NewConsumer(0);
  TAssert.AssertTrue('A read the first records', PollUntilAllSeen(False));
  TAssert.AssertEquals(3, Length(A.Assignment));
  // B joins while records keep coming.
  B := NewConsumer(1);
  LDeadline := PcTickMs + WAIT_MS;
  LSplit := False;
  while not LSplit and (PcTickMs < LDeadline) do
  begin
    if FSent < 300 then
      SendRecords(5);
    PollOnce(0, 200);
    PollOnce(1, 200);
    LSplit := (Length(A.Assignment) > 0) and (Length(B.Assignment) > 0) and
      (Length(A.Assignment) + Length(B.Assignment) = 3);
  end;
  TAssert.AssertTrue('the partitions were split between A and B', LSplit);
  TAssert.AssertTrue('A revoked before B got any', FRevoked[0] >= 1);
  SendRecords(30);
  TAssert.AssertTrue('A and B read everything', PollUntilAllSeen(True));
  // B leaves; A takes everything back.
  FreeAndNil(FConsumers[1]);
  SendRecords(30);
  TAssert.AssertTrue('A read everything after B left', PollUntilAllSeen(False));
  LDeadline := PcTickMs + WAIT_MS;
  while (Length(A.Assignment) < 3) and (PcTickMs < LDeadline) do
    PollOnce(0, 200);
  TAssert.AssertEquals('A holds every partition again', 3, Length(A.Assignment));
  SendRecords(10);
  TAssert.AssertTrue(PollUntilAllSeen(False));
  TAssert.AssertEquals('no record lost', 0, Missing);
  TAssert.AssertEquals('no record read twice', 0, FDuplicates);
  TAssert.AssertEquals('nothing from another run', 0, FForeign);
  TAssert.AssertEquals('nobody fenced', 0, FLost[0] + FLost[1]);
  TAssert.AssertTrue(FAssigned[1] >= 1);
end;

procedure TKafkaConsumerGroupIntegrationTests.NewConsumer_StartsAfterTheClosedOnesCommit;
var
  LDeadline: UInt64;
  I: Integer;
begin
  OpenProducer;
  SendRecords(20);
  NewConsumer(0);
  TAssert.AssertTrue(PollUntilAllSeen(False));
  FreeAndNil(FConsumers[0]); // Close: the auto-commit, the leave
  SendRecords(10);
  TAssert.AssertTrue(FProducer.Flush(WAIT_MS));
  FSeen.Clear;
  NewConsumer(0);
  LDeadline := PcTickMs + WAIT_MS;
  while (FSeen.Count < 10) and (PcTickMs < LDeadline) do
    PollOnce(0, 200);
  TAssert.AssertEquals(10, FSeen.Count);
  for I := 0 to 19 do
    TAssert.AssertFalse(Format('record %d was read again', [I]), FSeen.ContainsKey(I));
  for I := 20 to 29 do
    TAssert.AssertTrue(Format('record %d', [I]), FSeen.ContainsKey(I));
  TAssert.AssertEquals(0, FDuplicates);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaConsumerGroupIntegrationTests);

end.
