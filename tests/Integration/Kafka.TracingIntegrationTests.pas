unit Kafka.TracingIntegrationTests;

{ Spans and metrics (Kafka.Tracing, Kafka.Metrics) against the real Apache
  Kafka 4.4.0 broker of docker/docker-compose.yml (plaintext 9092): K3's
  step 7 (docs/design.md).

  - The trace context through the broker: records sent inside a span carry
    their send span's traceparent in their headers, the broker keeps the
    header as it is, and a consumer in a group reads it back; the process
    span it opens for a record is a child of that record's send span, in the
    first span's trace. The poll span names the topic and the group.
  - The metrics of the same run: the records and bytes the producer sent,
    no batch left in flight, the records the consumer read with no lag left,
    the rebalance events (assigned when it joined, revoked when it left) and
    a synchronous commit.

  The Java client reading the header is tools/interop.py's (its trace
  scenario), not a fixture: it runs through docker exec.

  Each run has a topic and a group of its own (KafkaTestUniqueId), so the
  process-wide registry's series start at 0. The topic is auto-created by
  the producer's Metadata (3 partitions, the compose file's default). A
  group's first assignment takes up to a heartbeat interval of the broker;
  the waits are the consumer's Polls, never a Sleep.

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Threading,
  PascalCommon.Utf8,
  PascalCommon.Tracing,
  PascalCommon.TraceContext,
  Kafka.Types,
  Kafka.Tracing,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestHelpers,
  Kafka.TestTracing;

type
  [TestFixture]
  TKafkaTracingIntegrationTests = class
  private
    FTopic: string;
    FGroup: string;
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FExporter: TKafkaTestSpanExporter;
    procedure OpenProducer;
    procedure OpenConsumer;
    function PollFor(ACount: Integer): TKafkaConsumerRecordArray;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure TraceParent_ThroughTheBroker_ProcessJoinsTheSendersTrace;
    [Test] procedure Metrics_ProducerAndGroupConsumer;
  end;

implementation

const
  WAIT_MS = 60000;
  COUNT = 3;

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function Bootstrap: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost') + ':' + EnvOr('KAFKA_TEST_PORT', '9092');
end;

function HeaderOf(const ARecord: TKafkaConsumerRecord; const AKey: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ARecord.Headers) do
    if ARecord.Headers[I].Key = AKey then
      PcTryUtf8BytesToString(ARecord.Headers[I].Value, Result);
end;

{ TKafkaTracingIntegrationTests }

procedure TKafkaTracingIntegrationTests.Setup;
var
  LMarker: string;
begin
  LMarker := KafkaTestUniqueId;
  FTopic := 'pascal-kafka-faa-it-trace-' + LMarker;
  FGroup := 'pascal-kafka-faa-it-trace-' + LMarker;
  FProducer := nil;
  FConsumer := nil;
  FExporter := KafkaTestStartTracing;
end;

procedure TKafkaTracingIntegrationTests.TearDown;
begin
  FreeAndNil(FConsumer);
  FreeAndNil(FProducer);
  FExporter := nil;
  KafkaTestStopTracing;
end;

procedure TKafkaTracingIntegrationTests.OpenProducer;
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams(Bootstrap);
  P.Cluster.Connection.ClientId := 'pascal-kafka-faa-trace-it';
  P.Cluster.MaxBlockMs := WAIT_MS;
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
  // The broker creates the topic for this Metadata request; the cluster
  // waits for its leaders.
  TAssert.AssertEquals(3, Length(FProducer.PartitionsFor(FTopic)));
end;

procedure TKafkaTracingIntegrationTests.OpenConsumer;
var
  P: TKafkaConsumerParams;
begin
  P := KafkaConsumerParams(Bootstrap);
  P.Cluster.Connection.ClientId := 'pascal-kafka-faa-trace-it-consumer';
  P.Cluster.MaxBlockMs := WAIT_MS;
  P.GroupId := FGroup;
  P.AutoOffsetReset := korEarliest;
  P.EnableAutoCommit := False;
  P.FetchMaxWaitMs := 200;
  FConsumer := TKafkaConsumer.Create(P);
  FConsumer.Open;
  FConsumer.Subscribe([FTopic]);
end;

function TKafkaTracingIntegrationTests.PollFor(ACount: Integer): TKafkaConsumerRecordArray;
var
  Deadline: UInt64;
  Got: TKafkaConsumerRecordArray;
  I, N: Integer;
begin
  Result := nil;
  Deadline := PcTickMs + WAIT_MS;
  while (Length(Result) < ACount) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(500);
    N := Length(Result);
    SetLength(Result, N + Length(Got));
    for I := 0 to High(Got) do
      Result[N + I] := Got[I];
  end;
end;

procedure TKafkaTracingIntegrationTests.TraceParent_ThroughTheBroker_ProcessJoinsTheSendersTrace;
var
  LParent, LProcess: IPcSpan;
  LTraceId: string;
  R: TKafkaProducerRecord;
  LRecords: TKafkaConsumerRecordArray;
  LSpans: TPcSpanDataArray;
  LParsed: TPcTraceParent;
  I, S, X, P: Integer;
  LSendIds: string;
begin
  OpenProducer;
  LParent := TPcTracing.StartSpan('POST /orders', skServer);
  try
    LTraceId := LParent.TraceId;
    for I := 1 to COUNT do
    begin
      R := KafkaProducerRecord(FTopic, PcStringToUtf8Bytes(IntToStr(I)),
        PcStringToUtf8Bytes('order ' + IntToStr(I)));
      FProducer.Send(R).Get(WAIT_MS);
    end;
  finally
    LParent.Finish;
  end;
  LSpans := FExporter.Spans;
  TAssert.AssertEquals(COUNT, KafkaTestCountSpans(LSpans, 'send ' + FTopic));
  LSendIds := '';
  for S := 0 to High(LSpans) do
    if LSpans[S].Name = 'send ' + FTopic then
    begin
      TAssert.AssertEquals(LTraceId, LSpans[S].TraceId);
      TAssert.AssertTrue('the broker', KafkaTestAttribute(LSpans[S], 'server.port') <> '');
      LSendIds := LSendIds + LSpans[S].SpanId + ',';
    end;

  OpenConsumer;
  LRecords := PollFor(COUNT);
  TAssert.AssertEquals(COUNT, Length(LRecords));
  for I := 0 to High(LRecords) do
  begin
    TAssert.AssertTrue('a traceparent', PcTryParseTraceParent(
      HeaderOf(LRecords[I], KAFKA_TRACEPARENT_HEADER), LParsed));
    TAssert.AssertEquals(LTraceId, LParsed.TraceId);
    TAssert.AssertTrue('a send span''s id', Pos(LParsed.ParentId + ',', LSendIds) > 0);
    LProcess := FConsumer.StartProcessSpan(LRecords[I]);
    KafkaFinishSpan(LProcess, nil);
    LProcess := nil;
  end;
  LSpans := FExporter.Spans;
  TAssert.AssertEquals(COUNT, KafkaTestCountSpans(LSpans, 'process ' + FTopic));
  for X := 0 to High(LSpans) do
    if LSpans[X].Name = 'process ' + FTopic then
    begin
      TAssert.AssertTrue(LSpans[X].Kind = skConsumer);
      TAssert.AssertEquals('the sender''s trace', LTraceId, LSpans[X].TraceId);
      TAssert.AssertTrue('a child of a send span', Pos(LSpans[X].ParentSpanId + ',', LSendIds) > 0);
      TAssert.AssertEquals(FGroup, KafkaTestAttribute(LSpans[X], 'messaging.consumer.group.name'));
    end;
  P := KafkaTestFindSpan(LSpans, 'poll ' + FTopic);
  TAssert.AssertTrue('the poll span', P >= 0);
  TAssert.AssertEquals(FGroup, KafkaTestAttribute(LSpans[P], 'messaging.consumer.group.name'));
end;

procedure TKafkaTracingIntegrationTests.Metrics_ProducerAndGroupConsumer;
var
  I, N: Integer;
  LInFlight, LLag: Double;
begin
  LInFlight := KafkaTestMetric('pascalkafka.producer.batches.in_flight', []);
  OpenProducer;
  for I := 1 to COUNT do
    FProducer.Send(KafkaProducerRecord(FTopic, PcStringToUtf8Bytes(IntToStr(I)),
      PcStringToUtf8Bytes('metric ' + IntToStr(I))));
  TAssert.AssertTrue(FProducer.Flush(WAIT_MS));
  TAssert.AssertEquals(COUNT * 1.0, KafkaTestMetric('messaging.client.sent.messages',
    ['kafka', FTopic, '']), 0.0);
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.producer.bytes', [FTopic]) > 0);
  TAssert.AssertEquals('none left in flight', LInFlight,
    KafkaTestMetric('pascalkafka.producer.batches.in_flight', []), 0.0);

  OpenConsumer;
  N := Length(PollFor(COUNT));
  TAssert.AssertEquals(COUNT, N);
  TAssert.AssertEquals(COUNT * 1.0, KafkaTestMetric('messaging.client.consumed.messages',
    ['kafka', FTopic, FGroup]), 0.0);
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.consumer.rebalances', [FGroup, 'assigned']) >= 1);
  LLag := 0;
  for I := 0 to 2 do
    LLag := LLag + KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, IntToStr(I), FGroup]);
  TAssert.AssertEquals('everything read', 0.0, LLag, 0.0);
  FConsumer.Commit;
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.consumer.commits',
    [FGroup, 'sync', '']), 0.0);
  FConsumer.Close;
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.consumer.rebalances', [FGroup, 'revoked']) >= 1);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaTracingIntegrationTests);

end.
