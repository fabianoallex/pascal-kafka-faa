implementation

const
  TOPIC = 'pascal-kafka-faa-it';

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function TestHost: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost');
end;

function TestPort: Word;
begin
  Result := StrToInt(EnvOr('KAFKA_TEST_PORT', '9092'));
end;

function TestTlsPort: Word;
begin
  Result := StrToInt(EnvOr('KAFKA_TEST_TLS_PORT', '9093'));
end;

function TopicRequest(const ATopic: string; AAutoCreate: Boolean): TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Name := ATopic;
  Result.AllowAutoTopicCreation := AAutoCreate;
end;

{ TKafkaIntegrationTests }

procedure TKafkaIntegrationTests.TearDown;
begin
  FreeAndNil(FConnection);
end;

function TKafkaIntegrationTests.Plain: TKafkaConnectionParams;
begin
  Result := KafkaConnectionParams(TestHost, TestPort);
  Result.ClientId := 'pascal-kafka-faa-it';
  Result.ConnectTimeoutMs := 5000;
  Result.RequestTimeoutMs := 10000;
end;

function TKafkaIntegrationTests.Tls(ABackend: TPcTlsBackend;
  const ACaFile: string): TKafkaConnectionParams;
begin
  Result := Plain;
  Result.Port := TestTlsPort;
  Result.UseTls := True;
  Result.TlsBackend := ABackend;
  Result.TlsCaFile := KafkaTestPkiDir + ACaFile;
  Result.TlsHandshakeTimeoutMs := 5000;
end;

function TKafkaIntegrationTests.Open(const AParams: TKafkaConnectionParams): TKafkaConnection;
begin
  FreeAndNil(FConnection);
  FConnection := TKafkaConnection.Create(AParams);
  FConnection.Open;
  Result := FConnection;
end;

procedure TKafkaIntegrationTests.OpenFConnection;
begin
  FConnection.Open;
end;

function TKafkaIntegrationTests.ReadTopic(AConnection: TKafkaConnection): TKafkaMetadataResponse;
var
  Deadline: TDateTime;
  Pause: TEvent;
begin
  Deadline := Now + 30 / SecsPerDay;
  Pause := TEvent.Create(nil, True, False, '');
  try
    repeat
      Result := AConnection.Metadata(TopicRequest(TOPIC, True));
      if (Length(Result.Topics) = 1) and (Result.Topics[0].ErrorCode = 0) and
         (Length(Result.Topics[0].Partitions) > 0) and
         (Result.Topics[0].Partitions[0].LeaderId >= 0) then
        Exit;
      Pause.WaitFor(250);
    until Now > Deadline;
  finally
    Pause.Free;
  end;
  TAssert.Fail(Format('Topic %s not ready in 30 s (error %s)',
    [TOPIC, KafkaErrorText(Result.Topics[0].ErrorCode)]));
end;

procedure TKafkaIntegrationTests.CheckTopic(const R: TKafkaMetadataResponse; AExpectedPort: Integer);
var
  I: Integer;
begin
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertEquals(1, Length(R.Brokers));
  TAssert.AssertEquals('localhost', R.Brokers[0].Host);
  // Each listener advertises itself: 9092 in plaintext, 9093 over TLS.
  TAssert.AssertEquals(AExpectedPort, R.Brokers[0].Port);
  TAssert.AssertFalse(R.ClusterIdIsNull);
  TAssert.AssertEquals(R.Brokers[0].NodeId, R.ControllerId);
  TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
  TAssert.AssertFalse('topic id', R.Topics[0].TopicId.IsZero);
  // KAFKA_NUM_PARTITIONS in the compose file.
  TAssert.AssertEquals(3, Length(R.Topics[0].Partitions));
  for I := 0 to High(R.Topics[0].Partitions) do
  begin
    TAssert.AssertEquals(0, Integer(R.Topics[0].Partitions[I].ErrorCode));
    TAssert.AssertEquals(R.Brokers[0].NodeId, R.Topics[0].Partitions[I].LeaderId);
  end;
end;

function TKafkaIntegrationTests.OpenSslMissing(const AParams: TKafkaConnectionParams): Boolean;
begin
  Result := False;
  {$IFDEF MSWINDOWS}
  try
    Open(AParams);
  except
    on E: EKafkaTls do
      if Pos('OpenSSL', E.Message) > 0 then
      begin
        System.WriteLn('  [notice] OpenSSL not loadable, ', E.Message);
        Result := True;
      end
      else
        raise;
  end;
  {$ELSE}
  Open(AParams);
  {$ENDIF}
end;

procedure TKafkaIntegrationTests.Plaintext_NegotiatesApiVersionsWithTheBroker;
var
  Av: TKafkaApiVersionsResponse;
begin
  Open(Plain);
  TAssert.AssertTrue(FConnection.IsOpen);
  // Kafka 4.4.0 knows ApiVersions 0-5 and Metadata 0-13, as this library does.
  TAssert.AssertEquals(5, Integer(FConnection.ApiVersionsVersion));
  TAssert.AssertEquals(5, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_API_VERSIONS)));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA)));
  Av := FConnection.BrokerApiVersions;
  TAssert.AssertEquals(0, Integer(Av.ErrorCode));
  TAssert.AssertTrue('the broker lists its APIs', Length(Av.ApiKeys) > 40);
  TAssert.AssertTrue('and its features', Length(Av.SupportedFeatures) > 0);
end;

procedure TKafkaIntegrationTests.Plaintext_ReadsTheTopicsMetadata;
begin
  Open(Plain);
  CheckTopic(ReadTopic(FConnection), TestPort);
end;

procedure TKafkaIntegrationTests.Plaintext_ManyRequestsInFlight;
const
  N = 50;
var
  Futures: array[0..N - 1] of IKafkaResponseFuture;
  V: Int16;
  I: Integer;
  R: TKafkaMetadataResponse;
begin
  Open(Plain);
  ReadTopic(FConnection); // the topic exists before the burst
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  for I := 0 to N - 1 do
    Futures[I] := FConnection.Send(KAFKA_API_KEY_METADATA, V, TopicRequest(TOPIC, True).ToBytes(V));
  for I := 0 to N - 1 do
  begin
    TAssert.AssertTrue('answered ' + IntToStr(I), Futures[I].Wait(10000));
    R.FromBytes(Futures[I].Body, V);
    TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
    Futures[I] := nil;
  end;
  TAssert.AssertEquals(0, FConnection.InFlightCount);
end;

procedure TKafkaIntegrationTests.Plaintext_UnknownTopicWithoutAutoCreation;
var
  R: TKafkaMetadataResponse;
  Name: string;
begin
  Open(Plain);
  Name := Format('pascal-kafka-faa-missing-%d', [Random(1000000000)]);
  R := FConnection.Metadata(TopicRequest(Name, False));
  TAssert.AssertEquals(1, Length(R.Topics));
  TAssert.AssertEquals(KAFKA_ERROR_UNKNOWN_TOPIC_OR_PARTITION, Integer(R.Topics[0].ErrorCode));
end;

procedure TKafkaIntegrationTests.Tls_DefaultBackend_PrivateCa;
begin
  Open(Tls(tbDefault, 'ca_cert.pem'));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA)));
  CheckTopic(ReadTopic(FConnection), TestTlsPort);
end;

procedure TKafkaIntegrationTests.Tls_OpenSsl_PrivateCa;
begin
  if OpenSslMissing(Tls(tbOpenSsl, 'ca_cert.pem')) then
    Exit;
  CheckTopic(ReadTopic(FConnection), TestTlsPort);
end;

procedure TKafkaIntegrationTests.Tls_CaThatDidntSignTheBroker_IsEKafkaTls;
begin
  FConnection := TKafkaConnection.Create(Tls(tbDefault, 'rogue_ca_cert.pem'));
  TAssert.AssertException(EKafkaTls, OpenFConnection);
end;

procedure TKafkaIntegrationTests.PlaintextClientOnTheTlsPort_FailsWithoutHanging;
var
  P: TKafkaConnectionParams;
  Message: string;
begin
  P := Plain;
  P.Port := TestTlsPort;
  P.RequestTimeoutMs := 5000;
  FConnection := TKafkaConnection.Create(P);
  Message := '';
  try
    FConnection.Open;
  except
    // The broker answers the ApiVersions bytes with a TLS alert
    // (15 03 03 00 02 02 50, measured), which reads as a size prefix of
    // 352 518 912 bytes: over the limit, so the connection breaks at once.
    on E: EKafkaProtocol do
      Message := E.Message;
  end;
  TAssert.AssertTrue('EKafkaProtocol naming TLS: ' + Message, Pos('TLS', Message) > 0);
  TAssert.AssertFalse(FConnection.IsOpen);
end;

initialization
  Randomize;
  RegisterTest(TKafkaIntegrationTests);

end.
