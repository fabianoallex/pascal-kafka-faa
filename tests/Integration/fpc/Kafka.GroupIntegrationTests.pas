{ The KIP-848 group membership (Kafka.Group.Consumer) against the real
  Apache Kafka 4.4.0 broker of docker/docker-compose.yml (plaintext 9092),
  to check what the fake coordinator of the unit suite can't: that a real
  coordinator agrees with this client's heartbeats, acknowledgements,
  commits and leave.

  - One member: joins a new topic's group, gets its three partitions,
    commits two offsets, reads them back, leaves (a revoke first); a second
    membership of the same group, which never joins, reads the commits as a
    simple consumer would, and the group has no member left.
  - Two members: the second joins, the first revokes before the second is
    given anything, and the three partitions end up split between them
    with none twice; then the second leaves and the first gets them all.

  Each run has a topic and a group of its own (KafkaTestUniqueId). The
  broker gives the heartbeat interval (group.consumer.heartbeat.interval.ms,
  5 s by default): a rebalance takes up to two intervals (the first member
  hears of it, then the second), so the waits are generous; they are on
  the membership's Notify signal, never a Sleep. The topic is auto-created
  (the compose file allows it, 3 partitions); the wait for its leader is
  the cluster's (MaxBlockMs).

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  Classes,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Connection,
  Kafka.Cluster,
  Kafka.Group,
  Kafka.Group.Consumer,
  Kafka.TestHelpers;

type
  TKafkaGroupItCounts = array[TKafkaGroupEventKind] of Integer;

  TKafkaGroupIntegrationTests = class(TTestCase)
  private
    FTopic: string;
    FGroup: string;
    FClusters: array[0..1] of TKafkaCluster;
    FMembers: array[0..1] of TKafkaConsumerProtocol;
    FMemberRefs: array[0..1] of IKafkaGroupMembership;
    FSignal: TKafkaEventSignal;
    FSignalRef: IKafkaSignal;
    FCounts: array[0..1] of TKafkaGroupItCounts;
    FRevoked: array[0..1] of string;
    function OpenCluster(AWhich: Integer): TKafkaCluster;
    function NewMember(AWhich: Integer): TKafkaConsumerProtocol;
    procedure HandleA(AKind: TKafkaGroupEventKind; const APartitions: TKafkaTopicPartitionArray);
    procedure HandleB(AKind: TKafkaGroupEventKind; const APartitions: TKafkaTopicPartitionArray);
    procedure PollBoth;
    /// Polls both members until A holds ACountA partitions and B ACountB.
    function PollUntil(ACountA, ACountB: Integer; ATimeoutMs: Cardinal): Boolean;
  protected
    /// ACountA = -1: until both hold some and together all three.
    procedure SetUp; override;
    procedure TearDown; override;
  published
    procedure OneMember_JoinsCommitsAndLeaves;
    procedure TwoMembers_SplitThePartitions_ThenOneLeaves;
  end;

implementation

const
  WAIT_MS = 30000;

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function Bootstrap: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost') + ':' + EnvOr('KAFKA_TEST_PORT', '9092');
end;

function Remaining(ADeadline: UInt64): Cardinal;
var
  LNow: UInt64;
begin
  LNow := PcTickMs;
  if LNow >= ADeadline then
    Result := 0
  else
    Result := Cardinal(ADeadline - LNow);
end;

function PartitionsText(const A: TKafkaTopicPartitionArray): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Sorted := True;
    for I := 0 to High(A) do
      L.Add(IntToStr(A[I].Partition));
    Result := L.CommaText;
  finally
    L.Free;
  end;
end;

{ TKafkaGroupIntegrationTests }

procedure TKafkaGroupIntegrationTests.Setup;
var
  I: Integer;
  K: TKafkaGroupEventKind;
begin
  FTopic := 'pascal-kafka-faa-it-group-' + KafkaTestUniqueId;
  FGroup := 'pascal-kafka-faa-it-' + KafkaTestUniqueId;
  FSignal := TKafkaEventSignal.Create;
  FSignalRef := FSignal;
  for I := 0 to 1 do
  begin
    FClusters[I] := nil;
    FMembers[I] := nil;
    FMemberRefs[I] := nil;
    FRevoked[I] := '';
    for K := Low(TKafkaGroupEventKind) to High(TKafkaGroupEventKind) do
      FCounts[I][K] := 0;
  end;
end;

procedure TKafkaGroupIntegrationTests.TearDown;
var
  I: Integer;
begin
  for I := 0 to 1 do
  begin
    FMembers[I] := nil;
    FMemberRefs[I] := nil;
  end;
  for I := 0 to 1 do
    FreeAndNil(FClusters[I]);
  FSignal := nil;
  FSignalRef := nil;
end;

function TKafkaGroupIntegrationTests.OpenCluster(AWhich: Integer): TKafkaCluster;
var
  P: TKafkaClusterParams;
begin
  P := KafkaClusterParams(Bootstrap);
  P.Connection.ClientId := 'pascal-kafka-faa-group-it';
  P.MaxBlockMs := WAIT_MS;
  P.AllowAutoTopicCreation := True;
  FClusters[AWhich] := TKafkaCluster.Create(P);
  FClusters[AWhich].Open;
  // Created by the broker on this Metadata request; the cluster waits for
  // its leader.
  FClusters[AWhich].Topic(FTopic);
  Result := FClusters[AWhich];
end;

function TKafkaGroupIntegrationTests.NewMember(AWhich: Integer): TKafkaConsumerProtocol;
var
  P: TKafkaConsumerProtocolParams;
begin
  if FClusters[AWhich] = nil then
    OpenCluster(AWhich);
  P := KafkaConsumerProtocolParams(FGroup);
  P.Notify := FSignalRef;
  FMembers[AWhich] := TKafkaConsumerProtocol.Create(FClusters[AWhich], P);
  FMemberRefs[AWhich] := FMembers[AWhich];
  Result := FMembers[AWhich];
end;

procedure TKafkaGroupIntegrationTests.HandleA(AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Inc(FCounts[0][AKind]);
  if AKind = kgeRevoked then
    FRevoked[0] := PartitionsText(APartitions);
end;

procedure TKafkaGroupIntegrationTests.HandleB(AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Inc(FCounts[1][AKind]);
  if AKind = kgeRevoked then
    FRevoked[1] := PartitionsText(APartitions);
end;

procedure TKafkaGroupIntegrationTests.PollBoth;
begin
  if FMembers[0] <> nil then
    FMembers[0].Poll(HandleA);
  if FMembers[1] <> nil then
    FMembers[1].Poll(HandleB);
end;

function TKafkaGroupIntegrationTests.PollUntil(ACountA, ACountB: Integer;
  ATimeoutMs: Cardinal): Boolean;
var
  LDeadline: UInt64;

  function Count(AWhich: Integer): Integer;
  begin
    if FMembers[AWhich] = nil then
      Result := 0
    else
      Result := Length(FMembers[AWhich].Assignment);
  end;

begin
  LDeadline := PcTickMs + ATimeoutMs;
  while True do
  begin
    PollBoth;
    if (ACountA < 0) and (Count(0) > 0) and (Count(1) > 0) and (Count(0) + Count(1) = 3) then
      Exit(True);
    if (Count(0) = ACountA) and (Count(1) = ACountB) then
      Exit(True);
    if PcTickMs >= LDeadline then
      Exit(False);
    FSignal.WaitFor(Remaining(LDeadline));
  end;
end;

procedure TKafkaGroupIntegrationTests.OneMember_JoinsCommitsAndLeaves;
var
  A, Reader: TKafkaConsumerProtocol;
  LOffsets, LGot: TKafkaCommittedOffsetArray;
begin
  A := NewMember(0);
  A.Subscribe([FTopic]);
  TAssert.AssertTrue('joined with every partition', PollUntil(3, 0, WAIT_MS));
  TAssert.AssertEquals('0,1,2', PartitionsText(A.Assignment));
  TAssert.AssertTrue(A.MemberEpoch > 0);
  SetLength(LOffsets, 2);
  LOffsets[0].Topic := FTopic;
  LOffsets[0].Partition := 0;
  LOffsets[0].Offset := 0;
  LOffsets[0].LeaderEpoch := -1;
  LOffsets[0].Metadata := 'from pascal';
  LOffsets[1] := LOffsets[0];
  LOffsets[1].Partition := 2;
  LOffsets[1].Metadata := '';
  A.Commit(LOffsets, WAIT_MS);
  LGot := A.Committed([KafkaTopicPartition(FTopic, 0), KafkaTopicPartition(FTopic, 1),
    KafkaTopicPartition(FTopic, 2)], WAIT_MS);
  TAssert.AssertEquals(Int64(0), LGot[0].Offset);
  TAssert.AssertEquals('from pascal', LGot[0].Metadata);
  TAssert.AssertEquals(Int64(-1), LGot[1].Offset);
  TAssert.AssertEquals(Int64(0), LGot[2].Offset);
  A.Leave(HandleA, WAIT_MS);
  TAssert.AssertEquals(1, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals('0,1,2', FRevoked[0]);
  TAssert.AssertEquals(-1, A.MemberEpoch);
  // Another membership of the group, not joined: a simple consumer's read.
  Reader := NewMember(1);
  LGot := Reader.Committed([KafkaTopicPartition(FTopic, 0)], WAIT_MS);
  TAssert.AssertEquals(Int64(0), LGot[0].Offset);
  TAssert.AssertEquals('from pascal', LGot[0].Metadata);
end;

procedure TKafkaGroupIntegrationTests.TwoMembers_SplitThePartitions_ThenOneLeaves;
var
  A, B: TKafkaConsumerProtocol;
  LAll: TKafkaTopicPartitionArray;
  I: Integer;
begin
  A := NewMember(0);
  A.Subscribe([FTopic]);
  TAssert.AssertTrue('A joined with every partition', PollUntil(3, 0, WAIT_MS));
  B := NewMember(1);
  B.Subscribe([FTopic]);
  // The uniform assignor: two and one. A lets go first (a revoke), then B
  // gets what A let go.
  TAssert.AssertTrue('split between the two', PollUntil(-1, -1, 2 * WAIT_MS));
  TAssert.AssertEquals(1, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals(0, FCounts[1][kgeRevoked]);
  TAssert.AssertEquals(FRevoked[0], PartitionsText(B.Assignment));
  LAll := A.Assignment;
  SetLength(LAll, Length(LAll) + Length(B.Assignment));
  for I := 0 to High(B.Assignment) do
    LAll[Length(A.Assignment) + I] := B.Assignment[I];
  TAssert.AssertEquals('none twice, none missing', '0,1,2', PartitionsText(LAll));
  TAssert.AssertEquals(0, FCounts[0][kgeLost]);
  TAssert.AssertEquals(0, FCounts[1][kgeLost]);
  // B leaves: A gets everything back.
  B.Leave(HandleB, WAIT_MS);
  FMembers[1] := nil;
  TAssert.AssertTrue('A got them back', PollUntil(3, 0, 2 * WAIT_MS));
  TAssert.AssertEquals(0, FCounts[0][kgeLost]);
end;

initialization
  RegisterTest(TKafkaGroupIntegrationTests);

end.
