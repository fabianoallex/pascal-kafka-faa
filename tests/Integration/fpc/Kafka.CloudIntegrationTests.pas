  Kafka.TestHelpers,
  Kafka.TestTracing;

type
  TKafkaCloudIntegrationTests = class(TTestCase)
  private
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FExporter: TKafkaTestSpanExporter;
    FEnds: TKafkaInt64Array;
    FAssigned: Integer;
    function Connection: TKafkaConnectionParams;
    procedure SeekToEnds(ASender: TKafkaConsumer; const APartitions: TKafkaTopicPartitionArray);
  protected
    procedure SetUp; override;
    procedure TearDown; override;
  published
    procedure ConfluentCloud_SaslPlainOverTls_ProducesAndConsumes;
    procedure ConfluentCloud_TraceContextAndMetrics_ThroughAGroup;
  end;

implementation

function CloudConfigured: Boolean;
begin
  Result := (GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP') <> '') and
    (GetEnvironmentVariable('KAFKA_CLOUD_API_KEY') <> '') and
    (GetEnvironmentVariable('KAFKA_CLOUD_API_SECRET') <> '');
end;

function CloudTopic: string;
begin
  Result := GetEnvironmentVariable('KAFKA_CLOUD_TOPIC');
  if Result = '' then
    Result := 'pascal-kafka-faa-it';
end;

function SkippedNotice: Boolean;
begin
  Result := not CloudConfigured;
  if Result then
    System.WriteLn('  [notice] Confluent Cloud test skipped: set KAFKA_CLOUD_BOOTSTRAP, ' +
      'KAFKA_CLOUD_API_KEY and KAFKA_CLOUD_API_SECRET to run it');
end;

function HeaderOf(const ARecord: TKafkaConsumerRecord; const AKey: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ARecord.Headers) do
    if ARecord.Headers[I].Key = AKey then
      PcTryUtf8BytesToString(ARecord.Headers[I].Value, Result);
end;

procedure TKafkaCloudIntegrationTests.Setup;
begin
  FProducer := nil;
  FConsumer := nil;
  FExporter := nil;
  FEnds := nil;
  FAssigned := 0;
end;

procedure TKafkaCloudIntegrationTests.TearDown;
begin
  FreeAndNil(FConsumer);
  FreeAndNil(FProducer);
  if FExporter <> nil then
  begin
    FExporter := nil;
    KafkaTestStopTracing;
  end;
end;

procedure TKafkaCloudIntegrationTests.SeekToEnds(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
var
  I: Integer;
begin
  for I := 0 to High(APartitions) do
    ASender.Seek(APartitions[I].Topic, APartitions[I].Partition,
      FEnds[APartitions[I].Partition]);
  Inc(FAssigned, Length(APartitions));
end;

function TKafkaCloudIntegrationTests.Connection: TKafkaConnectionParams;
begin
  // Host and port come from each broker's metadata; the template has the rest.
  Result := KafkaConnectionParams('', 9092);
  Result.ClientId := 'pascal-kafka-faa-cloud-it';
  Result.ConnectTimeoutMs := 15000;
  Result.RequestTimeoutMs := 30000;
  Result.UseTls := True;
  // Empty: the system's trust store, as for any public broker.
  Result.TlsCaFile := GetEnvironmentVariable('KAFKA_CLOUD_CA_FILE');
  Result.SaslMechanism := ksmPlain;
  Result.SaslUsername := GetEnvironmentVariable('KAFKA_CLOUD_API_KEY');
  Result.SaslPassword := GetEnvironmentVariable('KAFKA_CLOUD_API_SECRET');
end;

procedure TKafkaCloudIntegrationTests.ConfluentCloud_SaslPlainOverTls_ProducesAndConsumes;
const
  N = 30;
var
  PP: TKafkaProducerParams;
  CP: TKafkaConsumerParams;
  T: TKafkaTopicInfo;
  All: array of TKafkaTopicPartition;
  Ends: TKafkaInt64Array;
  F: array[0..N - 1] of IKafkaDeliveryFuture;
  Rep: array[0..N - 1] of TKafkaDeliveryReport;
  Rec: TKafkaProducerRecord;
  Got: TKafkaConsumerRecordArray;
  Marker, Text: string;
  I, K, Count, Leaders: Integer;
  Deadline: UInt64;
begin
  if SkippedNotice then
    Exit;
  CP := KafkaConsumerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  CP.Cluster.Connection := Connection;
  CP.Cluster.MaxBlockMs := 60000;
  CP.FetchMaxWaitMs := 500;
  FConsumer := TKafkaConsumer.Create(CP);
  FConsumer.Open;
  T := FConsumer.Cluster.Topic(CloudTopic);
  TAssert.AssertTrue('partitions', Length(T.Partitions) > 0);
  System.WriteLn(Format('  [cloud] %d brokers, topic %s with %d partitions',
    [Length(FConsumer.Cluster.Metadata.Brokers), CloudTopic, Length(T.Partitions)]));
  SetLength(All, Length(T.Partitions));
  for I := 0 to High(All) do
    All[I] := KafkaTopicPartition(CloudTopic, I);
  FConsumer.Assign(All);
  Ends := FConsumer.EndOffsets(All);
  for I := 0 to High(All) do
    FConsumer.Seek(CloudTopic, I, Ends[I]);

  PP := KafkaProducerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  PP.Cluster.Connection := Connection;
  PP.Cluster.MaxBlockMs := 60000;
  PP.Compression := kcGzip;
  FProducer := TKafkaProducer.Create(PP);
  FProducer.Open;
  Marker := 'cloud-it-' + KafkaTestUniqueId;
  for I := 0 to N - 1 do
  begin
    Rec := KafkaProducerRecord(CloudTopic, PcStringToUtf8Bytes(Marker + '-key-' + IntToStr(I mod 7)),
      PcStringToUtf8Bytes(Marker + ' ' + IntToStr(I)));
    SetLength(Rec.Headers, 1);
    Rec.Headers[0].Key := 'n';
    Rec.Headers[0].Value := PcStringToUtf8Bytes(IntToStr(I));
    F[I] := FProducer.Send(Rec);
  end;
  TAssert.AssertTrue('flushed', FProducer.Flush(60000));
  for I := 0 to N - 1 do
    Rep[I] := F[I].Get(0);
  Leaders := 0;
  for I := 0 to High(T.Partitions) do
    if FProducer.Cluster.Leader(CloudTopic, I).Connection.Params.SaslMechanism = ksmPlain then
      Inc(Leaders);
  TAssert.AssertEquals('every leader over SASL', Length(T.Partitions), Leaders);

  Count := 0;
  Deadline := PcTickMs + 60000;
  while (Count < N) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(1000);
    for K := 0 to High(Got) do
      if PcTryUtf8BytesToString(Got[K].Value, Text) and (Pos(Marker + ' ', Text) = 1) then
      begin
        I := StrToInt(Copy(Text, Length(Marker) + 2, MaxInt));
        TAssert.AssertEquals('where the report said', Rep[I].Partition, Got[K].Partition);
        TAssert.AssertEquals(Rep[I].Offset, Got[K].Offset);
        TAssert.AssertTrue(PcTryUtf8BytesToString(Got[K].Key, Text));
        TAssert.AssertEquals(Marker + '-key-' + IntToStr(I mod 7), Text);
        Inc(Count);
      end;
  end;
  TAssert.AssertEquals('all polled', N, Count);
  System.WriteLn(Format('  [cloud] %d records produced and polled back', [N]));
end;

procedure TKafkaCloudIntegrationTests.ConfluentCloud_TraceContextAndMetrics_ThroughAGroup;
const
  N = 5;
  WAIT_MS = 60000;
var
  PP: TKafkaProducerParams;
  CP: TKafkaConsumerParams;
  T: TKafkaTopicInfo;
  All: array of TKafkaTopicPartition;
  Group, Marker, Text, TraceId, SendIds: string;
  Parent, Process: IPcSpan;
  Spans: TPcSpanDataArray;
  Parsed: TPcTraceParent;
  Got: TKafkaConsumerRecordArray;
  Ours: array of TKafkaConsumerRecord;
  SentBefore, Lag: Double;
  I, K, P, Count: Integer;
  Deadline: UInt64;
begin
  if SkippedNotice then
    Exit;
  FExporter := KafkaTestStartTracing;
  Marker := 'cloud-trace-' + KafkaTestUniqueId;
  Group := 'pascal-kafka-faa-cloud-it-' + KafkaTestUniqueId;

  CP := KafkaConsumerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  CP.Cluster.Connection := Connection;
  CP.Cluster.MaxBlockMs := WAIT_MS;
  CP.GroupId := Group;
  CP.EnableAutoCommit := False;
  CP.FetchMaxWaitMs := 500;
  FConsumer := TKafkaConsumer.Create(CP);
  FConsumer.OnPartitionsAssigned := SeekToEnds;
  FConsumer.Open;
  T := FConsumer.Cluster.Topic(CloudTopic);
  SetLength(All, Length(T.Partitions));
  for I := 0 to High(All) do
    All[I] := KafkaTopicPartition(CloudTopic, I);
  FEnds := FConsumer.EndOffsets(All);
  FConsumer.Subscribe([CloudTopic]);
  // The group's first assignment (one member: every partition); the handler
  // moves each partition to the end read above.
  Deadline := PcTickMs + WAIT_MS;
  while (FAssigned < Length(All)) and (PcTickMs < Deadline) do
    FConsumer.Poll(500);
  TAssert.AssertEquals('every partition assigned', Length(All), FAssigned);
  System.WriteLn(Format('  [cloud] group %s joined, %d partitions', [Group, FAssigned]));

  PP := KafkaProducerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  PP.Cluster.Connection := Connection;
  PP.Cluster.MaxBlockMs := WAIT_MS;
  FProducer := TKafkaProducer.Create(PP);
  FProducer.Open;
  SentBefore := KafkaTestMetric('messaging.client.sent.messages', ['kafka', CloudTopic, '']);
  Parent := TPcTracing.StartSpan('POST /orders', skServer);
  try
    TraceId := Parent.TraceId;
    for I := 0 to N - 1 do
      FProducer.Send(KafkaProducerRecord(CloudTopic, PcStringToUtf8Bytes(Marker + '-' + IntToStr(I)),
        PcStringToUtf8Bytes(Marker + ' ' + IntToStr(I)))).Get(WAIT_MS);
  finally
    Parent.Finish;
  end;
  Spans := FExporter.Spans;
  TAssert.AssertEquals(N, KafkaTestCountSpans(Spans, 'send ' + CloudTopic));
  SendIds := '';
  for K := 0 to High(Spans) do
    if Spans[K].Name = 'send ' + CloudTopic then
    begin
      TAssert.AssertEquals(TraceId, Spans[K].TraceId);
      TAssert.AssertTrue('the broker', KafkaTestAttribute(Spans[K], 'server.address') <> '');
      SendIds := SendIds + Spans[K].SpanId + ',';
    end;
  TAssert.AssertEquals(N * 1.0, KafkaTestMetric('messaging.client.sent.messages',
    ['kafka', CloudTopic, '']) - SentBefore, 0.0);

  Ours := nil;
  Deadline := PcTickMs + WAIT_MS;
  while (Length(Ours) < N) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(1000);
    for K := 0 to High(Got) do
      if PcTryUtf8BytesToString(Got[K].Value, Text) and (Pos(Marker + ' ', Text) = 1) then
      begin
        SetLength(Ours, Length(Ours) + 1);
        Ours[High(Ours)] := Got[K];
      end;
  end;
  TAssert.AssertEquals('all polled', N, Length(Ours));
  for I := 0 to High(Ours) do
  begin
    TAssert.AssertTrue('a traceparent from the broker', PcTryParseTraceParent(
      HeaderOf(Ours[I], KAFKA_TRACEPARENT_HEADER), Parsed));
    TAssert.AssertEquals(TraceId, Parsed.TraceId);
    TAssert.AssertTrue('a send span''s id', Pos(Parsed.ParentId + ',', SendIds) > 0);
    Process := FConsumer.StartProcessSpan(Ours[I]);
    KafkaFinishSpan(Process, nil);
    Process := nil;
  end;
  Spans := FExporter.Spans;
  Count := 0;
  for K := 0 to High(Spans) do
    if Spans[K].Name = 'process ' + CloudTopic then
    begin
      TAssert.AssertEquals('the sender''s trace', TraceId, Spans[K].TraceId);
      TAssert.AssertTrue('a child of a send span', Pos(Spans[K].ParentSpanId + ',', SendIds) > 0);
      TAssert.AssertEquals(Group, KafkaTestAttribute(Spans[K], 'messaging.consumer.group.name'));
      Inc(Count);
    end;
  TAssert.AssertEquals(N, Count);
  P := KafkaTestFindSpan(Spans, 'poll ' + CloudTopic);
  TAssert.AssertTrue('the poll span', P >= 0);

  TAssert.AssertTrue(KafkaTestMetric('messaging.client.consumed.messages',
    ['kafka', CloudTopic, Group]) >= N);
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.consumer.rebalances', [Group, 'assigned']) >= 1);
  Lag := 0;
  for I := 0 to High(All) do
    Lag := Lag + KafkaTestMetric('pascalkafka.consumer.lag', [CloudTopic, IntToStr(I), Group]);
  TAssert.AssertEquals('everything read', 0.0, Lag, 0.0);
  FConsumer.Commit;
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.consumer.commits', [Group, 'sync', '']), 0.0);
  FConsumer.Close;
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.consumer.rebalances', [Group, 'revoked']) >= 1);
  System.WriteLn(Format('  [cloud] %d records with their traceparent through the broker, ' +
    'process spans in the sender''s trace, metrics counted', [N]));
end;

initialization
  RegisterTest(TKafkaCloudIntegrationTests);

end.
