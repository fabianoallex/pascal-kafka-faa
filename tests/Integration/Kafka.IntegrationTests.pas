unit Kafka.IntegrationTests;

{ Integration tests against a real Apache Kafka 4.4.0 broker: the one-node
  KRaft broker of docker/docker-compose.yml (plaintext 9092, TLS 9093 with
  pascal-common-faa's test PKI).

  The K1 foundation's milestone (docs/design.md, section 7): connect,
  negotiate ApiVersions and read Metadata of a topic, in plaintext and over
  TLS with a private CA, on every TLS backend the platform has (SChannel and
  OpenSSL on Windows, OpenSSL elsewhere). Also: many requests in flight on one
  connection, a topic that doesn't exist, a CA that didn't sign the broker's
  certificate, a plaintext client on the TLS port (EKafkaProtocol at once,
  with a message that says the bytes look like TLS).

  Records: a batch written by this library (Kafka.Protocol.RecordBatch),
  produced to partition 0 and fetched back from the offset the broker gave
  it, in plaintext and, gzip-compressed, over TLS; ListOffsets sees the
  partition's end move. With acks=0 the broker sends no answer: the test
  asks for the partition's end first, then a Fetch from there with a
  MaxWaitMs, which the broker holds until the record arrives (no Sleep). Each
  record carries a marker of its own, so the tests don't depend on what
  earlier runs left in the topic.

  The cluster (Kafka.Cluster): a bootstrap past an address that isn't Kafka
  (the TLS port, in plaintext), the leaders of the topic's partitions on one
  connection per broker, the same over TLS, a topic auto-created on first
  use (a new name each run: the broker keeps them), and a keyed record sent
  to the partition murmur2 gives its key, through that partition's leader.

  The broker's address: KAFKA_TEST_HOST (default localhost), KAFKA_TEST_PORT
  (9092) and KAFKA_TEST_TLS_PORT (9093). The certificates: KafkaTestPkiDir.

  The topic (pascal-kafka-faa-it) is created by the broker on the first
  Metadata request that asks for it (auto-creation, on in the compose file);
  until its partitions have a leader the broker answers LEADER_NOT_AVAILABLE,
  so the first read retries for up to 30 s. That wait is on an external
  system, the one place these suites wait on time instead of an event.

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  SyncObjs,
  PascalCommon.Transport,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Protocol.Primitives,
  Kafka.Messages.Apis,
  Kafka.Messages.ApiVersions,
  Kafka.Messages.Metadata,
  Kafka.Messages.Produce,
  Kafka.Messages.Fetch,
  Kafka.Messages.ListOffsets,
  Kafka.Compression,
  Kafka.Protocol.RecordBatch,
  Kafka.Connection,
  Kafka.Partitioner,
  Kafka.Cluster,
  PascalCommon.Utf8,
  PascalCommon.Tracing,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaIntegrationTests = class
  private
    FConnection: TKafkaConnection;
    FCluster: TKafkaCluster;
    function Plain: TKafkaConnectionParams;
    function Tls(ABackend: TPcTlsBackend; const ACaFile: string): TKafkaConnectionParams;
    function Open(const AParams: TKafkaConnectionParams): TKafkaConnection;
    procedure OpenFConnection;
    function ReadTopic(AConnection: TKafkaConnection): TKafkaMetadataResponse;
    procedure CheckTopic(const R: TKafkaMetadataResponse; AExpectedPort: Integer);
    function OpenSslMissing(const AParams: TKafkaConnectionParams): Boolean;
    procedure ProduceAndFetchBack(ACodec: TKafkaCompression);
    function NewCluster(const ABootstrap: string; ATls: Boolean): TKafkaCluster;
  public
    [TearDown] procedure TearDown;
    [Test] procedure Plaintext_NegotiatesApiVersionsWithTheBroker;
    [Test] procedure Plaintext_ReadsTheTopicsMetadata;
    [Test] procedure Plaintext_ManyRequestsInFlight;
    [Test] procedure Plaintext_UnknownTopicWithoutAutoCreation;
    [Test] procedure Tls_DefaultBackend_PrivateCa;
    [Test] procedure Tls_OpenSsl_PrivateCa;
    [Test] procedure Tls_CaThatDidntSignTheBroker_IsEKafkaTls;
    [Test] procedure PlaintextClientOnTheTlsPort_FailsWithoutHanging;
    [Test] procedure Plaintext_ProducesAndFetchesTheRecordsBack;
    [Test] procedure Tls_ProducesAndFetchesBackGzip;
    [Test] procedure Plaintext_AcksZero_TheFetchWaitsForTheRecord;
    [Test] procedure Cluster_BootstrapsPastABadAddress_LeadersOnOneConnection;
    [Test] procedure Cluster_Tls_LeaderConnectionsUseTls;
    [Test] procedure Cluster_WaitsForAnAutoCreatedTopic;
    [Test] procedure Cluster_KeyedRecord_GoesToItsPartitionsLeader;
  end;

implementation

const
  TOPIC = 'pascal-kafka-faa-it';

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function TestHost: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost');
end;

function TestPort: Word;
begin
  Result := StrToInt(EnvOr('KAFKA_TEST_PORT', '9092'));
end;

function TestTlsPort: Word;
begin
  Result := StrToInt(EnvOr('KAFKA_TEST_TLS_PORT', '9093'));
end;

function NowUnixMs: Int64;
begin
  Result := PcUnixNanoOfLocal(Now) div 1000000;
end;

function Marker: string;
begin
  Result := Format('it-%d-%d', [NowUnixMs, Random(1000000000)]);
end;

/// Two records under AMarker: one with key, value and headers, one with a
/// null key.
function MarkedBatch(const AMarker: string; ACodec: TKafkaCompression): TKafkaRecordBatch;
var
  R: TKafkaRecord;
  T: Int64;
begin
  T := NowUnixMs;
  Result.Init;
  R := KafkaRecord(PcStringToUtf8Bytes(AMarker), PcStringToUtf8Bytes('São Paulo ' + AMarker), T);
  KafkaAddRecordHeader(R, 'marker', PcStringToUtf8Bytes(AMarker));
  KafkaAddRecordHeader(R, 'none', nil, True);
  Result.Append(R);
  R := KafkaRecord(nil, PcStringToUtf8Bytes('second ' + AMarker), T + 1);
  R.KeyIsNull := True;
  Result.Append(R);
  Result.SetCompression(ACodec);
end;

function ProduceRequest(const ATopicId: TKafkaUuid; const ABatch: TKafkaRecordBatch;
  AAcks: Int16; APartition: Int32 = 0): TKafkaProduceRequest;
begin
  Result.Init;
  Result.Acks := AAcks;
  Result.TimeoutMs := 10000;
  SetLength(Result.TopicData, 1);
  Result.TopicData[0].Init;
  // Name up to v12, TopicId from v13 (both ignorable): whatever version
  // the connection negotiated.
  Result.TopicData[0].Name := TOPIC;
  Result.TopicData[0].TopicId := ATopicId;
  SetLength(Result.TopicData[0].PartitionData, 1);
  Result.TopicData[0].PartitionData[0].Init;
  Result.TopicData[0].PartitionData[0].Index := APartition;
  Result.TopicData[0].PartitionData[0].Records := ABatch.Encode;
  Result.TopicData[0].PartitionData[0].RecordsIsNull := False;
end;

function FetchRequest(const ATopicId: TKafkaUuid; AOffset: Int64;
  AMaxWaitMs: Integer; APartition: Int32 = 0): TKafkaFetchRequest;
begin
  Result.Init;
  Result.MaxWaitMs := AMaxWaitMs;
  Result.MinBytes := 1;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Topic := TOPIC;
  Result.Topics[0].TopicId := ATopicId;
  SetLength(Result.Topics[0].Partitions, 1);
  Result.Topics[0].Partitions[0].Init;
  Result.Topics[0].Partitions[0].Partition := APartition;
  Result.Topics[0].Partitions[0].FetchOffset := AOffset;
  Result.Topics[0].Partitions[0].PartitionMaxBytes := 1 shl 20;
end;

/// The end of partition 0 (ListOffsets, timestamp -1).
function PartitionEnd(AConnection: TKafkaConnection): Int64;
var
  Req: TKafkaListOffsetsRequest;
  Rsp: TKafkaListOffsetsResponse;
begin
  Req.Init;
  Req.ReplicaId := -1;
  Req.TimeoutMs := 10000;
  SetLength(Req.Topics, 1);
  Req.Topics[0].Init;
  Req.Topics[0].Name := TOPIC;
  SetLength(Req.Topics[0].Partitions, 1);
  Req.Topics[0].Partitions[0].Init;
  Req.Topics[0].Partitions[0].PartitionIndex := 0;
  Req.Topics[0].Partitions[0].Timestamp := -1;
  Rsp := AConnection.ListOffsets(Req);
  TAssert.AssertEquals('ListOffsets error', 0, Integer(Rsp.Topics[0].Partitions[0].ErrorCode));
  Result := Rsp.Topics[0].Partitions[0].Offset;
end;

/// The first batch of a Fetch from AOffset: the one this test produced.
function FetchedBatch(AConnection: TKafkaConnection; const ATopicId: TKafkaUuid;
  AOffset: Int64; AMaxWaitMs: Integer): TKafkaRecordBatch;
var
  Rsp: TKafkaFetchResponse;
  P: TKafkaFetchResponsePartitionData;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
begin
  Rsp := AConnection.Fetch(FetchRequest(ATopicId, AOffset, AMaxWaitMs));
  P := Rsp.Responses[0].Partitions[0];
  TAssert.AssertEquals('Fetch error', 0, Integer(P.ErrorCode));
  Batches := KafkaDecodeRecordBatches(P.Records, 1 shl 24, Trailing);
  TAssert.AssertTrue('a batch came back', Length(Batches) > 0);
  // A fetch starts at the batch holding AOffset; this test's batch starts
  // there, since it was produced on its own.
  TAssert.AssertEquals('base offset', AOffset, Batches[0].BaseOffset);
  Result := Batches[0];
end;

/// The batch whose first key is AMarker, at AFrom or after: fetch after
/// fetch, each held by the broker until there is data. Fails after 30 s.
function FindMarkedBatch(AConnection: TKafkaConnection; const ATopicId: TKafkaUuid;
  AFrom: Int64; const AMarker: string): TKafkaRecordBatch;
var
  Rsp: TKafkaFetchResponse;
  Batches: TKafkaRecordBatchArray;
  Trailing, I: Integer;
  Offset: Int64;
  Deadline: TDateTime;
  Key: string;
begin
  Offset := AFrom;
  Deadline := Now + 30 / SecsPerDay;
  repeat
    Rsp := AConnection.Fetch(FetchRequest(ATopicId, Offset, 10000));
    TAssert.AssertEquals('Fetch error', 0, Integer(Rsp.Responses[0].Partitions[0].ErrorCode));
    Batches := KafkaDecodeRecordBatches(Rsp.Responses[0].Partitions[0].Records, 1 shl 24, Trailing);
    for I := 0 to High(Batches) do
    begin
      if (Length(Batches[I].Records) > 0) and
         PcTryUtf8BytesToString(Batches[I].Records[0].Key, Key) and (Key = AMarker) then
        Exit(Batches[I]);
      Offset := Batches[I].NextOffset;
    end;
  until Now > Deadline;
  TAssert.Fail('No batch with marker ' + AMarker + ' from offset ' + IntToStr(AFrom));
  Result.Init;
end;

procedure CheckMarkedBatch(const AMarker: string; const ABatch: TKafkaRecordBatch);
var
  Value: string;
begin
  TAssert.AssertEquals(2, Length(ABatch.Records));
  TAssert.AssertTrue(PcTryUtf8BytesToString(ABatch.Records[0].Key, Value));
  TAssert.AssertEquals(AMarker, Value);
  TAssert.AssertTrue(PcTryUtf8BytesToString(ABatch.Records[0].Value, Value));
  TAssert.AssertEquals('São Paulo ' + AMarker, Value);
  TAssert.AssertEquals(2, Length(ABatch.Records[0].Headers));
  TAssert.AssertEquals('marker', ABatch.Records[0].Headers[0].Key);
  TAssert.AssertTrue(ABatch.Records[0].Headers[1].ValueIsNull);
  TAssert.AssertTrue('null key', ABatch.Records[1].KeyIsNull);
  TAssert.AssertEquals(ABatch.BaseOffset + 1, ABatch.Records[1].Offset);
end;

function TopicRequest(const ATopic: string; AAutoCreate: Boolean): TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Name := ATopic;
  Result.AllowAutoTopicCreation := AAutoCreate;
end;

{ TKafkaIntegrationTests }

procedure TKafkaIntegrationTests.TearDown;
begin
  FreeAndNil(FCluster);
  FreeAndNil(FConnection);
end;

function TKafkaIntegrationTests.Plain: TKafkaConnectionParams;
begin
  Result := KafkaConnectionParams(TestHost, TestPort);
  Result.ClientId := 'pascal-kafka-faa-it';
  Result.ConnectTimeoutMs := 5000;
  Result.RequestTimeoutMs := 10000;
end;

function TKafkaIntegrationTests.Tls(ABackend: TPcTlsBackend;
  const ACaFile: string): TKafkaConnectionParams;
begin
  Result := Plain;
  Result.Port := TestTlsPort;
  Result.UseTls := True;
  Result.TlsBackend := ABackend;
  Result.TlsCaFile := KafkaTestPkiDir + ACaFile;
  Result.TlsHandshakeTimeoutMs := 5000;
end;

function TKafkaIntegrationTests.Open(const AParams: TKafkaConnectionParams): TKafkaConnection;
begin
  FreeAndNil(FConnection);
  FConnection := TKafkaConnection.Create(AParams);
  FConnection.Open;
  Result := FConnection;
end;

procedure TKafkaIntegrationTests.OpenFConnection;
begin
  FConnection.Open;
end;

function TKafkaIntegrationTests.ReadTopic(AConnection: TKafkaConnection): TKafkaMetadataResponse;
var
  Deadline: TDateTime;
  Pause: TEvent;
begin
  Deadline := Now + 30 / SecsPerDay;
  Pause := TEvent.Create(nil, True, False, '');
  try
    repeat
      Result := AConnection.Metadata(TopicRequest(TOPIC, True));
      if (Length(Result.Topics) = 1) and (Result.Topics[0].ErrorCode = 0) and
         (Length(Result.Topics[0].Partitions) > 0) and
         (Result.Topics[0].Partitions[0].LeaderId >= 0) then
        Exit;
      Pause.WaitFor(250);
    until Now > Deadline;
  finally
    Pause.Free;
  end;
  TAssert.Fail(Format('Topic %s not ready in 30 s (error %s)',
    [TOPIC, KafkaErrorText(Result.Topics[0].ErrorCode)]));
end;

procedure TKafkaIntegrationTests.CheckTopic(const R: TKafkaMetadataResponse; AExpectedPort: Integer);
var
  I: Integer;
begin
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertEquals(1, Length(R.Brokers));
  TAssert.AssertEquals('localhost', R.Brokers[0].Host);
  // Each listener advertises itself: 9092 in plaintext, 9093 over TLS.
  TAssert.AssertEquals(AExpectedPort, R.Brokers[0].Port);
  TAssert.AssertFalse(R.ClusterIdIsNull);
  TAssert.AssertEquals(R.Brokers[0].NodeId, R.ControllerId);
  TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
  TAssert.AssertFalse('topic id', R.Topics[0].TopicId.IsZero);
  // KAFKA_NUM_PARTITIONS in the compose file.
  TAssert.AssertEquals(3, Length(R.Topics[0].Partitions));
  for I := 0 to High(R.Topics[0].Partitions) do
  begin
    TAssert.AssertEquals(0, Integer(R.Topics[0].Partitions[I].ErrorCode));
    TAssert.AssertEquals(R.Brokers[0].NodeId, R.Topics[0].Partitions[I].LeaderId);
  end;
end;

function TKafkaIntegrationTests.OpenSslMissing(const AParams: TKafkaConnectionParams): Boolean;
begin
  Result := False;
  {$IFDEF MSWINDOWS}
  try
    Open(AParams);
  except
    on E: EKafkaTls do
      if Pos('OpenSSL', E.Message) > 0 then
      begin
        System.WriteLn('  [notice] OpenSSL not loadable, ', E.Message);
        Result := True;
      end
      else
        raise;
  end;
  {$ELSE}
  Open(AParams);
  {$ENDIF}
end;

procedure TKafkaIntegrationTests.Plaintext_NegotiatesApiVersionsWithTheBroker;
var
  Av: TKafkaApiVersionsResponse;
begin
  Open(Plain);
  TAssert.AssertTrue(FConnection.IsOpen);
  // Kafka 4.4.0 knows ApiVersions 0-5 and Metadata 0-13, as this library does.
  TAssert.AssertEquals(5, Integer(FConnection.ApiVersionsVersion));
  TAssert.AssertEquals(5, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_API_VERSIONS)));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA)));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_PRODUCE)));
  TAssert.AssertEquals(18, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_FETCH)));
  TAssert.AssertEquals(11, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_LIST_OFFSETS)));
  Av := FConnection.BrokerApiVersions;
  TAssert.AssertEquals(0, Integer(Av.ErrorCode));
  TAssert.AssertTrue('the broker lists its APIs', Length(Av.ApiKeys) > 40);
  TAssert.AssertTrue('and its features', Length(Av.SupportedFeatures) > 0);
end;

procedure TKafkaIntegrationTests.Plaintext_ReadsTheTopicsMetadata;
begin
  Open(Plain);
  CheckTopic(ReadTopic(FConnection), TestPort);
end;

procedure TKafkaIntegrationTests.Plaintext_ManyRequestsInFlight;
const
  N = 50;
var
  Futures: array[0..N - 1] of IKafkaResponseFuture;
  V: Int16;
  I: Integer;
  R: TKafkaMetadataResponse;
begin
  Open(Plain);
  ReadTopic(FConnection); // the topic exists before the burst
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  for I := 0 to N - 1 do
    Futures[I] := FConnection.Send(KAFKA_API_KEY_METADATA, V, TopicRequest(TOPIC, True).ToBytes(V));
  for I := 0 to N - 1 do
  begin
    TAssert.AssertTrue('answered ' + IntToStr(I), Futures[I].Wait(10000));
    R.FromBytes(Futures[I].Body, V);
    TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
    Futures[I] := nil;
  end;
  TAssert.AssertEquals(0, FConnection.InFlightCount);
end;

procedure TKafkaIntegrationTests.Plaintext_UnknownTopicWithoutAutoCreation;
var
  R: TKafkaMetadataResponse;
  Name: string;
begin
  Open(Plain);
  Name := Format('pascal-kafka-faa-missing-%d', [Random(1000000000)]);
  R := FConnection.Metadata(TopicRequest(Name, False));
  TAssert.AssertEquals(1, Length(R.Topics));
  TAssert.AssertEquals(KAFKA_ERROR_UNKNOWN_TOPIC_OR_PARTITION, Integer(R.Topics[0].ErrorCode));
end;

procedure TKafkaIntegrationTests.Tls_DefaultBackend_PrivateCa;
begin
  Open(Tls(tbDefault, 'ca_cert.pem'));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA)));
  CheckTopic(ReadTopic(FConnection), TestTlsPort);
end;

procedure TKafkaIntegrationTests.Tls_OpenSsl_PrivateCa;
begin
  if OpenSslMissing(Tls(tbOpenSsl, 'ca_cert.pem')) then
    Exit;
  CheckTopic(ReadTopic(FConnection), TestTlsPort);
end;

procedure TKafkaIntegrationTests.Tls_CaThatDidntSignTheBroker_IsEKafkaTls;
begin
  FConnection := TKafkaConnection.Create(Tls(tbDefault, 'rogue_ca_cert.pem'));
  TAssert.AssertException(EKafkaTls, OpenFConnection);
end;

procedure TKafkaIntegrationTests.PlaintextClientOnTheTlsPort_FailsWithoutHanging;
var
  P: TKafkaConnectionParams;
  Message: string;
begin
  P := Plain;
  P.Port := TestTlsPort;
  P.RequestTimeoutMs := 5000;
  FConnection := TKafkaConnection.Create(P);
  Message := '';
  try
    FConnection.Open;
  except
    // The broker answers the ApiVersions bytes with a TLS alert
    // (15 03 03 00 02 02 50, measured), which reads as a size prefix of
    // 352 518 912 bytes: over the limit, so the connection breaks at once.
    on E: EKafkaProtocol do
      Message := E.Message;
  end;
  TAssert.AssertTrue('EKafkaProtocol naming TLS: ' + Message, Pos('TLS', Message) > 0);
  TAssert.AssertFalse(FConnection.IsOpen);
end;

procedure TKafkaIntegrationTests.ProduceAndFetchBack(ACodec: TKafkaCompression);
var
  TopicId: TKafkaUuid;
  M: string;
  Rsp: TKafkaProduceResponse;
  P: TKafkaProduceResponsePartitionProduceResponse;
  Batch: TKafkaRecordBatch;
begin
  TopicId := ReadTopic(FConnection).Topics[0].TopicId;
  M := Marker;
  Rsp := FConnection.Produce(ProduceRequest(TopicId, MarkedBatch(M, ACodec), -1));
  TAssert.AssertEquals(1, Length(Rsp.Responses));
  P := Rsp.Responses[0].PartitionResponses[0];
  TAssert.AssertEquals('Produce error', 0, Integer(P.ErrorCode));
  TAssert.AssertTrue('an offset', P.BaseOffset >= 0);
  TAssert.AssertTrue('the end moved past the batch', PartitionEnd(FConnection) >= P.BaseOffset + 2);
  Batch := FetchedBatch(FConnection, TopicId, P.BaseOffset, 0);
  TAssert.AssertEquals('codec kept', Ord(ACodec), Ord(Batch.Compression));
  CheckMarkedBatch(M, Batch);
end;

procedure TKafkaIntegrationTests.Plaintext_ProducesAndFetchesTheRecordsBack;
begin
  Open(Plain);
  ProduceAndFetchBack(kcNone);
end;

procedure TKafkaIntegrationTests.Tls_ProducesAndFetchesBackGzip;
begin
  Open(Tls(tbDefault, 'ca_cert.pem'));
  ProduceAndFetchBack(kcGzip);
end;

procedure TKafkaIntegrationTests.Plaintext_AcksZero_TheFetchWaitsForTheRecord;
var
  TopicId: TKafkaUuid;
  M: string;
  EndBefore: Int64;
  Rsp: TKafkaProduceResponse;
begin
  Open(Plain);
  TopicId := ReadTopic(FConnection).Topics[0].TopicId;
  EndBefore := PartitionEnd(FConnection);
  M := Marker;
  Rsp := FConnection.Produce(ProduceRequest(TopicId, MarkedBatch(M, kcNone), 0));
  TAssert.AssertEquals('no answer with acks=0', 0, Length(Rsp.Responses));
  TAssert.AssertEquals('nothing left waiting', 0, FConnection.InFlightCount);
  // The broker holds each fetch until there is data (up to 10 s). Another
  // producer may have written first, hence the search by marker.
  CheckMarkedBatch(M, FindMarkedBatch(FConnection, TopicId, EndBefore, M));
end;

function TKafkaIntegrationTests.NewCluster(const ABootstrap: string; ATls: Boolean): TKafkaCluster;
var
  P: TKafkaClusterParams;
begin
  P := KafkaClusterParams(ABootstrap);
  if ATls then
    P.Connection := Tls(tbDefault, 'ca_cert.pem')
  else
    P.Connection := Plain;
  P.MaxBlockMs := 30000;
  FreeAndNil(FCluster);
  FCluster := TKafkaCluster.Create(P);
  FCluster.Open;
  Result := FCluster;
end;

procedure TKafkaIntegrationTests.Cluster_BootstrapsPastABadAddress_LeadersOnOneConnection;
var
  M: IKafkaClusterMetadata;
  L: array[0..2] of IKafkaBrokerConnection;
  I: Integer;
begin
  // The TLS port, spoken to in plaintext, isn't Kafka to this client.
  NewCluster(Format('%s:%d,%s:%d', [TestHost, TestTlsPort, TestHost, TestPort]), False);
  M := FCluster.Metadata;
  TAssert.AssertEquals(1, Length(M.Brokers));
  TAssert.AssertTrue('a cluster id', M.ClusterId <> '');
  TAssert.AssertEquals(3, Length(FCluster.Topic(TOPIC).Partitions));
  for I := 0 to 2 do
  begin
    L[I] := FCluster.Leader(TOPIC, I);
    TAssert.AssertEquals(M.Brokers[0].NodeId, L[I].NodeId);
  end;
  TAssert.AssertTrue('one connection per broker', (L[0] = L[1]) and (L[1] = L[2]));
  // The address the broker advertises for this listener.
  TAssert.AssertEquals('localhost:' + IntToStr(TestPort), L[0].Connection.Address);
  TAssert.AssertFalse(L[0].Connection.Params.UseTls);
end;

procedure TKafkaIntegrationTests.Cluster_Tls_LeaderConnectionsUseTls;
var
  L: IKafkaBrokerConnection;
begin
  NewCluster(Format('%s:%d', [TestHost, TestTlsPort]), True);
  L := FCluster.Leader(TOPIC, 1);
  TAssert.AssertTrue(L.Connection.Params.UseTls);
  // The TLS listener advertises itself: 9093, not the plaintext 9092.
  TAssert.AssertEquals('localhost:' + IntToStr(TestTlsPort), L.Connection.Address);
  TAssert.AssertEquals(13, Integer(L.Connection.NegotiatedVersion(KAFKA_API_KEY_PRODUCE)));
end;

procedure TKafkaIntegrationTests.Cluster_WaitsForAnAutoCreatedTopic;
var
  Name: string;
  T: TKafkaTopicInfo;
begin
  NewCluster(Format('%s:%d', [TestHost, TestPort]), False);
  Name := Format('pascal-kafka-faa-it-new-%d', [Random(1000000000)]);
  // Unknown at first; the broker creates it on this Metadata request.
  T := FCluster.Topic(Name);
  TAssert.AssertTrue(T.IsReady);
  TAssert.AssertEquals('KAFKA_NUM_PARTITIONS', 3, Length(T.Partitions));
  TAssert.AssertFalse(T.TopicId.IsZero);
  TAssert.AssertTrue(FCluster.Leader(Name, 2).Connection.IsOpen);
end;

procedure TKafkaIntegrationTests.Cluster_KeyedRecord_GoesToItsPartitionsLeader;
var
  T: TKafkaTopicInfo;
  M, Key: string;
  Partition: Integer;
  L: IKafkaBrokerConnection;
  Batch: TKafkaRecordBatch;
  Rsp: TKafkaProduceResponse;
  P: TKafkaProduceResponsePartitionProduceResponse;
  Fetched: TKafkaFetchResponse;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
  Value: string;
begin
  NewCluster(Format('%s:%d', [TestHost, TestPort]), False);
  T := FCluster.Topic(TOPIC);
  M := Marker;
  Key := 'order-' + M;
  Partition := KafkaPartitionForKey(PcStringToUtf8Bytes(Key), Length(T.Partitions));
  L := FCluster.Leader(TOPIC, Partition);
  Batch.Init;
  Batch.Append(KafkaRecord(PcStringToUtf8Bytes(Key), PcStringToUtf8Bytes(M), NowUnixMs));
  Rsp := L.Connection.Produce(ProduceRequest(T.TopicId, Batch, -1, Partition));
  P := Rsp.Responses[0].PartitionResponses[0];
  TAssert.AssertEquals('Produce error', 0, Integer(P.ErrorCode));
  TAssert.AssertEquals(Partition, P.Index);
  Fetched := L.Connection.Fetch(FetchRequest(T.TopicId, P.BaseOffset, 0, Partition));
  TAssert.AssertEquals(0, Integer(Fetched.Responses[0].Partitions[0].ErrorCode));
  Batches := KafkaDecodeRecordBatches(Fetched.Responses[0].Partitions[0].Records, 1 shl 24,
    Trailing);
  TAssert.AssertTrue(Length(Batches) > 0);
  TAssert.AssertEquals(P.BaseOffset, Batches[0].BaseOffset);
  TAssert.AssertTrue(PcTryUtf8BytesToString(Batches[0].Records[0].Key, Value));
  TAssert.AssertEquals(Key, Value);
end;

initialization
  Randomize;
  TDUnitX.RegisterTestFixture(TKafkaIntegrationTests);

end.
