unit Kafka.SaslIntegrationTests;

{ Integration tests of SASL against the real broker of
  docker/docker-compose.yml: SASL_PLAINTEXT on 9096, SASL_SSL on 9097 (the
  TLS of pascal-common-faa's test PKI), and 9098, SASL_PLAINTEXT whose
  sessions last 2 s (connections.max.reauth.ms, KIP-368), and 9099,
  SASL_PLAINTEXT with OAUTHBEARER alone and Kafka's unsecured JWS validator
  (scope kafka required, 10 s of clock skew allowed). Users: PLAIN
  alice / alice-secret (JAAS), SCRAM-SHA-256 bob / bob-secret and
  SCRAM-SHA-512 carol / carol-secret (created when the storage was
  formatted, 8192 iterations).

  - The producer and the consumer through each listener and mechanism
    (SASL_PLAINTEXT and SASL_SSL, PLAIN, SCRAM-SHA-256 and SCRAM-SHA-512):
    keyed records produced and polled back where the producer's reports
    said.
  - What the broker answers, as Kafka.Connection reads it: a wrong password
    is EKafkaAuthentication with SASL_AUTHENTICATION_FAILED and the broker's
    message (PLAIN and both SCRAMs); bob, whose credential is SCRAM-SHA-256
    only, is refused under SCRAM-SHA-512; a SASL client on the PLAINTEXT
    listener gets
    ILLEGAL_SASL_STATE; a client without SASL on a SASL listener is hung up
    on at its first request after ApiVersions.
  - KIP-368: the broker gives a 2 s session; the connection is due for
    re-authentication between 1.7 and 1.9 s; the cluster then hands out a
    new connection, and the broker closes the old one at its next request
    once the session is over. A producer and a consumer keep working across
    several sessions.
  - OAUTHBEARER, with unsecured JWS tokens written by the test's provider
    (Kafka.TestHelpers) and an extension: produce and consume; a token that
    expired is EKafkaAuthentication with SASL_AUTHENTICATION_FAILED and the
    broker's JSON (status invalid_token, as BrokerMessage), one without
    the scope the listener requires gets insufficient_scope and the scope;
    a token that lasts 4 s gives a session as long (KIP-368: the broker
    takes the credential's lifetime), the cluster replaces the connection
    near its end with one that asked the provider for a new token, and the
    broker closes the old one once the token has expired.

  Waiting for time to pass. A session's end is the point of the KIP-368
  tests, so they wait for it: in a consumer's Poll on the PLAINTEXT
  listener, which the broker answers when records come or its MaxWaitMs runs
  out, looped to a deadline. With the wait for a topic's leader
  (Kafka.IntegrationTests), the only places the suites wait on time.

  Ports: KAFKA_TEST_SASL_PORT (9096), KAFKA_TEST_SASL_TLS_PORT (9097),
  KAFKA_TEST_REAUTH_PORT (9098), KAFKA_TEST_OAUTH_PORT (9099), KAFKA_TEST_PORT
  (9092), host
  KAFKA_TEST_HOST (localhost).

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Protocol.Primitives,
  Kafka.Sasl,
  Kafka.Messages.Metadata,
  Kafka.Connection,
  Kafka.Cluster,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestHelpers;

type
  TKafkaSaslListener = (kslSasl, kslSaslTls, kslReauth, kslOAuth, kslPlaintext);

  [TestFixture]
  TKafkaSaslIntegrationTests = class
  private
    FConnection: TKafkaConnection;
    FCluster: TKafkaCluster;
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FWaiter: TKafkaConsumer;
    FTokenCount: Integer;
    FTokenLifetimeMs: Int64;
    FTokenScope: string;
    FBrokerMessage: string;
    /// The provider: an unsecured JWS for alice, issued now, lasting
    /// FTokenLifetimeMs (negative: expired that long ago), with FTokenScope.
    function NextToken: string;
    function Params(AListener: TKafkaSaslListener;
      AMechanism: TKafkaSaslMechanism): TKafkaConnectionParams;
    function Bootstrap(AListener: TKafkaSaslListener): string;
    function NewProducer(AListener: TKafkaSaslListener;
      AMechanism: TKafkaSaslMechanism): TKafkaProducer;
    function NewConsumer(AListener: TKafkaSaslListener;
      AMechanism: TKafkaSaslMechanism): TKafkaConsumer;
    procedure ProduceAndConsume(AListener: TKafkaSaslListener; AMechanism: TKafkaSaslMechanism);
    function OpenFails(const AParams: TKafkaConnectionParams; out ACode: Int16): string;
    procedure CallMetadata;
    /// Polls FConsumer until a record whose value is AValue comes; False
    /// after ATimeoutMs.
    function PollFor(const AValue: string; ATimeoutMs: Cardinal): Boolean;
    /// Lets time pass until PcTickMs reaches ATick (the unit's header).
    procedure WaitUntil(ATick: UInt64);
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure SaslPlaintext_Plain_ProducesAndConsumes;
    [Test] procedure SaslPlaintext_Scram_ProducesAndConsumes;
    [Test] procedure SaslSsl_Plain_ProducesAndConsumes;
    [Test] procedure SaslSsl_Scram_ProducesAndConsumes;
    [Test] procedure SaslPlaintext_Scram512_ProducesAndConsumes;
    [Test] procedure SaslSsl_Scram512_ProducesAndConsumes;
    [Test] procedure Plain_WrongPassword_IsAuthenticationFailed;
    [Test] procedure Scram_WrongPassword_IsAuthenticationFailed;
    [Test] procedure Scram512_WrongPasswordOrA256OnlyUser_IsAuthenticationFailed;
    [Test] procedure SaslClientOnThePlaintextListener_IsIllegalSaslState;
    [Test] procedure ClientWithoutSaslOnASaslListener_IsHungUpOn;
    [Test] procedure Reauth_ClusterReplacesTheConnection_BrokerClosesTheOld;
    [Test] procedure Reauth_ProducerAndConsumerKeepWorkingAcrossSessions;
    [Test] procedure OAuth_ProducesAndConsumes;
    [Test] procedure OAuth_ExpiredToken_IsInvalidTokenWithTheJson;
    [Test] procedure OAuth_WithoutTheScope_IsInsufficientScopeWithTheJson;
    [Test] procedure OAuth_SessionEndsWithTheToken_TheNewConnectionTakesANewOne;
  end;

implementation

const
  TOPIC = 'pascal-kafka-faa-it';
  SESSION_MS = 2000; // connections.max.reauth.ms of the REAUTH listener

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function ListenerPort(AListener: TKafkaSaslListener): Word;
begin
  case AListener of
    kslSasl: Result := StrToInt(EnvOr('KAFKA_TEST_SASL_PORT', '9096'));
    kslSaslTls: Result := StrToInt(EnvOr('KAFKA_TEST_SASL_TLS_PORT', '9097'));
    kslReauth: Result := StrToInt(EnvOr('KAFKA_TEST_REAUTH_PORT', '9098'));
    kslOAuth: Result := StrToInt(EnvOr('KAFKA_TEST_OAUTH_PORT', '9099'));
  else
    Result := StrToInt(EnvOr('KAFKA_TEST_PORT', '9092'));
  end;
end;

/// A Metadata request for no topic (the brokers only).
function NoTopics: TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 0);
end;

function Marker: string;
begin
  Result := 'sasl-it-' + KafkaTestUniqueId;
end;

{ TKafkaSaslIntegrationTests }

procedure TKafkaSaslIntegrationTests.Setup;
begin
  FTokenCount := 0;
  FTokenLifetimeMs := 3600000;
  FTokenScope := 'kafka';
  FBrokerMessage := '';
end;

function TKafkaSaslIntegrationTests.NextToken: string;
var
  LNow: Int64;
begin
  PcAtomicInc(FTokenCount);
  LNow := KafkaTestUnixMs;
  if FTokenLifetimeMs > 0 then
    Result := KafkaTestUnsecuredJws('alice', FTokenScope, LNow, LNow + FTokenLifetimeMs)
  else
    // Issued before it expired, both in the past.
    Result := KafkaTestUnsecuredJws('alice', FTokenScope, LNow + 2 * FTokenLifetimeMs,
      LNow + FTokenLifetimeMs);
end;

procedure TKafkaSaslIntegrationTests.TearDown;
begin
  FreeAndNil(FWaiter);
  FreeAndNil(FConsumer);
  FreeAndNil(FProducer);
  FreeAndNil(FCluster);
  FreeAndNil(FConnection);
end;

function TKafkaSaslIntegrationTests.Params(AListener: TKafkaSaslListener;
  AMechanism: TKafkaSaslMechanism): TKafkaConnectionParams;
begin
  Result := KafkaConnectionParams(EnvOr('KAFKA_TEST_HOST', 'localhost'), ListenerPort(AListener));
  Result.ClientId := 'pascal-kafka-faa-sasl-it';
  Result.ConnectTimeoutMs := 5000;
  Result.RequestTimeoutMs := 10000;
  if AListener = kslSaslTls then
  begin
    Result.UseTls := True;
    Result.TlsCaFile := KafkaTestPkiDir + 'ca_cert.pem';
    Result.TlsHandshakeTimeoutMs := 5000;
  end;
  Result.SaslMechanism := AMechanism;
  if AMechanism = ksmPlain then
  begin
    Result.SaslUsername := 'alice';
    Result.SaslPassword := 'alice-secret';
  end
  else if AMechanism = ksmScramSha256 then
  begin
    Result.SaslUsername := 'bob';
    Result.SaslPassword := 'bob-secret';
  end
  else if AMechanism = ksmScramSha512 then
  begin
    Result.SaslUsername := 'carol';
    Result.SaslPassword := 'carol-secret';
  end
  else if AMechanism = ksmOAuthBearer then
  begin
    Result.SaslOAuthBearerTokenProvider := NextToken;
    // Kafka's unsecured validator takes any extension.
    SetLength(Result.SaslOAuthBearerExtensions, 1);
    Result.SaslOAuthBearerExtensions[0] := KafkaSaslExtension('traceId', 'it-' +
      KafkaTestUniqueId);
  end;
end;

function TKafkaSaslIntegrationTests.Bootstrap(AListener: TKafkaSaslListener): string;
begin
  Result := Format('%s:%d', [EnvOr('KAFKA_TEST_HOST', 'localhost'), ListenerPort(AListener)]);
end;

function TKafkaSaslIntegrationTests.NewProducer(AListener: TKafkaSaslListener;
  AMechanism: TKafkaSaslMechanism): TKafkaProducer;
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams(Bootstrap(AListener));
  P.Cluster.Connection := Params(AListener, AMechanism);
  P.Cluster.MaxBlockMs := 30000;
  P.Acks := kaAll;
  FreeAndNil(FProducer);
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
  Result := FProducer;
end;

function TKafkaSaslIntegrationTests.NewConsumer(AListener: TKafkaSaslListener;
  AMechanism: TKafkaSaslMechanism): TKafkaConsumer;
var
  P: TKafkaConsumerParams;
  All: array[0..2] of TKafkaTopicPartition;
  Ends: TKafkaInt64Array;
  I: Integer;
begin
  P := KafkaConsumerParams(Bootstrap(AListener));
  P.Cluster.Connection := Params(AListener, AMechanism);
  P.Cluster.MaxBlockMs := 30000;
  P.FetchMaxWaitMs := 200;
  Result := TKafkaConsumer.Create(P);
  try
    Result.Open;
    for I := 0 to 2 do
      All[I] := KafkaTopicPartition(TOPIC, I);
    Result.Assign(All);
    // From the end: only what this test produces.
    Ends := Result.EndOffsets(All);
    for I := 0 to 2 do
      Result.Seek(TOPIC, I, Ends[I]);
  except
    Result.Free;
    raise;
  end;
end;

function TKafkaSaslIntegrationTests.PollFor(const AValue: string; ATimeoutMs: Cardinal): Boolean;
var
  Got: TKafkaConsumerRecordArray;
  Deadline: UInt64;
  Text: string;
  I: Integer;
begin
  Deadline := PcTickMs + ATimeoutMs;
  repeat
    Got := FConsumer.Poll(500);
    for I := 0 to High(Got) do
      if PcTryUtf8BytesToString(Got[I].Value, Text) and (Text = AValue) then
        Exit(True);
  until PcTickMs >= Deadline;
  Result := False;
end;

procedure TKafkaSaslIntegrationTests.WaitUntil(ATick: UInt64);
var
  LNow: UInt64;
  LWait: Cardinal;
begin
  if FWaiter = nil then
    FWaiter := NewConsumer(kslPlaintext, ksmNone);
  LNow := PcTickMs;
  while LNow < ATick do
  begin
    LWait := 250;
    if ATick - LNow < LWait then
      LWait := Cardinal(ATick - LNow);
    FWaiter.Poll(LWait); // whatever other runners wrote is ignored
    LNow := PcTickMs;
  end;
end;

procedure TKafkaSaslIntegrationTests.ProduceAndConsume(AListener: TKafkaSaslListener;
  AMechanism: TKafkaSaslMechanism);
const
  N = 20;
var
  M, Text: string;
  F: array[0..N - 1] of IKafkaDeliveryFuture;
  Rep: array[0..N - 1] of TKafkaDeliveryReport;
  Seen: array[0..N - 1] of Boolean;
  Got: TKafkaConsumerRecordArray;
  I, K, Count: Integer;
  Deadline: UInt64;
begin
  FConsumer := NewConsumer(AListener, AMechanism);
  NewProducer(AListener, AMechanism);
  M := Marker;
  for I := 0 to N - 1 do
  begin
    F[I] := FProducer.Send(KafkaProducerRecord(TOPIC,
      PcStringToUtf8Bytes(M + '-key-' + IntToStr(I mod 4)),
      PcStringToUtf8Bytes(M + ' ' + IntToStr(I))));
    Seen[I] := False;
  end;
  TAssert.AssertTrue('flushed', FProducer.Flush(60000));
  for I := 0 to N - 1 do
    Rep[I] := F[I].Get(0);
  TAssert.AssertTrue('the leader''s connection authenticated too',
    FProducer.Cluster.Leader(TOPIC, Rep[0].Partition).Connection.Params.SaslMechanism = AMechanism);
  Count := 0;
  Deadline := PcTickMs + 30000;
  while (Count < N) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(1000);
    for K := 0 to High(Got) do
      if PcTryUtf8BytesToString(Got[K].Value, Text) and (Pos(M + ' ', Text) = 1) then
      begin
        I := StrToInt(Copy(Text, Length(M) + 2, MaxInt));
        TAssert.AssertFalse('once', Seen[I]);
        Seen[I] := True;
        Inc(Count);
        TAssert.AssertEquals('where the report said', Rep[I].Partition, Got[K].Partition);
        TAssert.AssertEquals(Rep[I].Offset, Got[K].Offset);
        TAssert.AssertTrue(PcTryUtf8BytesToString(Got[K].Key, Text));
        TAssert.AssertEquals(M + '-key-' + IntToStr(I mod 4), Text);
      end;
  end;
  TAssert.AssertEquals('all polled', N, Count);
end;

procedure TKafkaSaslIntegrationTests.SaslPlaintext_Plain_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSasl, ksmPlain);
end;

procedure TKafkaSaslIntegrationTests.SaslPlaintext_Scram_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSasl, ksmScramSha256);
end;

procedure TKafkaSaslIntegrationTests.SaslSsl_Plain_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSaslTls, ksmPlain);
end;

procedure TKafkaSaslIntegrationTests.SaslSsl_Scram_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSaslTls, ksmScramSha256);
end;

procedure TKafkaSaslIntegrationTests.SaslPlaintext_Scram512_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSasl, ksmScramSha512);
end;

procedure TKafkaSaslIntegrationTests.SaslSsl_Scram512_ProducesAndConsumes;
begin
  ProduceAndConsume(kslSaslTls, ksmScramSha512);
end;

function TKafkaSaslIntegrationTests.OpenFails(const AParams: TKafkaConnectionParams;
  out ACode: Int16): string;
begin
  Result := '';
  ACode := -1;
  FreeAndNil(FConnection);
  FConnection := TKafkaConnection.Create(AParams);
  try
    FConnection.Open;
    TAssert.Fail('Open authenticated');
  except
    on E: EKafkaAuthentication do
    begin
      Result := E.Message;
      ACode := E.ErrorCode;
      FBrokerMessage := E.BrokerMessage;
    end;
  end;
  TAssert.AssertFalse('closed', FConnection.IsOpen);
end;

procedure TKafkaSaslIntegrationTests.CallMetadata;
var
  R: TKafkaMetadataRequest;
begin
  R.Init;
  FConnection.Metadata(R);
end;

procedure TKafkaSaslIntegrationTests.Plain_WrongPassword_IsAuthenticationFailed;
var
  P: TKafkaConnectionParams;
  LCode: Int16;
  LMessage: string;
begin
  P := Params(kslSasl, ksmPlain);
  P.SaslPassword := 'not-alice-secret';
  LMessage := OpenFails(P, LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  // The broker's own message comes along.
  TAssert.AssertTrue(LMessage, Pos('Invalid username or password', LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('not-alice-secret', LMessage) = 0);
end;

procedure TKafkaSaslIntegrationTests.Scram_WrongPassword_IsAuthenticationFailed;
var
  P: TKafkaConnectionParams;
  LCode: Int16;
  LMessage: string;
begin
  P := Params(kslSaslTls, ksmScramSha256);
  P.SaslPassword := 'bob-secreT';
  LMessage := OpenFails(P, LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('SCRAM-SHA-256', LMessage) > 0);
end;

procedure TKafkaSaslIntegrationTests.Scram512_WrongPasswordOrA256OnlyUser_IsAuthenticationFailed;
var
  P: TKafkaConnectionParams;
  LCode: Int16;
  LMessage: string;
begin
  P := Params(kslSaslTls, ksmScramSha512);
  P.SaslPassword := 'carol-secreT';
  LMessage := OpenFails(P, LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('SCRAM-SHA-512', LMessage) > 0);
  // bob has a SCRAM-SHA-256 credential and none for SHA-512.
  P := Params(kslSasl, ksmScramSha512);
  P.SaslUsername := 'bob';
  P.SaslPassword := 'bob-secret';
  LMessage := OpenFails(P, LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
end;

procedure TKafkaSaslIntegrationTests.SaslClientOnThePlaintextListener_IsIllegalSaslState;
var
  LCode: Int16;
  LMessage: string;
begin
  LMessage := OpenFails(Params(kslPlaintext, ksmScramSha256), LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_ILLEGAL_SASL_STATE), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('SASL listener', LMessage) > 0);
end;

procedure TKafkaSaslIntegrationTests.ClientWithoutSaslOnASaslListener_IsHungUpOn;
begin
  FConnection := TKafkaConnection.Create(Params(kslSasl, ksmNone));
  FConnection.Open; // ApiVersions is allowed before authentication
  TAssert.AssertException(EKafkaConnection, CallMetadata);
  TAssert.AssertFalse(FConnection.IsOpen);
end;

procedure TKafkaSaslIntegrationTests.Reauth_ClusterReplacesTheConnection_BrokerClosesTheOld;
var
  P: TKafkaClusterParams;
  L1, L2: IKafkaBrokerConnection;
  T0, T1: UInt64;
  Elapsed: UInt64;
begin
  P := KafkaClusterParams(Bootstrap(kslReauth));
  P.Connection := Params(kslReauth, ksmScramSha256);
  P.MaxBlockMs := 30000;
  FCluster := TKafkaCluster.Create(P);
  FCluster.Open;
  FCluster.Topic(TOPIC);
  T0 := PcTickMs;
  L1 := FCluster.Leader(TOPIC, 0);
  T1 := PcTickMs;
  TAssert.AssertEquals('the listener''s session', Int64(SESSION_MS), L1.Connection.SessionLifetimeMs);
  TAssert.AssertFalse(L1.Connection.ReauthenticationDue);
  TAssert.AssertTrue('same connection while the session is young', L1 = FCluster.Leader(TOPIC, 0));
  // Due at 85% to 95% of the session.
  WaitUntil(T0 + SESSION_MS * 85 div 100 - 150);
  TAssert.AssertFalse('not before 85%', L1.Connection.ReauthenticationDue);
  WaitUntil(T1 + SESSION_MS * 95 div 100 + 50);
  TAssert.AssertTrue('due by 95%', L1.Connection.ReauthenticationDue);
  L2 := FCluster.Leader(TOPIC, 0);
  TAssert.AssertTrue('a new connection', L2.Connection <> L1.Connection);
  TAssert.AssertFalse(L2.Connection.ReauthenticationDue);
  L2.Connection.Metadata(NoTopics);
  // The old session is over: the broker closes the connection at its next
  // request, which is why the cluster stops handing it out.
  WaitUntil(T1 + SESSION_MS + 300);
  Elapsed := PcTickMs - T1;
  try
    L1.Connection.Metadata(NoTopics);
    TAssert.Fail(Format('the broker answered on an expired session (%d ms)', [Elapsed]));
  except
    on E: EKafkaConnection do ;
  end;
  TAssert.AssertFalse(L1.Connection.IsOpen);
  TAssert.AssertTrue('the new one still works', L2.Connection.IsOpen);
end;

procedure TKafkaSaslIntegrationTests.Reauth_ProducerAndConsumerKeepWorkingAcrossSessions;
const
  ROUNDS = 3;
var
  M: string;
  Round: Integer;
  First: IKafkaBrokerConnection;
  Start: UInt64;
  R: TKafkaDeliveryReport;
begin
  FConsumer := NewConsumer(kslReauth, ksmScramSha256);
  NewProducer(kslReauth, ksmPlain);
  First := FProducer.Cluster.Leader(TOPIC, 0);
  M := Marker;
  for Round := 1 to ROUNDS do
  begin
    Start := PcTickMs;
    R := FProducer.Send(KafkaProducerRecord(TOPIC, PcStringToUtf8Bytes(M + '-' + IntToStr(Round)))).Get(30000);
    TAssert.AssertTrue('delivered', R.Offset >= 0);
    TAssert.AssertTrue('polled in round ' + IntToStr(Round), PollFor(M + '-' + IntToStr(Round), 15000));
    // Past a whole session before the next round.
    WaitUntil(Start + SESSION_MS + 300);
  end;
  TAssert.AssertTrue('the producer''s connection was replaced',
    FProducer.Cluster.Leader(TOPIC, 0).Connection <> First.Connection);
end;

procedure TKafkaSaslIntegrationTests.OAuth_ProducesAndConsumes;
begin
  ProduceAndConsume(kslOAuth, ksmOAuthBearer);
  TAssert.AssertTrue('a token per connection', PcAtomicGet(FTokenCount) >= 2);
end;

procedure TKafkaSaslIntegrationTests.OAuth_ExpiredToken_IsInvalidTokenWithTheJson;
var
  LCode: Int16;
  LMessage: string;
begin
  // Past the listener's 10 s of allowed clock skew.
  FTokenLifetimeMs := -60000;
  LMessage := OpenFails(Params(kslOAuth, ksmOAuthBearer), LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertEquals('{"status":"invalid_token"}', FBrokerMessage);
  TAssert.AssertTrue(LMessage, Pos('{"status":"invalid_token"}', LMessage) > 0);
  TAssert.AssertTrue('no token in: ' + LMessage, Pos('eyJ', LMessage) = 0);
end;

procedure TKafkaSaslIntegrationTests.OAuth_WithoutTheScope_IsInsufficientScopeWithTheJson;
var
  LCode: Int16;
begin
  FTokenScope := 'other';
  OpenFails(Params(kslOAuth, ksmOAuthBearer), LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertEquals('{"status":"insufficient_scope", "scope":"[kafka]"}', FBrokerMessage);
end;

procedure TKafkaSaslIntegrationTests.OAuth_SessionEndsWithTheToken_TheNewConnectionTakesANewOne;
const
  TOKEN_MS = 4000;
var
  P: TKafkaClusterParams;
  L1, L2: IKafkaBrokerConnection;
  T1: UInt64;
  Lifetime: Int64;
  Before: Integer;
begin
  FTokenLifetimeMs := TOKEN_MS;
  P := KafkaClusterParams(Bootstrap(kslOAuth));
  P.Connection := Params(kslOAuth, ksmOAuthBearer);
  P.MaxBlockMs := 30000;
  FCluster := TKafkaCluster.Create(P);
  FCluster.Open;
  FCluster.Topic(TOPIC);
  L1 := FCluster.Leader(TOPIC, 0);
  T1 := PcTickMs;
  // The token's exp less the broker's clock: about TOKEN_MS, give or take
  // the difference between the host's and the container's clocks.
  Lifetime := L1.Connection.SessionLifetimeMs;
  TAssert.AssertTrue('a session as long as the token: ' + IntToStr(Lifetime),
    (Lifetime > 0) and (Lifetime <= TOKEN_MS + 2000));
  TAssert.AssertTrue('same connection while the session is young', L1 = FCluster.Leader(TOPIC, 0));
  Before := PcAtomicGet(FTokenCount);
  WaitUntil(T1 + UInt64(Lifetime) * 95 div 100 + 50);
  TAssert.AssertTrue('due by 95%', L1.Connection.ReauthenticationDue);
  L2 := FCluster.Leader(TOPIC, 0);
  TAssert.AssertTrue('a new connection', L2.Connection <> L1.Connection);
  TAssert.AssertTrue('a new token for it', PcAtomicGet(FTokenCount) > Before);
  L2.Connection.Metadata(NoTopics);
  // The old token has expired: the broker closes its connection at the
  // next request.
  WaitUntil(T1 + UInt64(Lifetime) + 300);
  try
    L1.Connection.Metadata(NoTopics);
    TAssert.Fail('the broker answered past the token''s expiry');
  except
    on E: EKafkaConnection do ;
  end;
  TAssert.AssertTrue('the new one still works', L2.Connection.IsOpen);
  L2.Connection.Metadata(NoTopics);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaSaslIntegrationTests);

end.
