unit Kafka.CloudIntegrationTests;

{ The opt-in test against Confluent Cloud, the first managed broker
  (docs/design.md, open question 1): SASL PLAIN over TLS, the server's
  certificate checked against the system's trust store, a cluster of several
  brokers this project didn't set up.

  It runs only when the credentials are in the environment, never from the
  repository:

    KAFKA_CLOUD_BOOTSTRAP   pkc-xxxxx.region.provider.confluent.cloud:9092
    KAFKA_CLOUD_API_KEY     the API key (SASL user name)
    KAFKA_CLOUD_API_SECRET  the API secret (SASL password)
    KAFKA_CLOUD_TOPIC       an existing topic (Confluent Cloud doesn't create
                            topics on a Metadata request); default
                            pascal-kafka-faa-it
    KAFKA_CLOUD_CA_FILE     optional: a CA file instead of the system's store,
                            to try the test against docker/'s SASL_SSL
                            listener (localhost:9097, alice / alice-secret,
                            external/pascal-common-faa/tests/pki/ca_cert.pem)

  Without them the test prints a notice and passes, as the OpenSSL test does
  where OpenSSL can't be loaded: CI has no credentials. Over 2 minutes of
  wait at most (MaxBlockMs, the polls).

  What it does: the cluster's metadata (brokers, the topic's partitions and
  leaders), then the producer and the consumer as in the local SASL tests:
  keyed records with a header, gzip, produced and polled back where the
  producer's reports said, through every partition's leader.

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Protocol.Primitives,
  Kafka.Compression,
  Kafka.Sasl,
  Kafka.Connection,
  Kafka.Cluster,
  Kafka.Producer,
  Kafka.Consumer;

type
  [TestFixture]
  TKafkaCloudIntegrationTests = class
  private
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    function Connection: TKafkaConnectionParams;
  public
    [TearDown] procedure TearDown;
    [Test] procedure ConfluentCloud_SaslPlainOverTls_ProducesAndConsumes;
  end;

implementation

function CloudConfigured: Boolean;
begin
  Result := (GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP') <> '') and
    (GetEnvironmentVariable('KAFKA_CLOUD_API_KEY') <> '') and
    (GetEnvironmentVariable('KAFKA_CLOUD_API_SECRET') <> '');
end;

function CloudTopic: string;
begin
  Result := GetEnvironmentVariable('KAFKA_CLOUD_TOPIC');
  if Result = '' then
    Result := 'pascal-kafka-faa-it';
end;

procedure TKafkaCloudIntegrationTests.TearDown;
begin
  FreeAndNil(FConsumer);
  FreeAndNil(FProducer);
end;

function TKafkaCloudIntegrationTests.Connection: TKafkaConnectionParams;
begin
  // Host and port come from each broker's metadata; the template has the rest.
  Result := KafkaConnectionParams('', 9092);
  Result.ClientId := 'pascal-kafka-faa-cloud-it';
  Result.ConnectTimeoutMs := 15000;
  Result.RequestTimeoutMs := 30000;
  Result.UseTls := True;
  // Empty: the system's trust store, as for any public broker.
  Result.TlsCaFile := GetEnvironmentVariable('KAFKA_CLOUD_CA_FILE');
  Result.SaslMechanism := ksmPlain;
  Result.SaslUsername := GetEnvironmentVariable('KAFKA_CLOUD_API_KEY');
  Result.SaslPassword := GetEnvironmentVariable('KAFKA_CLOUD_API_SECRET');
end;

procedure TKafkaCloudIntegrationTests.ConfluentCloud_SaslPlainOverTls_ProducesAndConsumes;
const
  N = 30;
var
  PP: TKafkaProducerParams;
  CP: TKafkaConsumerParams;
  T: TKafkaTopicInfo;
  All: array of TKafkaTopicPartition;
  Ends: TKafkaInt64Array;
  F: array[0..N - 1] of IKafkaDeliveryFuture;
  Rep: array[0..N - 1] of TKafkaDeliveryReport;
  Rec: TKafkaProducerRecord;
  Got: TKafkaConsumerRecordArray;
  Marker, Text: string;
  I, K, Count, Leaders: Integer;
  Deadline: UInt64;
begin
  if not CloudConfigured then
  begin
    System.WriteLn('  [notice] Confluent Cloud test skipped: set KAFKA_CLOUD_BOOTSTRAP, ' +
      'KAFKA_CLOUD_API_KEY and KAFKA_CLOUD_API_SECRET to run it');
    Exit;
  end;
  CP := KafkaConsumerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  CP.Cluster.Connection := Connection;
  CP.Cluster.MaxBlockMs := 60000;
  CP.FetchMaxWaitMs := 500;
  FConsumer := TKafkaConsumer.Create(CP);
  FConsumer.Open;
  T := FConsumer.Cluster.Topic(CloudTopic);
  TAssert.AssertTrue('partitions', Length(T.Partitions) > 0);
  System.WriteLn(Format('  [cloud] %d brokers, topic %s with %d partitions',
    [Length(FConsumer.Cluster.Metadata.Brokers), CloudTopic, Length(T.Partitions)]));
  SetLength(All, Length(T.Partitions));
  for I := 0 to High(All) do
    All[I] := KafkaTopicPartition(CloudTopic, I);
  FConsumer.Assign(All);
  Ends := FConsumer.EndOffsets(All);
  for I := 0 to High(All) do
    FConsumer.Seek(CloudTopic, I, Ends[I]);

  PP := KafkaProducerParams(GetEnvironmentVariable('KAFKA_CLOUD_BOOTSTRAP'));
  PP.Cluster.Connection := Connection;
  PP.Cluster.MaxBlockMs := 60000;
  PP.Compression := kcGzip;
  FProducer := TKafkaProducer.Create(PP);
  FProducer.Open;
  Marker := Format('cloud-it-%d-%d', [PcTickMs, Random(1000000000)]);
  for I := 0 to N - 1 do
  begin
    Rec := KafkaProducerRecord(CloudTopic, PcStringToUtf8Bytes(Marker + '-key-' + IntToStr(I mod 7)),
      PcStringToUtf8Bytes(Marker + ' ' + IntToStr(I)));
    SetLength(Rec.Headers, 1);
    Rec.Headers[0].Key := 'n';
    Rec.Headers[0].Value := PcStringToUtf8Bytes(IntToStr(I));
    F[I] := FProducer.Send(Rec);
  end;
  TAssert.AssertTrue('flushed', FProducer.Flush(60000));
  for I := 0 to N - 1 do
    Rep[I] := F[I].Get(0);
  Leaders := 0;
  for I := 0 to High(T.Partitions) do
    if FProducer.Cluster.Leader(CloudTopic, I).Connection.Params.SaslMechanism = ksmPlain then
      Inc(Leaders);
  TAssert.AssertEquals('every leader over SASL', Length(T.Partitions), Leaders);

  Count := 0;
  Deadline := PcTickMs + 60000;
  while (Count < N) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(1000);
    for K := 0 to High(Got) do
      if PcTryUtf8BytesToString(Got[K].Value, Text) and (Pos(Marker + ' ', Text) = 1) then
      begin
        I := StrToInt(Copy(Text, Length(Marker) + 2, MaxInt));
        TAssert.AssertEquals('where the report said', Rep[I].Partition, Got[K].Partition);
        TAssert.AssertEquals(Rep[I].Offset, Got[K].Offset);
        TAssert.AssertTrue(PcTryUtf8BytesToString(Got[K].Key, Text));
        TAssert.AssertEquals(Marker + '-key-' + IntToStr(I mod 7), Text);
        Inc(Count);
      end;
  end;
  TAssert.AssertEquals('all polled', N, Count);
  System.WriteLn(Format('  [cloud] %d records produced and polled back', [N]));
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaCloudIntegrationTests);

end.
