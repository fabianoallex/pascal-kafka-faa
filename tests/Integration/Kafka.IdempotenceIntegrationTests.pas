unit Kafka.IdempotenceIntegrationTests;

{ The idempotent producer against a real Apache Kafka 4.4.0 broker (the one of
  docker/docker-compose.yml, plaintext 9092), through an in-process proxy
  (Kafka.TestProxy) that can lose the broker's answers. Phase K3's
  criterion for idempotence:

  - A Produce answer lost after the broker wrote the batch: the producer sends
    the batch again after its request timeout, the broker recognises the
    sequence and answers with the first write's offset, and a consumer
    reading the partition finds the record once.
  - Many batches of one partition in flight at once (the proxy counts them),
    every record read back once and in the order sent.

  Each test uses a topic of its own (KafkaTestUniqueId: the broker keeps
  topics between runs), created by the broker on first use; the producer
  waits for its leader (MaxBlockMs) and the first record is sent before any
  answer is lost. The records are read back with a consumer connected to the
  broker directly, polled up to a deadline.

  DUnitX master: the FPCUnit mirror in tests/Integration/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Threading,
  PascalCommon.Utf8,
  Kafka.Types,
  Kafka.Connection,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestProxy,
  Kafka.TestHelpers;

type
  TValueArray = array of string;

  [TestFixture]
  TKafkaIdempotenceIntegrationTests = class
  private
    FProxy: TKafkaTestProxy;
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FTopic: string;
    procedure OpenProducer(ARequestTimeoutMs: Cardinal; ABatchSize: Integer);
    function Send(const AValue: string): IKafkaDeliveryFuture;
    /// The values of partition 0 from its start, polled until ACount came or
    /// 30 s passed.
    function ReadBack(ACount: Integer): TValueArray;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure LostAnswer_SentAgain_ReadBackOnce;
    [Test] procedure ManyBatchesInFlight_ReadBackInOrder;
  end;

implementation

function EnvOr(const AName, ADefault: string): string;
begin
  Result := GetEnvironmentVariable(AName);
  if Result = '' then
    Result := ADefault;
end;

function TestHost: string;
begin
  Result := EnvOr('KAFKA_TEST_HOST', 'localhost');
end;

function TestPort: Word;
begin
  Result := StrToInt(EnvOr('KAFKA_TEST_PORT', '9092'));
end;

{ TKafkaIdempotenceIntegrationTests }

procedure TKafkaIdempotenceIntegrationTests.Setup;
begin
  FProxy := TKafkaTestProxy.Create(TestHost, TestPort);
  FProducer := nil;
  FConsumer := nil;
  FTopic := 'pascal-kafka-faa-idempotent-' + KafkaTestUniqueId;
end;

procedure TKafkaIdempotenceIntegrationTests.TearDown;
begin
  FreeAndNil(FConsumer);
  FreeAndNil(FProducer);
  FreeAndNil(FProxy);
end;

procedure TKafkaIdempotenceIntegrationTests.OpenProducer(ARequestTimeoutMs: Cardinal;
  ABatchSize: Integer);
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams('127.0.0.1:' + IntToStr(FProxy.Port));
  P.Cluster.Connection.ClientId := 'idempotence-it';
  P.Cluster.Connection.RequestTimeoutMs := ARequestTimeoutMs;
  P.Cluster.MaxBlockMs := 30000;
  P.LingerMs := 0;
  P.BatchSize := ABatchSize;
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
end;

function TKafkaIdempotenceIntegrationTests.Send(const AValue: string): IKafkaDeliveryFuture;
var
  R: TKafkaProducerRecord;
begin
  R := KafkaProducerRecord(FTopic, PcStringToUtf8Bytes(AValue));
  R.Partition := 0;
  Result := FProducer.Send(R);
end;

function TKafkaIdempotenceIntegrationTests.ReadBack(ACount: Integer): TValueArray;
var
  P: TKafkaConsumerParams;
  Got: TKafkaConsumerRecordArray;
  Deadline: UInt64;
  N, I: Integer;
  Text: string;
begin
  P := KafkaConsumerParams(Format('%s:%d', [TestHost, TestPort]));
  P.Cluster.MaxBlockMs := 30000;
  P.FetchMaxWaitMs := 200;
  P.AutoOffsetReset := korEarliest;
  FConsumer := TKafkaConsumer.Create(P);
  FConsumer.Open;
  FConsumer.Assign([KafkaTopicPartition(FTopic, 0)]);
  Result := nil;
  SetLength(Result, ACount + 16);
  N := 0;
  Deadline := PcTickMs + 30000;
  // Past ACount too, briefly: a record written twice would show up there.
  while (N < ACount) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(1000);
    for I := 0 to High(Got) do
    begin
      if N = Length(Result) then
        SetLength(Result, 2 * N);
      if not PcTryUtf8BytesToString(Got[I].Value, Text) then
        Text := '?';
      Result[N] := Text;
      Inc(N);
    end;
  end;
  Got := FConsumer.Poll(500);
  for I := 0 to High(Got) do
  begin
    if N = Length(Result) then
      SetLength(Result, 2 * N);
    Result[N] := 'extra';
    Inc(N);
  end;
  SetLength(Result, N);
end;

procedure TKafkaIdempotenceIntegrationTests.LostAnswer_SentAgain_ReadBackOnce;
var
  R: TKafkaDeliveryReport;
  Values: TValueArray;
  Before: Integer;
begin
  OpenProducer(2000, 16384);
  TAssert.AssertTrue('idempotent', FProducer.Idempotent);
  // The topic exists and has a leader once this is delivered.
  TAssert.AssertEquals(Int64(0), Send('first').Get(60000).Offset);
  Before := FProxy.ProduceCount;
  FProxy.LoseProduceAnswers(1);
  R := Send('once').Get(60000);
  TAssert.AssertEquals('an answer was lost', 1, FProxy.LostCount);
  TAssert.AssertTrue('and the batch sent again', FProxy.ProduceCount >= Before + 2);
  TAssert.AssertEquals('the first write''s offset', Int64(1), R.Offset);
  TAssert.AssertEquals(Int64(2), Send('after').Get(60000).Offset);
  TAssert.AssertEquals(0, FProducer.EpochBumps);
  Values := ReadBack(3);
  TAssert.AssertEquals('records in the partition', 3, Length(Values));
  TAssert.AssertEquals('first', Values[0]);
  TAssert.AssertEquals('once', Values[1]);
  TAssert.AssertEquals('after', Values[2]);
end;

procedure TKafkaIdempotenceIntegrationTests.ManyBatchesInFlight_ReadBackInOrder;
const
  N = 3000;
var
  I: Integer;
  F: IKafkaDeliveryFuture;
  Values: TValueArray;
begin
  // A batch per record: as many batches as records, so they queue up behind
  // the requests in flight.
  OpenProducer(30000, 1);
  Send('warm-up').Get(60000);
  F := nil;
  for I := 0 to N - 1 do
    F := Send(IntToStr(I));
  TAssert.AssertTrue(FProducer.Flush(120000));
  TAssert.AssertEquals('the last offset', Int64(N), F.Get(0).Offset);
  TAssert.AssertTrue(Format('several batches of the partition in flight (%d)',
    [FProxy.MaxProduceInFlight]), FProxy.MaxProduceInFlight > 1);
  TAssert.AssertTrue('at most five', FProxy.MaxProduceInFlight <= 5);
  Values := ReadBack(N + 1);
  TAssert.AssertEquals('each record once', N + 1, Length(Values));
  TAssert.AssertEquals('warm-up', Values[0]);
  for I := 0 to N - 1 do
    TAssert.AssertEquals('in order', IntToStr(I), Values[I + 1]);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaIdempotenceIntegrationTests);

end.
