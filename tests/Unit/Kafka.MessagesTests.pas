unit Kafka.MessagesTests;

{ Tests for the generated codecs (Kafka.Messages.*) against real bytes: the captures of
  Kafka.TestCaptures, recorded from an Apache Kafka 4.4.0 broker and from the
  Java client of the same version (docs/codec-captures.md).

  - Every capture, request and response, of every version and every API
    (ApiVersions, Metadata, Produce, Fetch, ListOffsets, SaslHandshake,
    SaslAuthenticate): the header and body decode, and encoding them again
    gives back the same bytes. (The SASL ones field by field:
    Kafka.SaslTests.)
  - The hand-built ApiVersions (v0-v5) and Metadata (v0-v13) requests
    (tools/capture_versions.py), which the broker accepted: the same logical request
    built with the generated records encodes to the same bytes.
  - What the broker said: the APIs and versions it supports, its features in
    the tagged fields, the topic's id, partitions and leader.
    (Produce, Fetch and ListOffsets, field by field: Kafka.ProduceFetchTests.)
  - The version rules: a null or a non-default value where a version can't
    carry it, an unsupported version, trailing bytes, unknown tagged fields
    kept through decode and encode.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Kafka.Types,
  Kafka.Protocol.Primitives,
  Kafka.Protocol.Envelope,
  Kafka.Messages.Apis,
  Kafka.Messages.ApiVersions,
  Kafka.Messages.Metadata,
  Kafka.Messages.Produce,
  Kafka.Messages.Fetch,
  Kafka.Messages.ListOffsets,
  Kafka.Messages.SaslHandshake,
  Kafka.Messages.SaslAuthenticate,
  Kafka.TestCaptures,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaMessagesTests = class
  private
    FVersion: Int16;
    FMetadataRequest: TKafkaMetadataRequest;
    FData: TBytes;
    procedure EncodeMetadataRequest;
    procedure DecodeApiVersionsResponse;
  public
    [Test] procedure Captures_AreThere;
    [Test] procedure EveryCapture_DecodesAndEncodesBackToTheSameBytes;
    [Test] procedure HandBuiltMetadataRequests_EncodeToTheCapturedBytes;
    [Test] procedure HandBuiltApiVersionsRequests_EncodeToTheCapturedBytes;
    [Test] procedure JavaProducerMetadataRequest_EncodesToTheCapturedBytes;
    [Test] procedure JavaAdminMetadataRequest_AsksForAllTopics;
    [Test] procedure ApiVersionsResponse_V5_ListsTheBrokersApis;
    [Test] procedure ApiVersionsResponse_V5_FeaturesAreTaggedFields;
    [Test] procedure ApiVersionsResponse_V0_HasNoThrottleTime;
    [Test] procedure MetadataResponse_V13_DescribesTheTopic;
    [Test] procedure MetadataResponse_V0_DescribesTheTopic;
    [Test] procedure MetadataResponse_EveryVersion_SameTopicAndLeader;
    [Test] procedure MetadataRequest_NullTopicsInV0_IsRefused;
    [Test] procedure MetadataRequest_NoAutoCreationBeforeV4_IsRefused;
    [Test] procedure MetadataRequest_ClusterOperationsAfterV10_IsRefused;
    [Test] procedure MetadataRequest_IgnorableFieldIsDropped;
    [Test] procedure UnsupportedVersion_IsRefused;
    [Test] procedure TrailingBytes_AreRefused;
    [Test] procedure UnknownTaggedFields_SurviveDecodeAndEncode;
    [Test] procedure Init_SetsTheDefaults;
  end;

implementation

const
  TOPIC = 'captured-topic';

function DecodeApiVersions(const AName: string; AVersion: Int16): TKafkaApiVersionsResponse;
var
  H: TKafkaResponseHeader;
begin
  Result.FromBytes(ResponseBody(CaptureBytes(AName, False), 18, AVersion, H), AVersion);
end;

function DecodeMetadata(const AName: string; AVersion: Int16): TKafkaMetadataResponse;
var
  H: TKafkaResponseHeader;
begin
  Result.FromBytes(ResponseBody(CaptureBytes(AName, False), 3, AVersion, H), AVersion);
end;

/// Decodes ABody as the message and encodes it again.
function Reencode(AKey, AVersion: Int16; AIsRequest: Boolean; const ABody: TBytes): TBytes;
var
  AvReq: TKafkaApiVersionsRequest;
  AvRsp: TKafkaApiVersionsResponse;
  MdReq: TKafkaMetadataRequest;
  MdRsp: TKafkaMetadataResponse;
  PrReq: TKafkaProduceRequest;
  PrRsp: TKafkaProduceResponse;
  FeReq: TKafkaFetchRequest;
  FeRsp: TKafkaFetchResponse;
  LoReq: TKafkaListOffsetsRequest;
  LoRsp: TKafkaListOffsetsResponse;
  ShReq: TKafkaSaslHandshakeRequest;
  ShRsp: TKafkaSaslHandshakeResponse;
  SaReq: TKafkaSaslAuthenticateRequest;
  SaRsp: TKafkaSaslAuthenticateResponse;
begin
  case AKey of
    KAFKA_API_KEY_API_VERSIONS:
      if AIsRequest then
      begin
        AvReq.FromBytes(ABody, AVersion);
        Result := AvReq.ToBytes(AVersion);
      end
      else
      begin
        AvRsp.FromBytes(ABody, AVersion);
        Result := AvRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_METADATA:
      if AIsRequest then
      begin
        MdReq.FromBytes(ABody, AVersion);
        Result := MdReq.ToBytes(AVersion);
      end
      else
      begin
        MdRsp.FromBytes(ABody, AVersion);
        Result := MdRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_PRODUCE:
      if AIsRequest then
      begin
        PrReq.FromBytes(ABody, AVersion);
        Result := PrReq.ToBytes(AVersion);
      end
      else
      begin
        PrRsp.FromBytes(ABody, AVersion);
        Result := PrRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_FETCH:
      if AIsRequest then
      begin
        FeReq.FromBytes(ABody, AVersion);
        Result := FeReq.ToBytes(AVersion);
      end
      else
      begin
        FeRsp.FromBytes(ABody, AVersion);
        Result := FeRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_LIST_OFFSETS:
      if AIsRequest then
      begin
        LoReq.FromBytes(ABody, AVersion);
        Result := LoReq.ToBytes(AVersion);
      end
      else
      begin
        LoRsp.FromBytes(ABody, AVersion);
        Result := LoRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_SASL_HANDSHAKE:
      if AIsRequest then
      begin
        ShReq.FromBytes(ABody, AVersion);
        Result := ShReq.ToBytes(AVersion);
      end
      else
      begin
        ShRsp.FromBytes(ABody, AVersion);
        Result := ShRsp.ToBytes(AVersion);
      end;
    KAFKA_API_KEY_SASL_AUTHENTICATE:
      if AIsRequest then
      begin
        SaReq.FromBytes(ABody, AVersion);
        Result := SaReq.ToBytes(AVersion);
      end
      else
      begin
        SaRsp.FromBytes(ABody, AVersion);
        Result := SaRsp.ToBytes(AVersion);
      end;
  else
    raise Exception.CreateFmt('No codec for API key %d', [AKey]);
  end;
end;

function MetadataRequestFor(const ATopic: string): TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Name := ATopic;
end;

function HandBuiltBody(const AName: string): TBytes;
var
  H: TKafkaRequestHeader;
begin
  Result := RequestBody(CaptureBytes(AName, True), H);
end;

{ TKafkaMessagesTests }

procedure TKafkaMessagesTests.EncodeMetadataRequest;
begin
  FMetadataRequest.ToBytes(FVersion);
end;

procedure TKafkaMessagesTests.DecodeApiVersionsResponse;
var
  R: TKafkaApiVersionsResponse;
begin
  R.FromBytes(FData, FVersion);
end;

procedure TKafkaMessagesTests.Captures_AreThere;
begin
  // A request and a response each: 12 Java exchanges (5 of them SASL), and
  // by hand 6 ApiVersions, 14 Metadata, 11 Produce, 11 ListOffsets, 16 Fetch
  // and 9 SASL.
  TAssert.AssertEquals(158, KAFKA_CAPTURE_COUNT);
  TAssert.AssertEquals('4.4.0', KAFKA_CAPTURES[0].KafkaTag);
end;

procedure TKafkaMessagesTests.EveryCapture_DecodesAndEncodesBackToTheSameBytes;
var
  I: Integer;
  C: TKafkaCapture;
  Content, Body, Again, Frame: TBytes;
  ReqHeader: TKafkaRequestHeader;
  RspHeader: TKafkaResponseHeader;
  HeaderVersion: Int16;
  Flexible: Boolean;
begin
  for I := 0 to KAFKA_CAPTURE_COUNT - 1 do
  begin
    C := KAFKA_CAPTURES[I];
    Content := KafkaCaptureBytes(C);
    Flexible := KafkaApiIsFlexible(C.ApiKey, C.ApiVersion);
    if C.IsRequest then
    begin
      Body := RequestBody(Content, ReqHeader);
      TAssert.AssertEquals(C.Name + ' api key', Integer(C.ApiKey), Integer(ReqHeader.ApiKey));
      HeaderVersion := KafkaRequestHeaderVersion(Flexible);
      Again := Reencode(C.ApiKey, C.ApiVersion, True, Body);
      Frame := KafkaEncodeRequestFrame(ReqHeader, HeaderVersion, Again);
    end
    else
    begin
      Body := ResponseBody(Content, C.ApiKey, C.ApiVersion, RspHeader);
      HeaderVersion := KafkaResponseHeaderVersion(C.ApiKey, Flexible);
      Again := Reencode(C.ApiKey, C.ApiVersion, False, Body);
      Frame := KafkaEncodeResponseFrame(RspHeader, HeaderVersion, Again);
    end;
    TAssert.AssertEquals(C.Name + ' (request: ' + BoolToStr(C.IsRequest, True) + ') body',
      BytesToHex(Body), BytesToHex(Again));
    TAssert.AssertEquals(C.Name + ' frame', BytesToHex(Content), BytesToHex(BytesFrom(Frame, 4)));
  end;
end;

procedure TKafkaMessagesTests.HandBuiltMetadataRequests_EncodeToTheCapturedBytes;
var
  V: Int16;
  Req: TKafkaMetadataRequest;
begin
  for V := 0 to 13 do
  begin
    Req := MetadataRequestFor(TOPIC);
    TAssert.AssertEquals('metadata-v' + IntToStr(V),
      BytesToHex(HandBuiltBody('metadata-v' + IntToStr(V))), BytesToHex(Req.ToBytes(V)));
  end;
end;

procedure TKafkaMessagesTests.HandBuiltApiVersionsRequests_EncodeToTheCapturedBytes;
var
  V: Int16;
  Req: TKafkaApiVersionsRequest;
begin
  for V := 0 to 5 do
  begin
    Req.Init;
    Req.ClientSoftwareName := 'pascal-kafka-faa-capture';
    Req.ClientSoftwareVersion := '1.0';
    TAssert.AssertEquals('api-versions-v' + IntToStr(V),
      BytesToHex(HandBuiltBody('api-versions-v' + IntToStr(V))), BytesToHex(Req.ToBytes(V)));
  end;
end;

procedure TKafkaMessagesTests.JavaProducerMetadataRequest_EncodesToTheCapturedBytes;
var
  H: TKafkaRequestHeader;
  Body: TBytes;
  Req: TKafkaMetadataRequest;
begin
  Body := RequestBody(CaptureBytes('java-producer-metadata-v13', True), H);
  TAssert.AssertEquals('console-producer', H.ClientId);
  // The defaults are what the Java producer sends: no topic id, auto-creation
  // allowed, no authorized operations.
  Req := MetadataRequestFor(TOPIC);
  TAssert.AssertEquals(BytesToHex(Body), BytesToHex(Req.ToBytes(13)));
end;

procedure TKafkaMessagesTests.JavaAdminMetadataRequest_AsksForAllTopics;
var
  H: TKafkaRequestHeader;
  Req: TKafkaMetadataRequest;
begin
  Req.FromBytes(RequestBody(CaptureBytes('java-admin-metadata-v13', True), H), 13);
  TAssert.AssertTrue(Req.TopicsIsNull);
  TAssert.AssertEquals(0, Length(Req.Topics));
end;

procedure TKafkaMessagesTests.ApiVersionsResponse_V5_ListsTheBrokersApis;
var
  R: TKafkaApiVersionsResponse;
  I: Integer;
  FoundMetadata, FoundApiVersions: Boolean;
begin
  R := DecodeApiVersions('api-versions-v5', 5);
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertEquals(0, R.ThrottleTimeMs);
  FoundMetadata := False;
  FoundApiVersions := False;
  for I := 0 to High(R.ApiKeys) do
  begin
    if R.ApiKeys[I].ApiKey = KAFKA_API_KEY_METADATA then
    begin
      FoundMetadata := True;
      TAssert.AssertEquals(0, Integer(R.ApiKeys[I].MinVersion));
      TAssert.AssertEquals(13, Integer(R.ApiKeys[I].MaxVersion));
    end;
    if R.ApiKeys[I].ApiKey = KAFKA_API_KEY_API_VERSIONS then
    begin
      FoundApiVersions := True;
      TAssert.AssertEquals(5, Integer(R.ApiKeys[I].MaxVersion));
    end;
  end;
  TAssert.AssertTrue('Metadata listed', FoundMetadata);
  TAssert.AssertTrue('ApiVersions listed', FoundApiVersions);
  TAssert.AssertTrue('many APIs', Length(R.ApiKeys) > 40);
end;

procedure TKafkaMessagesTests.ApiVersionsResponse_V5_FeaturesAreTaggedFields;
var
  R: TKafkaApiVersionsResponse;
  I: Integer;
  Found: Boolean;
begin
  R := DecodeApiVersions('api-versions-v5', 5);
  Found := False;
  for I := 0 to High(R.SupportedFeatures) do
    if R.SupportedFeatures[I].Name = 'metadata.version' then
      Found := True;
  TAssert.AssertTrue('metadata.version among the supported features', Found);
  TAssert.AssertTrue('a finalized epoch', R.FinalizedFeaturesEpoch >= 0);
  TAssert.AssertTrue('finalized features', Length(R.FinalizedFeatures) > 0);
  TAssert.AssertEquals('no tag the library doesn''t know', 0, Length(R.UnknownTaggedFields));
end;

procedure TKafkaMessagesTests.ApiVersionsResponse_V0_HasNoThrottleTime;
var
  R0, R1: TKafkaApiVersionsResponse;
begin
  R0 := DecodeApiVersions('api-versions-v0', 0);
  R1 := DecodeApiVersions('api-versions-v1', 1);
  TAssert.AssertEquals(Length(R1.ApiKeys), Length(R0.ApiKeys));
  // 4 bytes apart (ThrottleTimeMs), as the capture sizes say (472 and 476).
  TAssert.AssertEquals(Length(R1.ToBytes(1)) - 4, Length(R0.ToBytes(0)));
end;

procedure TKafkaMessagesTests.MetadataResponse_V13_DescribesTheTopic;
var
  R: TKafkaMetadataResponse;
  Id: TKafkaUuid;
  I: Integer;
begin
  R := DecodeMetadata('metadata-v13', 13);
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertEquals(1, Length(R.Brokers));
  TAssert.AssertEquals(1, R.Brokers[0].NodeId);
  TAssert.AssertEquals('localhost', R.Brokers[0].Host);
  TAssert.AssertEquals(9092, R.Brokers[0].Port);
  TAssert.AssertTrue(R.Brokers[0].RackIsNull);
  TAssert.AssertFalse(R.ClusterIdIsNull);
  TAssert.AssertTrue(R.ClusterId <> '');
  TAssert.AssertEquals(1, R.ControllerId);
  TAssert.AssertEquals(1, Length(R.Topics));
  TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
  TAssert.AssertEquals(0, Integer(R.Topics[0].ErrorCode));
  TAssert.AssertTrue(TKafkaUuid.TryParse('gIIkYqBfQzW_O9gEpXKFuQ', Id));
  TAssert.AssertTrue('topic id', Id.Equals(R.Topics[0].TopicId));
  TAssert.AssertEquals(3, Length(R.Topics[0].Partitions));
  for I := 0 to 2 do
  begin
    TAssert.AssertEquals(I, R.Topics[0].Partitions[I].PartitionIndex);
    TAssert.AssertEquals(1, R.Topics[0].Partitions[I].LeaderId);
    TAssert.AssertEquals(1, Length(R.Topics[0].Partitions[I].ReplicaNodes));
    TAssert.AssertEquals(1, Length(R.Topics[0].Partitions[I].IsrNodes));
  end;
  // Not requested: the "unknown" value.
  TAssert.AssertEquals(Int64(Low(Int32)), Int64(R.Topics[0].TopicAuthorizedOperations));
end;

procedure TKafkaMessagesTests.MetadataResponse_V0_DescribesTheTopic;
var
  R: TKafkaMetadataResponse;
begin
  R := DecodeMetadata('metadata-v0', 0);
  TAssert.AssertEquals(1, Length(R.Brokers));
  TAssert.AssertEquals('localhost', R.Brokers[0].Host);
  // Fields v0 doesn't have keep their defaults.
  TAssert.AssertTrue(R.ClusterIdIsNull);
  TAssert.AssertEquals(-1, R.ControllerId);
  TAssert.AssertEquals(TOPIC, R.Topics[0].Name);
  TAssert.AssertEquals(3, Length(R.Topics[0].Partitions));
  TAssert.AssertEquals(-1, R.Topics[0].Partitions[0].LeaderEpoch);
end;

procedure TKafkaMessagesTests.MetadataResponse_EveryVersion_SameTopicAndLeader;
var
  V: Int16;
  R: TKafkaMetadataResponse;
begin
  for V := 0 to 13 do
  begin
    R := DecodeMetadata('metadata-v' + IntToStr(V), V);
    TAssert.AssertEquals('v' + IntToStr(V), TOPIC, R.Topics[0].Name);
    TAssert.AssertEquals('v' + IntToStr(V), 0, Integer(R.Topics[0].ErrorCode));
    TAssert.AssertEquals('v' + IntToStr(V), 3, Length(R.Topics[0].Partitions));
    TAssert.AssertEquals('v' + IntToStr(V), 1, R.Topics[0].Partitions[2].LeaderId);
    if V >= 7 then
      TAssert.AssertTrue('v' + IntToStr(V) + ' leader epoch', R.Topics[0].Partitions[0].LeaderEpoch >= 0);
  end;
end;

procedure TKafkaMessagesTests.MetadataRequest_NullTopicsInV0_IsRefused;
begin
  FMetadataRequest.Init;
  FMetadataRequest.TopicsIsNull := True;
  FVersion := 0;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
  FVersion := 1;
  EncodeMetadataRequest;
end;

procedure TKafkaMessagesTests.MetadataRequest_NoAutoCreationBeforeV4_IsRefused;
begin
  FMetadataRequest := MetadataRequestFor(TOPIC);
  FMetadataRequest.AllowAutoTopicCreation := False;
  FVersion := 3;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
  FVersion := 4;
  EncodeMetadataRequest;
end;

procedure TKafkaMessagesTests.MetadataRequest_ClusterOperationsAfterV10_IsRefused;
begin
  FMetadataRequest := MetadataRequestFor(TOPIC);
  FMetadataRequest.IncludeClusterAuthorizedOperations := True;
  FVersion := 10;
  EncodeMetadataRequest;
  FVersion := 11;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
  FVersion := 7;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
end;

procedure TKafkaMessagesTests.MetadataRequest_IgnorableFieldIsDropped;
var
  Req: TKafkaMetadataRequest;
begin
  // TopicId is ignorable: a v9 request without it encodes like one with none.
  Req := MetadataRequestFor(TOPIC);
  Req.Topics[0].TopicId.Bytes[0] := 1;
  TAssert.AssertEquals(BytesToHex(MetadataRequestFor(TOPIC).ToBytes(9)), BytesToHex(Req.ToBytes(9)));
end;

procedure TKafkaMessagesTests.UnsupportedVersion_IsRefused;
begin
  FMetadataRequest := MetadataRequestFor(TOPIC);
  FVersion := 14;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
  FVersion := -1;
  TAssert.AssertException(EKafkaUnsupportedVersion, EncodeMetadataRequest);
end;

procedure TKafkaMessagesTests.TrailingBytes_AreRefused;
var
  H: TKafkaResponseHeader;
  Body: TBytes;
begin
  Body := ResponseBody(CaptureBytes('api-versions-v0', False), 18, 0, H);
  SetLength(Body, Length(Body) + 1);
  FData := Body;
  FVersion := 0;
  TAssert.AssertException(EKafkaProtocol, DecodeApiVersionsResponse);
end;

procedure TKafkaMessagesTests.UnknownTaggedFields_SurviveDecodeAndEncode;
var
  R, R2: TKafkaApiVersionsResponse;
  First, Second: TBytes;
begin
  R := DecodeApiVersions('api-versions-v5', 5);
  // A newer broker's tags, after the known 0..3.
  KafkaAddRawTaggedField(R.UnknownTaggedFields, 20, Bytes([1, 2, 3]));
  KafkaAddRawTaggedField(R.UnknownTaggedFields, 40, Bytes([4]));
  First := R.ToBytes(5);
  R2.FromBytes(First, 5);
  TAssert.AssertEquals(2, Length(R2.UnknownTaggedFields));
  TAssert.AssertEquals(Int64(20), Int64(R2.UnknownTaggedFields[0].Tag));
  TAssert.AssertEquals('010203', BytesToHex(R2.UnknownTaggedFields[0].Data));
  TAssert.AssertEquals(Int64(40), Int64(R2.UnknownTaggedFields[1].Tag));
  TAssert.AssertTrue('known tags still read', Length(R2.SupportedFeatures) > 0);
  Second := R2.ToBytes(5);
  TAssert.AssertEquals(BytesToHex(First), BytesToHex(Second));
end;

procedure TKafkaMessagesTests.Init_SetsTheDefaults;
var
  Req: TKafkaMetadataRequest;
  Rsp: TKafkaMetadataResponse;
  Av: TKafkaApiVersionsRequest;
begin
  Req.Init;
  TAssert.AssertTrue(Req.AllowAutoTopicCreation);
  TAssert.AssertFalse(Req.TopicsIsNull);
  Rsp.Init;
  TAssert.AssertEquals(-1, Rsp.ControllerId);
  TAssert.AssertTrue(Rsp.ClusterIdIsNull);
  TAssert.AssertEquals(Int64(Low(Int32)), Int64(Rsp.ClusterAuthorizedOperations));
  Av.Init;
  TAssert.AssertTrue(Av.ClusterIdIsNull);
  TAssert.AssertEquals(-1, Av.NodeId);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaMessagesTests);

end.
