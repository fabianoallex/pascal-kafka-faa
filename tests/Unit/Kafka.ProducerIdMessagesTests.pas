unit Kafka.ProducerIdMessagesTests;

{ Tests for InitProducerId's generated codec (phase K3's foundation) and for
  what a Kafka 4.4.0 broker answers idempotent Produce batches, against the
  captures of Kafka.TestCaptures (docs/codec-captures.md, "The idempotent
  producer").

  - InitProducerId v0-v5, built by hand and accepted by the broker: rebuilt
    from the generated records they encode to the captured bytes (a null
    transactional id, TransactionTimeoutMs MaxInt: what the Java producer
    sends), and every answer gives a producer id with epoch 0. Asked again
    with the id and epoch it was given, the broker hands out a new id with
    epoch 0: without a transactional id there is no epoch to bump on its
    side.
  - The Java console producer 4.4.0 (idempotent by default): its request is
    the same as the hand-built one; the first answer, from a broker that had
    just started, is COORDINATOR_LOAD_IN_PROGRESS with no id, and the second
    (Java retried) has one; its Produce batch carries that id, epoch 0 and
    sequence 0, with acks all.
  - Idempotent Produce v13 batches, built by hand with the id the broker
    gave: rebuilt with TKafkaRecordBatch they encode to the captured bytes,
    and the broker's answers are what the fake broker must copy for the
    idempotent producer: the same batch again is answered without error and
    with its first offset; a gap in the sequence is OUT_OF_ORDER_SEQUENCE_NUMBER;
    a higher epoch starting at sequence 0 is accepted (the client may bump
    the epoch itself); the older epoch then is INVALID_PRODUCER_EPOCH; a
    producer id the broker never saw is accepted at any sequence; and a batch
    older than the five the broker remembers gets OUT_OF_ORDER_SEQUENCE_NUMBER,
    not DUPLICATE_SEQUENCE_NUMBER.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Protocol.Primitives,
  Kafka.Protocol.RecordBatch,
  Kafka.Messages.Produce,
  Kafka.Messages.InitProducerId,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaProducerIdMessagesTests = class
  public
    [Test] procedure InitProducerId_HandBuilt_EncodeToTheCapturedBytes;
    [Test] procedure InitProducerId_Answers_GiveAnIdWithEpochZero;
    [Test] procedure InitProducerId_AskedAgain_GivesANewId;
    [Test] procedure InitProducerId_Java_SameRequest_RetriedAfterLoading;
    [Test] procedure IdempotentProduce_HandBuilt_EncodeToTheCapturedBytes;
    [Test] procedure IdempotentProduce_Answers_WhatTheBrokerDoes;
    [Test] procedure IdempotentProduce_Java_CarriesItsProducerId;
  end;

implementation

const
  IDEMPOTENT_TOPIC_BASE_TS = Int64(1767225600000); // 2026-01-01T00:00:00Z
  NO_TRANSACTION_TIMEOUT = 2147483647;

function InitRequest(AProducerId: Int64; AEpoch: Int16): TKafkaInitProducerIdRequest;
begin
  Result.Init;
  Result.TransactionalIdIsNull := True;
  Result.TransactionTimeoutMs := NO_TRANSACTION_TIMEOUT;
  Result.ProducerId := AProducerId;
  Result.ProducerEpoch := AEpoch;
end;

function InitAnswer(const AName: string): TKafkaInitProducerIdResponse;
begin
  Result.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
end;

function ProduceAnswer(const AName: string): TKafkaProduceResponsePartitionProduceResponse;
var
  R: TKafkaProduceResponse;
begin
  R.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
  TAssert.AssertEquals(AName + ' topics', 1, Length(R.Responses));
  TAssert.AssertEquals(AName + ' partitions', 1, Length(R.Responses[0].PartitionResponses));
  Result := R.Responses[0].PartitionResponses[0];
end;

function ProduceRequest(const AName: string): TKafkaProduceRequest;
begin
  Result.FromBytes(CaptureRequestBody(AName), CaptureVersion(AName));
end;

/// The hand-built batch number AIndex of tools/capture_versions.py: two
/// records, idem-<n>-a and idem-<n>-b, a millisecond apart.
function HandBuiltBatch(AIndex: Integer; AProducerId: Int64; AEpoch: Int16;
  ASequence: Int32): TBytes;
var
  B: TKafkaRecordBatch;
  T: Int64;
begin
  T := IDEMPOTENT_TOPIC_BASE_TS + 1000 * AIndex;
  B.Init;
  B.ProducerId := AProducerId;
  B.ProducerEpoch := AEpoch;
  B.BaseSequence := ASequence;
  B.Append(KafkaRecord(Utf8(Format('idem-%d-a', [AIndex])),
    Utf8(Format('batch %d, first', [AIndex])), T));
  B.Append(KafkaRecord(Utf8(Format('idem-%d-b', [AIndex])),
    Utf8(Format('batch %d, second', [AIndex])), T + 1));
  Result := B.Encode;
end;

/// The producer id the Produce batches were written with: the answer to
/// the second InitProducerId v5.
function HandBuiltProducerId: Int64;
begin
  Result := InitAnswer('init-producer-id-v5-again').ProducerId;
end;

procedure TKafkaProducerIdMessagesTests.InitProducerId_HandBuilt_EncodeToTheCapturedBytes;
var
  Ver: Int16;
  Name: string;
  First: TKafkaInitProducerIdResponse;
begin
  for Ver := 0 to 5 do
  begin
    Name := 'init-producer-id-v' + IntToStr(Ver);
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)),
      BytesToHex(InitRequest(-1, -1).ToBytes(Ver)));
  end;
  First := InitAnswer('init-producer-id-v5');
  TAssert.AssertEquals('v5 again', BytesToHex(CaptureRequestBody('init-producer-id-v5-again')),
    BytesToHex(InitRequest(First.ProducerId, First.ProducerEpoch).ToBytes(5)));
end;

procedure TKafkaProducerIdMessagesTests.InitProducerId_Answers_GiveAnIdWithEpochZero;
var
  Ver: Int16;
  Name: string;
  R: TKafkaInitProducerIdResponse;
  Last: Int64;
begin
  Last := -1;
  for Ver := 0 to 5 do
  begin
    Name := 'init-producer-id-v' + IntToStr(Ver);
    R := InitAnswer(Name);
    TAssert.AssertEquals(Name + ' error', 0, Integer(R.ErrorCode));
    TAssert.AssertTrue(Name + ' a new id each time', R.ProducerId > Last);
    TAssert.AssertEquals(Name + ' epoch', 0, Integer(R.ProducerEpoch));
    Last := R.ProducerId;
  end;
  // A field v6 adds keeps its default in the versions without it.
  TAssert.AssertEquals(Int64(-1), R.OngoingTxnProducerId);
end;

procedure TKafkaProducerIdMessagesTests.InitProducerId_AskedAgain_GivesANewId;
var
  Sent: TKafkaInitProducerIdRequest;
  R: TKafkaInitProducerIdResponse;
begin
  Sent.FromBytes(CaptureRequestBody('init-producer-id-v5-again'), 5);
  TAssert.AssertTrue('sent an id', Sent.ProducerId >= 0);
  TAssert.AssertEquals('and its epoch', 0, Integer(Sent.ProducerEpoch));
  R := InitAnswer('init-producer-id-v5-again');
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertTrue('a different id', R.ProducerId <> Sent.ProducerId);
  TAssert.AssertEquals('epoch 0, not a bump', 0, Integer(R.ProducerEpoch));
end;

procedure TKafkaProducerIdMessagesTests.InitProducerId_Java_SameRequest_RetriedAfterLoading;
var
  Req: TKafkaInitProducerIdRequest;
  R: TKafkaInitProducerIdResponse;
begin
  TAssert.AssertEquals(5, Integer(CaptureVersion('java-idempotent-init-producer-id-v5')));
  // The Java client's body is the hand-built one: no transactional id,
  // TransactionTimeoutMs MaxInt, no id and no epoch yet.
  TAssert.AssertEquals(BytesToHex(CaptureRequestBody('init-producer-id-v5')),
    BytesToHex(CaptureRequestBody('java-idempotent-init-producer-id-v5')));
  Req.FromBytes(CaptureRequestBody('java-idempotent-init-producer-id-v5-loading'), 5);
  TAssert.AssertTrue(Req.TransactionalIdIsNull);
  TAssert.AssertEquals(NO_TRANSACTION_TIMEOUT, Req.TransactionTimeoutMs);
  TAssert.AssertEquals(Int64(-1), Req.ProducerId);
  TAssert.AssertEquals(-1, Integer(Req.ProducerEpoch));

  R := InitAnswer('java-idempotent-init-producer-id-v5-loading');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_COORDINATOR_LOAD_IN_PROGRESS), Integer(R.ErrorCode));
  TAssert.AssertEquals(Int64(-1), R.ProducerId);
  TAssert.AssertEquals(-1, Integer(R.ProducerEpoch));
  R := InitAnswer('java-idempotent-init-producer-id-v5');
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertTrue(R.ProducerId >= 0);
  TAssert.AssertEquals(0, Integer(R.ProducerEpoch));
end;

procedure TKafkaProducerIdMessagesTests.IdempotentProduce_HandBuilt_EncodeToTheCapturedBytes;

  procedure Check(const ALabel: string; AIndex: Integer; AProducerId: Int64;
    AEpoch: Int16; ASequence: Int32);
  var
    Name: string;
    Captured: TKafkaProduceRequest;
    R: TKafkaProduceRequest;
  begin
    Name := 'produce-v13-idempotent-' + ALabel;
    Captured := ProduceRequest(Name);
    R.Init;
    R.Acks := -1;
    R.TimeoutMs := 30000;
    SetLength(R.TopicData, 1);
    R.TopicData[0].Init;
    R.TopicData[0].TopicId := Captured.TopicData[0].TopicId;
    SetLength(R.TopicData[0].PartitionData, 1);
    R.TopicData[0].PartitionData[0].Init;
    R.TopicData[0].PartitionData[0].Index := 0;
    R.TopicData[0].PartitionData[0].Records := HandBuiltBatch(AIndex, AProducerId, AEpoch, ASequence);
    R.TopicData[0].PartitionData[0].RecordsIsNull := False;
    TAssert.AssertEquals(Name + ' batch', BytesToHex(ProduceRecords(Name)),
      BytesToHex(R.TopicData[0].PartitionData[0].Records));
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(R.ToBytes(13)));
  end;

var
  Pid: Int64;
begin
  Pid := HandBuiltProducerId;
  Check('first', 0, Pid, 0, 0);
  Check('retry', 0, Pid, 0, 0);
  Check('next', 1, Pid, 0, 2);
  Check('gap', 2, Pid, 0, 10);
  Check('new-epoch', 3, Pid, 1, 0);
  Check('old-epoch', 4, Pid, 0, 4);
  Check('unknown-producer', 5, Pid + 1000000, 0, 6);
  Check('evicted-retry', 3, Pid, 1, 0);
end;

procedure TKafkaProducerIdMessagesTests.IdempotentProduce_Answers_WhatTheBrokerDoes;

  procedure Check(const ALabel: string; AError: Int16; ABaseOffset: Int64);
  var
    Name: string;
    P: TKafkaProduceResponsePartitionProduceResponse;
  begin
    Name := 'produce-v13-idempotent-' + ALabel;
    P := ProduceAnswer(Name);
    TAssert.AssertEquals(Name + ' error', Integer(AError), Integer(P.ErrorCode));
    TAssert.AssertEquals(Name + ' base offset', ABaseOffset, P.BaseOffset);
  end;

begin
  Check('first', 0, 0);
  // The same batch again: no error and its first offset, not a second copy
  // (the next batch lands at 2).
  Check('retry', 0, 0);
  Check('next', 0, 2);
  Check('gap', KAFKA_ERROR_OUT_OF_ORDER_SEQUENCE_NUMBER, -1);
  // A new epoch starts at sequence 0, without asking the broker.
  Check('new-epoch', 0, 4);
  Check('old-epoch', KAFKA_ERROR_INVALID_PRODUCER_EPOCH, -1);
  // Unknown to the broker, and accepted at sequence 6.
  Check('unknown-producer', 0, 6);
  // After six more batches (offsets 8 to 18) the new epoch's first batch is
  // forgotten: out of order, not a duplicate.
  Check('evicted-retry', KAFKA_ERROR_OUT_OF_ORDER_SEQUENCE_NUMBER, -1);
end;

procedure TKafkaProducerIdMessagesTests.IdempotentProduce_Java_CarriesItsProducerId;
var
  Req: TKafkaProduceRequest;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
  P: TKafkaProduceResponsePartitionProduceResponse;
begin
  Req := ProduceRequest('java-idempotent-produce-v13');
  TAssert.AssertEquals('acks all', -1, Integer(Req.Acks));
  TAssert.AssertTrue(Req.TransactionalIdIsNull);
  Batches := KafkaDecodeRecordBatches(ProduceRecords('java-idempotent-produce-v13'), 1 shl 20, Trailing);
  TAssert.AssertEquals(1, Length(Batches));
  TAssert.AssertEquals(0, Trailing);
  TAssert.AssertEquals('the id InitProducerId gave',
    InitAnswer('java-idempotent-init-producer-id-v5').ProducerId, Batches[0].ProducerId);
  TAssert.AssertEquals(0, Integer(Batches[0].ProducerEpoch));
  TAssert.AssertEquals(0, Batches[0].BaseSequence);
  TAssert.AssertEquals('three lines', 3, Length(Batches[0].Records));
  TAssert.AssertFalse(Batches[0].IsTransactional);
  P := ProduceAnswer('java-idempotent-produce-v13');
  TAssert.AssertEquals(0, Integer(P.ErrorCode));
  TAssert.AssertEquals(Int64(0), P.BaseOffset);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaProducerIdMessagesTests);

end.
