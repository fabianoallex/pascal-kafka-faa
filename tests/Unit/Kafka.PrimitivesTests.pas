procedure TKafkaPrimitivesTests.Bytes_ClassicCompactAndNull;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  IsNull: Boolean;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteBytes(Bytes([1, 2]), False);
    W.WriteBytes(Bytes([1, 2]), True);
    W.WriteNullableBytes(nil, True, False);
    W.WriteNullableBytes(nil, True, True);
    W.WriteBytes(nil, True);
    TAssert.AssertEquals('000000020102' + '030102' + 'ffffffff' + '00' + '01', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      TAssert.AssertEquals('0102', BytesToHex(R.ReadBytes(False)));
      TAssert.AssertEquals('0102', BytesToHex(R.ReadBytes(True)));
      R.ReadNullableBytes(False, IsNull);
      TAssert.AssertTrue(IsNull);
      R.ReadNullableBytes(True, IsNull);
      TAssert.AssertTrue(IsNull);
      TAssert.AssertEquals(0, Length(R.ReadNullableBytes(True, IsNull)));
      TAssert.AssertFalse('empty is not null', IsNull);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Array_Lengths_ClassicCompactAndNull;
var
  W: TKafkaWriter;
  R: TKafkaReader;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteArrayLength(0, False);
    W.WriteArrayLength(0, True);
    W.WriteNullArray(False);
    W.WriteNullArray(True);
    TAssert.AssertEquals('00000000' + '01' + 'ffffffff' + '00', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      TAssert.AssertEquals(0, R.ReadArrayLength(False));
      TAssert.AssertEquals(0, R.ReadArrayLength(True));
      TAssert.AssertEquals(-1, R.ReadArrayLength(False));
      TAssert.AssertEquals(-1, R.ReadArrayLength(True));
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Array_CountLargerThanTheData_IsRefused;
