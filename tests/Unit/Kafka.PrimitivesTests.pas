procedure TKafkaPrimitivesTests.Int32Array_RoundTrip;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  A, B: TKafkaInt32Array;
begin
  A := nil;
  SetLength(A, 3);
  A[0] := 1;
  A[1] := -1;
  A[2] := High(Int32);
  W := TKafkaWriter.Create;
  try
    W.WriteInt32Array(A, True);
    TAssert.AssertEquals('04' + '00000001' + 'ffffffff' + '7fffffff', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      B := R.ReadInt32Array(True);
      TAssert.AssertEquals(3, Length(B));
      TAssert.AssertEquals(-1, B[1]);
      TAssert.AssertEquals(High(Int32), B[2]);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.StringArray_RoundTrip;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  A, B: TKafkaStringArray;
begin
  A := nil;
  SetLength(A, 2);
  A[0] := 'x';
  A[1] := '';
  W := TKafkaWriter.Create;
  try
    W.WriteStringArray(A, False);
    TAssert.AssertEquals('00000002' + '000178' + '0000', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      B := R.ReadStringArray(False);
      TAssert.AssertEquals(2, Length(B));
      TAssert.AssertEquals('x', B[0]);
      TAssert.AssertEquals('', B[1]);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Uuid_ToStringAndParse;
var
  U, V: TKafkaUuid;
begin
  // The topic id kafka-topics.sh printed for captured-topic, and its bytes in
  // the broker's Metadata v13 response.
  TAssert.AssertTrue(TKafkaUuid.TryParse('gIIkYqBfQzW_O9gEpXKFuQ', U));
  TAssert.AssertEquals('80822462a05f4335bf3bd804a57285b9', BytesToHex(Bytes(U.Bytes)));
  TAssert.AssertEquals('gIIkYqBfQzW_O9gEpXKFuQ', U.ToString);
  TAssert.AssertFalse(U.IsZero);
  TAssert.AssertTrue(TKafkaUuid.TryParse(U.ToString, V));
  TAssert.AssertTrue(U.Equals(V));
  TAssert.AssertFalse('21 characters', TKafkaUuid.TryParse('gIIkYqBfQzW_O9gEpXKFu', V));
  TAssert.AssertFalse('not base64url', TKafkaUuid.TryParse('gIIkYqBfQzW+O9gEpXKFuQ', V));
end;

procedure TKafkaPrimitivesTests.Uuid_Zero;
var
  U: TKafkaUuid;
begin
  U := TKafkaUuid.Zero;
  TAssert.AssertTrue(U.IsZero);
  TAssert.AssertEquals('AAAAAAAAAAAAAAAAAAAAAA', U.ToString);
end;

procedure TKafkaPrimitivesTests.TaggedFields_UnknownInterleavedInTagOrder;
var
  W: TKafkaWriter;
  Unknown: TKafkaRawTaggedFields;
  Index: Integer;
begin
  Unknown := nil;
  KafkaAddRawTaggedField(Unknown, 1, Bytes([$AA]));
  KafkaAddRawTaggedField(Unknown, 5, Bytes([$BB, $CC]));
  W := TKafkaWriter.Create;
  try
    // A known field with tag 3 goes between the unknown 1 and 5.
    Index := 0;
    W.WriteRawTaggedFieldsBelow(Unknown, Index, 3);
    W.WriteTaggedField(3, Bytes([$03]));
    W.WriteRawTaggedFieldsBelow(Unknown, Index, High(Int64));
    TAssert.AssertEquals('0101aa' + '030103' + '0502bbcc', Written(W));
    TAssert.AssertEquals(2, Index);
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.TaggedFields_ReadRaw;
var
  R: TKafkaReader;
  F: TKafkaRawTaggedFields;
begin
  R := TKafkaReader.Create(HexToBytes('02 0101aa 0502bbcc'));
  try
    F := R.ReadRawTaggedFields;
    TAssert.AssertEquals(2, Length(F));
    TAssert.AssertEquals(Int64(1), Int64(F[0].Tag));
    TAssert.AssertEquals('aa', BytesToHex(F[0].Data));
    TAssert.AssertEquals(Int64(5), Int64(F[1].Tag));
    TAssert.AssertEquals('bbcc', BytesToHex(F[1].Data));
    TAssert.AssertTrue(R.AtEnd);
  finally
    R.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Writer_GrowsPastItsInitialCapacity;
var
  W: TKafkaWriter;
  I: Integer;
  B: TBytes;
begin
  W := TKafkaWriter.Create(16);
  try
    for I := 0 to 9999 do
      W.WriteInt32(I);
    TAssert.AssertEquals(40000, W.Length);
    B := W.ToBytes;
    TAssert.AssertEquals(40000, Length(B));
    TAssert.AssertEquals('0000270f', BytesToHex(Copy(B, 39996, 4)));
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Reader_OverASlice_StopsAtItsEnd;
var
  R: TKafkaReader;
begin
  FData := HexToBytes('ff 00000001 ff');
  R := TKafkaReader.Create(FData, 1, 4);
  try
    TAssert.AssertEquals(4, R.Remaining);
    TAssert.AssertEquals(1, R.ReadInt32);
    TAssert.AssertTrue(R.AtEnd);
  finally
    R.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaPrimitivesTests);

end.
