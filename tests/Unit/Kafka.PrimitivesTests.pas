procedure TKafkaPrimitivesTests.UnsignedVarint_KnownEncodings;
const
  VALUES: array[0..7] of Cardinal = (0, 1, 127, 128, 300, 16383, 16384, $FFFFFFFF);
  EXPECTED: array[0..7] of string = ('00', '01', '7f', '8001', 'ac02', 'ff7f', '808001',
    'ffffffff0f');
var
  W: TKafkaWriter;
  I: Integer;
begin
  W := TKafkaWriter.Create;
  try
    for I := 0 to High(VALUES) do
    begin
      W.Clear;
      W.WriteUnsignedVarint(VALUES[I]);
      TAssert.AssertEquals(IntToStr(Int64(VALUES[I])), EXPECTED[I], Written(W));
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.UnsignedVarint_ReadBack;
var
  R: TKafkaReader;
begin
  R := TKafkaReader.Create(HexToBytes('00 7f 8001 ac02 ffffffff0f'));
  try
    TAssert.AssertEquals(Int64(0), Int64(R.ReadUnsignedVarint));
    TAssert.AssertEquals(Int64(127), Int64(R.ReadUnsignedVarint));
    TAssert.AssertEquals(Int64(128), Int64(R.ReadUnsignedVarint));
    TAssert.AssertEquals(Int64(300), Int64(R.ReadUnsignedVarint));
    TAssert.AssertEquals(Int64(4294967295), Int64(R.ReadUnsignedVarint));
    TAssert.AssertTrue(R.AtEnd);
  finally
    R.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Varint_Zigzag_KnownEncodings;
const
  VALUES: array[0..8] of Int32 = (0, -1, 1, -2, 63, -64, 64, High(Int32), Low(Int32));
  EXPECTED: array[0..8] of string = ('00', '01', '02', '03', '7e', '7f', '8001',
    'feffffff0f', 'ffffffff0f');
var
  W: TKafkaWriter;
  R: TKafkaReader;
  I: Integer;
begin
  W := TKafkaWriter.Create;
  try
    for I := 0 to High(VALUES) do
    begin
      W.Clear;
      W.WriteVarint(VALUES[I]);
      TAssert.AssertEquals(IntToStr(VALUES[I]), EXPECTED[I], Written(W));
      R := TKafkaReader.Create(W.ToBytes);
      try
        TAssert.AssertEquals(IntToStr(VALUES[I]), Int64(VALUES[I]), Int64(R.ReadVarint));
      finally
        R.Free;
      end;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Varint_Extremes_RoundTrip;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  V: Int64;
begin
  // Every power of two and its neighbours, both signs, inside Int32.
  W := TKafkaWriter.Create;
  try
    V := 1;
    while V <= High(Int32) do
    begin
      W.WriteVarint(Int32(V));
      W.WriteVarint(Int32(V - 1));
      W.WriteVarint(Int32(-V));
      W.WriteVarint(Int32(-V + 1));
      V := V * 2;
    end;
    R := TKafkaReader.Create(W.ToBytes);
    try
      V := 1;
      while V <= High(Int32) do
      begin
        TAssert.AssertEquals(V, Int64(R.ReadVarint));
        TAssert.AssertEquals(V - 1, Int64(R.ReadVarint));
        TAssert.AssertEquals(-V, Int64(R.ReadVarint));
        TAssert.AssertEquals(-V + 1, Int64(R.ReadVarint));
        V := V * 2;
      end;
      TAssert.AssertTrue(R.AtEnd);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Varlong_KnownEncodings;
var
  W: TKafkaWriter;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteVarlong(0);
    TAssert.AssertEquals('00', Written(W));
    W.Clear;
    W.WriteVarlong(-1);
    TAssert.AssertEquals('01', Written(W));
    W.Clear;
    W.WriteVarlong(300);
    TAssert.AssertEquals('d804', Written(W));
    W.Clear;
    W.WriteVarlong(High(Int64));
    TAssert.AssertEquals('feffffffffffffffff01', Written(W));
    W.Clear;
    W.WriteVarlong(Low(Int64));
    TAssert.AssertEquals('ffffffffffffffffff01', Written(W));
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Varlong_Extremes_RoundTrip;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  I: Integer;
  V: Int64;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteVarlong(High(Int64));
    W.WriteVarlong(Low(Int64));
    V := 1;
    for I := 0 to 61 do
    begin
      W.WriteVarlong(V);
      W.WriteVarlong(-V);
      V := V * 2;
    end;
    R := TKafkaReader.Create(W.ToBytes);
    try
      TAssert.AssertEquals(High(Int64), R.ReadVarlong);
      TAssert.AssertEquals(Low(Int64), R.ReadVarlong);
      V := 1;
      for I := 0 to 61 do
      begin
        TAssert.AssertEquals(V, R.ReadVarlong);
        TAssert.AssertEquals(-V, R.ReadVarlong);
        V := V * 2;
      end;
      TAssert.AssertTrue(R.AtEnd);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

