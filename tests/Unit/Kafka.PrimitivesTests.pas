procedure TKafkaPrimitivesTests.BigEndianIntegers;
var
  W: TKafkaWriter;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteInt8(-1);
    W.WriteInt16(-2);
    W.WriteInt32($01020304);
    W.WriteInt64(Int64($0102030405060708));
    W.WriteUInt16($ABCD);
    W.WriteUInt32($DEADBEEF);
    TAssert.AssertEquals('ff' + 'fffe' + '01020304' + '0102030405060708' + 'abcd' + 'deadbeef',
      Written(W));
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.BigEndianIntegers_ReadBack;
var
  R: TKafkaReader;
begin
  R := TKafkaReader.Create(HexToBytes('80 8000 80000000 8000000000000000 ffff ffffffff'));
  try
    TAssert.AssertEquals(-128, Integer(R.ReadInt8));
    TAssert.AssertEquals(-32768, Integer(R.ReadInt16));
    TAssert.AssertEquals(Int64(Low(Int32)), Int64(R.ReadInt32));
    TAssert.AssertEquals(Low(Int64), R.ReadInt64);
    TAssert.AssertEquals(65535, Integer(R.ReadUInt16));
    TAssert.AssertEquals(Int64(4294967295), Int64(R.ReadUInt32));
    TAssert.AssertTrue(R.AtEnd);
  finally
    R.Free;
  end;
end;

procedure TKafkaPrimitivesTests.Float64_IsIeee754BigEndian;
