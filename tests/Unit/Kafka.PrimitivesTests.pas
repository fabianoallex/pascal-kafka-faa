unit Kafka.PrimitivesTests;

{ Tests for Kafka.Protocol.Primitives: the byte layout of every primitive,
  checked against the encodings of the protocol guide and of Kafka's own
  ByteUtilsTest (unsigned varint, zigzag varint and varlong, including the
  32- and 64-bit extremes), the classic and compact forms of strings, bytes
  and arrays with their nulls, UUIDs, raw tagged fields, and the refusals: a
  truncated value, an over-long varint, invalid UTF-8, a null where none is
  allowed, an array count larger than the bytes left.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Kafka.Types,
  Kafka.Protocol.Primitives,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaPrimitivesTests = class
  private
    FData: TBytes;
    procedure ReadUnsignedVarintFromData;
    procedure ReadVarlongFromData;
    procedure ReadInt32FromData;
    procedure ReadStringFromData;
    procedure ReadCompactStringFromData;
    procedure ReadCompactArrayLengthFromData;
    procedure ReadClassicArrayLengthFromData;
    procedure ReadNonNullCompactArrayFromData;
    procedure WriteLongClassicString;
  public
    [Test] procedure BigEndianIntegers;
    [Test] procedure BigEndianIntegers_ReadBack;
    [Test] procedure Float64_IsIeee754BigEndian;
    [Test] procedure Bool_AnyNonZeroIsTrue;
    [Test] procedure UnsignedVarint_KnownEncodings;
    [Test] procedure UnsignedVarint_ReadBack;
    [Test] procedure Varint_Zigzag_KnownEncodings;
    [Test] procedure Varint_Extremes_RoundTrip;
    [Test] procedure Varlong_KnownEncodings;
    [Test] procedure Varlong_Extremes_RoundTrip;
    [Test] procedure UnsignedVarint_SixBytes_IsRefused;
    [Test] procedure UnsignedVarint_FifthByteTooLarge_IsRefused;
    [Test] procedure UnsignedVarint_Truncated_IsRefused;
    [Test] procedure Varlong_ElevenBytes_IsRefused;
    [Test] procedure Int32_Truncated_IsRefused;
    [Test] procedure String_ClassicAndCompact;
    [Test] procedure String_Null_ClassicAndCompact;
    [Test] procedure String_NonAscii_IsUtf8;
    [Test] procedure String_InvalidUtf8_IsRefused;
    [Test] procedure String_NullWhereNotNullable_IsRefused;
    [Test] procedure String_ClassicLongerThan32767_IsRefused;
    [Test] procedure Bytes_ClassicCompactAndNull;
    [Test] procedure Array_Lengths_ClassicCompactAndNull;
    [Test] procedure Array_CountLargerThanTheData_IsRefused;
    [Test] procedure Array_NullWhereNotNullable_IsRefused;
    [Test] procedure Int32Array_RoundTrip;
