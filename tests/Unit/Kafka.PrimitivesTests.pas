  FData := HexToBytes('c1843d');
  TAssert.AssertException(EKafkaProtocol, ReadCompactArrayLengthFromData);
  FData := HexToBytes('7fffffff');
  TAssert.AssertException(EKafkaProtocol, ReadClassicArrayLengthFromData);
  FData := HexToBytes('fffffffe');
  TAssert.AssertException(EKafkaProtocol, ReadClassicArrayLengthFromData);
end;

