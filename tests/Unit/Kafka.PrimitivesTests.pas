procedure TKafkaPrimitivesTests.String_ClassicAndCompact;
var
  W: TKafkaWriter;
  R: TKafkaReader;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteString('abc', False);
    W.WriteString('abc', True);
    W.WriteString('', False);
    W.WriteString('', True);
    TAssert.AssertEquals('0003616263' + '04616263' + '0000' + '01', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      TAssert.AssertEquals('abc', R.ReadString(False));
      TAssert.AssertEquals('abc', R.ReadString(True));
      TAssert.AssertEquals('', R.ReadString(False));
      TAssert.AssertEquals('', R.ReadString(True));
      TAssert.AssertTrue(R.AtEnd);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

procedure TKafkaPrimitivesTests.String_Null_ClassicAndCompact;
var
  W: TKafkaWriter;
  R: TKafkaReader;
  IsNull: Boolean;
begin
  W := TKafkaWriter.Create;
  try
    W.WriteNullableString('ignored', True, False);
    W.WriteNullableString('ignored', True, True);
    W.WriteNullableString('', False, True);
    TAssert.AssertEquals('ffff' + '00' + '01', Written(W));
    R := TKafkaReader.Create(W.ToBytes);
    try
      TAssert.AssertEquals('', R.ReadNullableString(False, IsNull));
      TAssert.AssertTrue('classic null', IsNull);
      R.ReadNullableString(True, IsNull);
      TAssert.AssertTrue('compact null', IsNull);
      R.ReadNullableString(True, IsNull);
      TAssert.AssertFalse('empty is not null', IsNull);
    finally
      R.Free;
    end;
  finally
    W.Free;
  end;
end;

