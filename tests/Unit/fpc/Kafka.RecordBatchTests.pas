const
  // gzip.compress(b"hello kafka", mtime=0)
  GZ_PLAIN = '1f8b080000000000020acb48cdc9c957c84e4ccb4e0400d175816c0b000000';
  // GzipFile(filename="payload.txt", mtime=0): FNAME set
  GZ_NAMED = '1f8b08080000000002ff7061796c6f61642e74787400cbcf39bc504721bd2ab340a13cb324' +
    '432151212d332755212f31371500912175461b000000';
  // GZ_PLAIN's deflate and trailer under a header with FHCRC, FEXTRA, FNAME
  // and FCOMMENT (built by hand; Python's gzip.decompress reads it)
  GZ_ALL_FLAGS = '1f8b081e0000000000ff0400414200006e2e62696e006120636f6d6d656e74008bf0cb48' +
    'cdc9c957c84e4ccb4e0400d175816c0b000000';
  // gzip.compress(b"one ") + gzip.compress(b"two")
  GZ_TWO_MEMBERS = '1f8b080000000000020acbcf4b5500004961ac23040000001f8b080000000000020a2b29' +
    'cf0700668aca1103000000';
  // zlib.compress(b"hello kafka"): RFC 1950, not gzip
  ZLIB_DATA = '789ccb48cdc9c957c84e4ccb4e04001a2a0461';

function Join(const AParts: array of TBytes): TBytes;
var
  I, N: Integer;
begin
  Result := nil;
  for I := 0 to High(AParts) do
  begin
    N := Length(Result);
    SetLength(Result, N + Length(AParts[I]));
    if Length(AParts[I]) > 0 then
      Move(AParts[I][0], Result[N], Length(AParts[I]));
  end;
end;

function Text(const AData: TBytes): string;
begin
  Result := FromUtf8(AData);
end;

function Pseudorandom(ACount: Integer): TBytes;
var
  I: Integer;
  X: Cardinal;
begin
  Result := nil;
  SetLength(Result, ACount);
  X := 12345;
  for I := 0 to ACount - 1 do
  begin
    // xorshift32: no multiplication to overflow under Delphi's $Q+.
    X := X xor (X shl 13);
    X := X xor (X shr 17);
    X := X xor (X shl 5);
    Result[I] := Byte(X);
  end;
end;

procedure FixCrc(var ABatch: TBytes);
var
  C: Cardinal;
begin
  C := KafkaCrc32c(ABatch, 21, Length(ABatch) - 21);
  ABatch[17] := Byte(C shr 24);
  ABatch[18] := Byte(C shr 16);
  ABatch[19] := Byte(C shr 8);
  ABatch[20] := Byte(C);
end;

function DecodeAll(const AData: TBytes; out ATrailing: Integer): TKafkaRecordBatchArray;
begin
  Result := KafkaDecodeRecordBatches(AData, 1 shl 24, ATrailing);
end;

function DecodeOne(const AData: TBytes): TKafkaRecordBatch;
var
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
begin
  Batches := DecodeAll(AData, Trailing);
  TAssert.AssertEquals('one batch', 1, Length(Batches));
  TAssert.AssertEquals('no tail', 0, Trailing);
  Result := Batches[0];
end;

/// Five records covering what a record can hold.
function SampleBatch: TKafkaRecordBatch;
var
  R: TKafkaRecord;
begin
  Result.Init;
  R := KafkaRecord(Utf8('key'), Utf8('value'), 1000);
  KafkaAddRecordHeader(R, 'traceparent', Utf8('00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01'));
  KafkaAddRecordHeader(R, 'São', Utf8('Paulo'));
  KafkaAddRecordHeader(R, 'nothing', nil, True);
  KafkaAddRecordHeader(R, 'empty', nil, False);
  Result.Append(R);
  // Null key, empty value (not null).
  R := KafkaRecord(nil, nil, 900);
  R.KeyIsNull := True;
  Result.Append(R);
  // Empty key, null value (a tombstone).
  R := KafkaRecord(nil, nil, 2500);
  R.ValueIsNull := True;
  Result.Append(R);
  // A value over the one-byte varint lengths, and over a few KB.
  Result.Append(KafkaRecord(Utf8('big'), Pseudorandom(70000), 2000));
  Result.Append(KafkaRecord(Utf8('last'), Utf8('ünïcödé'), 1500));
end;

procedure CheckSameRecords(const AWhat: string; const AExpected, AActual: TKafkaRecordBatch);
var
  I, K: Integer;
  E, A: TKafkaRecord;
begin
  TAssert.AssertEquals(AWhat + ' count', Length(AExpected.Records), Length(AActual.Records));
  for I := 0 to High(AExpected.Records) do
  begin
    E := AExpected.Records[I];
    A := AActual.Records[I];
    TAssert.AssertEquals(AWhat + ' key null', E.KeyIsNull, A.KeyIsNull);
    TAssert.AssertEquals(AWhat + ' key', BytesToHex(E.Key), BytesToHex(A.Key));
    TAssert.AssertEquals(AWhat + ' value null', E.ValueIsNull, A.ValueIsNull);
    TAssert.AssertTrue(AWhat + ' value', SameBytes(E.Value, A.Value));
    TAssert.AssertEquals(AWhat + ' offset', E.Offset, A.Offset);
    TAssert.AssertEquals(AWhat + ' timestamp', E.Timestamp, A.Timestamp);
    TAssert.AssertEquals(AWhat + ' headers', Length(E.Headers), Length(A.Headers));
    for K := 0 to High(E.Headers) do
    begin
      TAssert.AssertEquals(E.Headers[K].Key, A.Headers[K].Key);
      TAssert.AssertEquals(E.Headers[K].ValueIsNull, A.Headers[K].ValueIsNull);
      TAssert.AssertEquals(BytesToHex(E.Headers[K].Value), BytesToHex(A.Headers[K].Value));
    end;
  end;
end;

