procedure TKafkaRecordBatchTests.Crc32_KnownVectors;
var
  Check: TBytes;
begin
  Check := Utf8('123456789');
  TAssert.AssertEquals('CBF43926', IntToHex(KafkaCrc32(Check, 0, Length(Check)), 8));
  TAssert.AssertEquals('00000000', IntToHex(KafkaCrc32(nil, 0, 0), 8));
  Check := Utf8('The quick brown fox jumps over the lazy dog');
  TAssert.AssertEquals('414FA339', IntToHex(KafkaCrc32(Check, 0, Length(Check)), 8));
end;

procedure TKafkaRecordBatchTests.Gzip_RoundTrip_SeveralSizes;
const
  SIZES: array[0..4] of Integer = (0, 1, 1000, 65536, 300000);
var
  I: Integer;
  Data, Zipped: TBytes;
begin
  for I := Low(SIZES) to High(SIZES) do
  begin
    Data := Pseudorandom(SIZES[I]);
    Zipped := KafkaGzipCompress(Data);
    TAssert.AssertEquals('magic', '1f8b08', BytesToHex(Copy(Zipped, 0, 3)));
    TAssert.AssertTrue(IntToStr(SIZES[I]) + ' bytes',
      SameBytes(Data, KafkaGzipDecompress(Zipped, SIZES[I])));
  end;
  // Text compresses: the codec does something.
  Data := Utf8(StringOfChar('a', 10000));
  TAssert.AssertTrue(Length(KafkaGzipCompress(Data)) < 200);
end;

procedure TKafkaRecordBatchTests.Gzip_ReadsPythonsMembers;
begin
  TAssert.AssertEquals('hello kafka', Text(KafkaGzipDecompress(HexToBytes(GZ_PLAIN), 100)));
  TAssert.AssertEquals('olá, gzip with a file name',
    Text(KafkaGzipDecompress(HexToBytes(GZ_NAMED), 100)));
  TAssert.AssertEquals('hello kafka', Text(KafkaGzipDecompress(HexToBytes(GZ_ALL_FLAGS), 100)));
end;

procedure TKafkaRecordBatchTests.Gzip_TwoMembers_AreRefused;
begin
  FData := HexToBytes(GZ_TWO_MEMBERS);
  FMax := 100;
  TAssert.AssertException(EKafkaCompression, GunzipData);
end;

procedure TKafkaRecordBatchTests.Gzip_WrongTrailer_IsRefused;
begin
  FData := HexToBytes(GZ_PLAIN);
  FMax := 100;
  FData[Length(FData) - 6] := FData[Length(FData) - 6] xor 1; // a CRC byte
  TAssert.AssertException(EKafkaCompression, GunzipData);
  FData := HexToBytes(GZ_PLAIN);
  FData[Length(FData) - 4] := 12; // ISIZE 12 instead of 11
  TAssert.AssertException(EKafkaCompression, GunzipData);
end;

procedure TKafkaRecordBatchTests.Gzip_CutShort_IsRefused;
var
  Whole: TBytes;
  N: Integer;
begin
  Whole := KafkaGzipCompress(Pseudorandom(5000));
  FMax := 10000;
  for N := 0 to 30 do
  begin
    FData := Copy(Whole, 0, Length(Whole) - 1 - N * 37);
    TAssert.AssertException(EKafkaCompression, GunzipData);
  end;
end;

procedure TKafkaRecordBatchTests.Gzip_ZlibData_IsRefused;
begin
  FData := HexToBytes(ZLIB_DATA);
  FMax := 100;
  TAssert.AssertException(EKafkaCompression, GunzipData);
end;

procedure TKafkaRecordBatchTests.Gzip_LargerThanTheLimit_IsRefused;
var
  Zeros: TBytes;
begin
  Zeros := nil;
  SetLength(Zeros, 1000000);
  FillChar(Zeros[0], Length(Zeros), 0);
  FData := KafkaGzipCompress(Zeros);
  TAssert.AssertTrue('a megabyte of zeros is small', Length(FData) < 5000);
  FMax := 999999;
  TAssert.AssertException(EKafkaCompression, GunzipData);
  FMax := 1000000;
  GunzipData;
end;

procedure TKafkaRecordBatchTests.Compression_Zstd_IsReadButNotWritten;
var
  Codec: TKafkaCompression;
begin
  FData := Utf8('x');
  FCodec := kcZstd;
  TAssert.AssertFalse(KafkaCompressionName(FCodec), KafkaCompressionSupported(FCodec));
  TAssert.AssertTrue(KafkaCompressionName(FCodec), KafkaDecompressionSupported(FCodec));
  TAssert.AssertException(EKafkaCompression, CompressData);
  for Codec := kcNone to kcLz4 do
  begin
    TAssert.AssertTrue(KafkaCompressionName(Codec), KafkaCompressionSupported(Codec));
    TAssert.AssertTrue(KafkaCompressionName(Codec), KafkaDecompressionSupported(Codec));
  end;
  TAssert.AssertEquals('zstd', KafkaCompressionName(kcZstd));
  TAssert.AssertEquals(Ord(kcLz4), Ord(KafkaCompressionFromAttributes($0013)));
  TAssert.AssertException(EKafkaCompression, CodecFromBits5);
end;

procedure TKafkaRecordBatchTests.RecordBatch_EncodeThenDecode_GivesTheRecordsBack;
var
  Batch, Back: TKafkaRecordBatch;
begin
  Batch := SampleBatch;
  TAssert.AssertEquals(Int64(1000), Batch.BaseTimestamp);
  TAssert.AssertEquals('the largest, not the last', Int64(2500), Batch.MaxTimestamp);
  TAssert.AssertEquals(Int64(-100), Batch.Records[1].TimestampDelta);
  TAssert.AssertEquals(4, Batch.LastOffsetDelta);
  Back := DecodeOne(Batch.Encode);
  CheckSameRecords('none', Batch, Back);
  TAssert.AssertEquals(Int64(KAFKA_NO_PRODUCER_ID), Back.ProducerId);
  TAssert.AssertEquals(Integer(KAFKA_NO_PRODUCER_EPOCH), Integer(Back.ProducerEpoch));
  TAssert.AssertEquals(KAFKA_NO_SEQUENCE, Back.BaseSequence);
  TAssert.AssertEquals(KAFKA_NO_PARTITION_LEADER_EPOCH, Back.PartitionLeaderEpoch);
  TAssert.AssertEquals(Int64(5), Back.NextOffset);
  TAssert.AssertEquals('São', Back.Records[0].Headers[1].Key);
  TAssert.AssertEquals('ünïcödé', Text(Back.Records[4].Value));
  // Offsets follow BaseOffset.
  Batch.BaseOffset := 1000;
  Back := DecodeOne(Batch.Encode);
  TAssert.AssertEquals(Int64(1003), Back.Records[3].Offset);
  TAssert.AssertEquals(Int64(1005), Back.NextOffset);
end;

procedure TKafkaRecordBatchTests.RecordBatch_Gzip_EncodeThenDecode;
var
  Batch, Back: TKafkaRecordBatch;
  Plain, Zipped: TBytes;
begin
  Batch := SampleBatch;
  Plain := Batch.Encode;
  Batch.SetCompression(kcGzip);
  Zipped := Batch.Encode;
  Back := DecodeOne(Zipped);
  TAssert.AssertEquals(Ord(kcGzip), Ord(Back.Compression));
  CheckSameRecords('gzip', Batch, Back);
  // The 70 000 pseudo-random bytes don't shrink; the rest does, a little.
  TAssert.AssertTrue(Length(Zipped) < Length(Plain) + 100);
  // The record count sits outside the compressed part.
  TAssert.AssertEquals('00000005', BytesToHex(Copy(Zipped, 57, 4)));
end;

procedure TKafkaRecordBatchTests.RecordBatch_DecodeThenEncode_GivesTheBrokersBytesBack;
var
  Records: TBytes;
  Batches: TKafkaRecordBatchArray;
  Trailing, I, P, Size: Integer;
begin
  Records := FetchRecords('fetch-v18');
  Batches := DecodeAll(Records, Trailing);
  TAssert.AssertEquals(11, Length(Batches));
  P := 0;
  for I := 0 to High(Batches) do
  begin
    // batchLength (offset 8) plus the 12 bytes before it.
    Size := ((Records[P + 8] shl 24) or (Records[P + 9] shl 16) or (Records[P + 10] shl 8) or
      Records[P + 11]) + 12;
    // The gzip one (Produce v13's) is compressed again by this library's
    // zlib, not Python's: its records were compared in Kafka.ProduceFetchTests.
    if Batches[I].Compression = kcNone then
      TAssert.AssertEquals('batch ' + IntToStr(I), BytesToHex(Copy(Records, P, Size)),
        BytesToHex(Batches[I].Encode));
    // The broker set the leader epoch; it travels with the batch.
    TAssert.AssertEquals(0, Batches[I].PartitionLeaderEpoch);
    Inc(P, Size);
  end;
  TAssert.AssertEquals(Length(Records), P);
end;

procedure TKafkaRecordBatchTests.RecordBatch_AttributeBits;
var
  Batch, Back: TKafkaRecordBatch;
begin
  Batch.Init;
  Batch.Append(KafkaRecord(nil, Utf8('v'), 1));
  Batch.Attributes := KAFKA_BATCH_ATTR_TRANSACTIONAL or KAFKA_BATCH_ATTR_CONTROL;
  Batch.SetCompression(kcGzip);
  TAssert.AssertEquals(Integer($31), Integer(Batch.Attributes));
  Back := DecodeOne(Batch.Encode);
  TAssert.AssertTrue(Back.IsTransactional);
  TAssert.AssertTrue(Back.IsControl);
  TAssert.AssertFalse(Back.IsLogAppendTime);
  TAssert.AssertFalse(Back.HasDeleteHorizon);
  TAssert.AssertEquals(Ord(kcGzip), Ord(Back.Compression));
  Back.SetCompression(kcNone);
  TAssert.AssertEquals(Integer($30), Integer(Back.Attributes));
end;

procedure TKafkaRecordBatchTests.RecordBatch_LogAppendTime_EveryRecordHasTheMaxTimestamp;
var
  Batch, Back: TKafkaRecordBatch;
  I: Integer;
begin
  Batch := SampleBatch;
  Batch.Attributes := KAFKA_BATCH_ATTR_LOG_APPEND_TIME;
  Batch.MaxTimestamp := 777777;
  Back := DecodeOne(Batch.Encode);
  TAssert.AssertTrue(Back.IsLogAppendTime);
  for I := 0 to High(Back.Records) do
    TAssert.AssertEquals(Int64(777777), Back.Records[I].Timestamp);
end;

procedure TKafkaRecordBatchTests.RecordBatch_CorruptByte_FailsTheCrc;
var
  Good: TBytes;
  Positions: array[0..2] of Integer;
  I, P: Integer;
begin
  Good := SampleBatch.Encode;
  // One byte in the header after the CRC, one in a record, the last one.
  Positions[0] := 22;
  Positions[1] := 100;
  Positions[2] := Length(Good) - 1;
  for I := 0 to 2 do
  begin
    P := Positions[I];
    FData := Copy(Good, 0, Length(Good));
    FData[P] := FData[P] xor $40;
    TAssert.AssertException('byte ' + IntToStr(P), EKafkaProtocol, DecodeData);
  end;
  // Bytes 12-15 (the leader epoch) are outside the CRC.
  FData := Copy(Good, 0, Length(Good));
  FData[13] := 7;
  DecodeData;
end;

procedure TKafkaRecordBatchTests.RecordBatch_OldMagic_IsRefused;
begin
  FData := SampleBatch.Encode;
  FData[16] := 1;
  TAssert.AssertException(EKafkaProtocol, DecodeData);
end;

procedure TKafkaRecordBatchTests.RecordBatch_CountBeyondTheBytes_IsRefused;
begin
  FData := SampleBatch.Encode;
  FData[57] := $7F; // 2 billion records, CRC made right
  FixCrc(FData);
  TAssert.AssertException(EKafkaProtocol, DecodeData);
  FData := SampleBatch.Encode;
  FData[60] := 6; // one record more than there is
  FixCrc(FData);
  TAssert.AssertException(EKafkaProtocol, DecodeData);
  FData := SampleBatch.Encode;
  FData[60] := 4; // one fewer: bytes left over
  FixCrc(FData);
  TAssert.AssertException(EKafkaProtocol, DecodeData);
end;

procedure TKafkaRecordBatchTests.RecordBatch_HeaderKeyNotUtf8_IsRefused;
var
  Batch: TKafkaRecordBatch;
  R: TKafkaRecord;
  I: Integer;
begin
  Batch.Init;
  R := KafkaRecord(nil, nil, 0);
  KafkaAddRecordHeader(R, 'QQ', nil);
  Batch.Append(R);
  FData := Batch.Encode;
  for I := 61 to Length(FData) - 2 do
    if (FData[I] = Ord('Q')) and (FData[I + 1] = Ord('Q')) then
    begin
      FData[I] := $FF; // never valid in UTF-8
      Break;
    end;
  FixCrc(FData);
  TAssert.AssertException(EKafkaProtocol, DecodeData);
end;

procedure TKafkaRecordBatchTests.RecordBatches_InARow_AndACutTail;
var
  A, B, C, All: TBytes;
  Batches: TKafkaRecordBatchArray;
  Trailing, Cut, I: Integer;
  Cuts: array[0..4] of Integer;
  Batch: TKafkaRecordBatch;
begin
  Batch := SampleBatch;
  A := Batch.Encode;
  Batch.BaseOffset := 5;
  B := Batch.Encode;
  Batch.BaseOffset := 10;
  C := Batch.Encode;
  // Inside batchLength, right after it, inside the header, inside the records.
  Cuts[0] := 1;
  Cuts[1] := 11;
  Cuts[2] := 12;
  Cuts[3] := 60;
  Cuts[4] := Length(C) - 1;
  for I := 0 to 4 do
  begin
    Cut := Cuts[I];
    All := Join([A, B, Copy(C, 0, Cut)]);
    Batches := DecodeAll(All, Trailing);
    TAssert.AssertEquals('cut at ' + IntToStr(Cut), 2, Length(Batches));
    TAssert.AssertEquals(Cut, Trailing);
    TAssert.AssertEquals(Int64(5), Batches[1].BaseOffset);
    TAssert.AssertEquals(Int64(9), Batches[1].Records[4].Offset);
  end;
  Batches := DecodeAll(Join([A, B, C]), Trailing);
  TAssert.AssertEquals(3, Length(Batches));
  TAssert.AssertEquals(0, Trailing);
  Batches := DecodeAll(nil, Trailing);
  TAssert.AssertEquals(0, Length(Batches));
end;

initialization
  RegisterTest(TKafkaRecordBatchTests);

end.
