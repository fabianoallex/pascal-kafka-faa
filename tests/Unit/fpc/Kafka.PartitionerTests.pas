interface

uses
  fpcunit, testregistry,
  SysUtils,
  Kafka.Partitioner,
  Kafka.TestPartitions,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  TKafkaPartitionerTests = class(TTestCase)
  private
    FCount: Integer;
    procedure PartitionOfAKey;
  published
    procedure Murmur2_KafkasVectors;
    procedure Murmur2_ShortKeysAndHighBytes;
    procedure PartitionForKey_IsWhatTheJavaProducerChose;
    procedure ToPositive_ClearsTheSignBit;
    procedure PartitionForKey_NoPartitions_IsRefused;
  end;

implementation

procedure TKafkaPartitionerTests.PartitionOfAKey;
begin
  KafkaPartitionForKey(Utf8('k'), FCount);
end;

procedure TKafkaPartitionerTests.Murmur2_KafkasVectors;
begin
  TAssert.AssertEquals(-973932308, KafkaMurmur2(Utf8('21')));
  TAssert.AssertEquals(-790332482, KafkaMurmur2(Utf8('foobar')));
  TAssert.AssertEquals(-985981536, KafkaMurmur2(Utf8('a-little-bit-long-string')));
  TAssert.AssertEquals(-1486304829, KafkaMurmur2(Utf8('a-little-bit-longer-string')));
  TAssert.AssertEquals(-58897971,
    KafkaMurmur2(Utf8('lkjh234lh9fiuh90y23oiuhsafujhadof229phr9h19h89h8')));
  TAssert.AssertEquals(479470107, KafkaMurmur2(Bytes([Ord('a'), Ord('b'), Ord('c')])));
end;

procedure TKafkaPartitionerTests.Murmur2_ShortKeysAndHighBytes;
begin
  TAssert.AssertEquals('empty', 275646681, KafkaMurmur2(nil));
  TAssert.AssertEquals('a', -1563381124, KafkaMurmur2(Utf8('a')));
  TAssert.AssertEquals('ab', 316155434, KafkaMurmur2(Utf8('ab')));
  TAssert.AssertEquals('abcd', -1323649548, KafkaMurmur2(Utf8('abcd')));
  TAssert.AssertEquals('ff x5', -363838622, KafkaMurmur2(HexToBytes('ffffffffff')));
  TAssert.AssertEquals('80 x7', -1845943597, KafkaMurmur2(HexToBytes('80808080808080')));
end;

procedure TKafkaPartitionerTests.PartitionForKey_IsWhatTheJavaProducerChose;
var
  I: Integer;
  Key: TBytes;
  E: TKafkaJavaPartition;
begin
  TAssert.AssertEquals(70, KAFKA_JAVA_PARTITION_COUNT);
  for I := 0 to KAFKA_JAVA_PARTITION_COUNT - 1 do
  begin
    E := KAFKA_JAVA_PARTITIONS[I];
    Key := HexToBytes(E.KeyHex);
    TAssert.AssertEquals(E.Label_ + ' of 1', E.Of1, KafkaPartitionForKey(Key, 1));
    TAssert.AssertEquals(E.Label_ + ' of 3', E.Of3, KafkaPartitionForKey(Key, 3));
    TAssert.AssertEquals(E.Label_ + ' of 12', E.Of12, KafkaPartitionForKey(Key, 12));
    TAssert.AssertEquals(E.Label_ + ' of 100', E.Of100, KafkaPartitionForKey(Key, 100));
  end;
end;

procedure TKafkaPartitionerTests.ToPositive_ClearsTheSignBit;
begin
  TAssert.AssertEquals(0, KafkaToPositive(Low(Int32)));
  TAssert.AssertEquals(High(Int32), KafkaToPositive(-1));
  TAssert.AssertEquals(5, KafkaToPositive(5));
  TAssert.AssertEquals(1, KafkaToPositive(-High(Int32)));
end;

procedure TKafkaPartitionerTests.PartitionForKey_NoPartitions_IsRefused;
begin
  FCount := 0;
  TAssert.AssertException(EArgumentException, PartitionOfAKey);
  FCount := -3;
  TAssert.AssertException(EArgumentException, PartitionOfAKey);
end;

initialization
  RegisterTest(TKafkaPartitionerTests);

end.
