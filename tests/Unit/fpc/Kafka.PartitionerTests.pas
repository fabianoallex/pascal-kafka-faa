procedure TKafkaPartitionerTests.PartitionOfAKey;
begin
  KafkaPartitionForKey(Utf8('k'), FCount);
end;

function Ints(const AValues: array of Int32): TKafkaInt32Array;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AValues));
  for I := 0 to High(AValues) do
    Result[I] := AValues[I];
end;

procedure TKafkaPartitionerTests.Sticky_KeptUntilBatchSize_ThenAnother;
var
  S: TKafkaStickyPartitioner;
  First, Second, I: Integer;
begin
  S := TKafkaStickyPartitioner.Create(100, 12345);
  try
    First := S.Partition('t', 5, nil, 30);
    // 30 + 30 + 30 = 90: still the same; 120 after the fourth.
    for I := 1 to 3 do
      TAssert.AssertEquals('record ' + IntToStr(I), First, S.Partition('t', 5, nil, 30));
    Second := S.Partition('t', 5, nil, 30);
    TAssert.AssertTrue('moved', Second <> First);
    TAssert.AssertTrue((Second >= 0) and (Second < 5));
    // A record larger than the batch size moves it at once after itself.
    TAssert.AssertEquals(Second, S.Partition('t', 5, nil, 500));
    TAssert.AssertTrue(S.Partition('t', 5, nil, 1) <> Second);
  finally
    S.Free;
  end;
end;

procedure TKafkaPartitionerTests.Sticky_OnlyPartitionsWithALeader;
var
  S: TKafkaStickyPartitioner;
  I, P: Integer;
begin
  S := TKafkaStickyPartitioner.Create(10, 777);
  try
    for I := 1 to 200 do
    begin
      P := S.Partition('t', 6, Ints([1, 4]), 10);
      TAssert.AssertTrue(IntToStr(P), (P = 1) or (P = 4));
    end;
  finally
    S.Free;
  end;
end;

procedure TKafkaPartitionerTests.Sticky_OnePartition_OrOneLeader_Stays;
var
  S: TKafkaStickyPartitioner;
  I: Integer;
begin
  S := TKafkaStickyPartitioner.Create(10, 99);
  try
    for I := 1 to 20 do
      TAssert.AssertEquals(0, S.Partition('one', 1, nil, 50));
    for I := 1 to 20 do
      TAssert.AssertEquals(2, S.Partition('led', 4, Ints([2]), 50));
  finally
    S.Free;
  end;
end;

procedure TKafkaPartitionerTests.Sticky_TopicsAreIndependent;
var
  S: TKafkaStickyPartitioner;
  A, I: Integer;
begin
  S := TKafkaStickyPartitioner.Create(100, 4242);
  try
    A := S.Partition('a', 8, nil, 60);
    // b's records don't count towards a's batch: a is at 60 + 40 = 100
    // after its second record, and moves on its third.
    for I := 1 to 10 do
      S.Partition('b', 8, nil, 60);
    TAssert.AssertEquals(A, S.Partition('a', 8, nil, 40));
    TAssert.AssertTrue(S.Partition('a', 8, nil, 1) <> A);
  finally
    S.Free;
  end;
end;

procedure TKafkaPartitionerTests.Sticky_UsesEveryPartitionOverTime;
var
  S: TKafkaStickyPartitioner;
  Seen: array[0..11] of Boolean;
  I: Integer;
begin
  S := TKafkaStickyPartitioner.Create(1, 2024);
  try
    for I := 0 to 11 do
      Seen[I] := False;
    for I := 1 to 2000 do
      Seen[S.Partition('t', 12, nil, 1)] := True;
    for I := 0 to 11 do
      TAssert.AssertTrue('partition ' + IntToStr(I), Seen[I]);
  finally
    S.Free;
  end;
end;

procedure TKafkaPartitionerTests.Murmur2_KafkasVectors;
begin
  TAssert.AssertEquals(-973932308, KafkaMurmur2(Utf8('21')));
  TAssert.AssertEquals(-790332482, KafkaMurmur2(Utf8('foobar')));
  TAssert.AssertEquals(-985981536, KafkaMurmur2(Utf8('a-little-bit-long-string')));
  TAssert.AssertEquals(-1486304829, KafkaMurmur2(Utf8('a-little-bit-longer-string')));
  TAssert.AssertEquals(-58897971,
    KafkaMurmur2(Utf8('lkjh234lh9fiuh90y23oiuhsafujhadof229phr9h19h89h8')));
  TAssert.AssertEquals(479470107, KafkaMurmur2(Bytes([Ord('a'), Ord('b'), Ord('c')])));
end;

procedure TKafkaPartitionerTests.Murmur2_ShortKeysAndHighBytes;
begin
  TAssert.AssertEquals('empty', 275646681, KafkaMurmur2(nil));
  TAssert.AssertEquals('a', -1563381124, KafkaMurmur2(Utf8('a')));
  TAssert.AssertEquals('ab', 316155434, KafkaMurmur2(Utf8('ab')));
  TAssert.AssertEquals('abcd', -1323649548, KafkaMurmur2(Utf8('abcd')));
  TAssert.AssertEquals('ff x5', -363838622, KafkaMurmur2(HexToBytes('ffffffffff')));
  TAssert.AssertEquals('80 x7', -1845943597, KafkaMurmur2(HexToBytes('80808080808080')));
end;

procedure TKafkaPartitionerTests.PartitionForKey_IsWhatTheJavaProducerChose;
var
  I: Integer;
  Key: TBytes;
  E: TKafkaJavaPartition;
begin
  TAssert.AssertEquals(70, KAFKA_JAVA_PARTITION_COUNT);
  for I := 0 to KAFKA_JAVA_PARTITION_COUNT - 1 do
  begin
    E := KAFKA_JAVA_PARTITIONS[I];
    Key := HexToBytes(E.KeyHex);
    TAssert.AssertEquals(E.Label_ + ' of 1', E.Of1, KafkaPartitionForKey(Key, 1));
    TAssert.AssertEquals(E.Label_ + ' of 3', E.Of3, KafkaPartitionForKey(Key, 3));
    TAssert.AssertEquals(E.Label_ + ' of 12', E.Of12, KafkaPartitionForKey(Key, 12));
    TAssert.AssertEquals(E.Label_ + ' of 100', E.Of100, KafkaPartitionForKey(Key, 100));
  end;
end;

procedure TKafkaPartitionerTests.ToPositive_ClearsTheSignBit;
begin
  TAssert.AssertEquals(0, KafkaToPositive(Low(Int32)));
  TAssert.AssertEquals(High(Int32), KafkaToPositive(-1));
  TAssert.AssertEquals(5, KafkaToPositive(5));
  TAssert.AssertEquals(1, KafkaToPositive(-High(Int32)));
end;

procedure TKafkaPartitionerTests.PartitionForKey_NoPartitions_IsRefused;
begin
  FCount := 0;
  TAssert.AssertException(EArgumentException, PartitionOfAKey);
  FCount := -3;
  TAssert.AssertException(EArgumentException, PartitionOfAKey);
end;

initialization
  RegisterTest(TKafkaPartitionerTests);

end.
