procedure TKafkaGroupTests.Commit_ThenCommitted;
var
  M: TKafkaConsumerProtocol;
  LOffsets: TKafkaCommittedOffsetArray;
  LGot: TKafkaCommittedOffsetArray;
begin
  StartBroker(3);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 3));
  SetLength(LOffsets, 2);
  LOffsets[0] := Offset(TOPIC, 0, 10, 'm0');
  LOffsets[1] := Offset(TOPIC, 2, 20, '');
  M.Commit(LOffsets, WAIT_MS);
  TAssert.AssertEquals(Int64(10), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  TAssert.AssertEquals(Int64(20), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 2));
  TAssert.AssertEquals('m0', FBroker.Groups.CommittedMetadata(GROUP, TOPIC, 0));
  LGot := M.Committed([KafkaTopicPartition(TOPIC, 2), KafkaTopicPartition(TOPIC, 1),
    KafkaTopicPartition(TOPIC, 0)], WAIT_MS);
  TAssert.AssertEquals(3, Length(LGot));
  TAssert.AssertEquals(Int64(20), LGot[0].Offset);
  TAssert.AssertEquals(Int64(-1), LGot[1].Offset);
  TAssert.AssertEquals(Int64(10), LGot[2].Offset);
  TAssert.AssertEquals('m0', LGot[2].Metadata);
  TAssert.AssertEquals(1, FBroker.Groups.CommitCount);
  TAssert.AssertEquals(1, FBroker.Groups.OffsetFetchCount);
end;

procedure TKafkaGroupTests.Commit_RetriesLoadInProgressAndStaleEpoch;
var
  M: TKafkaConsumerProtocol;
  LOffsets: TKafkaCommittedOffsetArray;
begin
  StartBroker(1);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 1));
  SetLength(LOffsets, 1);
  LOffsets[0] := Offset(TOPIC, 0, 7, '');
  FBroker.Groups.CommitErrorCode := KAFKA_ERROR_COORDINATOR_LOAD_IN_PROGRESS;
  FBroker.Groups.CommitErrors := 1;
  M.Commit(LOffsets, WAIT_MS);
  TAssert.AssertEquals(2, FBroker.Groups.CommitCount);
  TAssert.AssertEquals(Int64(7), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  LOffsets[0].Offset := 8;
  FBroker.Groups.CommitErrorCode := KAFKA_ERROR_STALE_MEMBER_EPOCH;
  FBroker.Groups.CommitErrors := 1;
  M.Commit(LOffsets, WAIT_MS);
  TAssert.AssertEquals(4, FBroker.Groups.CommitCount);
  TAssert.AssertEquals(Int64(8), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
end;

procedure TKafkaGroupTests.Commit_UnknownMember_RaisesAtOnce;
var
  M: TKafkaConsumerProtocol;
  LOffsets: TKafkaCommittedOffsetArray;
  LCode: Integer;
begin
  StartBroker(1);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 1));
  SetLength(LOffsets, 1);
  LOffsets[0] := Offset(TOPIC, 0, 7, '');
  FBroker.Groups.CommitErrorCode := KAFKA_ERROR_UNKNOWN_MEMBER_ID;
  FBroker.Groups.CommitErrors := 1;
  LCode := 0;
  try
    M.Commit(LOffsets, WAIT_MS);
  except
    on E: EKafkaBrokerError do
      LCode := E.ErrorCode;
  end;
  TAssert.AssertEquals(KAFKA_ERROR_UNKNOWN_MEMBER_ID, LCode);
  TAssert.AssertEquals(1, FBroker.Groups.CommitCount);
  TAssert.AssertEquals(Int64(-1), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
end;

procedure TKafkaGroupTests.Committed_NotCoordinator_LooksUpAgain;
var
  M: TKafkaConsumerProtocol;
  LLookups: Integer;
  LGot: TKafkaCommittedOffsetArray;
begin
  StartBroker(1);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 1));
  FBroker.Groups.SetCommitted(GROUP, TOPIC, 0, 42);
  LLookups := FBroker.FindCoordinatorCount;
  FBroker.Groups.OffsetFetchErrorCode := KAFKA_ERROR_NOT_COORDINATOR;
  FBroker.Groups.OffsetFetchErrors := 1;
  LGot := M.Committed([KafkaTopicPartition(TOPIC, 0)], WAIT_MS);
