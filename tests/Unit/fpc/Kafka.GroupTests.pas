const
  TOPIC = 'orders';
  GROUP = 'billing';
  WAIT_MS = 10000;

function Remaining(ADeadline: UInt64): Cardinal;
var
  LNow: UInt64;
begin
  LNow := PcTickMs;
  if LNow >= ADeadline then
    Result := 0
  else
    Result := Cardinal(ADeadline - LNow);
end;

function Offset(const ATopic: string; APartition: Int32; AOffset: Int64;
  const AMetadata: string): TKafkaCommittedOffset;
begin
  Result.Topic := ATopic;
  Result.Partition := APartition;
  Result.Offset := AOffset;
  Result.LeaderEpoch := -1;
  Result.Metadata := AMetadata;
end;

/// 'orders-0,orders-2', sorted.
function PartitionsText(const A: TKafkaTopicPartitionArray): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Sorted := True;
    for I := 0 to High(A) do
      L.Add(A[I].Topic + '-' + IntToStr(A[I].Partition));
    Result := '';
    for I := 0 to L.Count - 1 do
    begin
      if I > 0 then
        Result := Result + ',';
      Result := Result + L[I];
    end;
  finally
    L.Free;
  end;
end;

function Joined(const A, B: TKafkaTopicPartitionArray): TKafkaTopicPartitionArray;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(A) + Length(B));
  for I := 0 to High(A) do
    Result[I] := A[I];
  for I := 0 to High(B) do
    Result[Length(A) + I] := B[I];
end;

{ TKafkaGroupTests }

procedure TKafkaGroupTests.Setup;
var
  I: Integer;
  K: TKafkaGroupEventKind;
begin
  FBrokers := nil;
  FBroker := nil;
  FTestThread := TThread.CurrentThread.ThreadID;
  FWrongThread := False;
  for I := 0 to 1 do
  begin
    FClusters[I] := nil;
    FMembers[I] := nil;
    FMemberRefs[I] := nil;
    FSignals[I] := TKafkaEventSignal.Create;
    FSignalRefs[I] := FSignals[I];
    for K := Low(TKafkaGroupEventKind) to High(TKafkaGroupEventKind) do
    begin
      FCounts[I][K] := 0;
      FLast[I, K] := nil;
    end;
    FErrorClass[I] := '';
    FErrorCode[I] := 0;
  end;
end;

procedure TKafkaGroupTests.TearDown;
var
  I: Integer;
begin
  for I := 0 to 1 do
  begin
    FMembers[I] := nil;
    FMemberRefs[I] := nil; // frees it: Close joins its thread
  end;
  for I := 0 to 1 do
    FreeAndNil(FClusters[I]);
  for I := 0 to 1 do
  begin
    FSignals[I] := nil;
    FSignalRefs[I] := nil;
  end;
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
  FBroker := nil;
end;

procedure TKafkaGroupTests.StartBroker(APartitions: Integer);
var
  LLeaders: array of Int32;
  I: Integer;
begin
  SetLength(FBrokers, 1);
  FBrokers[0] := TKafkaFakeBroker.Create;
  FBroker := FBrokers[0];
  SetLength(LLeaders, APartitions);
  for I := 0 to APartitions - 1 do
    LLeaders[I] := 1;
  FView := KafkaFakeClusterView(FBrokers, TOPIC, LLeaders);
  KafkaFakeUseView(FBrokers, FView);
end;

function TKafkaGroupTests.OpenCluster(AWhich: Integer): TKafkaCluster;
var
  P: TKafkaClusterParams;
begin
  P := KafkaClusterParams('127.0.0.1:' + IntToStr(FBroker.Port));
  P.Connection.ClientId := 'group-test';
  P.Connection.ConnectTimeoutMs := 2000;
  P.Connection.RequestTimeoutMs := 5000;
  P.MaxBlockMs := 5000;
  P.RetryBackoffMs := 20;
  P.AllowAutoTopicCreation := False;
  FClusters[AWhich] := TKafkaCluster.Create(P);
  FClusters[AWhich].Open;
  Result := FClusters[AWhich];
end;

function TKafkaGroupTests.Join(AWhich: Integer): TKafkaConsumerProtocol;
var
  P: TKafkaConsumerProtocolParams;
begin
  if FClusters[AWhich] = nil then
    OpenCluster(AWhich);
  P := KafkaConsumerProtocolParams(GROUP);
  P.RetryBackoffMs := 20;
  P.RetryBackoffMaxMs := 80;
  P.Notify := FSignalRefs[AWhich];
  FMembers[AWhich] := TKafkaConsumerProtocol.Create(FClusters[AWhich], P);
  FMemberRefs[AWhich] := FMembers[AWhich];
  FMembers[AWhich].Subscribe([TOPIC]);
  Result := FMembers[AWhich];
end;

function TKafkaGroupTests.Coordinator: TKafkaGroupCoordinator;
begin
  if FClusters[0] = nil then
    OpenCluster(0);
  Result := TKafkaGroupCoordinator.Create(FClusters[0], GROUP, 20, 80);
end;

procedure TKafkaGroupTests.Note(AWhich: Integer; AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
begin
  if TThread.CurrentThread.ThreadID <> FTestThread then
    FWrongThread := True;
  Inc(FCounts[AWhich][AKind]);
  FLast[AWhich, AKind] := APartitions;
end;

procedure TKafkaGroupTests.HandleA(AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Note(0, AKind, APartitions);
end;

procedure TKafkaGroupTests.HandleB(AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Note(1, AKind, APartitions);
end;

procedure TKafkaGroupTests.DoPoll(AWhich: Integer);
begin
  try
    if AWhich = 0 then
      FMembers[0].Poll(HandleA)
    else
      FMembers[1].Poll(HandleB);
  except
    on E: EKafkaBrokerError do
    begin
      FErrorClass[AWhich] := E.ClassName;
      FErrorCode[AWhich] := E.ErrorCode;
    end;
    on E: Exception do
      FErrorClass[AWhich] := E.ClassName;
  end;
end;

function TKafkaGroupTests.PollUntilOwned(AWhich, ACount: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + WAIT_MS;
  while True do
  begin
    DoPoll(AWhich);
    if Length(FMembers[AWhich].Assignment) = ACount then
      Exit(FBroker.Groups.WaitMemberOwns(GROUP, FMembers[AWhich].MemberId, ACount,
        Remaining(LDeadline)));
    if PcTickMs >= LDeadline then
      Exit(False);
    FSignals[AWhich].WaitFor(Remaining(LDeadline));
  end;
end;

function TKafkaGroupTests.PollUntilEvents(AWhich: Integer; AKind: TKafkaGroupEventKind;
  ACount: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + WAIT_MS;
  while True do
  begin
    DoPoll(AWhich);
    if FCounts[AWhich][AKind] >= ACount then
      Exit(True);
    if PcTickMs >= LDeadline then
      Exit(False);
    FSignals[AWhich].WaitFor(Remaining(LDeadline));
  end;
end;

function TKafkaGroupTests.PollUntilError(AWhich: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + WAIT_MS;
  while True do
  begin
    DoPoll(AWhich);
    if FErrorClass[AWhich] <> '' then
      Exit(True);
    if PcTickMs >= LDeadline then
      Exit(False);
    FSignals[AWhich].WaitFor(Remaining(LDeadline));
  end;
end;

{ The fake broker }

procedure TKafkaGroupTests.FakeBroker_ServesTwoConnectionsAtOnce;
var
  C1, C2: TKafkaConnection;
  R: TKafkaMetadataRequest;
  LAnswer: TKafkaMetadataResponse;
begin
  StartBroker(1);
  C1 := TKafkaConnection.Create(KafkaConnectionParams('127.0.0.1', FBroker.Port));
  C2 := TKafkaConnection.Create(KafkaConnectionParams('127.0.0.1', FBroker.Port));
  try
    C1.Open;
    C2.Open; // one connection at a time: this would wait for C1 to close
    R.Init;
    SetLength(R.Topics, 1);
    R.Topics[0].Init;
    R.Topics[0].Name := TOPIC;
    LAnswer := C2.Metadata(R);
    TAssert.AssertEquals(TOPIC, LAnswer.Topics[0].Name);
    LAnswer := C1.Metadata(R);
    TAssert.AssertEquals(TOPIC, LAnswer.Topics[0].Name);
    TAssert.AssertEquals(2, FBroker.LiveConnectionCount);
  finally
    C1.Free;
    C2.Free;
  end;
end;

{ The coordinator }

procedure TKafkaGroupTests.Coordinator_ListForm_OwnConnection;
var
  C: TKafkaGroupCoordinator;
  LConn, LAgain: IKafkaBrokerConnection;
  LWait: Cardinal;
begin
  StartBroker(1);
  C := Coordinator;
  try
    LConn := C.Connection(WAIT_MS);
    TAssert.AssertEquals(1, LConn.NodeId);
    TAssert.AssertEquals(1, FBroker.FindCoordinatorCount);
    TAssert.AssertEquals(6, Integer(FBroker.LastFindCoordinatorVersion));
    TAssert.AssertEquals(6, Integer(C.LastVersion));
    TAssert.AssertEquals(1, C.NodeId);
    // Known: no second lookup.
    TAssert.AssertTrue(C.TryConnection(LAgain, LWait));
    TAssert.AssertTrue('the same connection', LAgain.Connection = LConn.Connection);
    TAssert.AssertEquals(1, FBroker.FindCoordinatorCount);
    // Not the connection fetches use.
    TAssert.AssertTrue('a connection of its own',
      FClusters[0].Broker(1).Connection <> LConn.Connection);
  finally
    C.Free;
  end;
end;

procedure TKafkaGroupTests.Coordinator_OldBroker_SingleKeyForm;
var
  C: TKafkaGroupCoordinator;
begin
  StartBroker(1);
  FBroker.FindCoordinatorMax := 3;
  C := Coordinator;
  try
    TAssert.AssertEquals(1, C.Connection(WAIT_MS).NodeId);
    TAssert.AssertEquals(3, Integer(FBroker.LastFindCoordinatorVersion));
  finally
    C.Free;
  end;
end;

procedure TKafkaGroupTests.Coordinator_NotAvailable_RetriedWithBackoff;
var
  C: TKafkaGroupCoordinator;
  LStart, LElapsed: UInt64;
begin
  StartBroker(1);
  FBroker.FindCoordinatorErrorCode := KAFKA_ERROR_COORDINATOR_NOT_AVAILABLE;
  FBroker.FindCoordinatorErrors := 3;
  C := Coordinator;
  try
    LStart := PcTickMs;
    TAssert.AssertEquals(1, C.Connection(WAIT_MS).NodeId);
    LElapsed := PcTickMs - LStart;
    TAssert.AssertEquals(4, FBroker.FindCoordinatorCount);
    TAssert.AssertEquals(4, C.LookupCount);
    // 20 ms doubled per failure up to 80, -20% at worst: 32 + 64 + 64.
    TAssert.AssertTrue(Format('the backoff grew (%d ms)', [LElapsed]), LElapsed >= 150);
  finally
    C.Free;
  end;
end;

procedure TKafkaGroupTests.Coordinator_MarkUnknown_LooksUpAgain;
var
  C: TKafkaGroupCoordinator;
begin
  StartBroker(1);
  C := Coordinator;
  try
    C.Connection(WAIT_MS);
    C.MarkUnknown('a test');
    TAssert.AssertFalse(C.IsKnown);
    TAssert.AssertEquals(-1, C.NodeId);
    C.Connection(WAIT_MS);
    TAssert.AssertEquals(2, FBroker.FindCoordinatorCount);
    TAssert.AssertTrue(C.IsKnown);
  finally
    C.Free;
  end;
end;

procedure TKafkaGroupTests.Coordinator_GroupAuthorizationFailed_RaisesAtOnce;
var
  C: TKafkaGroupCoordinator;
  LCode: Integer;
begin
  StartBroker(1);
  FBroker.FindCoordinatorErrorCode := KAFKA_ERROR_GROUP_AUTHORIZATION_FAILED;
  FBroker.FindCoordinatorErrors := 100;
  C := Coordinator;
  try
    LCode := 0;
    try
      C.Connection(WAIT_MS);
    except
      on E: EKafkaBrokerError do
        LCode := E.ErrorCode;
    end;
    TAssert.AssertEquals(KAFKA_ERROR_GROUP_AUTHORIZATION_FAILED, LCode);
    TAssert.AssertEquals(1, FBroker.FindCoordinatorCount);
  finally
    C.Free;
  end;
end;

procedure TKafkaGroupTests.Coordinator_NeverFound_TimesOut;
var
  C: TKafkaGroupCoordinator;
  LRaised: string;
begin
  StartBroker(1);
  FBroker.FindCoordinatorErrorCode := KAFKA_ERROR_COORDINATOR_NOT_AVAILABLE;
  FBroker.FindCoordinatorErrors := 100000;
  C := Coordinator;
  try
    LRaised := '';
    try
      C.Connection(300);
    except
      on E: Exception do
        LRaised := E.ClassName;
    end;
    TAssert.AssertEquals('EKafkaTimeout', LRaised);
    TAssert.AssertTrue(FBroker.FindCoordinatorCount >= 2);
  finally
    C.Free;
  end;
end;

{ The membership }

procedure TKafkaGroupTests.Join_LoneMemberGetsEveryPartition;
var
  M: TKafkaConsumerProtocol;
begin
  StartBroker(3);
  M := Join(0);
  TAssert.AssertEquals(22, Length(M.MemberId));
  TAssert.AssertTrue(PollUntilOwned(0, 3));
  TAssert.AssertEquals(1, FCounts[0][kgeAssigned]);
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(FLast[0, kgeAssigned]));
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(M.Assignment));
  TAssert.AssertFalse('events on the caller''s thread', FWrongThread);
  TAssert.AssertTrue(M.MemberEpoch > 0);
  TAssert.AssertEquals(M.MemberEpoch, FBroker.Groups.MemberEpoch(GROUP, M.MemberId));
  TAssert.AssertEquals(1, FBroker.Groups.MemberCount(GROUP));
  TAssert.AssertEquals(1, FBroker.Groups.JoinCount);
  TAssert.AssertTrue(M.State in [kmsStable, kmsAcknowledging]);
end;

procedure TKafkaGroupTests.Heartbeat_SendsOnlyWhatChanged;
var
  M: TKafkaConsumerProtocol;
  LJoin, LLast: TKafkaConsumerGroupHeartbeatRequest;
  N: Integer;
begin
  StartBroker(2);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  N := FBroker.Groups.MemberHeartbeats(GROUP, M.MemberId);
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, M.MemberId, N + 2, WAIT_MS));
  TAssert.AssertTrue(FBroker.Groups.MemberRequests(GROUP, M.MemberId, LJoin, LLast));
  // Joining: everything.
  TAssert.AssertEquals(0, LJoin.MemberEpoch);
  TAssert.AssertEquals(M.MemberId, LJoin.MemberId);
  TAssert.AssertFalse(LJoin.SubscribedTopicNamesIsNull);
  TAssert.AssertEquals(1, Length(LJoin.SubscribedTopicNames));
  TAssert.AssertEquals(TOPIC, LJoin.SubscribedTopicNames[0]);
  TAssert.AssertEquals(KAFKA_DEFAULT_MAX_POLL_INTERVAL_MS, LJoin.RebalanceTimeoutMs);
  TAssert.AssertFalse(LJoin.TopicPartitionsIsNull);
  TAssert.AssertEquals(0, Length(LJoin.TopicPartitions));
  TAssert.AssertTrue(LJoin.ServerAssignorIsNull);
  TAssert.AssertTrue(LJoin.RackIdIsNull);
  // Later: only the epoch, nothing that didn't change.
  TAssert.AssertEquals(M.MemberEpoch, LLast.MemberEpoch);
  TAssert.AssertTrue(LLast.SubscribedTopicNamesIsNull);
  TAssert.AssertEquals(-1, LLast.RebalanceTimeoutMs);
  TAssert.AssertTrue(LLast.TopicPartitionsIsNull);
end;

procedure TKafkaGroupTests.Heartbeat_AtTheCoordinatorsInterval;
var
  M: TKafkaConsumerProtocol;
  N: Integer;
  LStart, LElapsed: UInt64;
begin
  StartBroker(1);
  FBroker.Groups.HeartbeatIntervalMs := 150;
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 1));
  TAssert.AssertEquals(150, Integer(M.HeartbeatIntervalMs));
  N := FBroker.Groups.MemberHeartbeats(GROUP, M.MemberId);
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, M.MemberId, N + 1, WAIT_MS));
  LStart := PcTickMs;
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, M.MemberId, N + 4, WAIT_MS));
  LElapsed := PcTickMs - LStart;
  // Three intervals; a Windows timer tick (15.6 ms) of slack.
  TAssert.AssertTrue(Format('three intervals took %d ms', [LElapsed]), LElapsed >= 3 * 150 - 20);
end;

procedure TKafkaGroupTests.TwoMembers_PartitionsMoveOnlyAfterTheRevoke;
var
  A, B: TKafkaConsumerProtocol;
  NA, NB: Integer;
begin
  StartBroker(4);
  A := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 4));
  B := Join(1);
  TAssert.AssertTrue(FBroker.Groups.WaitMemberCount(GROUP, 2, WAIT_MS));
  // A hears of the new target, B heartbeats on: while A hasn't handled
  // the revoke (no Poll), B is given nothing.
  NA := FBroker.Groups.MemberHeartbeats(GROUP, A.MemberId);
  NB := FBroker.Groups.MemberHeartbeats(GROUP, B.MemberId);
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, A.MemberId, NA + 2, WAIT_MS));
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, B.MemberId, NB + 2, WAIT_MS));
  TAssert.AssertEquals(2, Length(FBroker.Groups.MemberGiven(GROUP, A.MemberId)));
  TAssert.AssertEquals(4, Length(FBroker.Groups.MemberOwned(GROUP, A.MemberId)));
  TAssert.AssertEquals(0, Length(FBroker.Groups.MemberGiven(GROUP, B.MemberId)));
  DoPoll(1);
  TAssert.AssertEquals(0, Length(B.Assignment));
  // A handles the revoke; then B gets what A let go.
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  TAssert.AssertEquals(1, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals(2, Length(FLast[0, kgeRevoked]));
  TAssert.AssertTrue(PollUntilOwned(1, 2));
  TAssert.AssertEquals(PartitionsText(FLast[0, kgeRevoked]), PartitionsText(B.Assignment));
  TAssert.AssertEquals('orders-0,orders-1,orders-2,orders-3',
    PartitionsText(Joined(A.Assignment, B.Assignment)));
  TAssert.AssertEquals(0, FCounts[0][kgeLost]);
  TAssert.AssertFalse(FWrongThread);
end;

procedure TKafkaGroupTests.PassiveMemberLeaves_PartitionsComeBack;
var
  A: TKafkaConsumerProtocol;
begin
  StartBroker(4);
  A := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 4));
  FBroker.Groups.AddMember(GROUP, 'passive', [TOPIC], FView);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  TAssert.AssertEquals(2, Length(FBroker.Groups.MemberOwned(GROUP, 'passive')));
  FBroker.Groups.RemoveMember(GROUP, 'passive', FView);
  TAssert.AssertTrue(PollUntilOwned(0, 4));
  // Joining, the revoke's reconciliation (nothing new: an empty list), and
  // the two partitions back.
  TAssert.AssertEquals(3, FCounts[0][kgeAssigned]);
  TAssert.AssertEquals(1, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals(2, Length(FLast[0, kgeAssigned]));
  TAssert.AssertEquals('orders-0,orders-1,orders-2,orders-3', PartitionsText(A.Assignment));
end;

procedure TKafkaGroupTests.Fenced_LosesThePartitionsAndJoinsAgain;
var
  M: TKafkaConsumerProtocol;
  LId: string;
begin
  StartBroker(3);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 3));
  LId := M.MemberId;
  FBroker.Groups.FenceNext := 1;
  TAssert.AssertTrue(PollUntilEvents(0, kgeLost, 1));
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(FLast[0, kgeLost]));
  TAssert.AssertTrue(PollUntilOwned(0, 3));
  TAssert.AssertEquals(LId, M.MemberId);
  TAssert.AssertEquals(2, FBroker.Groups.JoinCount);
  TAssert.AssertEquals(2, FCounts[0][kgeAssigned]);
  TAssert.AssertEquals(0, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals('', FErrorClass[0]);
end;

procedure TKafkaGroupTests.UnknownMember_LosesThePartitionsAndJoinsAgain;
var
  M: TKafkaConsumerProtocol;
begin
  StartBroker(2);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  // Its session expired, as far as the coordinator knows.
  FBroker.Groups.RemoveMember(GROUP, M.MemberId, FView);
  TAssert.AssertTrue(PollUntilEvents(0, kgeLost, 1));
  TAssert.AssertEquals(2, Length(FLast[0, kgeLost]));
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  TAssert.AssertEquals(2, FBroker.Groups.JoinCount);
  TAssert.AssertEquals('', FErrorClass[0]);
end;

procedure TKafkaGroupTests.NotCoordinator_LooksUpAgain_KeepsThePartitions;
var
  M: TKafkaConsumerProtocol;
  LLookups, N: Integer;
begin
  StartBroker(2);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  LLookups := FBroker.FindCoordinatorCount;
  FBroker.Groups.HeartbeatErrorCode := KAFKA_ERROR_NOT_COORDINATOR;
  FBroker.Groups.HeartbeatErrors := 3;
  N := FBroker.Groups.HeartbeatCount;
  // The three errors, then heartbeats that work again.
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, M.MemberId,
    FBroker.Groups.MemberHeartbeats(GROUP, M.MemberId) + 2, WAIT_MS));
  TAssert.AssertTrue(FBroker.Groups.HeartbeatCount >= N + 5);
  TAssert.AssertTrue('looked up again', FBroker.FindCoordinatorCount >= LLookups + 1);
  DoPoll(0);
  TAssert.AssertEquals(0, FCounts[0][kgeLost]);
  TAssert.AssertEquals(2, Length(M.Assignment));
  TAssert.AssertEquals(2, Length(FBroker.Groups.MemberOwned(GROUP, M.MemberId)));
  TAssert.AssertEquals('', FErrorClass[0]);
end;

procedure TKafkaGroupTests.ConnectionDropped_HeartbeatsResume;
var
  M: TKafkaConsumerProtocol;
  LConnections: Integer;
begin
  StartBroker(2);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  LConnections := FBroker.ConnectionCount;
  FBroker.DropClient;
  TAssert.AssertTrue(FBroker.Groups.WaitMemberHeartbeats(GROUP, M.MemberId,
    FBroker.Groups.MemberHeartbeats(GROUP, M.MemberId) + 3, WAIT_MS));
  TAssert.AssertTrue('a new connection', FBroker.ConnectionCount > LConnections);
  DoPoll(0);
  TAssert.AssertEquals(0, FCounts[0][kgeLost]);
  TAssert.AssertEquals(2, Length(M.Assignment));
  TAssert.AssertEquals('', FErrorClass[0]);
end;

procedure TKafkaGroupTests.GroupAuthorizationFailed_RaisedFromPollOnce;
var
  M: TKafkaConsumerProtocol;
begin
  StartBroker(2);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 2));
  FBroker.Groups.HeartbeatErrorCode := KAFKA_ERROR_GROUP_AUTHORIZATION_FAILED;
  FBroker.Groups.HeartbeatErrors := 1;
  TAssert.AssertTrue(PollUntilError(0));
  TAssert.AssertEquals('EKafkaBrokerError', FErrorClass[0]);
  TAssert.AssertEquals(KAFKA_ERROR_GROUP_AUTHORIZATION_FAILED, FErrorCode[0]);
  TAssert.AssertTrue(M.State = kmsFatal);
  // The partitions are lost; the error isn't raised again.
  FErrorClass[0] := '';
  DoPoll(0);
  TAssert.AssertEquals('', FErrorClass[0]);
  TAssert.AssertEquals(1, FCounts[0][kgeLost]);
  TAssert.AssertEquals(0, Length(M.Assignment));
end;

procedure TKafkaGroupTests.BrokerWithoutTheProtocol_RaisesUnsupportedVersion;
begin
  StartBroker(1);
  FBroker.OfferConsumerGroupHeartbeat := False;
  Join(0);
  TAssert.AssertTrue(PollUntilError(0));
  TAssert.AssertEquals('EKafkaUnsupportedVersion', FErrorClass[0]);
  TAssert.AssertEquals(0, FBroker.Groups.HeartbeatCount);
end;

procedure TKafkaGroupTests.Leave_RevokesThenSendsEpochMinusOne;
var
  M: TKafkaConsumerProtocol;
begin
  StartBroker(3);
  M := Join(0);
  TAssert.AssertTrue(PollUntilOwned(0, 3));
  M.Leave(HandleA, WAIT_MS);
  TAssert.AssertEquals(1, FCounts[0][kgeRevoked]);
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(FLast[0, kgeRevoked]));
  TAssert.AssertEquals(1, FBroker.Groups.LeaveCount);
  TAssert.AssertEquals(0, FBroker.Groups.MemberCount(GROUP));
  TAssert.AssertEquals(-1, M.MemberEpoch);
  TAssert.AssertTrue(M.State = kmsUnsubscribed);
  TAssert.AssertEquals(0, Length(M.Assignment));
end;

