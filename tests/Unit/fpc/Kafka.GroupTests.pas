  TAssert.AssertEquals(2, FBroker.Groups.OffsetFetchCount);
  TAssert.AssertTrue(FBroker.FindCoordinatorCount > LLookups);
end;

procedure TKafkaGroupTests.Commit_BeforeJoining_AsASimpleConsumer;
var
  P: TKafkaConsumerProtocolParams;
