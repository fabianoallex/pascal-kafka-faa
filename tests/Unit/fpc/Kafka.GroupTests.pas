  TAssert.AssertEquals(Int64(5), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  TAssert.AssertEquals(Int64(5), M.Committed([KafkaTopicPartition(TOPIC, 0)], WAIT_MS)[0].Offset);
  TAssert.AssertEquals(0, FBroker.Groups.MemberCount(GROUP));
