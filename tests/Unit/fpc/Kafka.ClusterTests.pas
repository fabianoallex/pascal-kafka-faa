var
  P: TKafkaClusterParams;
begin
  P := KafkaClusterParams(ABootstrap);
  P.Connection.ClientId := 'cluster-test';
  P.Connection.ConnectTimeoutMs := 2000;
  P.Connection.RequestTimeoutMs := 5000;
  P.MaxBlockMs := 5000;
  P.RetryBackoffMs := 20;
  FreeAndNil(FCluster);
  FCluster := TKafkaCluster.Create(P);
  Result := FCluster;
end;

