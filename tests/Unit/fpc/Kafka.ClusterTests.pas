procedure TKafkaClusterTests.Open_BootstrapsThroughTheFirstAddressThatAnswers;
var
  Tls: TKafkaFakeBroker;
  M: IKafkaClusterMetadata;
begin
  StartBrokers(2);
  SetView('', []);
  // A TLS listener hangs up on a plaintext client at once: an address that
  // doesn't answer, without waiting for a connect timeout.
  Tls := TKafkaFakeBroker.CreateTls;
  try
    NewCluster(Format('127.0.0.1:%d, %s', [Tls.Port, Address(1)]));
    FCluster.Open;
  finally
    Tls.Free;
  end;
  M := FCluster.Metadata;
  TAssert.AssertEquals('fake-cluster', M.ClusterId);
  TAssert.AssertEquals(2, Length(M.Brokers));
  TAssert.AssertEquals(FBrokers[1].Port, M.Brokers[1].Port);
  TAssert.AssertEquals('asked broker 2 only', 1, FBrokers[1].MetadataCount);
  TAssert.AssertEquals(0, FBrokers[0].MetadataCount);
  TAssert.AssertEquals(1, FCluster.RefreshCount);
  // Nothing tracked yet: Metadata asked for no topic.
  TAssert.AssertEquals(0, M.TopicCount);
end;

procedure TKafkaClusterTests.Open_NoAddressAnswers_NamesEach;
var
  Tls: TKafkaFakeBroker;
  Message: string;
  Port: Integer;
begin
  Tls := TKafkaFakeBroker.CreateTls;
  try
    Port := Tls.Port;
    NewCluster(Format('127.0.0.1:%d,127.0.0.1:%d', [Port, Port]));
    Message := '';
    try
      FCluster.Open;
    except
      on E: EKafkaConnection do
        Message := E.Message;
    end;
  finally
    Tls.Free;
  end;
  TAssert.AssertTrue('EKafkaConnection: ' + Message, Pos('No broker answered', Message) > 0);
  TAssert.AssertTrue('names the address: ' + Message,
    Pos('127.0.0.1:' + IntToStr(Port), Message) > 0);
end;

procedure TKafkaClusterTests.Open_BeforeAndAfter_AreRefused;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  NewCluster(Address(0));
  FTopic := TOPIC;
  TAssert.AssertException('before Open', EKafkaConnection, ReadTopic);
  FCluster.Open;
  TAssert.AssertException('twice', EKafkaConnection, OpenCluster);
  ReadTopic;
  FCluster.Close;
  FCluster.Close; // idempotent
  TAssert.AssertException('after Close', EKafkaConnection, ReadTopic);
  TAssert.AssertTrue(FCluster.Metadata = nil);
end;

procedure TKafkaClusterTests.Leader_IsThePartitionsLeader_OneConnectionPerBroker;
var
  T: TKafkaTopicInfo;
  L0, L1, L2: IKafkaBrokerConnection;
  I: Integer;
begin
  StartBrokers(2);
  SetView(TOPIC, [1, 2, 1]);
  NewCluster(Address(0)).Open;
  T := FCluster.Topic(TOPIC);
  TAssert.AssertTrue(T.IsReady);
  TAssert.AssertEquals(3, Length(T.Partitions));
  for I := 0 to 2 do
    TAssert.AssertEquals('in order', I, T.Partitions[I].Partition);
  TAssert.AssertEquals(2, T.Partitions[1].LeaderId);
  TAssert.AssertEquals(3, T.Partitions[1].LeaderEpoch);
  TAssert.AssertEquals(7, Integer(T.TopicId.Bytes[15]));
  L0 := FCluster.Leader(TOPIC, 0);
  L1 := FCluster.Leader(TOPIC, 1);
  L2 := FCluster.Leader(TOPIC, 2);
  TAssert.AssertEquals(1, L0.NodeId);
  TAssert.AssertEquals(2, L1.NodeId);
  TAssert.AssertEquals(Address(1), L1.Connection.Address);
  TAssert.AssertTrue('one connection to broker 1', L0 = L2);
  TAssert.AssertTrue(L0 <> L1);
  TAssert.AssertTrue(L1.Connection.IsOpen);
  TAssert.AssertEquals('one Topic refresh, nothing more', 2, FCluster.RefreshCount);
end;

procedure TKafkaClusterTests.Leader_PartitionOutOfRange_IsRefused;
begin
  StartBrokers(1);
  SetView(TOPIC, [1, 1]);
  NewCluster(Address(0)).Open;
  FTopic := TOPIC;
  FPartition := 2;
  TAssert.AssertException(EArgumentOutOfRangeException, ReadLeader);
  FPartition := -1;
  TAssert.AssertException(EArgumentOutOfRangeException, ReadLeader);
end;

procedure TKafkaClusterTests.Topic_Unknown_WaitsThenTimesOut;
var
  P: TKafkaClusterParams;
  Started: UInt64;
  Message: string;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  P := KafkaClusterParams(Address(0));
  P.MaxBlockMs := 300;
  P.RetryBackoffMs := 30;
  FCluster := TKafkaCluster.Create(P);
  FCluster.Open;
  Started := PcTickMs;
  Message := '';
  try
    FCluster.Topic('missing');
  except
    on E: EKafkaTimeout do
      Message := E.Message;
  end;
  TAssert.AssertTrue('EKafkaTimeout: ' + Message, Pos('UNKNOWN_TOPIC_OR_PARTITION', Message) > 0);
  TAssert.AssertTrue('waited', PcTickMs - Started >= 250);
  TAssert.AssertTrue('and asked again meanwhile', FBrokers[0].MetadataCount >= 4);
end;

procedure TKafkaClusterTests.Topic_NotReadyForAWhile_ThenReady;
var
  T: TKafkaTopicInfo;
begin
  StartBrokers(1);
  SetView(TOPIC, [1, 1, 1]);
  FBrokers[0].NotReadyAnswers := 3;
  NewCluster(Address(0)).Open;
  T := FCluster.Topic(TOPIC);
  TAssert.AssertTrue(T.IsReady);
  TAssert.AssertEquals(3, Length(T.Partitions));
  // Open, three answers not ready, the ready one.
  TAssert.AssertEquals(5, FBrokers[0].MetadataCount);
end;

procedure TKafkaClusterTests.Topic_AuthorizationError_RaisesAtOnce;
var
  V: TKafkaMetadataResponse;
  Code: Integer;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  V := FBrokers[0].ClusterView;
  V.Topics[0].ErrorCode := KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED;
  V.Topics[0].Partitions := nil;
  FBrokers[0].ClusterView := V;
  NewCluster(Address(0)).Open;
  Code := 0;
  try
    FCluster.Topic(TOPIC);
  except
    on E: EKafkaBrokerError do
      Code := E.ErrorCode;
  end;
  TAssert.AssertEquals(KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED, Code);
  TAssert.AssertEquals('no waiting', 2, FBrokers[0].MetadataCount);
end;

procedure TKafkaClusterTests.Metadata_IsReusedUntilInvalidated;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  NewCluster(Address(0)).Open;
  FCluster.Topic(TOPIC);
  FCluster.Topic(TOPIC);
  FCluster.Leader(TOPIC, 0);
  TAssert.AssertEquals('Open and the first Topic', 2, FBrokers[0].MetadataCount);
  FCluster.Invalidate;
  FCluster.Leader(TOPIC, 0);
  TAssert.AssertEquals(3, FBrokers[0].MetadataCount);
  FCluster.Refresh([]);
  TAssert.AssertEquals(4, FBrokers[0].MetadataCount);
  TAssert.AssertEquals(1, FCluster.Metadata.TopicCount);
end;

procedure TKafkaClusterTests.Broker_BrokenConnection_IsReplaced;
var
  A, B: IKafkaBrokerConnection;
  R: TKafkaMetadataRequest;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  NewCluster(Address(0)).Open;
  A := FCluster.Broker(1);
  FBrokers[0].DropClient;
  // The next request on it fails: the broker reset the connection.
  FHeld := A;
  TAssert.AssertException(EKafkaConnection, MetadataOnHeld);
  FHeld := nil;
  TAssert.AssertFalse(A.Connection.IsOpen);
  B := FCluster.Broker(1);
  TAssert.AssertTrue('a new connection', A <> B);
  R.Init;
  B.Connection.Metadata(R);
  TAssert.AssertTrue(B.Connection.IsOpen);
  A := nil; // the broken one goes with its last holder
end;

procedure TKafkaClusterTests.Refresh_BrokerGone_AnotherAnswers;
begin
  StartBrokers(2);
  SetView(TOPIC, [2]);
  NewCluster(Address(0)).Open;
  FCluster.Leader(TOPIC, 0); // connects to broker 2
  // Open and the Topic refresh both went to broker 1, the first known.
  TAssert.AssertEquals(2, FBrokers[0].MetadataCount);
  TAssert.AssertEquals(0, FBrokers[1].MetadataCount);
  FreeAndNil(FBrokers[0]);
  // Broker 1 is gone: the refresh fails there and asks broker 2.
  FCluster.Refresh([]);
  TAssert.AssertEquals(1, FBrokers[1].MetadataCount);
end;

procedure TKafkaClusterTests.Close_EndsAWaitOnAnotherThread;
var
  P: TKafkaClusterParams;
  Waiter: TTopicWaiter;
  Started: UInt64;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  P := KafkaClusterParams(Address(0));
  P.MaxBlockMs := 30000;
  P.RetryBackoffMs := 20;
  FCluster := TKafkaCluster.Create(P);
  FCluster.Open;
  Waiter := TTopicWaiter.Create(FCluster, 'missing');
  try
    Waiter.Start;
    TAssert.AssertTrue('the waiter is asking', WaitMetadataCount(FBrokers[0], 3, 10000));
    Started := PcTickMs;
    FCluster.Close;
    Waiter.WaitFor;
    TAssert.AssertTrue('ended at once', PcTickMs - Started < 3000);
    TAssert.AssertEquals('EKafkaConnection', Waiter.ErrorClass);
  finally
    Waiter.Free;
  end;
end;

procedure TKafkaClusterTests.Close_ClosesTheConnectionsCallersHold;
var
  B: IKafkaBrokerConnection;
begin
  StartBrokers(1);
  SetView(TOPIC, [1]);
  NewCluster(Address(0)).Open;
  B := FCluster.Leader(TOPIC, 0);
  TAssert.AssertTrue(B.Connection.IsOpen);
  FCluster.Close;
  TAssert.AssertFalse('closed by the cluster', B.Connection.IsOpen);
  FreeAndNil(FCluster);
  TAssert.AssertEquals('still usable as an object', 1, B.NodeId);
  B := nil;
end;

procedure TKafkaClusterTests.ErrorsThatInvalidateMetadata;
const
  YES: array[0..8] of Int16 = (3, 5, 6, 9, 56, 72, 74, 100, 103);
  NO: array[0..6] of Int16 = (0, -1, 1, 7, 29, 75, 16);
var
  I: Integer;
begin
  for I := Low(YES) to High(YES) do
    TAssert.AssertTrue(KafkaErrorName(YES[I]), KafkaErrorInvalidatesMetadata(YES[I]));
  // NONE, UNKNOWN_SERVER_ERROR, OFFSET_OUT_OF_RANGE, REQUEST_TIMED_OUT,
  // TOPIC_AUTHORIZATION_FAILED, UNKNOWN_LEADER_EPOCH (retriable, but not an
  // InvalidMetadataException), NOT_COORDINATOR (the group's).
  for I := Low(NO) to High(NO) do
    TAssert.AssertFalse(KafkaErrorName(NO[I]), KafkaErrorInvalidatesMetadata(NO[I]));
end;

procedure Refused(const AServers: string);
var
  Raised: Boolean;
  C: TKafkaCluster;
begin
  Raised := False;
  try
    C := TKafkaCluster.Create(KafkaClusterParams(AServers));
    C.Free;
  except
    on EArgumentException do
      Raised := True;
  end;
  TAssert.AssertTrue('refused: "' + AServers + '"', Raised);
end;

procedure TKafkaClusterTests.BootstrapServers_BadAddress_IsRefused;
begin
  Refused('');
  Refused(' , ');
  Refused('localhost:0');
  Refused('localhost:70000');
  Refused('localhost:x');
  Refused(':9092');
  // These parse (no connection is made before Open).
  TKafkaCluster.Create(KafkaClusterParams('localhost')).Free;
  TKafkaCluster.Create(KafkaClusterParams('[::1]:9092, broker-2:19092')).Free;
end;

initialization
  RegisterTest(TKafkaClusterTests);

