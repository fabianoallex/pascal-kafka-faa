const
  TOPIC = 'orders';

type
  /// Runs Topic on its own thread and records how it ended.
  TTopicWaiter = class(TThread)
  private
    FCluster: TKafkaCluster;
    FTopic: string;
  protected
    procedure Execute; override;
  public
    ErrorClass: string;
    constructor Create(ACluster: TKafkaCluster; const ATopic: string);
  end;

constructor TTopicWaiter.Create(ACluster: TKafkaCluster; const ATopic: string);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FCluster := ACluster;
  FTopic := ATopic;
end;

procedure TTopicWaiter.Execute;
begin
  try
    FCluster.Topic(FTopic);
    ErrorClass := 'none';
  except
    on E: Exception do
      ErrorClass := E.ClassName;
  end;
end;

/// Waits up to ATimeoutMs for ABroker to have received ACount Metadata
/// requests.
function WaitMetadataCount(ABroker: TKafkaFakeBroker; ACount: Integer; ATimeoutMs: Cardinal): Boolean;
var
  Deadline: UInt64;
  Pause: TEvent;
begin
  Deadline := PcTickMs + ATimeoutMs;
  Pause := TEvent.Create(nil, True, False, '');
  try
    while ABroker.MetadataCount < ACount do
    begin
      if PcTickMs >= Deadline then
        Exit(False);
      Pause.WaitFor(5);
    end;
    Result := True;
  finally
    Pause.Free;
  end;
end;

{ TKafkaClusterTests }

procedure TKafkaClusterTests.Setup;
begin
  FBrokers := nil;
  FCluster := nil;
end;

procedure TKafkaClusterTests.TearDown;
var
  I: Integer;
begin
  FHeld := nil;
  FreeAndNil(FCluster);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
end;

procedure TKafkaClusterTests.StartBrokers(ACount: Integer);
var
  I: Integer;
begin
  SetLength(FBrokers, ACount);
  for I := 0 to ACount - 1 do
    FBrokers[I] := TKafkaFakeBroker.Create;
end;

function TKafkaClusterTests.Address(AIndex: Integer): string;
begin
  Result := '127.0.0.1:' + IntToStr(FBrokers[AIndex].Port);
end;

procedure TKafkaClusterTests.SetView(const ATopic: string; const ALeaders: array of Int32);
var
  V: TKafkaMetadataResponse;
  I, P: Integer;
begin
  V.Init;
  V.ClusterId := 'fake-cluster';
  V.ClusterIdIsNull := False;
  V.ControllerId := 1;
  SetLength(V.Brokers, Length(FBrokers));
  for I := 0 to High(FBrokers) do
  begin
    V.Brokers[I].Init;
    V.Brokers[I].NodeId := I + 1;
    V.Brokers[I].Host := '127.0.0.1';
    V.Brokers[I].Port := FBrokers[I].Port;
  end;
  if ATopic <> '' then
  begin
    SetLength(V.Topics, 1);
    V.Topics[0].Init;
    V.Topics[0].Name := ATopic;
    V.Topics[0].TopicId.Bytes[15] := 7;
    SetLength(V.Topics[0].Partitions, Length(ALeaders));
    for I := 0 to High(ALeaders) do
    begin
      // Reverse order: the cluster must not assume the broker sorts them.
      P := High(ALeaders) - I;
      V.Topics[0].Partitions[I].Init;
      V.Topics[0].Partitions[I].PartitionIndex := P;
      V.Topics[0].Partitions[I].LeaderId := ALeaders[P];
      V.Topics[0].Partitions[I].LeaderEpoch := 3;
    end;
  end;
  for I := 0 to High(FBrokers) do
  begin
    FBrokers[I].ClusterView := V;
    FBrokers[I].UseClusterView := True;
  end;
end;

