const
  TOPIC = 'orders';
  GROUP = 'billing';
  WAIT_MS = 10000;

function Remaining(ADeadline: UInt64): Cardinal;
var
  LNow: UInt64;
begin
  LNow := PcTickMs;
  if LNow >= ADeadline then
    Result := 0
  else
    Result := Cardinal(ADeadline - LNow);
end;

/// 'orders-0,orders-2', sorted.
function PartitionsText(const A: TKafkaTopicPartitionArray): string;
var
  L: TStringList;
  I: Integer;
begin
  L := TStringList.Create;
  try
    L.Sorted := True;
    for I := 0 to High(A) do
      L.Add(A[I].Topic + '-' + IntToStr(A[I].Partition));
    Result := '';
    for I := 0 to L.Count - 1 do
    begin
      if I > 0 then
        Result := Result + ',';
      Result := Result + L[I];
    end;
  finally
    L.Free;
  end;
end;

function SeenKey(APartition: Int32; AOffset: Int64): string;
begin
  Result := IntToStr(APartition) + ':' + IntToStr(AOffset);
end;

{ TKafkaConsumerGroupTests }

procedure TKafkaConsumerGroupTests.Setup;
var
  I: Integer;
  K: TKafkaGroupEventKind;
begin
  FBrokers := nil;
  FBroker := nil;
  for I := 0 to 1 do
  begin
    FConsumers[I] := nil;
    for K := Low(TKafkaGroupEventKind) to High(TKafkaGroupEventKind) do
    begin
      FCounts[I, K] := 0;
      FLast[I, K] := nil;
    end;
  end;
  FSeen := TDictionary<string, Integer>.Create;
  FSeenBy := TDictionary<string, Integer>.Create;
  FDuplicates := 0;
  FTestThread := TThread.CurrentThread.ThreadID;
  FWrongThread := False;
  FCommitInRevoke := False;
  FCommittedInRevoke := '';
  FSeekInAssign := -1;
  FPollInHandler := '';
  FReports := 0;
  FParams := KafkaConsumerParams('');
  FParams.Cluster.Connection.ClientId := 'consumer-group-test';
  FParams.Cluster.Connection.ConnectTimeoutMs := 2000;
  FParams.Cluster.Connection.RequestTimeoutMs := 5000;
  FParams.Cluster.MaxBlockMs := 5000;
  FParams.Cluster.RetryBackoffMs := 20;
  FParams.RetryBackoffMaxMs := 80;
  FParams.FetchMaxWaitMs := 100;
  FParams.AutoOffsetReset := korEarliest;
  FParams.GroupId := GROUP;
  FParams.DefaultApiTimeoutMs := WAIT_MS;
  // Long: a test that wants the interval sets it.
  FParams.AutoCommitIntervalMs := 600000;
end;

procedure TKafkaConsumerGroupTests.TearDown;
var
  I: Integer;
begin
  for I := 0 to 1 do
    FreeAndNil(FConsumers[I]);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
  FBroker := nil;
  FSeen.Free;
  FSeenBy.Free;
end;

procedure TKafkaConsumerGroupTests.StartBroker(APartitions: Integer);
var
  LLeaders: array of Int32;
  I: Integer;
begin
  SetLength(FBrokers, 1);
  FBrokers[0] := TKafkaFakeBroker.Create;
  FBroker := FBrokers[0];
  SetLength(LLeaders, APartitions);
  for I := 0 to APartitions - 1 do
    LLeaders[I] := 1;
  FView := KafkaFakeClusterView(FBrokers, TOPIC, LLeaders);
  KafkaFakeUseView(FBrokers, FView);
  FParams.Cluster.BootstrapServers := '127.0.0.1:' + IntToStr(FBroker.Port);
end;

procedure TKafkaConsumerGroupTests.Append(APartition, ACount: Integer);
var
  B: TKafkaRecordBatch;
  I: Integer;
begin
  B.Init;
  for I := 0 to ACount - 1 do
    B.Append(KafkaRecord(Utf8('k' + IntToStr(I)), Utf8('v' + IntToStr(I)), 1000 + I));
  FBroker.AppendBatch(TOPIC, APartition, B);
end;

function TKafkaConsumerGroupTests.NewConsumer(AWhich: Integer): TKafkaConsumer;
begin
  Result := TKafkaConsumer.Create(FParams);
  FConsumers[AWhich] := Result;
  Result.OnPartitionsAssigned := Assigned_;
  Result.OnPartitionsRevoked := Revoked;
  Result.OnPartitionsLost := Lost;
  Result.Open;
end;

function TKafkaConsumerGroupTests.Which(ASender: TKafkaConsumer): Integer;
begin
  if ASender = FConsumers[1] then
    Result := 1
  else
    Result := 0;
end;

function TKafkaConsumerGroupTests.MemberOf(AWhich: Integer): string;
begin
  Result := FConsumers[AWhich].Group.MemberId;
end;

procedure TKafkaConsumerGroupTests.Note(ASender: TKafkaConsumer; AKind: TKafkaGroupEventKind;
  const APartitions: TKafkaTopicPartitionArray);
var
  W: Integer;
begin
  if TThread.CurrentThread.ThreadID <> FTestThread then
    FWrongThread := True;
  W := Which(ASender);
  Inc(FCounts[W, AKind]);
  FLast[W, AKind] := APartitions;
end;

procedure TKafkaConsumerGroupTests.Assigned_(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
var
  I: Integer;
begin
  Note(ASender, kgeAssigned, APartitions);
  try
    ASender.Poll(0);
    FPollInHandler := 'none';
  except
    on E: EKafka do
      FPollInHandler := E.ClassName;
  end;
  if FSeekInAssign >= 0 then
    for I := 0 to High(APartitions) do
      ASender.Seek(APartitions[I].Topic, APartitions[I].Partition, FSeekInAssign);
end;

procedure TKafkaConsumerGroupTests.Revoked(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
var
  I: Integer;
begin
  Note(ASender, kgeRevoked, APartitions);
  if FCommitInRevoke then
  begin
    ASender.Commit;
    FCommittedInRevoke := '';
    for I := 0 to High(APartitions) do
      FCommittedInRevoke := FCommittedInRevoke + IntToStr(FBroker.Groups.CommittedOffset(GROUP,
        APartitions[I].Topic, APartitions[I].Partition)) + ';';
  end;
end;

procedure TKafkaConsumerGroupTests.Lost(ASender: TKafkaConsumer;
  const APartitions: TKafkaTopicPartitionArray);
begin
  Note(ASender, kgeLost, APartitions);
end;

procedure TKafkaConsumerGroupTests.CommitDone(const AReport: TKafkaCommitReport);
begin
  if TThread.CurrentThread.ThreadID <> FTestThread then
    FWrongThread := True;
  Inc(FReports);
  FLastReport := AReport;
end;

function TKafkaConsumerGroupTests.PollOnce(AWhich: Integer; ATimeoutMs: Cardinal): Integer;
var
  R: TKafkaConsumerRecordArray;
  I, N: Integer;
  K: string;
begin
  R := FConsumers[AWhich].Poll(ATimeoutMs);
  for I := 0 to High(R) do
  begin
    K := SeenKey(R[I].Partition, R[I].Offset);
    if FSeen.TryGetValue(K, N) then
    begin
      Inc(FDuplicates);
      FSeen[K] := N + 1;
    end
    else
      FSeen.Add(K, 1);
    FSeenBy.AddOrSetValue(K, AWhich);
  end;
  Result := Length(R);
end;

function TKafkaConsumerGroupTests.PollUntilSeen(ATotal: Integer; ABoth: Boolean): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + WAIT_MS;
  while FSeen.Count < ATotal do
  begin
    if PcTickMs >= LDeadline then
      Exit(False);
    PollOnce(0, 50);
    if ABoth then
      PollOnce(1, 50);
  end;
  Result := True;
end;

function TKafkaConsumerGroupTests.PollUntilOwned(AWhich, ACount: Integer; ABoth: Boolean): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + WAIT_MS;
  while True do
  begin
    PollOnce(AWhich, 50);
    if ABoth then
      PollOnce(1 - AWhich, 50);
    if (Length(FConsumers[AWhich].Assignment) = ACount) and
      FBroker.Groups.WaitMemberOwns(GROUP, MemberOf(AWhich), ACount, 0) then
      Exit(True);
    if PcTickMs >= LDeadline then
      Exit(False);
  end;
end;

procedure TKafkaConsumerGroupTests.CreateClassic;
var
  P: TKafkaConsumerParams;
begin
  P := FParams;
  P.GroupProtocol := kgpClassic;
  TKafkaConsumer.Create(P).Free;
end;

procedure TKafkaConsumerGroupTests.SubscribeWithoutGroup;
var
  P: TKafkaConsumerParams;
  C: TKafkaConsumer;
begin
  P := FParams;
  P.GroupId := '';
  C := TKafkaConsumer.Create(P);
  try
    C.Open;
    C.Subscribe([TOPIC]);
  finally
    C.Free;
  end;
end;

procedure TKafkaConsumerGroupTests.SubscribeFirst;
begin
  FConsumers[0].Subscribe([TOPIC]);
end;

procedure TKafkaConsumerGroupTests.AssignFirst;
begin
  FConsumers[0].Assign([KafkaTopicPartition(TOPIC, 0)]);
end;

{ Tests }

procedure TKafkaConsumerGroupTests.Subscribe_JoinsAtTheFirstPoll_StartsFromTheCommits;
var
  C: TKafkaConsumer;
begin
  StartBroker(3);
  Append(0, 5);
  Append(1, 3);
  Append(2, 2);
  FBroker.Groups.SetCommitted(GROUP, TOPIC, 0, 2);
  FBroker.Groups.SetCommitted(GROUP, TOPIC, 1, 3);
  FParams.EnableAutoCommit := False;
  C := NewConsumer(0);
  C.Subscribe([TOPIC]);
  TAssert.AssertEquals('no join before Poll', 0, FBroker.Groups.HeartbeatCount);
  TAssert.AssertEquals(TOPIC, C.Subscription[0]);
  // 0: 2..4 (the commit); 1: nothing (committed at its end); 2: 0..1
  // (none committed: earliest).
  TAssert.AssertTrue(PollUntilSeen(5, False));
  TAssert.AssertEquals(5, FSeen.Count);
  TAssert.AssertTrue(FSeen.ContainsKey(SeenKey(0, 2)));
  TAssert.AssertFalse('before the commit', FSeen.ContainsKey(SeenKey(0, 1)));
  TAssert.AssertTrue(FSeen.ContainsKey(SeenKey(2, 0)));
  TAssert.AssertEquals(1, FBroker.Groups.JoinCount);
  TAssert.AssertEquals(1, FCounts[0, kgeAssigned]);
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(FLast[0, kgeAssigned]));
  TAssert.AssertEquals('orders-0,orders-1,orders-2', PartitionsText(C.Assignment));
  TAssert.AssertEquals(Int64(5), C.Position(TOPIC, 0));
  TAssert.AssertEquals(Int64(3), C.Position(TOPIC, 1));
  TAssert.AssertFalse('handlers on the polling thread', FWrongThread);
  TAssert.AssertEquals('Poll refused inside a handler', 'EKafka', FPollInHandler);
  TAssert.AssertEquals(0, FDuplicates);
end;

procedure TKafkaConsumerGroupTests.SeekInOnPartitionsAssigned_WinsOverTheCommit;
begin
  StartBroker(1);
  Append(0, 4);
  FBroker.Groups.SetCommitted(GROUP, TOPIC, 0, 1);
  FParams.EnableAutoCommit := False;
  FSeekInAssign := 3;
  NewConsumer(0).Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(1, False));
  TAssert.AssertTrue(FSeen.ContainsKey(SeenKey(0, 3)));
  TAssert.AssertEquals(1, FSeen.Count);
end;

procedure TKafkaConsumerGroupTests.TwoConsumers_RevokeCommitsFirst_EveryRecordOnce;
var
  A, B: TKafkaConsumer;
  P, I: Integer;
  K: string;
  LMoved: TKafkaTopicPartitionArray;
begin
  StartBroker(4);
  for P := 0 to 3 do
    Append(P, 3);
  A := NewConsumer(0);
  A.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(12, False));
  TAssert.AssertTrue(PollUntilOwned(0, 4, False));
  // B joins: A revokes two partitions (its auto-commit first), then B gets
  // them and starts from A's commits: nothing read twice.
  B := NewConsumer(1);
  B.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilOwned(1, 2, True));
  TAssert.AssertTrue(PollUntilOwned(0, 2, True));
  TAssert.AssertEquals(1, FCounts[0, kgeRevoked]);
  LMoved := FLast[0, kgeRevoked];
  TAssert.AssertEquals(PartitionsText(LMoved), PartitionsText(B.Assignment));
  for I := 0 to High(LMoved) do
    TAssert.AssertEquals('committed before the move', Int64(3),
      FBroker.Groups.CommittedOffset(GROUP, TOPIC, LMoved[I].Partition));
  TAssert.AssertEquals(12, FSeen.Count);
  // New records: each read once, by its partition's owner.
  for P := 0 to 3 do
    Append(P, 2);
  TAssert.AssertTrue(PollUntilSeen(20, True));
  for I := 0 to High(LMoved) do
  begin
    K := SeenKey(LMoved[I].Partition, 3);
    TAssert.AssertEquals('read by B', 1, FSeenBy[K]);
  end;
  // B closes: its commit, its leave; A takes the partitions back from B's
  // commits.
  FreeAndNil(FConsumers[1]);
  TAssert.AssertTrue(PollUntilOwned(0, 4, False));
  for P := 0 to 3 do
    Append(P, 1);
  TAssert.AssertTrue(PollUntilSeen(24, False));
  TAssert.AssertEquals('no record read twice', 0, FDuplicates);
  TAssert.AssertEquals(0, FCounts[0, kgeLost]);
  TAssert.AssertFalse(FWrongThread);
end;

procedure TKafkaConsumerGroupTests.ManualCommitInOnPartitionsRevoked_BeforeTheyMove;
var
  A: TKafkaConsumer;
  P: Integer;
begin
  StartBroker(4);
  for P := 0 to 3 do
    Append(P, 2);
  FParams.EnableAutoCommit := False;
  FCommitInRevoke := True;
  A := NewConsumer(0);
  A.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(8, False));
  TAssert.AssertTrue(PollUntilOwned(0, 4, False));
  TAssert.AssertEquals('nothing committed yet', Int64(-1),
    FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  FBroker.Groups.AddMember(GROUP, 'passive', [TOPIC], FView);
  TAssert.AssertTrue(PollUntilOwned(0, 2, False));
  TAssert.AssertEquals(1, FCounts[0, kgeRevoked]);
  // Seen from inside the handler: committed already, while A held them.
  TAssert.AssertEquals('2;2;', FCommittedInRevoke);
  TAssert.AssertEquals(2, Length(FBroker.Groups.MemberOwned(GROUP, 'passive')));
end;

procedure TKafkaConsumerGroupTests.AutoCommit_OnTheInterval_OnlyWhenChanged;
var
  LDeadline, LUntil: UInt64;
  N: Integer;
begin
  StartBroker(1);
  Append(0, 3);
  FParams.AutoCommitIntervalMs := 100;
  NewConsumer(0).Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(3, False));
  LDeadline := PcTickMs + WAIT_MS;
  while (FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0) <> 3) and (PcTickMs < LDeadline) do
    PollOnce(0, 50);
  TAssert.AssertEquals(Int64(3), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  N := FBroker.Groups.CommitCount;
  // Four intervals with nothing new: no commit.
  LUntil := PcTickMs + 400;
  while PcTickMs < LUntil do
    PollOnce(0, Remaining(LUntil));
  TAssert.AssertEquals('nothing changed', N, FBroker.Groups.CommitCount);
  Append(0, 1);
  TAssert.AssertTrue(PollUntilSeen(4, False));
  LDeadline := PcTickMs + WAIT_MS;
  while (FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0) <> 4) and (PcTickMs < LDeadline) do
    PollOnce(0, 50);
  TAssert.AssertEquals(Int64(4), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
end;

procedure TKafkaConsumerGroupTests.CommitAsync_FutureAndCallbackInPoll_ThenSyncAndCommitted;
var
  C: TKafkaConsumer;
  F: IKafkaCommitFuture;
  LOffsets: TKafkaCommittedOffsetArray;
  LGot: TKafkaCommittedOffsetArray;
begin
  StartBroker(1);
  Append(0, 3);
  FParams.EnableAutoCommit := False;
  C := NewConsumer(0);
  C.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(3, False));
  F := C.CommitAsync(CommitDone);
  TAssert.AssertTrue(F.Wait(WAIT_MS));
  TAssert.AssertTrue(F.Report.Succeeded);
  TAssert.AssertEquals(Int64(3), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  TAssert.AssertEquals('the callback waits for a Poll', 0, FReports);
  C.Poll(0);
  TAssert.AssertEquals(1, FReports);
  TAssert.AssertTrue(FLastReport.Succeeded);
  TAssert.AssertEquals(1, Length(FLastReport.Offsets));
  TAssert.AssertEquals(Int64(3), FLastReport.Offsets[0].Offset);
  TAssert.AssertFalse(FWrongThread);
  // Synchronous, with offsets of its own; then read back.
  SetLength(LOffsets, 1);
  LOffsets[0].Topic := TOPIC;
  LOffsets[0].Partition := 0;
  LOffsets[0].Offset := 1;
  LOffsets[0].LeaderEpoch := -1;
  LOffsets[0].Metadata := 'm';
  C.CommitOffsets(LOffsets);
  TAssert.AssertEquals(Int64(1), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  LGot := C.Committed([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(1), LGot[0].Offset);
  TAssert.AssertEquals('m', LGot[0].Metadata);
end;

procedure TKafkaConsumerGroupTests.CommitAsync_Failure_ReportedNotRetried;
var
  C: TKafkaConsumer;
  F: IKafkaCommitFuture;
  N: Integer;
begin
  StartBroker(1);
  Append(0, 3);
  FParams.EnableAutoCommit := False;
  C := NewConsumer(0);
  C.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(3, False));
  N := FBroker.Groups.CommitCount;
  FBroker.Groups.CommitErrorCode := KAFKA_ERROR_COORDINATOR_LOAD_IN_PROGRESS;
  FBroker.Groups.CommitErrors := 1;
  F := C.CommitAsync(CommitDone);
  TAssert.AssertTrue(F.Wait(WAIT_MS));
  TAssert.AssertFalse(F.Report.Succeeded);
  TAssert.AssertEquals(KAFKA_ERROR_COORDINATOR_LOAD_IN_PROGRESS, Integer(F.Report.ErrorCode));
  TAssert.AssertEquals('not retried', N + 1, FBroker.Groups.CommitCount);
  C.Poll(0);
  TAssert.AssertEquals(1, FReports);
  TAssert.AssertFalse(FLastReport.Succeeded);
  // A synchronous commit retries what can be retried; this one just works.
  C.Commit;
  TAssert.AssertEquals(Int64(3), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
end;

procedure TKafkaConsumerGroupTests.Close_CommitsRevokesAndLeaves;
var
  C: TKafkaConsumer;
begin
  StartBroker(2);
  Append(0, 2);
  Append(1, 3);
  C := NewConsumer(0);
  C.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilSeen(5, False));
  TAssert.AssertTrue(PollUntilOwned(0, 2, False));
  TAssert.AssertEquals(Int64(-1), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  C.Close;
  TAssert.AssertEquals(Int64(2), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 0));
  TAssert.AssertEquals(Int64(3), FBroker.Groups.CommittedOffset(GROUP, TOPIC, 1));
  TAssert.AssertEquals(1, FCounts[0, kgeRevoked]);
  TAssert.AssertEquals('orders-0,orders-1', PartitionsText(FLast[0, kgeRevoked]));
  TAssert.AssertEquals(1, FBroker.Groups.LeaveCount);
  TAssert.AssertEquals(0, FBroker.Groups.MemberCount(GROUP));
end;

procedure TKafkaConsumerGroupTests.PollNotCalled_MemberGoesStale_ThenJoinsAgain;
var
  C: TKafkaConsumer;
  LId: string;
  LJoins: Integer;
begin
  StartBroker(2);
  FParams.MaxPollIntervalMs := 400;
  C := NewConsumer(0);
  C.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilOwned(0, 2, False));
  LId := C.Group.MemberId;
  LJoins := FBroker.Groups.JoinCount;
  // No Poll: after 400 ms the member leaves (epoch -1) and is stale.
  TAssert.AssertTrue(FBroker.Groups.WaitMemberCount(GROUP, 0, WAIT_MS));
  TAssert.AssertEquals(1, FBroker.Groups.LeaveCount);
  TAssert.AssertTrue(C.Group.State = kmsStale);
  // The next Poll: the partitions lost (not revoked), then a new join.
  TAssert.AssertTrue(PollUntilOwned(0, 2, False));
  TAssert.AssertEquals(1, FCounts[0, kgeLost]);
  TAssert.AssertEquals('orders-0,orders-1', PartitionsText(FLast[0, kgeLost]));
  TAssert.AssertEquals(0, FCounts[0, kgeRevoked]);
  TAssert.AssertEquals(2, FCounts[0, kgeAssigned]);
  TAssert.AssertEquals(LJoins + 1, FBroker.Groups.JoinCount);
  TAssert.AssertEquals(LId, C.Group.MemberId);
end;

procedure TKafkaConsumerGroupTests.SubscribeAndAssign_Exclusive_GroupProtocolChecked;
var
  C: TKafkaConsumer;
begin
  StartBroker(1);
  TAssert.AssertException(EKafka, CreateClassic);
  TAssert.AssertException(EKafka, SubscribeWithoutGroup);
  C := NewConsumer(0);
  C.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertException(EKafka, SubscribeFirst);
  C.Assign([]);
  C.Subscribe([TOPIC]);
  TAssert.AssertTrue(PollUntilOwned(0, 1, False));
  TAssert.AssertException(EKafka, AssignFirst);
  // Assign([]) is Unsubscribe: the revoke, the leave.
  C.Assign([]);
  TAssert.AssertEquals(1, FBroker.Groups.LeaveCount);
  TAssert.AssertEquals(1, FCounts[0, kgeRevoked]);
  TAssert.AssertEquals(0, Length(C.Subscription));
  TAssert.AssertEquals(0, Length(C.Assignment));
  C.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(1, Length(C.Assignment));
end;

initialization
  RegisterTest(TKafkaConsumerGroupTests);

end.
