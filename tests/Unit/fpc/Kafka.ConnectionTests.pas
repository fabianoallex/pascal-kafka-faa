const
  WAIT_MS = 10000;

function MetadataFor(const ATopic: string): TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Name := ATopic;
end;

{ TKafkaConnectionTests }

procedure TKafkaConnectionTests.Setup;
begin
  FBroker := TKafkaFakeBroker.Create;
  FParams := KafkaConnectionParams('127.0.0.1', FBroker.Port);
  FParams.ClientId := 'test-client';
  FConnection := nil;
  FFuture := nil;
end;

procedure TKafkaConnectionTests.TearDown;
begin
  FFuture := nil;
  FreeAndNil(FConnection);
  FreeAndNil(FBroker);
end;

function TKafkaConnectionTests.Connect: TKafkaConnection;
begin
  FConnection := TKafkaConnection.Create(FParams);
  FConnection.Open;
  Result := FConnection;
end;

procedure TKafkaConnectionTests.OpenConnection;
begin
  FConnection.Open;
end;

procedure TKafkaConnectionTests.CallMetadata;
begin
  FConnection.Metadata(MetadataFor('t'));
end;

procedure TKafkaConnectionTests.CallNegotiatedMetadata;
begin
  FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
end;

procedure TKafkaConnectionTests.ReadFutureBody;
begin
  FFuture.Body;
end;

procedure TKafkaConnectionTests.SendMetadata;
begin
  FConnection.Send(KAFKA_API_KEY_METADATA, 12, MetadataFor('t').ToBytes(12));
end;

procedure TKafkaConnectionTests.Open_NegotiatesTheHighestCommonVersion;
var
  V: Int16;
begin
  FBroker.MetadataMax := 9;
  Connect;
  TAssert.AssertTrue(FConnection.IsOpen);
  TAssert.AssertEquals(5, Integer(FConnection.ApiVersionsVersion));
  TAssert.AssertTrue(FConnection.TryNegotiatedVersion(KAFKA_API_KEY_METADATA, V));
  TAssert.AssertEquals(9, Integer(V));
  TAssert.AssertEquals(5, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_API_VERSIONS)));
end;

procedure TKafkaConnectionTests.Open_BrokerWithOlderApiVersions_RetriesAtItsVersion;
begin
  FBroker.ApiVersionsMax := 3;
  Connect;
  TAssert.AssertEquals(3, Integer(FConnection.ApiVersionsVersion));
  TAssert.AssertEquals(13, Integer(FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA)));
  // One refused ApiVersions, one accepted.
  TAssert.AssertEquals(2, FBroker.RequestCount);
end;

procedure TKafkaConnectionTests.Metadata_NotOffered_IsUnsupported;
var
  V: Int16;
begin
  FBroker.OfferMetadata := False;
  Connect;
  TAssert.AssertFalse(FConnection.TryNegotiatedVersion(KAFKA_API_KEY_METADATA, V));
  TAssert.AssertEquals(-1, Integer(V));
  TAssert.AssertException(EKafkaUnsupportedVersion, CallNegotiatedMetadata);
  TAssert.AssertException(EKafkaUnsupportedVersion, CallMetadata);
end;

procedure TKafkaConnectionTests.Metadata_RangesDontMeet_IsUnsupported;
var
  V: Int16;
begin
  FBroker.MetadataMin := 14;
  FBroker.MetadataMax := 20;
  Connect;
  TAssert.AssertFalse(FConnection.TryNegotiatedVersion(KAFKA_API_KEY_METADATA, V));
  TAssert.AssertException(EKafkaUnsupportedVersion, CallMetadata);
end;

procedure TKafkaConnectionTests.Metadata_AnswersTheTopicAsked;
var
  R: TKafkaMetadataResponse;
begin
  Connect;
  R := FConnection.Metadata(MetadataFor('orders'));
  TAssert.AssertEquals(1, Length(R.Topics));
  TAssert.AssertEquals('orders', R.Topics[0].Name);
  TAssert.AssertEquals(Integer(FBroker.Port), R.Brokers[0].Port);
  TAssert.AssertEquals(0, FConnection.InFlightCount);
end;

procedure TKafkaConnectionTests.ManyInFlight_AnsweredInReverse_EachReachesItsCaller;
const
  N = 20;
var
  Futures: array[0..N - 1] of IKafkaResponseFuture;
  I: Integer;
  R: TKafkaMetadataResponse;
  V: Int16;
begin
  Connect;
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  FBroker.HoldMetadata := True;
  for I := 0 to N - 1 do
    Futures[I] := FConnection.Send(KAFKA_API_KEY_METADATA, V,
      MetadataFor('topic-' + IntToStr(I)).ToBytes(V));
  TAssert.AssertTrue('all held', FBroker.WaitHeld(N, WAIT_MS));
  TAssert.AssertEquals(N, FConnection.InFlightCount);
  for I := 0 to N - 1 do
    TAssert.AssertFalse('not answered yet', Futures[I].IsDone);
  FBroker.ReleaseHeld;
  for I := 0 to N - 1 do
  begin
    TAssert.AssertTrue('answered ' + IntToStr(I), Futures[I].Wait(WAIT_MS));
    R.FromBytes(Futures[I].Body, V);
    TAssert.AssertEquals('topic-' + IntToStr(I), R.Topics[0].Name);
  end;
  TAssert.AssertEquals(0, FConnection.InFlightCount);
  for I := 0 to N - 1 do
    Futures[I] := nil;
end;

procedure TKafkaConnectionTests.RequestTimeout_RaisesTimeoutAndTheConnectionStaysUsable;
var
  R: TKafkaMetadataResponse;
begin
  FParams.RequestTimeoutMs := 300;
  Connect;
  FBroker.DropNextMetadata := 1;
  TAssert.AssertException(EKafkaTimeout, CallMetadata);
  TAssert.AssertTrue(FConnection.IsOpen);
  TAssert.AssertEquals(0, FConnection.InFlightCount);
  R := FConnection.Metadata(MetadataFor('after'));
  TAssert.AssertEquals('after', R.Topics[0].Name);
end;

procedure TKafkaConnectionTests.Signal_FiresOnAnswerFailureAndAbandon;
var
  Signal: TKafkaEventSignal;
  Keep: IKafkaSignal;
  V: Int16;
  A, B: IKafkaResponseFuture;
begin
  Signal := TKafkaEventSignal.Create;
  Keep := Signal;
  Connect;
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  // Answered.
  A := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('a').ToBytes(V), Keep);
  TAssert.AssertTrue('answered', Signal.WaitFor(WAIT_MS));
  TAssert.AssertTrue(A.IsDone);
  TAssert.AssertFalse('auto-reset', Signal.WaitFor(0));
  // Abandoned.
  FBroker.HoldMetadata := True;
  A := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('b').ToBytes(V), Keep);
  TAssert.AssertTrue(FBroker.WaitHeld(1, WAIT_MS));
  TAssert.AssertFalse(Signal.WaitFor(0));
  FConnection.Abandon(A);
  TAssert.AssertTrue('abandoned', Signal.WaitFor(0));
  // Failed: the broker goes away.
  B := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('c').ToBytes(V), Keep);
  TAssert.AssertTrue(FBroker.WaitHeld(2, WAIT_MS));
  FBroker.DropClient;
  TAssert.AssertTrue('failed', Signal.WaitFor(WAIT_MS));
  TAssert.AssertTrue(B.IsDone);
  A := nil;
  B := nil;
  Keep := nil;
end;

procedure TKafkaConnectionTests.BrokerGoesAway_FailsInFlightAndBreaks;
const
  N = 3;
var
  Futures: array[0..N - 1] of IKafkaResponseFuture;
  I: Integer;
  V: Int16;
begin
  Connect;
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  FBroker.HoldMetadata := True;
  for I := 0 to N - 1 do
    Futures[I] := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('t').ToBytes(V));
  TAssert.AssertTrue(FBroker.WaitHeld(N, WAIT_MS));
  FBroker.DropClient;
  for I := 0 to N - 1 do
  begin
    TAssert.AssertTrue('failed ' + IntToStr(I), Futures[I].Wait(WAIT_MS));
    FFuture := Futures[I];
    TAssert.AssertException(EKafkaConnection, ReadFutureBody);
    Futures[I] := nil;
  end;
  TAssert.AssertFalse(FConnection.IsOpen);
  TAssert.AssertTrue(FConnection.BrokenReason <> '');
  TAssert.AssertException(EKafkaConnection, SendMetadata);
end;

procedure TKafkaConnectionTests.OversizedResponse_BreaksWithProtocolError;
var
  V: Int16;
begin
  FParams.MaxResponseBytes := 1000;
  Connect;
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  FBroker.OversizedMetadata := True;
  FFuture := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('t').ToBytes(V));
  TAssert.AssertTrue(FFuture.Wait(WAIT_MS));
  TAssert.AssertException(EKafkaProtocol, ReadFutureBody);
  TAssert.AssertFalse(FConnection.IsOpen);
  TAssert.AssertException(EKafkaProtocol, SendMetadata);
end;

procedure TKafkaConnectionTests.Close_FailsInFlightAndIsIdempotent;
var
  V: Int16;
begin
  Connect;
  V := FConnection.NegotiatedVersion(KAFKA_API_KEY_METADATA);
  FBroker.HoldMetadata := True;
  FFuture := FConnection.Send(KAFKA_API_KEY_METADATA, V, MetadataFor('t').ToBytes(V));
  TAssert.AssertTrue(FBroker.WaitHeld(1, WAIT_MS));
  FConnection.Close;
  TAssert.AssertTrue(FFuture.IsDone);
  TAssert.AssertException(EKafkaConnection, ReadFutureBody);
  FConnection.Close;
  TAssert.AssertFalse(FConnection.IsOpen);
  TAssert.AssertException(EKafkaConnection, SendMetadata);
end;

procedure TKafkaConnectionTests.OpenTwice_IsRefused;
begin
  Connect;
  TAssert.AssertException(EKafka, OpenConnection);
  FConnection.Close;
  TAssert.AssertException(EKafka, OpenConnection);
end;

procedure TKafkaConnectionTests.ClosedPort_IsEKafkaConnection;
var
  L: TPcListener;
  Port: Word;
begin
  L := PcTcpListen('127.0.0.1', 0, Default(TPcTcpOptions));
  Port := L.Port;
  L.Close;
  L.Free;
  FParams := KafkaConnectionParams('127.0.0.1', Port);
  // Windows retries a refused SYN on loopback for about 2 s.
  FParams.ConnectTimeoutMs := 6000;
  FConnection := TKafkaConnection.Create(FParams);
  TAssert.AssertException(EKafkaConnection, OpenConnection);
  TAssert.AssertFalse(FConnection.IsOpen);
end;

procedure TKafkaConnectionTests.UseTlsBroker(ABackend: TPcTlsBackend;
  const ACaFile, AHost: string);
begin
  FreeAndNil(FBroker);
  FBroker := TKafkaFakeBroker.CreateTls;
  FParams := KafkaConnectionParams(AHost, FBroker.Port);
  FParams.UseTls := True;
  FParams.TlsBackend := ABackend;
  FParams.TlsCaFile := KafkaTestPkiDir + ACaFile;
  FParams.TlsHandshakeTimeoutMs := 5000;
end;

function TKafkaConnectionTests.OpenSslMissing: Boolean;
begin
  // Only on Windows can OpenSSL be absent while the tests still mean
  // something (SChannel's run anyway); elsewhere it is the only backend.
  Result := False;
  {$IFDEF MSWINDOWS}
  try
    UseTlsBroker(tbOpenSsl, 'ca_cert.pem', '127.0.0.1');
    FConnection := TKafkaConnection.Create(FParams);
    FConnection.Open;
  except
    on E: EKafkaTls do
      if Pos('OpenSSL', E.Message) > 0 then
      begin
        System.WriteLn('  [notice] OpenSSL not loadable, ', E.Message);
        Result := True;
      end
      else
        raise;
  end;
  {$ENDIF}
end;

procedure TKafkaConnectionTests.TlsAgainstPlaintext_IsAnEKafkaConnection;
var
  Raised: Boolean;
begin
  FParams.UseTls := True;
  FParams.TlsSkipServerVerification := True;
  FParams.TlsHandshakeTimeoutMs := 5000;
  FConnection := TKafkaConnection.Create(FParams);
  // The fake broker reads the ClientHello as an absurd frame size and hangs up.
  Raised := False;
  try
    FConnection.Open;
  except
    on E: EKafkaConnection do
      Raised := True;
  end;
  TAssert.AssertTrue('EKafkaConnection (or EKafkaTls)', Raised);
end;

procedure TKafkaConnectionTests.Tls_PrivateCa_DefaultBackend;
var
  R: TKafkaMetadataResponse;
begin
  UseTlsBroker(tbDefault, 'ca_cert.pem', '127.0.0.1');
  Connect;
  R := FConnection.Metadata(MetadataFor('over-tls'));
  TAssert.AssertEquals('over-tls', R.Topics[0].Name);
end;

procedure TKafkaConnectionTests.Tls_PrivateCa_OpenSsl;
var
  R: TKafkaMetadataResponse;
begin
  if OpenSslMissing then
    Exit;
  if FConnection = nil then
  begin
    // Off Windows OpenSslMissing doesn't connect.
    UseTlsBroker(tbOpenSsl, 'ca_cert.pem', '127.0.0.1');
    Connect;
  end;
  R := FConnection.Metadata(MetadataFor('over-openssl'));
  TAssert.AssertEquals('over-openssl', R.Topics[0].Name);
end;

procedure TKafkaConnectionTests.Tls_WrongCa_IsEKafkaTls;
begin
  UseTlsBroker(tbDefault, 'rogue_ca_cert.pem', '127.0.0.1');
  FConnection := TKafkaConnection.Create(FParams);
  TAssert.AssertException(EKafkaTls, OpenConnection);
end;

procedure TKafkaConnectionTests.Tls_WrongHostName_IsEKafkaTls;
begin
  // The certificate names localhost and 127.0.0.1; ask for another name
  // while connecting to the same address.
  UseTlsBroker(tbDefault, 'ca_cert.pem', '127.0.0.1');
  FParams.TlsServerName := 'kafka.example.com';
  FConnection := TKafkaConnection.Create(FParams);
  TAssert.AssertException(EKafkaTls, OpenConnection);
end;

procedure TKafkaConnectionTests.Header_CarriesClientIdAndFlexibleVersion;
begin
  Connect;
  FConnection.Metadata(MetadataFor('t'));
  TAssert.AssertEquals('test-client', FBroker.LastClientId);
  TAssert.AssertEquals(2, Integer(FBroker.LastHeaderVersion));
end;

