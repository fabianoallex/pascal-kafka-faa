procedure Append(var AData: TBytes; var ALength: Integer; const APart: TBytes);
begin
  if ALength + Length(APart) > Length(AData) then
    SetLength(AData, 2 * (ALength + Length(APart)));
  if Length(APart) > 0 then
    Move(APart[0], AData[ALength], Length(APart));
  Inc(ALength, Length(APart));
end;

function Text(ACount: Integer): TBytes;
var
  I, N: Integer;
begin
  Result := nil;
  N := 0;
  for I := 0 to ACount - 1 do
    Append(Result, N, Utf8(Format('record %d of a batch, key=k%d; ', [I, I mod 17])));
  SetLength(Result, N);
end;

function Pseudorandom(ACount: Integer): TBytes;
var
  I: Integer;
  X: Cardinal;
begin
  Result := nil;
  SetLength(Result, ACount);
  X := 12345;
  for I := 0 to ACount - 1 do
  begin
    // xorshift32: no multiplication to overflow under Delphi's $Q+.
    X := X xor (X shl 13);
    X := X xor (X shr 17);
    X := X xor (X shl 5);
    Result[I] := Byte(X);
  end;
end;

function Filled(ACount: Integer; AValue: Byte): TBytes;
begin
  Result := nil;
  SetLength(Result, ACount);
  if ACount > 0 then
    FillChar(Result[0], ACount, AValue);
end;

function Repeated(const AText: string; ACount: Integer): TBytes;
var
  I, N: Integer;
  B: TBytes;
begin
  B := Utf8(AText);
  N := Length(B);
  Result := nil;
  SetLength(Result, N * ACount);
  for I := 0 to ACount - 1 do
    Move(B[0], Result[I * N], N);
end;

function Join(const AParts: array of TBytes): TBytes;
var
  I, N: Integer;
begin
  Result := nil;
  for I := 0 to High(AParts) do
  begin
    N := Length(Result);
    SetLength(Result, N + Length(AParts[I]));
    if Length(AParts[I]) > 0 then
      Move(AParts[I][0], Result[N], Length(AParts[I]));
  end;
end;

function Shape(AIndex, ASize: Integer): TBytes;
var
  Half: TBytes;
begin
  case AIndex of
    0: Result := Filled(ASize, 0);
    1: Result := Copy(Repeated('0123456789abcdef', ASize div 16 + 1), 0, ASize);
    2: Result := Pseudorandom(ASize);
    3: Result := Copy(Repeated('ab', ASize div 2 + 1), 0, ASize);
  else
    begin
      // Random and repeated halves.
      Half := Pseudorandom(ASize div 2);
      Result := Join([Half, Copy(Text(ASize div 30 + 1), 0, ASize - ASize div 2)]);
    end;
  end;
end;

function Compressed(AShape: TShape; const AData: TBytes): TBytes;
begin
  case AShape of
    shSnappy: Result := KafkaSnappyCompress(AData);
    shSnappyRaw: Result := KafkaSnappyRawCompress(AData);
    shLz4: Result := KafkaLz4Compress(AData);
  else
    Result := KafkaLz4BlockCompress(AData);
  end;
end;

function Decompressed(AShape: TShape; const AData: TBytes; AMax: Integer): TBytes;
begin
  case AShape of
    shSnappy: Result := KafkaSnappyDecompress(AData, AMax);
    shSnappyRaw: Result := KafkaSnappyRawDecompress(AData, AMax);
    shLz4: Result := KafkaLz4Decompress(AData, AMax);
  else
    Result := KafkaLz4BlockDecompress(AData, AMax);
  end;
end;

/// The message of the EKafkaCompression decompressing AData raises, or ''
/// when it decompresses. Any other exception fails the test.
function ErrorOf(AShape: TShape; const AData: TBytes; AMax: Integer = LIMIT): string;
begin
  try
    Decompressed(AShape, AData, AMax);
    Result := '';
  except
    on E: EKafkaCompression do
      Result := E.Message;
  end;
end;

procedure CheckRefused(const AWhat: string; AShape: TShape; const AData: TBytes;
  const AWords: string; AMax: Integer = LIMIT);
var
  Msg: string;
begin
  Msg := ErrorOf(AShape, AData, AMax);
  TAssert.AssertTrue(AWhat + ': refused', Msg <> '');
  TAssert.AssertTrue(AWhat + ': "' + Msg + '" says "' + AWords + '"', Pos(AWords, Msg) > 0);
end;

procedure CheckGives(const AWhat: string; AShape: TShape; const AData, AExpected: TBytes);
begin
  TAssert.AssertTrue(AWhat, SameBytes(AExpected, Decompressed(AShape, AData, LIMIT)));
end;

function Lz4HeaderEnd(const AFrame: TBytes): Integer;
begin
  Result := 6;
  if (AFrame[4] and $08) <> 0 then
    Inc(Result, 8);
end;

/// The frame's header checksum made right again after a change to it.
procedure FixHeaderChecksum(var AFrame: TBytes);
var
  P: Integer;
begin
  P := Lz4HeaderEnd(AFrame);
  AFrame[P] := Byte(KafkaXxHash32(AFrame, 4, P - 4, 0) shr 8);
end;

function WithByte(const AData: TBytes; AIndex: Integer; AValue: Byte): TBytes;
begin
  Result := Copy(AData, 0, Length(AData));
  Result[AIndex] := AValue;
end;

function Lz4Frame(AFlg, ABd: Byte): TBytes;
begin
  Result := WithByte(WithByte(HexToBytes(LZ4_HELLO), 4, AFlg), 5, ABd);
  FixHeaderChecksum(Result);
end;

procedure TKafkaCompressionTests.XxHash32_KnownVectors;

  function H(const AText: string; ASeed: Cardinal): string;
  var
    B: TBytes;
  begin
    B := Utf8(AText);
    Result := IntToHex(Int64(KafkaXxHash32(B, 0, Length(B), ASeed)), 8);
  end;

var
  B: TBytes;
begin
  TAssert.AssertEquals('02CC5D05', H('', 0));
  TAssert.AssertEquals('550D7456', H('a', 0));
  TAssert.AssertEquals('32D153FF', H('abc', 0));
  TAssert.AssertEquals('E2293B2F', H('Nobody inspects the spammish repetition', 0));
  TAssert.AssertEquals('855ED232', H('0123456789abcdefXYZ', 0));
  TAssert.AssertEquals('36B78AE7', H('', $9E3779B1));
  TAssert.AssertEquals('A1AE7709', H('abc', $9E3779B1));
  TAssert.AssertEquals('C9E89E68', H('Nobody inspects the spammish repetition', $9E3779B1));
  // An offset into a larger buffer.
  B := Utf8('--abc--');
  TAssert.AssertEquals('32D153FF', IntToHex(Int64(KafkaXxHash32(B, 2, 3, 0)), 8));
  // lz4's header checksum of FLG 60, BD 40 (the second byte of the hash).
  B := Bytes([$60, $40]);
  TAssert.AssertEquals($82, Integer((KafkaXxHash32(B, 0, 2, 0) shr 8) and $FF));
end;

procedure TKafkaCompressionTests.Snappy_Raw_ReadsTheReferenceBlocks;
begin
  CheckGives('hello', shSnappyRaw, HexToBytes(SNAPPY_HELLO), Utf8('hello kafka'));
  CheckGives('text', shSnappyRaw, HexToBytes(SNAPPY_TEXT), Text(200));
  CheckGives('random', shSnappyRaw, HexToBytes(SNAPPY_RANDOM), Pseudorandom(300));
  CheckGives('run', shSnappyRaw, HexToBytes(SNAPPY_RUN), Repeated('ab', 500));
  // Text(200) shrinks to a fifth in the reference's hands.
  TAssert.AssertTrue(Length(HexToBytes(SNAPPY_TEXT)) * 4 < Length(Text(200)));
end;

procedure TKafkaCompressionTests.Snappy_Raw_EveryKindOfElement;
var
  R: TBytes;
begin
  // Literals: length in the tag, then in 1, 2, 3 and 4 more bytes.
  CheckGives('literal of 61', shSnappyRaw, Join([Bytes([61, $F0, 60]), Pseudorandom(61)]),
    Pseudorandom(61));
  CheckGives('literal of 300', shSnappyRaw, Join([Bytes([$AC, $02, $F4, $2B, $01]),
    Pseudorandom(300)]), Pseudorandom(300));
  R := Pseudorandom(70000);
  CheckGives('literal of 70000, 3 bytes', shSnappyRaw, Join([Bytes([$F0, $A2, $04, $F8, $6F,
    $11, $01]), R]), R);
  CheckGives('literal of 70000, 4 bytes', shSnappyRaw, Join([Bytes([$F0, $A2, $04, $FC, $6F,
    $11, $01, $00]), R]), R);
  // Copies: a 1-byte offset (length 4 to 11), 2 bytes (1 to 64), 4 bytes.
  CheckGives('copy, 1-byte offset', shSnappyRaw, HexToBytes('080c6162636401' + '04'),
    Utf8('abcdabcd'));
  CheckGives('copy, 2-byte offset', shSnappyRaw, HexToBytes('0e0c61626364' + '260400'),
    Utf8('abcdabcdabcdab'));
  CheckGives('copy, 4-byte offset', shSnappyRaw, HexToBytes('0a0c61626364' + '1702000000'),
    Utf8('abcdcdcdcd'));
  // Overlapping: one byte back, 64 times.
  CheckGives('a run', shSnappyRaw, HexToBytes('4100' + '7a' + 'fe0100'), Filled(65, Ord('z')));
  // Nothing at all.
  CheckGives('empty', shSnappyRaw, HexToBytes('00'), nil);
end;

procedure TKafkaCompressionTests.Snappy_Raw_RoundTrip_SeveralSizesAndShapes;
const
  SIZES: array[0..13] of Integer = (0, 1, 3, 4, 5, 59, 60, 61, 255, 256, 257, 65535, 65537,
    150000);
var
  I, S: Integer;
  Data, Z: TBytes;
begin
  for S := 0 to 4 do
    for I := 0 to High(SIZES) do
    begin
      Data := Shape(S, SIZES[I]);
      Z := KafkaSnappyRawCompress(Data);
      TAssert.AssertTrue(Format('shape %d, %d bytes', [S, SIZES[I]]),
        SameBytes(Data, KafkaSnappyRawDecompress(Z, SIZES[I])));
      // Incompressible data grows by little: the length and literal tags.
      TAssert.AssertTrue(Length(Z) <= 32 + SIZES[I] + SIZES[I] div 6);
    end;
  TAssert.AssertTrue('zeros shrink', Length(KafkaSnappyRawCompress(Shape(0, 150000))) < 8000);
  TAssert.AssertTrue('text shrinks', Length(KafkaSnappyRawCompress(Text(200))) < 2000);
end;

procedure TKafkaCompressionTests.Snappy_Raw_BadBlocks_AreRefused;
begin
  CheckRefused('nothing', shSnappyRaw, nil, 'ends inside its length');
  CheckRefused('a length cut', shSnappyRaw, HexToBytes('80'), 'ends inside its length');
  CheckRefused('a length of 33 bits', shSnappyRaw, HexToBytes('ffffffff1f'), 'fit 32 bits');
  // 1 000 000 bytes from 3: no block that size can hold that much.
  CheckRefused('a length beyond the block', shSnappyRaw, HexToBytes('c0843d' + 'fe0000'),
    'more than such a block can');
  CheckRefused('a copy from offset 0', shSnappyRaw, HexToBytes('080c6162636401' + '00'),
    'a copy from 0 bytes back');
  CheckRefused('a copy from before the start', shSnappyRaw, HexToBytes('080c6162636401' + '05'),
    'a copy from 5 bytes back, with 4');
  CheckRefused('a copy cut', shSnappyRaw, HexToBytes('080c61626364' + '2604'), 'cut short');
  CheckRefused('a literal past the end', shSnappyRaw, HexToBytes('05106162'), 'runs past');
  CheckRefused('more than declared', shSnappyRaw, HexToBytes('020c61626364'),
    'more than the 2 bytes');
  CheckRefused('less than declared', shSnappyRaw, HexToBytes('0508616263'),
    'gives 3 bytes and declares 5');
  CheckRefused('a copy past the declared length', shSnappyRaw,
    HexToBytes('060c61626364' + '0104'), 'more than the 6 bytes');
end;

procedure TKafkaCompressionTests.Snappy_LargerThanTheLimit_IsRefused;
var
  Z: TBytes;
begin
  Z := KafkaSnappyCompress(Filled(1000000, 0));
  TAssert.AssertTrue('a megabyte of zeros is small', Length(Z) < 60000);
  CheckRefused('framed', shSnappy, Z, 'more than 999999 bytes', 999999);
  TAssert.AssertEquals(1000000, Length(KafkaSnappyDecompress(Z, 1000000)));
  // A raw block says its size first: refused before anything is allocated.
  Z := KafkaSnappyRawCompress(Filled(1000000, 0));
  CheckRefused('raw', shSnappyRaw, Z, 'more than 999999 bytes', 999999);
  TAssert.AssertEquals(1000000, Length(KafkaSnappyRawDecompress(Z, 1000000)));
end;

procedure TKafkaCompressionTests.Snappy_Xerial_TheFramingJavaWrites;
const
  HEADER = '82534e41505059000000000100000001';
var
  Data, Z: TBytes;
  P, Chunks: Integer;
  Size: Cardinal;
begin
  // Java's SnappyOutputStream writes the header even with nothing after it.
  TAssert.AssertEquals(HEADER, BytesToHex(KafkaSnappyCompress(nil)));
  TAssert.AssertEquals(0, Length(KafkaSnappyDecompress(HexToBytes(HEADER), LIMIT)));
  // 100 000 bytes: chunks of 32 KiB, 3 whole and one of 1696, each a raw
  // block after its big-endian length.
  Data := Shape(4, 100000);
  Z := KafkaSnappyCompress(Data);
  TAssert.AssertEquals(HEADER, BytesToHex(Copy(Z, 0, 16)));
  P := 16;
  Chunks := 0;
  while P < Length(Z) do
  begin
    Size := (Cardinal(Z[P]) shl 24) or (Cardinal(Z[P + 1]) shl 16) or (Cardinal(Z[P + 2]) shl 8)
      or Z[P + 3];
    if Chunks < 3 then
      TAssert.AssertEquals('chunk ' + IntToStr(Chunks), 32768,
        Length(KafkaSnappyRawDecompress(Copy(Z, P + 4, Integer(Size)), LIMIT)))
    else
      TAssert.AssertEquals(100000 - 3 * 32768,
        Length(KafkaSnappyRawDecompress(Copy(Z, P + 4, Integer(Size)), LIMIT)));
    Inc(P, 4 + Integer(Size));
    Inc(Chunks);
  end;
  TAssert.AssertEquals(4, Chunks);
  TAssert.AssertEquals(Length(Z), P);
  TAssert.AssertTrue(SameBytes(Data, KafkaSnappyDecompress(Z, LIMIT)));
  TAssert.AssertTrue(SameBytes(Data, KafkaDecompress(kcSnappy, KafkaCompress(kcSnappy, Data),
    LIMIT)));
end;

procedure TKafkaCompressionTests.Snappy_Xerial_ReadsConcatenatedStreamsAndRawBlocks;
var
  A, B: TBytes;
begin
  A := Text(50);
  B := Pseudorandom(40000);
  // Two streams one after the other, as xerial reads them: one content.
  CheckGives('concatenated', shSnappy, Join([KafkaSnappyCompress(A), KafkaSnappyCompress(B)]),
    Join([A, B]));
  // A raw block (librdkafka's producers) through the same reader, also
  // the reference's.
  CheckGives('raw, this library''s', shSnappy, KafkaSnappyRawCompress(B), B);
  CheckGives('raw, the reference''s', shSnappy, HexToBytes(SNAPPY_TEXT), Text(200));
  CheckGives('raw, short', shSnappy, HexToBytes(SNAPPY_HELLO), Utf8('hello kafka'));
  // The magic with less than a header after it is not xerial (Java reads
  // it as a raw block, which it isn't).
  CheckRefused('the magic alone', shSnappy, HexToBytes('82534e4150505900'), 'snappy');
end;

procedure TKafkaCompressionTests.Snappy_Xerial_BadFramings_AreRefused;
const
  HEADER = '82534e41505059000000000100000001';
var
  Z: TBytes;
begin
  Z := KafkaSnappyCompress(Utf8('hello kafka'));
  CheckRefused('bytes after the last chunk', shSnappy, Join([Z, Bytes([0, 0])]),
    '2 bytes after the last chunk');
  CheckRefused('a chunk longer than what is left', shSnappy, Join([HexToBytes(HEADER),
    HexToBytes('00000064'), Utf8('hello')]), 'a chunk of 100 bytes with 5 left');
  CheckRefused('a negative chunk length', shSnappy, Join([HexToBytes(HEADER),
    HexToBytes('ffffff00'), Utf8('hello')]), 'with 5 left');
  CheckRefused('an empty chunk', shSnappy, Join([HexToBytes(HEADER), HexToBytes('00000000')]),
    'ends inside its length');
  CheckRefused('version 0', shSnappy, HexToBytes('82534e41505059000000000000000001'),
    'framing version 0');
  CheckRefused('a chunk cut short', shSnappy, Copy(Z, 0, Length(Z) - 1), 'with');
  // Each chunk is a block of its own: the second may not copy from the first.
  CheckRefused('a copy into the chunk before', shSnappy, Join([HexToBytes(HEADER),
    HexToBytes('00000006' + '040c61626364'), HexToBytes('00000003' + '040104')]),
    'a copy from 4 bytes back, with 0');
end;

procedure TKafkaCompressionTests.Lz4_ReadsTheReferenceFrames;
var
  Z: TBytes;
begin
  CheckGives('hello', shLz4, HexToBytes(LZ4_HELLO), Utf8('hello kafka'));
  CheckGives('checksums and content size', shLz4, HexToBytes(LZ4_TEXT_ALL), Text(200));
  CheckGives('4 MiB blocks', shLz4, HexToBytes(LZ4_TEXT_4MB), Text(200));
  CheckGives('LZ4HC', shLz4, HexToBytes(LZ4_TEXT_HC), Text(200));
  CheckGives('three blocks with checksums', shLz4, HexToBytes(LZ4_ZEROS_BLOCKS),
    Filled(150000, 0));
  CheckGives('a block stored uncompressed', shLz4, HexToBytes(LZ4_RANDOM), Pseudorandom(300));
  Z := HexToBytes(LZ4_TEXT_ALL);
  TAssert.AssertEquals('FLG: version 1, independent, both checksums, content size', $7C,
    Integer(Z[4]));
end;

procedure TKafkaCompressionTests.Lz4_TheFrameJavaWrites;
var
  Z: TBytes;
  P, Blocks: Integer;
  Size: Cardinal;
begin
  // Magic, FLG 60 (version 1, independent blocks, nothing else), BD 40
  // (64 KiB), the header checksum, then the end mark. Java writes no block
  // for no data.
  TAssert.AssertEquals('04224d186040' + '82' + '00000000', BytesToHex(KafkaLz4Compress(nil)));
  TAssert.AssertEquals(0, Length(KafkaLz4Decompress(KafkaLz4Compress(nil), LIMIT)));
  // 150 000 zeros: two whole blocks and one of 18 928, compressed.
  Z := KafkaLz4Compress(Filled(150000, 0));
  P := 7;
  Blocks := 0;
  repeat
    Size := Cardinal(Z[P]) or (Cardinal(Z[P + 1]) shl 8) or (Cardinal(Z[P + 2]) shl 16) or
      (Cardinal(Z[P + 3]) shl 24);
    Inc(P, 4);
    if Size <> 0 then
    begin
      TAssert.AssertTrue('compressed', (Size and $80000000) = 0);
      if Blocks < 2 then
        TAssert.AssertEquals(65536, Length(KafkaLz4BlockDecompress(Copy(Z, P, Integer(Size)),
          65536)))
      else
        TAssert.AssertEquals(150000 - 2 * 65536,
          Length(KafkaLz4BlockDecompress(Copy(Z, P, Integer(Size)), 65536)));
      Inc(P, Integer(Size));
      Inc(Blocks);
    end;
  until Size = 0;
  TAssert.AssertEquals(3, Blocks);
  TAssert.AssertEquals(Length(Z), P);
  // Random bytes don't shrink: the block goes as it is, its size's high
  // bit set.
  Z := KafkaLz4Compress(Pseudorandom(300));
  TAssert.AssertEquals('2c010080', BytesToHex(Copy(Z, 7, 4)));
  TAssert.AssertTrue(SameBytes(Pseudorandom(300), Copy(Z, 11, 300)));
  TAssert.AssertEquals(7 + 4 + 300 + 4, Length(Z));
  // The reference library writes the same bytes for that frame.
  TAssert.AssertEquals(LZ4_RANDOM, BytesToHex(Z));
end;

procedure TKafkaCompressionTests.Lz4_HeaderChecksum_Kip57;
var
  Z: TBytes;
begin
  Z := HexToBytes(LZ4_HELLO);
  TAssert.AssertEquals($82, Integer(Z[6]));
  // Kafka 0.8's checksum, over the magic number too: 1a for FLG 60, BD 40.
  TAssert.AssertEquals($1A, Integer(Byte(KafkaXxHash32(Z, 0, 6, 0) shr 8)));
  CheckRefused('the broken checksum', shLz4, WithByte(Z, 6, $1A), 'KIP-57');
  CheckRefused('another wrong checksum', shLz4, WithByte(Z, 6, $00),
    'header checksum 00, 82 expected');
end;

procedure TKafkaCompressionTests.Lz4_WhatJavaRefuses_IsRefused;
begin
  // Each with its header checksum right, so the field itself is refused.
  TAssert.AssertEquals('', ErrorOf(shLz4, Lz4Frame($60, $40)));
  CheckRefused('dependent blocks', shLz4, Lz4Frame($40, $40), 'dependent blocks');
  CheckRefused('a dictionary id', shLz4, Lz4Frame($61, $40), 'dictionary id');
  CheckRefused('a reserved flag', shLz4, Lz4Frame($62, $40), 'reserved flag');
  CheckRefused('version 2', shLz4, Lz4Frame($A0, $40), 'frame version 2');
  CheckRefused('version 0', shLz4, Lz4Frame($20, $40), 'frame version 0');
  CheckRefused('block size code 3', shLz4, Lz4Frame($60, $30), 'block size code 3');
  CheckRefused('reserved descriptor bits', shLz4, Lz4Frame($60, $41), 'block descriptor');
  CheckRefused('a legacy frame', shLz4, HexToBytes('02214c18' + '0000000000'), 'not an lz4 frame');
end;

procedure TKafkaCompressionTests.Lz4_CorruptFrames_AreRefused;
var
  Hello, All, Zeros, Z: TBytes;
begin
  Hello := HexToBytes(LZ4_HELLO);
  All := HexToBytes(LZ4_TEXT_ALL);
  Zeros := HexToBytes(LZ4_ZEROS_BLOCKS);
  CheckRefused('short', shLz4, Copy(Hello, 0, 6), 'shorter than a frame header');
  CheckRefused('no end mark', shLz4, Copy(Hello, 0, Length(Hello) - 4), 'before its end mark');
  CheckRefused('a block cut', shLz4, Copy(Hello, 0, 16), 'a block of 11 bytes with 5 left');
  CheckRefused('bytes after the frame', shLz4, Join([Hello, Bytes([0])]),
    '1 bytes after the frame');
  // The first block's checksum (FLG 70: block checksums), after its 267 bytes.
  TAssert.AssertEquals('0b010000', BytesToHex(Copy(Zeros, 7, 4)));
  CheckRefused('a block checksum', shLz4, WithByte(Zeros, 11 + 267, Zeros[11 + 267] xor 1),
    'block checksum doesn''t match');
  CheckRefused('the content checksum', shLz4, WithByte(All, Length(All) - 1,
    All[Length(All) - 1] xor 1), 'content checksum doesn''t match');
  // Content size 6171 for 6170 bytes (and the header checksum made right).
  Z := WithByte(All, 6, All[6] + 1);
  FixHeaderChecksum(Z);
  CheckRefused('the content size', shLz4, Z, 'says 6171 bytes and holds 6170');
  // A block larger than the frame's maximum.
  CheckRefused('a block above 64 KiB', shLz4, HexToBytes('04224d186040' + '82' + '01000180'),
    'above the frame''s 65536');
  // Blocks are independent: the second may not copy from the first ("abcd",
  // stored), even 4 bytes back.
  CheckRefused('a match into the block before', shLz4, HexToBytes('04224d186040' + '82' +
    '04000080' + '61626364' + '05000000' + '0004001065' + '00000000'),
    'a match from 4 bytes back, with 0 bytes before it in the block');
  // A compressed block whose bytes don't decode.
  CheckRefused('a block that doesn''t decode', shLz4, HexToBytes('04224d186040' + '82' +
    '07000000' + '40616263640000' + '00000000'), 'a match from 0 bytes back');
end;

procedure TKafkaCompressionTests.Lz4_Block_ByHandAndFromTheReference;
begin
  CheckGives('the reference', shLz4Block, HexToBytes(LZ4_BLOCK_TEXT), Text(200));
  // 4 literals and a match of 4 from 4 back, then a last literal.
  CheckGives('a match', shLz4Block, HexToBytes('40616263640400' + '1065'), Utf8('abcdabcde'));
  // 1 literal, then a match of 4 + 15 + 10 from 1 back (a run), then a last
  // sequence of no literals.
  CheckGives('a run', shLz4Block, HexToBytes('1f6101000a' + '00'), Filled(30, Ord('a')));
  // Literal lengths of 15 and more take extra bytes: 15 + 255 + 30.
  CheckGives('a long literal', shLz4Block, Join([HexToBytes('f0ff1e'), Pseudorandom(300)]),
    Pseudorandom(300));
  CheckGives('nothing', shLz4Block, HexToBytes('00'), nil);
end;

procedure TKafkaCompressionTests.Lz4_Block_BadBlocks_AreRefused;
begin
  CheckRefused('empty', shLz4Block, nil, 'an empty compressed block');
  CheckRefused('offset 0', shLz4Block, HexToBytes('40616263640000' + '00'),
    'a match from 0 bytes back');
  CheckRefused('before the start', shLz4Block, HexToBytes('40616263640500' + '00'),
    'a match from 5 bytes back, with 4');
  CheckRefused('ending with a match', shLz4Block, HexToBytes('40616263640400'),
    'ends with a match');
  CheckRefused('literals past the end', shLz4Block, HexToBytes('5061626364'), '5 literals with 4');
  CheckRefused('an offset cut', shLz4Block, HexToBytes('406162636404'), 'offset is cut short');
  CheckRefused('a literal length cut', shLz4Block, HexToBytes('f0ff'), 'literal length is cut');
  CheckRefused('a match length cut', shLz4Block, HexToBytes('1f610100'), 'match length is cut');
  CheckRefused('larger than allowed', shLz4Block, HexToBytes(LZ4_BLOCK_TEXT),
    'more than its 6169 bytes', 6169);
end;

procedure TKafkaCompressionTests.Lz4_RoundTrip_SeveralSizesAndShapes;
const
  SIZES: array[0..14] of Integer = (0, 1, 4, 12, 13, 14, 59, 255, 256, 270, 65535, 65536,
    65537, 131072, 200000);
var
  I, S: Integer;
  Data, Z: TBytes;
begin
  for S := 0 to 4 do
    for I := 0 to High(SIZES) do
    begin
      Data := Shape(S, SIZES[I]);
      Z := KafkaLz4Compress(Data);
      TAssert.AssertTrue(Format('frame, shape %d, %d bytes', [S, SIZES[I]]),
        SameBytes(Data, KafkaLz4Decompress(Z, SIZES[I])));
      // At worst each block goes as it is: 4 bytes more per block.
      TAssert.AssertTrue(Length(Z) <= 11 + SIZES[I] + 4 * (SIZES[I] div 65536 + 1));
      if SIZES[I] <= 65536 then
        TAssert.AssertTrue(Format('block, shape %d, %d bytes', [S, SIZES[I]]),
          SameBytes(Data, KafkaLz4BlockDecompress(KafkaLz4BlockCompress(Data), SIZES[I])));
    end;
  TAssert.AssertTrue('zeros shrink', Length(KafkaLz4Compress(Shape(0, 200000))) < 1000);
  TAssert.AssertTrue('text shrinks', Length(KafkaLz4Compress(Text(200))) < 2000);
end;

procedure TKafkaCompressionTests.Lz4_LargerThanTheLimit_IsRefused;
var
  Z: TBytes;
begin
  Z := KafkaLz4Compress(Filled(1000000, 0));
  TAssert.AssertTrue('a megabyte of zeros is small', Length(Z) < 5000);
  CheckRefused('the frame', shLz4, Z, 'more than 999999 bytes', 999999);
  TAssert.AssertEquals(1000000, Length(KafkaLz4Decompress(Z, 1000000)));
  // A frame that says its size is refused before its blocks are read.
  CheckRefused('the content size', shLz4, HexToBytes(LZ4_TEXT_ALL), 'its frame says 6170', 6169);
end;

procedure TKafkaCompressionTests.CorruptInput_IsDecodedOrRefused_NothingElse;
var
  X: Cardinal;

  function Rnd(N: Integer): Integer;
  begin
    X := X xor (X shl 13);
    X := X xor (X shr 17);
    X := X xor (X shl 5);
    Result := Integer(X mod Cardinal(N));
  end;

var
  S, I, K, N: Integer;
  AShape: TShape;
  Z, M: TBytes;
begin
  X := 2463534242;
  for S := 1 to 4 do
    for AShape := Low(TShape) to High(TShape) do
    begin
      Z := Compressed(AShape, Shape(S, 20000));
      for I := 1 to 250 do
      begin
        M := Copy(Z, 0, Length(Z));
        case Rnd(3) of
          0:
            for K := 0 to Rnd(3) do
              M[Rnd(Length(M))] := Byte(Rnd(256));
          1:
            SetLength(M, Rnd(Length(M)));
        else
          begin
            N := Rnd(Length(M));
            M := Join([Copy(M, 0, N), Bytes([$FF, Byte(Rnd(256))]), BytesFrom(M, N)]);
          end;
        end;
        // EKafkaCompression is caught; anything else fails the test.
        ErrorOf(AShape, M, 1 shl 20);
      end;
    end;
end;

procedure TKafkaCompressionTests.RecordBatch_SnappyAndLz4_EncodeThenDecode;
var
  Batch, Back: TKafkaRecordBatch;
  Codec: TKafkaCompression;
  Batches: TKafkaRecordBatchArray;
  Trailing, I: Integer;
  Plain, Zipped: TBytes;
begin
  for Codec := kcSnappy to kcLz4 do
  begin
    Batch.Init;
    for I := 0 to 99 do
      Batch.Append(KafkaRecord(Utf8('key-' + IntToStr(I mod 7)),
        Utf8(Format('value %d, olá, %s', [I, StringOfChar('x', I)])), 1000 + I));
    Plain := Batch.Encode;
    Batch.SetCompression(Codec);
    Zipped := Batch.Encode;
    TAssert.AssertTrue(KafkaCompressionName(Codec) + ' shrinks the batch',
      Length(Zipped) < Length(Plain) div 2);
    Batches := KafkaDecodeRecordBatches(Zipped, LIMIT, Trailing);
    TAssert.AssertEquals(1, Length(Batches));
    Back := Batches[0];
    TAssert.AssertEquals(Ord(Codec), Ord(Back.Compression));
    TAssert.AssertEquals(100, Length(Back.Records));
    for I := 0 to 99 do
    begin
      TAssert.AssertEquals('key-' + IntToStr(I mod 7), FromUtf8(Back.Records[I].Key));
      TAssert.AssertEquals(Format('value %d, olá, %s', [I, StringOfChar('x', I)]),
        FromUtf8(Back.Records[I].Value));
      TAssert.AssertEquals(Int64(1000 + I), Back.Records[I].Timestamp);
    end;
  end;
  TAssert.AssertTrue(KafkaCompressionSupported(kcSnappy));
  TAssert.AssertTrue(KafkaCompressionSupported(kcLz4));
end;

initialization
  RegisterTest(TKafkaCompressionTests);

end.
