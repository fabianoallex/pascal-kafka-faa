  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  CallMetadata;
end;

procedure TKafkaSaslConnectionTests.OAuth_RefusedToken_IsAuthenticationFailedWithTheJson;
const
  JSON = '{"status":"invalid_token", "scope":"[kafka]", ' +
    '"openid-configuration":"https://issuer.example/.well-known/openid-configuration"}';
var
  LCode: Int16;
  LMessage: string;
begin
  UseOAuth;
  FBroker.OAuthRejectToken := 'token-1';
  FBroker.OAuthErrorJson := JSON;
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertEquals(JSON, FBrokerMessage);
  TAssert.AssertTrue(LMessage, Pos(JSON, LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('OAUTHBEARER', LMessage) > 0);
  TAssert.AssertTrue('no token in: ' + LMessage, Pos('token-1', LMessage) = 0);
  TAssert.AssertEquals(0, FBroker.SaslAuthenticatedCount);
  // The next connection asks again, gets token-2, which the broker takes.
  Connect;
  TAssert.AssertEquals('token-1,token-2', FBroker.OAuthTokensSeen);
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
end;

procedure TKafkaSaslConnectionTests.OAuth_NoProviderRaisingProviderOrBadToken_FailBeforeSending;
var
  LCode: Int16;
  LMessage: string;
begin
  UseOAuth;
  FParams.SaslOAuthBearerTokenProvider := nil;
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(0, Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('no token provider', LMessage) > 0);

  FParams.SaslOAuthBearerTokenProvider := NextToken;
  FProviderRaises := True;
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(0, Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('the issuer is down', LMessage) > 0);

  FProviderRaises := False;
  FBadToken := 'secret token';
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(0, Integer(LCode));
  TAssert.AssertTrue('no token in: ' + LMessage, Pos('secret', LMessage) = 0);

  // Nothing reached the broker past ApiVersions.
  TAssert.AssertEquals('', FBroker.LastSaslMechanism);
  TAssert.AssertEquals('', FBroker.OAuthTokensSeen);
end;

procedure TKafkaSaslConnectionTests.OAuth_EachConnectionAsksTheProvider;
var
  Second: TKafkaConnection;
begin
  UseOAuth;
  Connect;
  Second := TKafkaConnection.Create(FParams);
  try
    Second.Open;
    TAssert.AssertEquals('token-1,token-2', FBroker.OAuthTokensSeen);
    TAssert.AssertEquals(2, FBroker.SaslAuthenticatedCount);
  finally
    Second.Free;
  end;
end;

procedure TKafkaSaslConnectionTests.OAuth_Kip368_NewConnectionTakesANewToken;
var
  LBrokers: TKafkaFakeBrokerArray;
  P: TKafkaClusterParams;
  C: TKafkaCluster;
  L1, L2: IKafkaBrokerConnection;
  LSeen: string;
begin
  UseOAuth;
  SetLength(LBrokers, 1);
  LBrokers[0] := FBroker;
  KafkaFakeUseView(LBrokers, KafkaFakeClusterView(LBrokers, 'renewed', [1]));
  // Due at once: 85% to 95% of 1 ms rounds down to the moment it was sent.
  FBroker.SaslSessionLifetimeMs := 1;
  P := KafkaClusterParams('127.0.0.1:' + IntToStr(FBroker.Port));
  P.Connection := FParams;
  P.MaxBlockMs := 10000;
  C := TKafkaCluster.Create(P);
  try
    C.Open;
    C.Topic('renewed');
    L1 := C.Leader('renewed', 0);
    TAssert.AssertTrue(L1.Connection.ReauthenticationDue);
    LSeen := FBroker.OAuthTokensSeen;
    L2 := C.Leader('renewed', 0);
    TAssert.AssertTrue('a new connection', L2.Connection <> L1.Connection);
    // The new connection asked the provider again.
    TAssert.AssertEquals(LSeen + ',token-' + IntToStr(PcAtomicGet(FTokenCount)),
      FBroker.OAuthTokensSeen);
    TAssert.AssertTrue(FTokenCount >= 3);
  finally
    L1 := nil;
    L2 := nil;
    C.Free;
  end;
end;

procedure TKafkaSaslConnectionTests.OAuth_Producer_Delivers;
var
  P: TKafkaProducerParams;
  LProducer: TKafkaProducer;
  LBrokers: TKafkaFakeBrokerArray;
  R: TKafkaDeliveryReport;
begin
  UseOAuth;
  SetLength(LBrokers, 1);
  LBrokers[0] := FBroker;
  KafkaFakeUseView(LBrokers, KafkaFakeClusterView(LBrokers, 'secured', [1]));
  P := KafkaProducerParams('127.0.0.1:' + IntToStr(FBroker.Port));
  P.Cluster.Connection.SaslMechanism := ksmOAuthBearer;
  P.Cluster.Connection.SaslOAuthBearerTokenProvider := NextToken;
  P.Cluster.MaxBlockMs := 10000;
  P.LingerMs := 0;
  LProducer := TKafkaProducer.Create(P);
  try
    LProducer.Open;
    R := LProducer.Send(KafkaProducerRecord('secured', PcStringToUtf8Bytes('hello'))).Get(10000);
    TAssert.AssertEquals(Int64(0), R.Offset);
  finally
    LProducer.Free;
  end;
  // The bootstrap connection and the leader's, each with its own token.
  TAssert.AssertEquals('token-1,token-2', FBroker.OAuthTokensSeen);
