unit Kafka.Crc32cTests;

{$mode delphi}{$H+}

{ GENERATED FILE — produced by tools/gen_fpc_mirror.py from
  tests/Unit/Kafka.Crc32cTests.pas (DUnitX). Do not edit by hand: edit the DUnitX
  master and run the script again. }

{ Tests for Kafka.Protocol.Crc32c against published vectors: the five of
  RFC 3720, appendix B.4 (32 zero bytes, 32 bytes of $FF, 32 ascending, 32
  descending, and an iSCSI read command PDU), and the CRC-32C check value of
  "123456789" (0xE3069283, from the CRC catalogue). The RFC prints each CRC
  as the bytes sent on the wire, least significant first: "aa 36 91 8a" is
  $8A9136AA. Also: a running CRC fed in pieces equals the one-call CRC, and
  the empty input.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  Kafka.Protocol.Crc32c,
  Kafka.TestHelpers;

type
  TKafkaCrc32cTests = class(TTestCase)
  published
    procedure Rfc3720_32Zeros;
    procedure Rfc3720_32Ones;
    procedure Rfc3720_32Ascending;
    procedure Rfc3720_32Descending;
    procedure Rfc3720_IscsiReadPdu;
    procedure CheckValue_123456789;
    procedure Empty_IsZero;
    procedure Running_InPieces_EqualsOneCall;
    procedure OffsetAndCount;
  end;

implementation

function Filled(AValue: Byte): TBytes;
begin
  Result := nil;
  SetLength(Result, 32);
  FillChar(Result[0], 32, AValue);
end;

procedure TKafkaCrc32cTests.Rfc3720_32Zeros;
begin
  TAssert.AssertEquals(Int64($8A9136AA), Int64(KafkaCrc32c(Filled(0))));
end;

procedure TKafkaCrc32cTests.Rfc3720_32Ones;
begin
  TAssert.AssertEquals(Int64($62A8AB43), Int64(KafkaCrc32c(Filled($FF))));
end;

procedure TKafkaCrc32cTests.Rfc3720_32Ascending;
var
  B: TBytes;
  I: Integer;
begin
  B := Filled(0);
  for I := 0 to 31 do
    B[I] := I;
  TAssert.AssertEquals(Int64($46DD794E), Int64(KafkaCrc32c(B)));
end;

procedure TKafkaCrc32cTests.Rfc3720_32Descending;
var
  B: TBytes;
  I: Integer;
begin
  B := Filled(0);
  for I := 0 to 31 do
    B[I] := 31 - I;
  TAssert.AssertEquals(Int64($113FDB5C), Int64(KafkaCrc32c(B)));
end;

procedure TKafkaCrc32cTests.Rfc3720_IscsiReadPdu;
const
  PDU = '01c00000 00000000 00000000 00000000' +
        '14000000 00000400 00000014 00000018' +
        '28000000 00000000 02000000 00000000';
begin
  TAssert.AssertEquals(Int64($D9963A56), Int64(KafkaCrc32c(HexToBytes(PDU))));
end;

procedure TKafkaCrc32cTests.CheckValue_123456789;
begin
  TAssert.AssertEquals(Int64($E3069283), Int64(KafkaCrc32c(HexToBytes('313233343536373839'))));
end;

procedure TKafkaCrc32cTests.Empty_IsZero;
begin
  TAssert.AssertEquals(Int64(0), Int64(KafkaCrc32c(nil)));
end;

procedure TKafkaCrc32cTests.Running_InPieces_EqualsOneCall;
var
  B: TBytes;
  Crc: Cardinal;
begin
  B := HexToBytes('313233343536373839');
  Crc := KafkaCrc32cInit;
  Crc := KafkaCrc32cUpdate(Crc, B[0], 4);
  Crc := KafkaCrc32cUpdate(Crc, B[4], 5);
  TAssert.AssertEquals(Int64($E3069283), Int64(KafkaCrc32cFinal(Crc)));
end;

procedure TKafkaCrc32cTests.OffsetAndCount;
begin
  // "123456789" inside other bytes.
  TAssert.AssertEquals(Int64($E3069283),
    Int64(KafkaCrc32c(HexToBytes('ffff 313233343536373839 ff'), 2, 9)));
end;

initialization
  RegisterTest(TKafkaCrc32cTests);

end.
