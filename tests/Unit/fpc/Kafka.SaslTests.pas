  TAssert.AssertEquals('PLAIN', KafkaSaslMechanismName(ksmPlain));
  TAssert.AssertEquals('SCRAM-SHA-256', KafkaSaslMechanismName(ksmScramSha256));
  TAssert.AssertEquals('SCRAM-SHA-512', KafkaSaslMechanismName(ksmScramSha512));
  TAssert.AssertEquals('OAUTHBEARER', KafkaSaslMechanismName(ksmOAuthBearer));
  TAssert.AssertEquals('', KafkaSaslMechanismName(ksmNone));
end;

procedure TKafkaSaslTests.Create_NoMechanismOrEmptyUser_IsRefused;
begin
  FMechanism := ksmNone;
  FUser := 'alice';
  TAssert.AssertException(EKafka, CreateClient);
  // OAUTHBEARER takes a token: TKafkaOAuthBearerClient.
  FMechanism := ksmOAuthBearer;
  TAssert.AssertException(EKafka, CreateClient);
  FMechanism := ksmPlain;
  FUser := '';
  TAssert.AssertException(EKafkaAuthentication, CreateClient);
  FMechanism := ksmScramSha256;
  TAssert.AssertException(EKafkaAuthentication, CreateClient);
  FUser := 'alice';
  CreateClient;
  TAssert.AssertEquals('SCRAM-SHA-256', FClient.Mechanism);
  TAssert.AssertEquals(Ord(kshSha256), Ord((FClient as TKafkaScramClient).Hash));
  FMechanism := ksmScramSha512;
  CreateClient;
  TAssert.AssertEquals('SCRAM-SHA-512', FClient.Mechanism);
  TAssert.AssertEquals(Ord(kshSha512), Ord((FClient as TKafkaScramClient).Hash));
end;

procedure TKafkaSaslTests.Plain_InitialResponse_IsNulSeparatedUtf8;
begin
  FClient := TKafkaSaslPlainClient.Create('alice', 'São Paulo');
  TAssert.AssertEquals('PLAIN', FClient.Mechanism);
  // "" NUL "alice" NUL "São Paulo", the ã in two bytes.
  TAssert.AssertEquals('00616c6963650053c3a36f205061756c6f', BytesToHex(FClient.InitialResponse));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertException(EKafkaAuthentication, InitialResponse);
end;

procedure TKafkaSaslTests.Plain_EmptyAnswerCompletes_AnythingElseIsRefused;
begin
  FClient := TKafkaSaslPlainClient.Create('alice', 'secret');
  FChallenge := nil;
  TAssert.AssertException('before the initial response', EKafkaAuthentication, Evaluate);
  FClient.InitialResponse;
  FChallenge := Bytes([1]);
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  TAssert.AssertFalse(FClient.IsComplete);
  FChallenge := nil;
  TAssert.AssertEquals(0, Length(FClient.Evaluate(FChallenge)));
  TAssert.AssertTrue(FClient.IsComplete);
  TAssert.AssertException('after completing', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Plain_NulInUserName_IsRefused;
begin
  TAssert.AssertException(EKafkaAuthentication, CreatePlainWithNul);
end;

procedure TKafkaSaslTests.OAuth_InitialResponse_IsJavasFormat;
begin
  FClient := TKafkaOAuthBearerClient.Create('eyJh.eyJz.', nil);
  TAssert.AssertEquals('OAUTHBEARER', FClient.Mechanism);
  // n,, ^A auth=Bearer <token> ^A ^A
  TAssert.AssertEquals(BytesToHex(Utf8Of('n,,' + #1 + 'auth=Bearer eyJh.eyJz.' + #1 + #1)),
    BytesToHex(FClient.InitialResponse));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertException(EKafkaAuthentication, InitialResponse);
  // Extensions after the token, in the order given, each ended by ^A.
  SetLength(FExtensions, 2);
  FExtensions[0] := KafkaSaslExtension('logicalCluster', 'lkc-123');
  FExtensions[1] := KafkaSaslExtension('identityPoolId', 'pool a');
  FreeAndNil(FClient);
  FClient := TKafkaOAuthBearerClient.Create('t0k3n==', FExtensions);
  TAssert.AssertEquals(BytesToHex(Utf8Of('n,,' + #1 + 'auth=Bearer t0k3n==' + #1 +
    'logicalCluster=lkc-123' + #1 + 'identityPoolId=pool a' + #1 + #1)),
    BytesToHex(FClient.InitialResponse));
end;

procedure TKafkaSaslTests.OAuth_EmptyAnswerCompletes_ErrorJsonIsAnsweredWithKvsep;
const
  JSON = '{"status":"invalid_token", "scope":"[kafka]"}';
var
  LMessage: string;
begin
  FClient := TKafkaOAuthBearerClient.Create('a.b.', nil);
  FChallenge := nil;
  TAssert.AssertException('before the initial response', EKafkaAuthentication, Evaluate);
  FreeAndNil(FClient);
  FClient := TKafkaOAuthBearerClient.Create('a.b.', nil);
  FClient.InitialResponse;
  TAssert.AssertEquals(0, Length(FClient.Evaluate(nil)));
  TAssert.AssertTrue(FClient.IsComplete);
  TAssert.AssertException('after completing', EKafkaAuthentication, Evaluate);

  // A refusal: the JSON as the challenge, answered with kvsep alone.
  FreeAndNil(FClient);
  FClient := TKafkaOAuthBearerClient.Create('a.b.', nil);
  FClient.InitialResponse;
  TAssert.AssertEquals('01', BytesToHex(FClient.Evaluate(Utf8Of(JSON))));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertEquals(JSON, (FClient as TKafkaOAuthBearerClient).ServerError);
  // A broker that went on instead of failing the exchange: refused here.
  LMessage := '';
  try
    FClient.Evaluate(nil);
  except
    on E: EKafkaAuthentication do
      LMessage := E.Message;
  end;
  TAssert.AssertTrue(LMessage, Pos(JSON, LMessage) > 0);
  TAssert.AssertFalse(FClient.IsComplete);
end;

procedure TKafkaSaslTests.OAuth_BadTokenOrExtension_IsRefusedWithoutTheToken;
const
  BAD_TOKENS: array[0..5] of string = ('', 'secret token', 'secret' + #1 + 'token',
    'secret=token', 'secrét', 'secret,token');
var
  I: Integer;
  LMessage: string;
begin
  FExtensions := nil;
  for I := 0 to High(BAD_TOKENS) do
  begin
    FToken := BAD_TOKENS[I];
    LMessage := '';
    try
      CreateOAuth;
      TAssert.Fail('accepted token ' + IntToStr(I));
    except
      on E: EKafkaAuthentication do
        LMessage := E.Message;
    end;
    TAssert.AssertTrue(LMessage, LMessage <> '');
    TAssert.AssertTrue('no token in: ' + LMessage, Pos('secret', LMessage) = 0);
  end;
  FToken := 'a.b.';
  SetLength(FExtensions, 1);
  // Java's checks: names of letters only and not "auth", values printable
  // ASCII, space, tab, CR, LF, not empty.
  FExtensions[0] := KafkaSaslExtension('auth', 'x');
  TAssert.AssertException('auth', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('trace_id', 'x');
  TAssert.AssertException('underscore', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('', 'x');
  TAssert.AssertException('no name', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('traceId', '');
  TAssert.AssertException('no value', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('traceId', 'a' + #1 + 'b');
  TAssert.AssertException('kvsep in a value', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('traceId', 'São');
  TAssert.AssertException('not ASCII', EKafkaAuthentication, CreateOAuth);
  FExtensions[0] := KafkaSaslExtension('traceId', 'a b' + #9 + 'c' + #13#10 + '~!');
  CreateOAuth;
  SetLength(FExtensions, 2);
  FExtensions[1] := KafkaSaslExtension('traceId', 'again');
  TAssert.AssertException('twice', EKafkaAuthentication, CreateOAuth);
end;

procedure TKafkaSaslTests.OAuth_IsBearerToken_Rfc6750;
begin
  TAssert.AssertTrue(KafkaIsOAuthBearerToken('eyJhbGciOiJub25lIn0.eyJzdWIiOiJhIn0.'));
  TAssert.AssertTrue(KafkaIsOAuthBearerToken('AZaz09-._~+/'));
  TAssert.AssertTrue('trailing =', KafkaIsOAuthBearerToken('abc=='));
  TAssert.AssertFalse('= alone', KafkaIsOAuthBearerToken('=='));
  TAssert.AssertFalse('= inside', KafkaIsOAuthBearerToken('a=b'));
  TAssert.AssertFalse('empty', KafkaIsOAuthBearerToken(''));
  TAssert.AssertFalse('space', KafkaIsOAuthBearerToken('a b'));
  TAssert.AssertFalse('comma', KafkaIsOAuthBearerToken('a,b'));
end;

procedure TKafkaSaslTests.Scram_Rfc7677_ClientMessagesAndServerSignature;
var
  LFinal: TBytes;
begin
  FClient := TKafkaScramClient.CreateWithNonce(kshSha256, 'user', 'pencil', RFC_NONCE);
  TAssert.AssertEquals('SCRAM-SHA-256', FClient.Mechanism);
  TAssert.AssertEquals('n,,n=user,r=' + RFC_NONCE, Text(FClient.InitialResponse));
  LFinal := FClient.Evaluate(Utf8Of(RFC_SERVER_FIRST));
  TAssert.AssertEquals(RFC_CLIENT_FINAL, Text(LFinal));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertEquals(0, Length(FClient.Evaluate(Utf8Of(RFC_SERVER_FINAL))));
  TAssert.AssertTrue(FClient.IsComplete);
  FChallenge := nil;
  TAssert.AssertException('after completing', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_WrongServerSignature_IsRefused;
begin
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  // The RFC's signature with its first character changed.
  FChallenge := Utf8Of('v=7rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  TAssert.AssertFalse(FClient.IsComplete);
  // Not Base64 at all.
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('v=***');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Neither v= nor e=.
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('x=1');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_ServerError_IsRefusedWithItsText;
begin
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('e=invalid-proof');
  try
    FClient.Evaluate(FChallenge);
    TAssert.Fail('no exception');
  except
    on E: EKafkaAuthentication do
      TAssert.AssertTrue(E.Message, Pos('invalid-proof', E.Message) > 0);
  end;
  TAssert.AssertFalse(FClient.IsComplete);
end;

procedure TKafkaSaslTests.Scram_NonceNotExtended_IsRefused;
begin
  // The client's nonce alone, not extended.
  ScramAfterFirst('r=' + RFC_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Another nonce.
  ScramAfterFirst('r=XOprNGfwEbeRWgbNEkqOabc,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Attributes out of order.
  ScramAfterFirst('s=W22ZaJ0SNY7soEsUEjb6gQ==,r=' + RFC_SERVER_NONCE + ',i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_IterationsOutOfRangeOrNotANumber_AreRefused;
const
  BASE = 'r=' + RFC_SERVER_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ==,i=';
begin
  ScramAfterFirst(BASE + '4095');
  TAssert.AssertException('4095', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '16385');
  TAssert.AssertException('16385', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '99999999999');
  TAssert.AssertException('too long', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '$1000');
  TAssert.AssertException('hex', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE);
  TAssert.AssertException('empty', EKafkaAuthentication, Evaluate);
  // 16384 is accepted (extensions after it are ignored).
  ScramAfterFirst(BASE + '16384,x=ext');
  TAssert.AssertTrue(Pos(',p=', Text(FClient.Evaluate(FChallenge))) > 0);
end;

procedure TKafkaSaslTests.Scram_MandatoryExtensionOrBadSalt_IsRefused;
begin
  ScramAfterFirst('m=ext,' + RFC_SERVER_FIRST);
  TAssert.AssertException('m=', EKafkaAuthentication, Evaluate);
  ScramAfterFirst('r=' + RFC_SERVER_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ,i=4096');
  TAssert.AssertException('salt without its pad', EKafkaAuthentication, Evaluate);
  ScramAfterFirst('r=' + RFC_SERVER_NONCE + ',s=,i=4096');
  TAssert.AssertException('empty salt', EKafkaAuthentication, Evaluate);
  FreeAndNil(FClient);
  FClient := TKafkaScramClient.CreateWithNonce(kshSha256, 'user', 'pencil', RFC_NONCE);
  FClient.InitialResponse;
  FChallenge := Bytes([$72, $3D, $FF]); // "r=" and a byte that isn't UTF-8
  TAssert.AssertException('not UTF-8', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_RandomNonce_DiffersEachTime;
var
  A, B: string;
begin
  FClient := TKafkaScramClient.Create(kshSha256, 'a=b,c', 'x');
  A := Text(FClient.InitialResponse);
  FreeAndNil(FClient);
  FClient := TKafkaScramClient.Create(kshSha256, 'a=b,c', 'x');
  B := Text(FClient.InitialResponse);
  TAssert.AssertEquals('n,,n=a=3Db=2Cc,r=', Copy(A, 1, 17));
  // 24 random bytes in Base64: 32 characters.
  TAssert.AssertEquals(17 + 32, Length(A));
  TAssert.AssertTrue(A <> B);
end;

procedure TKafkaSaslTests.Scram512_DraftMelnikov_ClientMessagesAndServerSignature;
var
  LFinal: TBytes;
begin
  FClient := TKafkaScramClient.CreateWithNonce(kshSha512, 'user', 'pencil', RFC_NONCE);
  TAssert.AssertEquals('SCRAM-SHA-512', FClient.Mechanism);
  TAssert.AssertEquals('n,,n=user,r=' + RFC_NONCE, Text(FClient.InitialResponse));
  LFinal := FClient.Evaluate(Utf8Of(SHA512_SERVER_FIRST));
  // A 64-byte proof: 88 Base64 characters.
  TAssert.AssertEquals(SHA512_CLIENT_FINAL, Text(LFinal));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertEquals(0, Length(FClient.Evaluate(Utf8Of(SHA512_SERVER_FINAL))));
  TAssert.AssertTrue(FClient.IsComplete);
end;

procedure TKafkaSaslTests.Scram512_WrongServerSignature_IsRefused;
begin
  FClient := TKafkaScramClient.CreateWithNonce(kshSha512, 'user', 'pencil', RFC_NONCE);
  FClient.InitialResponse;
  FClient.Evaluate(Utf8Of(SHA512_SERVER_FIRST));
  // The draft's signature with its first character changed.
  FChallenge := Utf8Of('v=CQuhnKHqYDwQWS5jAw4sZed+C9KFUALsbrq81bB0mh+bcUUbbMPNNmBIupnS2Amy' +
    'yDnG5CTBQtkjJ9kyY4kzmw==');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  TAssert.AssertFalse(FClient.IsComplete);
  // SCRAM-SHA-256's signature for the same exchange: 32 bytes, not 64.
  FreeAndNil(FClient);
  FClient := TKafkaScramClient.CreateWithNonce(kshSha512, 'user', 'pencil', RFC_NONCE);
  FClient.InitialResponse;
  FClient.Evaluate(Utf8Of(SHA512_SERVER_FIRST));
  FChallenge := Utf8Of(RFC_SERVER_FINAL);
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
end;

function AuthRequestBytes(const AName: string): TBytes;
var
  R: TKafkaSaslAuthenticateRequest;
begin
  R.FromBytes(CaptureRequestBody(AName), CaptureVersion(AName));
  Result := R.AuthBytes;
end;

function AuthResponse(const AName: string): TKafkaSaslAuthenticateResponse;
begin
  Result.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
end;

function HandshakeResponse(const AName: string): TKafkaSaslHandshakeResponse;
begin
  Result.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
end;

procedure TKafkaSaslTests.Java_Plain_SameInitialResponse;
var
  H: TKafkaSaslHandshakeRequest;
  A: TKafkaSaslAuthenticateResponse;
begin
  H.FromBytes(CaptureRequestBody('java-plain-sasl-handshake-v1'), 1);
  TAssert.AssertEquals('PLAIN', H.Mechanism);
  FClient := TKafkaSaslPlainClient.Create('alice', 'alice-secret');
  TAssert.AssertEquals(BytesToHex(AuthRequestBytes('java-plain-sasl-authenticate-v2-step1')),
    BytesToHex(FClient.InitialResponse));
  A := AuthResponse('java-plain-sasl-authenticate-v2-step1');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals(0, Length(FClient.Evaluate(A.AuthBytes)));
  TAssert.AssertTrue(FClient.IsComplete);
end;

/// Java's SCRAM exchange in the captures APrefix: given its nonce, this
/// client writes the same messages, and the broker's signature verifies.
procedure CheckJavaScram(var AClient: TKafkaSaslClient; const APrefix, AMechanism: string;
  AHash: TKafkaScramHash; const AUser, APassword: string);
var
  H: TKafkaSaslHandshakeRequest;
  JavaFirst, Nonce: string;
  P: Integer;
  A1, A2: TKafkaSaslAuthenticateResponse;
begin
  H.FromBytes(CaptureRequestBody(APrefix + '-sasl-handshake-v1'), 1);
  TAssert.AssertEquals(AMechanism, H.Mechanism);
  JavaFirst := Text(AuthRequestBytes(APrefix + '-sasl-authenticate-v2-step1'));
  P := Pos(',r=', JavaFirst);
  TAssert.AssertEquals('n,,n=' + AUser + ',r=', Copy(JavaFirst, 1, P + 2));
  Nonce := Copy(JavaFirst, P + 3, MaxInt);
  AClient := TKafkaScramClient.CreateWithNonce(AHash, AUser, APassword, Nonce);
  TAssert.AssertEquals(AMechanism, AClient.Mechanism);
  TAssert.AssertEquals('client-first', JavaFirst, Text(AClient.InitialResponse));
  A1 := AuthResponse(APrefix + '-sasl-authenticate-v2-step1');
  TAssert.AssertEquals(0, Integer(A1.ErrorCode));
  // The broker's salt and iteration count (8192, docker/kafka-start.sh).
  TAssert.AssertTrue(Text(A1.AuthBytes), Pos(',i=8192', Text(A1.AuthBytes)) > 0);
  TAssert.AssertEquals('client-final, the proof included',
    Text(AuthRequestBytes(APrefix + '-sasl-authenticate-v2-step2')),
    Text(AClient.Evaluate(A1.AuthBytes)));
  A2 := AuthResponse(APrefix + '-sasl-authenticate-v2-step2');
  TAssert.AssertEquals(0, Integer(A2.ErrorCode));
  TAssert.AssertEquals(0, Length(AClient.Evaluate(A2.AuthBytes)));
  TAssert.AssertTrue('the broker''s signature verified', AClient.IsComplete);
end;

procedure TKafkaSaslTests.Java_Scram_SameNonce_SameMessages_TheBrokersSignatureVerifies;
begin
  CheckJavaScram(FClient, 'java-scram', 'SCRAM-SHA-256', kshSha256, 'bob', 'bob-secret');
end;

procedure TKafkaSaslTests.Java_Scram512_SameNonce_SameMessages_TheBrokersSignatureVerifies;
begin
  CheckJavaScram(FClient, 'java-scram512', 'SCRAM-SHA-512', kshSha512, 'carol',
    'carol-secret');
end;

/// The token in an OAUTHBEARER initial response (after "auth=Bearer ").
function BearerToken(const AInitialResponse: string): string;
var
  P: Integer;
begin
  P := Pos('auth=Bearer ', AInitialResponse);
  TAssert.AssertTrue(AInitialResponse, P > 0);
  Result := Copy(AInitialResponse, P + Length('auth=Bearer '), MaxInt);
  Result := Copy(Result, 1, Pos(#1, Result) - 1);
end;

procedure TKafkaSaslTests.Java_OAuth_SameInitialResponse_Completes;
var
  H: TKafkaSaslHandshakeRequest;
  A: TKafkaSaslAuthenticateResponse;
  JavaInitial: string;
begin
  H.FromBytes(CaptureRequestBody('java-oauth-sasl-handshake-v1'), 1);
  TAssert.AssertEquals('OAUTHBEARER', H.Mechanism);
  TAssert.AssertEquals('OAUTHBEARER', HandshakeResponse('java-oauth-sasl-handshake-v1').Mechanisms[0]);
  JavaInitial := Text(AuthRequestBytes('java-oauth-sasl-authenticate-v2-step1'));
  // unsecuredLoginExtension_traceId="abc123" in Java's JAAS line.
  SetLength(FExtensions, 1);
  FExtensions[0] := KafkaSaslExtension('traceId', 'abc123');
  FClient := TKafkaOAuthBearerClient.Create(BearerToken(JavaInitial), FExtensions);
  TAssert.AssertEquals(BytesToHex(AuthRequestBytes('java-oauth-sasl-authenticate-v2-step1')),
    BytesToHex(FClient.InitialResponse));
  A := AuthResponse('java-oauth-sasl-authenticate-v2-step1');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals(0, Length(FClient.Evaluate(A.AuthBytes)));
  TAssert.AssertTrue(FClient.IsComplete);
  // Java's unsecured login token lasts an hour, and so does the session
  // (KIP-368: the broker takes the credential's lifetime).
  TAssert.AssertTrue(IntToStr(A.SessionLifetimeMs), (A.SessionLifetimeMs > 3500000) and
    (A.SessionLifetimeMs <= 3600000));
end;

procedure TKafkaSaslTests.Java_OAuth_ScopeRefused_SameKvsep_TheJsonInTheError;
const
  JSON = '{"status":"insufficient_scope", "scope":"[kafka]"}';
var
  A1, A2: TKafkaSaslAuthenticateResponse;
begin
  FClient := TKafkaOAuthBearerClient.Create(BearerToken(Text(AuthRequestBytes(
    'java-oauth-scope-sasl-authenticate-v2-step1'))), nil);
  TAssert.AssertEquals(BytesToHex(AuthRequestBytes('java-oauth-scope-sasl-authenticate-v2-step1')),
    BytesToHex(FClient.InitialResponse));
  A1 := AuthResponse('java-oauth-scope-sasl-authenticate-v2-step1');
  TAssert.AssertEquals('a challenge, not an error', 0, Integer(A1.ErrorCode));
  TAssert.AssertEquals(JSON, Text(A1.AuthBytes));
  TAssert.AssertEquals('Java''s kvsep', BytesToHex(AuthRequestBytes(
    'java-oauth-scope-sasl-authenticate-v2-step2')), BytesToHex(FClient.Evaluate(A1.AuthBytes)));
  A2 := AuthResponse('java-oauth-scope-sasl-authenticate-v2-step2');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(A2.ErrorCode));
  TAssert.AssertEquals(JSON, A2.ErrorMessage);
  TAssert.AssertEquals(JSON, (FClient as TKafkaOAuthBearerClient).ServerError);
end;

procedure TKafkaSaslTests.HandBuiltOAuth_RequestsAndAnswers;
const
  NAMES: array[0..2] of string = ('sasl-authenticate-v0-oauth', 'sasl-authenticate-v1-oauth',
    'sasl-authenticate-v2-oauth');
  // 2100-01-01 less the day of the capture (2026-11-03): about 73 years.
  SEVENTY_YEARS_MS = Int64(70) * 365 * 24 * 3600 * 1000;
var
  R: TKafkaSaslAuthenticateRequest;
  A: TKafkaSaslAuthenticateResponse;
  Token: string;
  V: Int16;
begin
  Token := BearerToken(Text(AuthRequestBytes('sasl-authenticate-v2-oauth')));
  for V := 0 to 2 do
  begin
    FreeAndNil(FClient);
    FClient := TKafkaOAuthBearerClient.Create(Token, nil);
    R.Init;
    R.AuthBytes := FClient.InitialResponse;
    TAssert.AssertEquals(NAMES[V], BytesToHex(CaptureRequestBody(NAMES[V])),
      BytesToHex(R.ToBytes(V)));
    A := AuthResponse(NAMES[V]);
    TAssert.AssertEquals(0, Integer(A.ErrorCode));
    TAssert.AssertEquals(0, Length(FClient.Evaluate(A.AuthBytes)));
    TAssert.AssertTrue(FClient.IsComplete);
    if V = 0 then
      TAssert.AssertEquals('v0 has no lifetime', Int64(0), A.SessionLifetimeMs)
    else
      TAssert.AssertTrue('the token''s exp: ' + IntToStr(A.SessionLifetimeMs),
        A.SessionLifetimeMs > SEVENTY_YEARS_MS);
  end;
  SetLength(FExtensions, 1);
  FExtensions[0] := KafkaSaslExtension('traceId', 'abc123');
  FreeAndNil(FClient);
  FClient := TKafkaOAuthBearerClient.Create(Token, FExtensions);
  R.Init;
  R.AuthBytes := FClient.InitialResponse;
  TAssert.AssertEquals(BytesToHex(CaptureRequestBody('sasl-authenticate-v2-oauth-extension')),
    BytesToHex(R.ToBytes(2)));
  TAssert.AssertEquals(0, Integer(AuthResponse('sasl-authenticate-v2-oauth-extension').ErrorCode));

  // A token that expired: the JSON as the challenge, then error 58 with it.
  FreeAndNil(FClient);
  FClient := TKafkaOAuthBearerClient.Create(
    BearerToken(Text(AuthRequestBytes('sasl-authenticate-v2-oauth-expired'))), nil);
  FClient.InitialResponse;
  A := AuthResponse('sasl-authenticate-v2-oauth-expired');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals('{"status":"invalid_token"}', Text(A.AuthBytes));
  R.Init;
  R.AuthBytes := FClient.Evaluate(A.AuthBytes);
  TAssert.AssertEquals(BytesToHex(CaptureRequestBody('sasl-authenticate-v2-oauth-after-error')),
    BytesToHex(R.ToBytes(2)));
  A := AuthResponse('sasl-authenticate-v2-oauth-after-error');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(A.ErrorCode));
  TAssert.AssertEquals('{"status":"invalid_token"}', A.ErrorMessage);
  // An initial response without auth: Java's generic refusal.
  A := AuthResponse('sasl-authenticate-v2-oauth-malformed');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(A.ErrorCode));
  TAssert.AssertEquals('Authentication failed during authentication due to invalid ' +
    'credentials with SASL mechanism OAUTHBEARER', A.ErrorMessage);
end;

procedure TKafkaSaslTests.HandBuiltRequests_EncodeToTheCapturedBytes;
const
  NAMES: array[0..2] of string = ('sasl-authenticate-v0', 'sasl-authenticate-v1',
    'sasl-authenticate-v2');
var
  H: TKafkaSaslHandshakeRequest;
  A: TKafkaSaslAuthenticateRequest;
  V: Int16;
begin
  H.Init;
  H.Mechanism := 'PLAIN';
  for V := 0 to 1 do
    TAssert.AssertEquals('handshake v' + IntToStr(V),
      BytesToHex(CaptureRequestBody('sasl-handshake-v' + IntToStr(V))), BytesToHex(H.ToBytes(V)));
  FClient := TKafkaSaslPlainClient.Create('alice', 'alice-secret');
  A.Init;
  A.AuthBytes := FClient.InitialResponse;
  for V := 0 to 2 do
    TAssert.AssertEquals(NAMES[V], BytesToHex(CaptureRequestBody(NAMES[V])),
      BytesToHex(A.ToBytes(V)));
end;

procedure TKafkaSaslTests.BrokerAnswers_Decode;
var
  H: TKafkaSaslHandshakeResponse;
  A: TKafkaSaslAuthenticateResponse;
begin
  H := HandshakeResponse('sasl-handshake-v1');
  TAssert.AssertEquals(0, Integer(H.ErrorCode));
  TAssert.AssertEquals(2, Length(H.Mechanisms));
  TAssert.AssertEquals('PLAIN', H.Mechanisms[0]);
  TAssert.AssertEquals('SCRAM-SHA-256', H.Mechanisms[1]);
  H := HandshakeResponse('sasl-handshake-v1-unsupported');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_UNSUPPORTED_SASL_MECHANISM), Integer(H.ErrorCode));
  TAssert.AssertEquals(2, Length(H.Mechanisms));

  A := AuthResponse('sasl-authenticate-v0');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals(0, Length(A.AuthBytes));
  TAssert.AssertEquals('v0 has no lifetime', Int64(0), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2');
  TAssert.AssertEquals('no connections.max.reauth.ms', Int64(0), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v1-lifetime');
  TAssert.AssertEquals(Int64(2000), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2-lifetime');
  TAssert.AssertEquals(Int64(2000), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2-failed');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(A.ErrorCode));
  TAssert.AssertFalse(A.ErrorMessageIsNull);
  TAssert.AssertEquals('Authentication failed: Invalid username or password', A.ErrorMessage);
end;

initialization
  RegisterTest(TKafkaSaslTests);

end.
