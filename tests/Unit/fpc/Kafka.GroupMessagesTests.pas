const
  RECORDS_TOPIC = 'captured-records';
  GROUP = 'captured-group';

function Int32s(AValue: Int32): TKafkaInt32Array;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AValue;
end;

function Strings(const AValue: string): TKafkaStringArray;
begin
  Result := nil;
  SetLength(Result, 1);
  Result[0] := AValue;
end;

/// The topic id the broker gave RECORDS_TOPIC, from OffsetCommit v10's request.
function CapturedTopicId: TKafkaUuid;
var
  R: TKafkaOffsetCommitRequest;
begin
  R.FromBytes(CaptureRequestBody('offset-commit-v10'), 10);
  Result := R.Topics[0].TopicId;
end;

procedure TKafkaGroupMessagesTests.FindCoordinator_HandBuilt_EncodeToTheCapturedBytes;
var
  R: TKafkaFindCoordinatorRequest;
  Ver: Int16;
  Name: string;
begin
  for Ver := 0 to 6 do
  begin
    Name := 'find-coordinator-v' + IntToStr(Ver);
    R.Init;
    if Ver <= 3 then
      R.Key := GROUP
    else
    begin
      SetLength(R.CoordinatorKeys, 1);
      R.CoordinatorKeys[0] := GROUP;
    end;
    R.KeyType := 0;
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(R.ToBytes(Ver)));
  end;
end;

procedure TKafkaGroupMessagesTests.FindCoordinator_Answers_NameTheCoordinator;
var
  R: TKafkaFindCoordinatorResponse;
  Ver: Int16;
  Name: string;
begin
  for Ver := 0 to 6 do
  begin
    Name := 'find-coordinator-v' + IntToStr(Ver);
    R.FromBytes(CaptureResponseBody(Name), Ver);
    if Ver <= 3 then
    begin
      TAssert.AssertEquals(Name, 0, Integer(R.ErrorCode));
      TAssert.AssertEquals(Name, 1, R.NodeId);
      TAssert.AssertEquals(Name, 'localhost', R.Host);
      TAssert.AssertEquals(Name, 9092, R.Port);
    end
    else
    begin
      TAssert.AssertEquals(Name, 1, Length(R.Coordinators));
      TAssert.AssertEquals(Name, GROUP, R.Coordinators[0].Key);
      TAssert.AssertEquals(Name, 0, Integer(R.Coordinators[0].ErrorCode));
      TAssert.AssertEquals(Name, 1, R.Coordinators[0].NodeId);
      TAssert.AssertEquals(Name, 'localhost', R.Coordinators[0].Host);
      TAssert.AssertEquals(Name, 9092, R.Coordinators[0].Port);
    end;
  end;
  // The Java consumer asked the same in v6, of a broker that had just
  // started: the coordinator was still loading.
  R.FromBytes(CaptureResponseBody('java-consumer-group-find-coordinator-v6'), 6);
  TAssert.AssertEquals('captured-java-group', R.Coordinators[0].Key);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_COORDINATOR_NOT_AVAILABLE),
    Integer(R.Coordinators[0].ErrorCode));
  TAssert.AssertEquals(-1, R.Coordinators[0].NodeId);
  TAssert.AssertEquals('', R.Coordinators[0].Host);
  TAssert.AssertEquals(-1, R.Coordinators[0].Port);
end;

procedure TKafkaGroupMessagesTests.OffsetCommit_HandBuilt_EncodeToTheCapturedBytes;
var
  R: TKafkaOffsetCommitRequest;
  Ver: Int16;
  Name: string;
begin
  for Ver := 2 to 10 do
  begin
    Name := 'offset-commit-v' + IntToStr(Ver);
    R.Init;
    R.GroupId := GROUP;
    R.GenerationIdOrMemberEpoch := -1;
    R.MemberId := '';
    SetLength(R.Topics, 1);
    R.Topics[0].Init;
    if Ver >= 10 then
      R.Topics[0].TopicId := CapturedTopicId
    else
      R.Topics[0].Name := RECORDS_TOPIC;
    SetLength(R.Topics[0].Partitions, 1);
    R.Topics[0].Partitions[0].Init;
    R.Topics[0].Partitions[0].PartitionIndex := 0;
    R.Topics[0].Partitions[0].CommittedOffset := 100 + Ver;
    R.Topics[0].Partitions[0].CommittedMetadata := 'commit v' + IntToStr(Ver);
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(R.ToBytes(Ver)));
  end;
end;

procedure TKafkaGroupMessagesTests.OffsetCommit_Answers_AcceptEveryCommit;
var
  R: TKafkaOffsetCommitResponse;
  Ver: Int16;
  Name: string;
begin
  for Ver := 2 to 10 do
  begin
    Name := 'offset-commit-v' + IntToStr(Ver);
    R.FromBytes(CaptureResponseBody(Name), Ver);
    TAssert.AssertEquals(Name, 1, Length(R.Topics));
    if Ver < 10 then
      TAssert.AssertEquals(Name, RECORDS_TOPIC, R.Topics[0].Name)
    else
      TAssert.AssertTrue(Name, R.Topics[0].TopicId.Equals(CapturedTopicId));
    TAssert.AssertEquals(Name, 0, R.Topics[0].Partitions[0].PartitionIndex);
    TAssert.AssertEquals(Name, 0, Integer(R.Topics[0].Partitions[0].ErrorCode));
  end;
  // The Java consumer's commit when it closed.
  R.FromBytes(CaptureResponseBody('java-consumer-group-offset-commit-v10'), 10);
  TAssert.AssertEquals(0, Integer(R.Topics[0].Partitions[0].ErrorCode));
end;

procedure TKafkaGroupMessagesTests.OffsetFetch_HandBuilt_EncodeToTheCapturedBytes;
var
  R: TKafkaOffsetFetchRequest;
  Ver: Int16;
  Name: string;
begin
  for Ver := 1 to 10 do
  begin
    Name := 'offset-fetch-v' + IntToStr(Ver);
    R.Init;
    if Ver <= 7 then
    begin
      R.GroupId := GROUP;
      SetLength(R.Topics, 1);
      R.Topics[0].Init;
      R.Topics[0].Name := RECORDS_TOPIC;
      R.Topics[0].PartitionIndexes := Int32s(0);
      R.TopicsIsNull := False;
    end
    else
    begin
      SetLength(R.Groups, 1);
      R.Groups[0].Init;
      R.Groups[0].GroupId := GROUP;
      SetLength(R.Groups[0].Topics, 1);
      R.Groups[0].TopicsIsNull := False;
      R.Groups[0].Topics[0].Init;
      if Ver >= 10 then
        R.Groups[0].Topics[0].TopicId := CapturedTopicId
      else
        R.Groups[0].Topics[0].Name := RECORDS_TOPIC;
      R.Groups[0].Topics[0].PartitionIndexes := Int32s(0);
    end;
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(R.ToBytes(Ver)));
  end;
end;

procedure TKafkaGroupMessagesTests.OffsetFetch_EveryVersion_ReadsTheLastCommit;
var
  R: TKafkaOffsetFetchResponse;
  Ver: Int16;
  Name: string;
  P: TKafkaOffsetFetchResponsePartitions;
begin
  for Ver := 1 to 10 do
  begin
    Name := 'offset-fetch-v' + IntToStr(Ver);
    R.FromBytes(CaptureResponseBody(Name), Ver);
    if Ver <= 7 then
    begin
      TAssert.AssertEquals(Name, 0, Integer(R.ErrorCode));
      TAssert.AssertEquals(Name, RECORDS_TOPIC, R.Topics[0].Name);
      TAssert.AssertEquals(Name, Int64(110), R.Topics[0].Partitions[0].CommittedOffset);
      TAssert.AssertEquals(Name, 'commit v10', R.Topics[0].Partitions[0].Metadata);
      TAssert.AssertEquals(Name, 0, Integer(R.Topics[0].Partitions[0].ErrorCode));
    end
    else
    begin
      TAssert.AssertEquals(Name, GROUP, R.Groups[0].GroupId);
      TAssert.AssertEquals(Name, 0, Integer(R.Groups[0].ErrorCode));
      P := R.Groups[0].Topics[0].Partitions[0];
      TAssert.AssertEquals(Name, Int64(110), P.CommittedOffset);
      TAssert.AssertEquals(Name, 'commit v10', P.Metadata);
      TAssert.AssertEquals(Name, -1, P.CommittedLeaderEpoch);
    end;
  end;
end;

function HeartbeatRequest(AJoin: Boolean; AVersion: Int16): TKafkaConsumerGroupHeartbeatRequest;
begin
  Result.Init;
  Result.GroupId := 'captured-cgh-v' + IntToStr(AVersion);
  Result.MemberId := 'capture-member-v' + IntToStr(AVersion);
  if AJoin then
  begin
    Result.MemberEpoch := 0;
    Result.RebalanceTimeoutMs := 300000;
    Result.SubscribedTopicNames := Strings(RECORDS_TOPIC);
    Result.SubscribedTopicNamesIsNull := False;
    Result.TopicPartitions := nil;
    Result.TopicPartitionsIsNull := False;     // [] on joining
  end
  else
    Result.MemberEpoch := -1;                  // leave; the rest null
end;

procedure TKafkaGroupMessagesTests.Heartbeat_HandBuilt_EncodeToTheCapturedBytes;
var
  Ver: Int16;
  Name: string;
begin
  for Ver := 0 to 1 do
  begin
    Name := 'consumer-group-heartbeat-v' + IntToStr(Ver) + '-join';
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)),
      BytesToHex(HeartbeatRequest(True, Ver).ToBytes(Ver)));
    Name := 'consumer-group-heartbeat-v' + IntToStr(Ver) + '-leave';
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)),
      BytesToHex(HeartbeatRequest(False, Ver).ToBytes(Ver)));
  end;
end;

procedure TKafkaGroupMessagesTests.Heartbeat_JoinAndLeave_Answers;
var
  R: TKafkaConsumerGroupHeartbeatResponse;
  Ver: Int16;
  Name: string;
  I: Integer;
begin
  for Ver := 0 to 1 do
  begin
    Name := 'consumer-group-heartbeat-v' + IntToStr(Ver) + '-join';
    R.FromBytes(CaptureResponseBody(Name), Ver);
    TAssert.AssertEquals(Name, 0, Integer(R.ErrorCode));
    TAssert.AssertEquals(Name, 'capture-member-v' + IntToStr(Ver), R.MemberId);
    TAssert.AssertTrue(Name + ' epoch', R.MemberEpoch > 0);
    // group.consumer.heartbeat.interval.ms's default.
    TAssert.AssertEquals(Name, 5000, R.HeartbeatIntervalMs);
    TAssert.AssertFalse(Name + ' an assignment', R.AssignmentIsNull);
    TAssert.AssertEquals(Name, 1, Length(R.Assignment.TopicPartitions));
    TAssert.AssertTrue(Name, R.Assignment.TopicPartitions[0].TopicId.Equals(CapturedTopicId));
    // The only member: every partition of the topic (3, KAFKA_NUM_PARTITIONS).
    TAssert.AssertEquals(Name, 3, Length(R.Assignment.TopicPartitions[0].Partitions));
    for I := 0 to 2 do
      TAssert.AssertEquals(Name, I, R.Assignment.TopicPartitions[0].Partitions[I]);
    Name := 'consumer-group-heartbeat-v' + IntToStr(Ver) + '-leave';
    R.FromBytes(CaptureResponseBody(Name), Ver);
    TAssert.AssertEquals(Name, 0, Integer(R.ErrorCode));
    TAssert.AssertEquals(Name, -1, R.MemberEpoch);
    TAssert.AssertTrue(Name, R.AssignmentIsNull);
  end;
end;

procedure TKafkaGroupMessagesTests.Describe_SeesTheMember;
var
  Q: TKafkaConsumerGroupDescribeRequest;
  R: TKafkaConsumerGroupDescribeResponse;
  G: TKafkaConsumerGroupDescribeResponseDescribedGroup;
  Ver: Int16;
  Name: string;
begin
  for Ver := 0 to 1 do
  begin
    Name := 'consumer-group-describe-v' + IntToStr(Ver);
    Q.Init;
    Q.GroupIds := Strings('captured-cgh-v' + IntToStr(Ver));
    TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(Q.ToBytes(Ver)));
    R.FromBytes(CaptureResponseBody(Name), Ver);
    TAssert.AssertEquals(Name, 1, Length(R.Groups));
    G := R.Groups[0];
    TAssert.AssertEquals(Name, 0, Integer(G.ErrorCode));
    TAssert.AssertEquals(Name, 'captured-cgh-v' + IntToStr(Ver), G.GroupId);
    TAssert.AssertEquals(Name, 'Stable', G.GroupState);
    TAssert.AssertEquals(Name, 'uniform', G.AssignorName);
    TAssert.AssertEquals(Name, 1, Length(G.Members));
    TAssert.AssertEquals(Name, 'capture-member-v' + IntToStr(Ver), G.Members[0].MemberId);
    TAssert.AssertEquals(Name, 'pascal-kafka-faa-capture', G.Members[0].ClientId);
    TAssert.AssertEquals(Name, RECORDS_TOPIC, G.Members[0].SubscribedTopicNames[0]);
    TAssert.AssertEquals(Name, 3, Length(G.Members[0].Assignment.TopicPartitions[0].Partitions));
    TAssert.AssertEquals(Name, RECORDS_TOPIC, G.Members[0].Assignment.TopicPartitions[0].TopicName);
    if Ver >= 1 then
      TAssert.AssertEquals(Name + ' MemberType: consumer', 1, Integer(G.Members[0].MemberType))
    else
      TAssert.AssertEquals(Name + ' MemberType: absent', -1, Integer(G.Members[0].MemberType));
  end;
end;

procedure TKafkaGroupMessagesTests.Heartbeat_Java_NullAndPresentAssignment;
var
  Q: TKafkaConsumerGroupHeartbeatRequest;
  R: TKafkaConsumerGroupHeartbeatResponse;
begin
  // The Java consumer's first heartbeat, to a coordinator still loading.
  R.FromBytes(CaptureResponseBody('java-consumer-group-consumer-group-heartbeat-v1-first'), 1);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_NOT_COORDINATOR), Integer(R.ErrorCode));
  TAssert.AssertTrue('no assignment', R.AssignmentIsNull);
  TAssert.AssertTrue('no member id', R.MemberIdIsNull);
  // KIP-1082: the consumer chose its member id; the broker kept it.
  Q.FromBytes(CaptureRequestBody('java-consumer-group-consumer-group-heartbeat-v1-joined'), 1);
  R.FromBytes(CaptureResponseBody('java-consumer-group-consumer-group-heartbeat-v1-joined'), 1);
  TAssert.AssertEquals(0, Integer(R.ErrorCode));
  TAssert.AssertEquals(Q.MemberId, R.MemberId);
  TAssert.AssertEquals('captured-group-java', Q.SubscribedTopicNames[0]);
  TAssert.AssertFalse(R.AssignmentIsNull);
  TAssert.AssertEquals(2, Length(R.Assignment.TopicPartitions[0].Partitions));
  // The last one leaves.
  Q.FromBytes(CaptureRequestBody('java-consumer-group-consumer-group-heartbeat-v1-last'), 1);
  TAssert.AssertEquals(-1, Q.MemberEpoch);
end;

procedure TKafkaGroupMessagesTests.Heartbeat_Assignment_InitIsNull_RoundTrips;
var
  R, Back: TKafkaConsumerGroupHeartbeatResponse;
  Bytes1: TBytes;
begin
  R.Init;
  TAssert.AssertTrue('null by default', R.AssignmentIsNull);
  TAssert.AssertTrue(R.IsDefault);
  Bytes1 := R.ToBytes(1);
  Back.FromBytes(Bytes1, 1);
  TAssert.AssertTrue(Back.AssignmentIsNull);
  // Present but empty: the marker 1 and an empty struct, not null.
  R.AssignmentIsNull := False;
  TAssert.AssertFalse(R.IsDefault);
  Back.FromBytes(R.ToBytes(1), 1);
  TAssert.AssertFalse('present', Back.AssignmentIsNull);
  TAssert.AssertEquals(0, Length(Back.Assignment.TopicPartitions));
  TAssert.AssertEquals('two bytes more than null: the array and the tagged fields', Length(Bytes1) + 2, Length(R.ToBytes(1)));
end;

initialization
  RegisterTest(TKafkaGroupMessagesTests);

end.
