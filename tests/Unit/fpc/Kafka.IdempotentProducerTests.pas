procedure TKafkaIdempotentProducerTests.Setup;
begin
  FBrokers := nil;
  FProducer := nil;
  FParams := KafkaProducerParams('');
  FParams.Cluster.Connection.ClientId := 'idempotent-test';
  FParams.Cluster.Connection.ConnectTimeoutMs := 2000;
  FParams.Cluster.Connection.RequestTimeoutMs := 5000;
  FParams.Cluster.MaxBlockMs := 5000;
  FParams.Cluster.RetryBackoffMs := 20;
  FParams.LingerMs := 0;
end;

procedure TKafkaIdempotentProducerTests.TearDown;
var
  I: Integer;
begin
  FreeAndNil(FProducer);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
end;

procedure TKafkaIdempotentProducerTests.StartBroker(APartitions: Integer);
var
  LLeaders: array of Int32;
  I: Integer;
begin
  SetLength(FBrokers, 1);
  FBrokers[0] := TKafkaFakeBroker.Create;
  SetLength(LLeaders, APartitions);
  for I := 0 to APartitions - 1 do
    LLeaders[I] := 1;
  KafkaFakeUseView(FBrokers, KafkaFakeClusterView(FBrokers, TOPIC, LLeaders));
  FParams.Cluster.BootstrapServers := '127.0.0.1:' + IntToStr(FBrokers[0].Port);
end;

function TKafkaIdempotentProducerTests.Broker: TKafkaFakeBroker;
begin
  Result := FBrokers[0];
end;

procedure TKafkaIdempotentProducerTests.OpenProducer;
begin
  FProducer := TKafkaProducer.Create(FParams);
  FProducer.Open;
end;

function TKafkaIdempotentProducerTests.Send(const AValue: string;
  APartition: Int32): IKafkaDeliveryFuture;
var
  R: TKafkaProducerRecord;
begin
  R := KafkaProducerRecord(TOPIC, Utf8(AValue));
  R.Partition := APartition;
  Result := FProducer.Send(R);
end;

function TKafkaIdempotentProducerTests.LoggedValues(APartition: Int32): string;
var
  L: TKafkaRecordArray;
  I: Integer;
begin
  L := Broker.Logged(TOPIC, APartition);
  Result := '';
  for I := 0 to High(L) do
  begin
    if I > 0 then
      Result := Result + ',';
    Result := Result + FromUtf8(L[I].Value);
  end;
end;

procedure TKafkaIdempotentProducerTests.CreateWithParams;
var
  P: TKafkaProducer;
begin
  P := TKafkaProducer.Create(FParams);
  P.Free;
end;

procedure TKafkaIdempotentProducerTests.Default_IsIdempotent_SequencesPerPartition;
var
  B0, B1: TKafkaRecordBatchArray;
  I: Integer;
  LNext: Int32;
begin
  StartBroker(2);
  FParams.BatchSize := 1; // a batch per record
  OpenProducer;
  TAssert.AssertTrue('idempotent by default', FProducer.Idempotent);
  for I := 0 to 3 do
    Send('p0-' + IntToStr(I), 0);
  Send('p1-0', 1);
  TAssert.AssertTrue(FProducer.Flush(10000));
  TAssert.AssertEquals('one InitProducerId', 1, Broker.InitProducerIdCount);
  TAssert.AssertEquals(1, FProducer.InitProducerIdCount);
  TAssert.AssertEquals(Int64(1000), FProducer.ProducerId);
  TAssert.AssertEquals(0, Integer(FProducer.ProducerEpoch));
  B0 := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(4, Length(B0));
  LNext := 0;
  for I := 0 to High(B0) do
  begin
    TAssert.AssertEquals('id', Int64(1000), B0[I].ProducerId);
    TAssert.AssertEquals('epoch', 0, Integer(B0[I].ProducerEpoch));
    TAssert.AssertEquals('sequence', LNext, B0[I].BaseSequence);
    Inc(LNext, Length(B0[I].Records));
  end;
  B1 := Broker.StoredBatches(TOPIC, 1);
  TAssert.AssertEquals(1, Length(B1));
  TAssert.AssertEquals('each partition from 0', 0, B1[0].BaseSequence);
  TAssert.AssertEquals('p0-0,p0-1,p0-2,p0-3', LoggedValues(0));
  TAssert.AssertEquals(0, FProducer.EpochBumps);
end;

procedure TKafkaIdempotentProducerTests.LostAnswer_SentAgain_WrittenOnce;
var
  R: TKafkaDeliveryReport;
begin
  StartBroker(1);
  FParams.Cluster.Connection.RequestTimeoutMs := 400;
  OpenProducer;
  // The broker writes the batch and the answer never comes: the producer
  // can't tell that from a request that was lost on the way.
  Broker.LoseProduceAnswers := 1;
  R := Send('once').Get(10000);
  TAssert.AssertEquals('sent twice', 2, Broker.ProduceCount);
  TAssert.AssertEquals('written once', 1, Broker.LoggedCount);
  TAssert.AssertEquals('once', LoggedValues(0));
  TAssert.AssertEquals('the first write''s offset', Int64(0), R.Offset);
  TAssert.AssertEquals('one batch stored', 1, Length(Broker.StoredBatches(TOPIC, 0)));
  // The next record follows at once, sequence 1.
  R := Send('next').Get(10000);
  TAssert.AssertEquals(Int64(1), R.Offset);
  TAssert.AssertEquals(1, Broker.StoredBatches(TOPIC, 0)[1].BaseSequence);
  TAssert.AssertEquals('once,next', LoggedValues(0));
  TAssert.AssertEquals(0, FProducer.EpochBumps);
end;

procedure TKafkaIdempotentProducerTests.FiveInFlight_OnePartition_InOrder;
const
  N = 10;
var
  I: Integer;
  B: TKafkaRecordBatchArray;
  Expected: string;
begin
  StartBroker(1);
  FParams.BatchSize := 1;
  OpenProducer;
  Send('first').Get(10000); // the producer id is known
  Broker.HoldProduce := True;
  Expected := 'first';
  for I := 0 to N - 1 do
  begin
    Send('r' + IntToStr(I));
    Expected := Expected + ',r' + IntToStr(I);
  end;
  // Five requests for one partition at once: K1's producer sent one.
  TAssert.AssertTrue('five in flight', Broker.WaitProduceCount(1 + 5, 10000));
  Broker.ReleaseHeldProduce;
  TAssert.AssertTrue(FProducer.Flush(10000));
  TAssert.AssertEquals(Expected, LoggedValues(0));
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(N + 1, Length(B));
  for I := 0 to High(B) do
    TAssert.AssertEquals(Format('batch %d: epoch %d, sequence', [I, B[I].ProducerEpoch]), I,
      B[I].BaseSequence);
end;

procedure TKafkaIdempotentProducerTests.SecondOfFiveFails_RetriedInOrder_NoDuplicate;
var
  I: Integer;
  F: array[0..4] of IKafkaDeliveryFuture;
begin
  StartBroker(1);
  FParams.BatchSize := 1;
  OpenProducer;
  Send('first').Get(10000);
  Broker.HoldProduce := True;
  // The first held request goes through, the second fails with a retriable
  // error; the broker answers the three after it OUT_OF_ORDER (a gap).
  Broker.ProduceErrorCode := KAFKA_ERROR_NOT_LEADER_OR_FOLLOWER;
  Broker.ProduceErrorSkip := 1;
  Broker.ProduceErrors := 1;
  for I := 0 to 4 do
    F[I] := Send('r' + IntToStr(I));
  TAssert.AssertTrue(Broker.WaitProduceCount(1 + 5, 10000));
  Broker.ReleaseHeldProduce;
  for I := 0 to 4 do
    TAssert.AssertEquals('offset', Int64(1 + I), F[I].Get(10000).Offset);
  TAssert.AssertEquals('first,r0,r1,r2,r3,r4', LoggedValues(0));
  TAssert.AssertEquals('no new epoch for a retriable error', 0, FProducer.EpochBumps);
  TAssert.AssertTrue('retried', Broker.ProduceCount > 6);
end;

procedure TKafkaIdempotentProducerTests.OutOfOrder_OnTheNextBatch_BumpsTheEpoch;
var
  R: TKafkaDeliveryReport;
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  OpenProducer;
  Broker.ProduceErrorCode := KAFKA_ERROR_OUT_OF_ORDER_SEQUENCE_NUMBER;
  Broker.ProduceErrors := 1;
  R := Send('a').Get(10000);
  TAssert.AssertEquals(Int64(0), R.Offset);
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  TAssert.AssertEquals('the same id', Int64(1000), FProducer.ProducerId);
  TAssert.AssertEquals('epoch 1', 1, Integer(FProducer.ProducerEpoch));
  TAssert.AssertEquals('bumped locally', 1, Broker.InitProducerIdCount);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(1, Length(B));
  TAssert.AssertEquals(1, Integer(B[0].ProducerEpoch));
  TAssert.AssertEquals('from 0 again', 0, B[0].BaseSequence);
end;

procedure TKafkaIdempotentProducerTests.OutOfOrder_WithBatchesInFlight_RenumberedInOrder;
var
  I: Integer;
  F: array[0..2] of IKafkaDeliveryFuture;
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  FParams.BatchSize := 1;
  OpenProducer;
  Send('first').Get(10000);
  Broker.HoldProduce := True;
  // The first of three in flight is answered OUT_OF_ORDER although it is
  // the next one; the two after it then are too, by the broker's own check.
  Broker.ProduceErrorCode := KAFKA_ERROR_OUT_OF_ORDER_SEQUENCE_NUMBER;
  Broker.ProduceErrors := 1;
  for I := 0 to 2 do
    F[I] := Send('r' + IntToStr(I));
  TAssert.AssertTrue(Broker.WaitProduceCount(1 + 3, 10000));
  Broker.ReleaseHeldProduce;
  for I := 0 to 2 do
    TAssert.AssertEquals(Int64(1 + I), F[I].Get(10000).Offset);
  TAssert.AssertEquals('first,r0,r1,r2', LoggedValues(0));
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(4, Length(B));
  for I := 1 to 3 do
  begin
    TAssert.AssertEquals('the new epoch', 1, Integer(B[I].ProducerEpoch));
    TAssert.AssertEquals('renumbered from 0', I - 1, B[I].BaseSequence);
  end;
end;

procedure TKafkaIdempotentProducerTests.UnknownProducerId_BumpsAndRetries;
var
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  OpenProducer;
  Send('a').Get(10000);
  Broker.ProduceErrorCode := KAFKA_ERROR_UNKNOWN_PRODUCER_ID;
  Broker.ProduceErrors := 1;
  TAssert.AssertEquals(Int64(1), Send('b').Get(10000).Offset);
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(2, Length(B));
  TAssert.AssertEquals(1, Integer(B[1].ProducerEpoch));
  TAssert.AssertEquals(0, B[1].BaseSequence);
  TAssert.AssertEquals('a,b', LoggedValues(0));
end;

procedure TKafkaIdempotentProducerTests.InvalidProducerEpoch_FailsTheBatch_NextOnANewEpoch;
var
  F: IKafkaDeliveryFuture;
  R: TKafkaDeliveryReport;
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  OpenProducer;
  Broker.ProduceErrorCode := KAFKA_ERROR_INVALID_PRODUCER_EPOCH;
  Broker.ProduceErrors := 1;
  F := Send('refused');
  TAssert.AssertTrue(F.Wait(10000));
  R := F.Report;
  TAssert.AssertTrue(R.ErrorClass = EKafkaBrokerError);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_INVALID_PRODUCER_EPOCH), Integer(R.ErrorCode));
  TAssert.AssertEquals('not retried', 1, Broker.ProduceCount);
  TAssert.AssertEquals(Int64(0), Send('next').Get(10000).Offset);
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(1, Length(B));
  TAssert.AssertEquals(1, Integer(B[0].ProducerEpoch));
  TAssert.AssertEquals(0, B[0].BaseSequence);
end;

procedure TKafkaIdempotentProducerTests.DuplicateSequence_CountsAsDelivered;
var
  R: TKafkaDeliveryReport;
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  OpenProducer;
  Broker.ProduceErrorCode := KAFKA_ERROR_DUPLICATE_SEQUENCE_NUMBER;
  Broker.ProduceErrors := 1;
  R := Send('seen before').Get(10000);
  TAssert.AssertTrue(R.Succeeded);
  TAssert.AssertEquals('no offset to report', Int64(-1), R.Offset);
  TAssert.AssertEquals(1, Broker.ProduceCount);
  // The sequence counts as written: the next batch follows it.
  Send('next').Get(10000);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(1, Length(B));
  TAssert.AssertEquals(1, B[0].BaseSequence);
  TAssert.AssertEquals(0, Integer(B[0].ProducerEpoch));
  TAssert.AssertEquals(0, FProducer.EpochBumps);
end;

procedure TKafkaIdempotentProducerTests.RanOutOfTime_FateUnknown_NextOnANewEpoch;
var
  F: IKafkaDeliveryFuture;
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  FParams.Cluster.Connection.RequestTimeoutMs := 300;
  FParams.DeliveryTimeoutMs := 1000;
  OpenProducer;
  Send('known').Get(10000);
  Broker.DropProduce := 1000;
  F := Send('lost');
  TAssert.AssertTrue(F.Wait(10000));
  TAssert.AssertFalse('failed', F.Report.Succeeded);
  Broker.DropProduce := 0;
  TAssert.AssertEquals(Int64(1), Send('after').Get(10000).Offset);
  TAssert.AssertEquals('known,after', LoggedValues(0));
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(2, Length(B));
  TAssert.AssertEquals('a new epoch', 1, Integer(B[1].ProducerEpoch));
  TAssert.AssertEquals('from 0', 0, B[1].BaseSequence);
end;

procedure TKafkaIdempotentProducerTests.InitProducerId_Loading_IsRetried;
begin
  StartBroker(1);
  Broker.InitProducerIdErrorCode := KAFKA_ERROR_COORDINATOR_LOAD_IN_PROGRESS;
  Broker.InitProducerIdErrors := 2;
  OpenProducer;
  TAssert.AssertEquals(Int64(0), Send('a').Get(10000).Offset);
  TAssert.AssertEquals(3, Broker.InitProducerIdCount);
  TAssert.AssertEquals(3, FProducer.InitProducerIdCount);
  TAssert.AssertEquals(Int64(1000), FProducer.ProducerId);
end;

procedure TKafkaIdempotentProducerTests.InitProducerId_Refused_FailsTheWaitingRecords;
var
  F: IKafkaDeliveryFuture;
  R: TKafkaDeliveryReport;
begin
  StartBroker(1);
  Broker.InitProducerIdErrorCode := KAFKA_ERROR_CLUSTER_AUTHORIZATION_FAILED;
  Broker.InitProducerIdErrors := 1000000;
  OpenProducer;
  F := Send('a');
  TAssert.AssertTrue(F.Wait(10000));
  R := F.Report;
  TAssert.AssertTrue(R.ErrorClass = EKafkaBrokerError);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_CLUSTER_AUTHORIZATION_FAILED), Integer(R.ErrorCode));
  TAssert.AssertEquals(0, Broker.ProduceCount);
  Broker.InitProducerIdErrors := 0;
  TAssert.AssertEquals(Int64(0), Send('b').Get(10000).Offset);
  TAssert.AssertEquals('b', LoggedValues(0));
end;

procedure TKafkaIdempotentProducerTests.Params_AutoIsOffWithAcksOneOrNoRetries;
var
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  FParams.Acks := kaLeader;
  OpenProducer;
  TAssert.AssertFalse('acks=1: off', FProducer.Idempotent);
  Send('a').Get(10000);
  TAssert.AssertEquals(0, Broker.InitProducerIdCount);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(Int64(KAFKA_NO_PRODUCER_ID), B[0].ProducerId);
  TAssert.AssertEquals(Integer(KAFKA_NO_SEQUENCE), B[0].BaseSequence);
  FreeAndNil(FProducer);
  FParams.Acks := kaAll;
  FParams.Retries := 0;
  OpenProducer;
  TAssert.AssertFalse('Retries 0: off', FProducer.Idempotent);
  FreeAndNil(FProducer);
  FParams.Retries := 3;
  OpenProducer;
  TAssert.AssertTrue('acks all, Retries > 0: on', FProducer.Idempotent);
end;

procedure TKafkaIdempotentProducerTests.Params_OnRefusesWhatItCantKeep;
begin
  // An address (nothing is opened): the cluster refuses an empty one.
  FParams.Cluster.BootstrapServers := '127.0.0.1:9';
  FParams.Idempotence := kidOn;
  FParams.Acks := kaLeader;
  TAssert.AssertException('acks=1', EArgumentException, CreateWithParams);
  FParams.Acks := kaAll;
  FParams.Retries := 0;
  TAssert.AssertException('Retries 0', EArgumentException, CreateWithParams);
  FParams.Retries := 1;
  CreateWithParams;
end;

procedure TKafkaIdempotentProducerTests.Params_MoreThanFiveInFlight_RefusedUnlessOff;
begin
  // An address (nothing is opened): the cluster refuses an empty one.
  FParams.Cluster.BootstrapServers := '127.0.0.1:9';
  FParams.MaxInFlightPerBroker := 6;
  // Java refuses it with idempotence on by default too.
  TAssert.AssertException('auto', EArgumentException, CreateWithParams);
  FParams.Idempotence := kidOn;
  TAssert.AssertException('on', EArgumentException, CreateWithParams);
  FParams.Idempotence := kidOff;
  CreateWithParams;
  // With idempotence off by acks=1, kidAuto takes it too.
  FParams.Idempotence := kidAuto;
  FParams.Acks := kaLeader;
  CreateWithParams;
end;

procedure TKafkaIdempotentProducerTests.Off_BatchesWithoutProducerId;
var
  B: TKafkaRecordBatchArray;
begin
  StartBroker(1);
  FParams.Idempotence := kidOff;
  OpenProducer;
  TAssert.AssertFalse(FProducer.Idempotent);
  Send('a').Get(10000);
  Send('b').Get(10000);
  TAssert.AssertEquals(0, Broker.InitProducerIdCount);
  TAssert.AssertEquals(Int64(-1), FProducer.ProducerId);
  B := Broker.StoredBatches(TOPIC, 0);
  TAssert.AssertEquals(2, Length(B));
  TAssert.AssertEquals(Int64(KAFKA_NO_PRODUCER_ID), B[1].ProducerId);
  TAssert.AssertEquals(Integer(KAFKA_NO_SEQUENCE), B[1].BaseSequence);
end;

initialization
  RegisterTest(TKafkaIdempotentProducerTests);

end.
