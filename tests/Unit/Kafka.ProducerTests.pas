unit Kafka.ProducerTests;

{ Tests for Kafka.Producer against fake brokers in process
  (Kafka.TestFakeBroker, which answers Produce and keeps a log per
  partition).

  - Partitions: a key's is murmur2's, an explicit one is kept, one the topic
    doesn't have fails at once, records without a key stick to a partition
    for BatchSize bytes and then move.
  - Batching: LingerMs gathers records into one request; a full batch goes
    without waiting for it.
  - Errors: a retriable one (NOT_LEADER_OR_FOLLOWER) is retried after a
    metadata refresh with the partition's order kept; a request with no
    answer is abandoned after the request timeout and sent again; a
    non-retriable one, or a retriable one with Retries 0, fails the records;
    a partition without a leader expires after DeliveryTimeoutMs.
  - Limits: a record larger than MaxRequestSize fails at once; with
    BufferMemory taken, Send waits up to MaxBlockMs and then fails; a topic
    that never appears fails after MaxBlockMs.
  - acks=0, gzip, headers, a tombstone, an explicit timestamp; snappy and
    lz4, small records batched and a 100 000-byte one (several xerial
    chunks, several lz4 blocks); zstd refused at Create (read, not
    written).
  - Flush and Close: callbacks have run when Flush returns, Close delivers
    what was sent, Close with a timeout fails what is left, a callback can't
    call Flush, and Send before Open or after Close raises.

  No Sleep: the producer's own waits (futures, Flush) and deadline loops on
  the fake broker's counters.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Classes,
  SyncObjs,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Compression,
  Kafka.Protocol.RecordBatch,
  Kafka.Cluster,
  Kafka.Partitioner,
  Kafka.Producer,
  Kafka.TestFakeBroker,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  TKafkaDeliveryReportArray = array of TKafkaDeliveryReport;
  TKafkaDeliveryFutureArray = array of IKafkaDeliveryFuture;

  [TestFixture]
  TKafkaProducerTests = class
  private
    FBrokers: TKafkaFakeBrokerArray;
    FProducer: TKafkaProducer;
    FParams: TKafkaProducerParams;
    FLock: TCriticalSection;
    FReports: TKafkaDeliveryReportArray;
    FReportCount: Integer;
    FCallbackThreads: array of TThreadID;
    FFlushInCallback: Boolean;
    FCallbackError: string;
    procedure StartBrokers(ACount: Integer; const ALeaders: array of Int32);
    function Broker(ANodeId: Integer): TKafkaFakeBroker;
    procedure OpenProducer;
    procedure OnDelivery(const AReport: TKafkaDeliveryReport);
    function Reports: TKafkaDeliveryReportArray;
    function Send(const ARecord: TKafkaProducerRecord): IKafkaDeliveryFuture;
    procedure SendOne;
    procedure CreateWithParams;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Keyed_GoToMurmur2Partitions_InOrder_CallbacksDoneOnFlush;
    [Test] procedure ExplicitPartition_IsKept_OutOfRange_FailsAtOnce;
    [Test] procedure NoKey_StickyPartition_MovesAfterBatchSize;
    [Test] procedure Linger_GathersRecordsIntoOneRequest;
    [Test] procedure FullBatch_GoesWithoutWaitingForTheLinger;
    [Test] procedure NotLeader_RetriedAfterARefresh_OrderKept;
    [Test] procedure NoAnswer_AbandonedAfterTheRequestTimeout_SentAgain;
    [Test] procedure NonRetriableError_FailsWithoutRetry;
    [Test] procedure RetriesZero_FailsOnTheFirstRetriableError;
    [Test] procedure PartitionWithoutLeader_ExpiresAfterDeliveryTimeout;
    [Test] procedure RecordLargerThanMaxRequestSize_FailsAtOnce;
    [Test] procedure BufferFull_SendWaitsMaxBlockThenFails;
    [Test] procedure UnknownTopic_FailsAfterMaxBlock;
    [Test] procedure AcksNone_DoneOnceWritten_WithoutOffsets;
    [Test] procedure Gzip_Headers_Tombstone_Timestamp_Arrive;
    [Test] procedure SnappyAndLz4_LargeAndSmallRecordsArrive;
    [Test] procedure Close_DeliversWhatWasSent;
    [Test] procedure Close_WithTimeout_FailsWhatIsLeft;
    [Test] procedure Callback_CannotFlush;
    [Test] procedure Send_BeforeOpenAndAfterClose_Raises;
    [Test] procedure Params_DeliveryTimeoutTooShort_IsRefused;
    [Test] procedure Params_Zstd_IsRefused;
  end;

implementation

const
  TOPIC = 'orders';

/// Waits up to ATimeoutMs for ABroker to have logged ACount records.
function WaitLogged(ABroker: TKafkaFakeBroker; ACount: Integer; ATimeoutMs: Cardinal): Boolean;
var
  Deadline: UInt64;
  Pause: TEvent;
begin
  Deadline := PcTickMs + ATimeoutMs;
  Pause := TEvent.Create(nil, True, False, '');
  try
    while ABroker.LoggedCount < ACount do
    begin
      if PcTickMs >= Deadline then
        Exit(False);
      Pause.WaitFor(5);
    end;
    Result := True;
  finally
    Pause.Free;
  end;
end;

function Value(const AText: string): TBytes;
begin
  Result := Utf8(AText);
end;

{ TKafkaProducerTests }

procedure TKafkaProducerTests.Setup;
begin
  FBrokers := nil;
  FProducer := nil;
  FLock := TCriticalSection.Create;
  FReports := nil;
  FReportCount := 0;
  FCallbackThreads := nil;
  FFlushInCallback := False;
  FCallbackError := '';
  FParams := KafkaProducerParams('');
  FParams.Cluster.Connection.ClientId := 'producer-test';
  FParams.Cluster.Connection.ConnectTimeoutMs := 2000;
  FParams.Cluster.Connection.RequestTimeoutMs := 5000;
  FParams.Cluster.MaxBlockMs := 5000;
  FParams.Cluster.RetryBackoffMs := 20;
  FParams.LingerMs := 0;
end;

procedure TKafkaProducerTests.TearDown;
var
  I: Integer;
begin
  FreeAndNil(FProducer);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
  FLock.Free;
end;

procedure TKafkaProducerTests.StartBrokers(ACount: Integer; const ALeaders: array of Int32);
var
  I: Integer;
begin
  SetLength(FBrokers, ACount);
  for I := 0 to ACount - 1 do
    FBrokers[I] := TKafkaFakeBroker.Create;
  KafkaFakeUseView(FBrokers, KafkaFakeClusterView(FBrokers, TOPIC, ALeaders));
  FParams.Cluster.BootstrapServers := '127.0.0.1:' + IntToStr(FBrokers[0].Port);
end;

function TKafkaProducerTests.Broker(ANodeId: Integer): TKafkaFakeBroker;
begin
  Result := FBrokers[ANodeId - 1];
end;

procedure TKafkaProducerTests.OpenProducer;
begin
  FProducer := TKafkaProducer.Create(FParams);
  FProducer.Open;
end;

procedure TKafkaProducerTests.OnDelivery(const AReport: TKafkaDeliveryReport);
begin
  FLock.Enter;
  try
    if FReportCount = Length(FReports) then
    begin
      SetLength(FReports, 2 * FReportCount + 16);
      SetLength(FCallbackThreads, Length(FReports));
    end;
    FReports[FReportCount] := AReport;
    FCallbackThreads[FReportCount] := TThread.CurrentThread.ThreadID;
    Inc(FReportCount);
  finally
    FLock.Leave;
  end;
  if FFlushInCallback then
    try
      FProducer.Flush(0);
      FCallbackError := 'none';
    except
      on E: Exception do
        FCallbackError := E.ClassName;
    end;
end;

function TKafkaProducerTests.Reports: TKafkaDeliveryReportArray;
begin
  FLock.Enter;
  try
    Result := Copy(FReports, 0, FReportCount);
  finally
    FLock.Leave;
  end;
end;

function TKafkaProducerTests.Send(const ARecord: TKafkaProducerRecord): IKafkaDeliveryFuture;
begin
  Result := FProducer.Send(ARecord, OnDelivery, 0);
end;

procedure TKafkaProducerTests.SendOne;
begin
  FProducer.Send(KafkaProducerRecord(TOPIC, Value('x')));
end;

procedure TKafkaProducerTests.CreateWithParams;
var
  P: TKafkaProducer;
begin
  P := TKafkaProducer.Create(FParams);
  P.Free;
end;

procedure TKafkaProducerTests.Keyed_GoToMurmur2Partitions_InOrder_CallbacksDoneOnFlush;
const
  N = 30;
  LEADERS: array[0..2] of Integer = (1, 2, 1);
var
  F: TKafkaDeliveryFutureArray;
  R: TKafkaDeliveryReport;
  I, P: Integer;
  Logged: TKafkaRecordArray;
  Seen: array[0..2] of Integer;
  All: TKafkaDeliveryReportArray;
  Last: array[0..2] of Int64;
begin
  StartBrokers(2, [1, 2, 1]);
  FParams.LingerMs := 20;
  OpenProducer;
  SetLength(F, N);
  for I := 0 to N - 1 do
    F[I] := Send(KafkaProducerRecord(TOPIC, Value('key-' + IntToStr(I mod 7)),
      Value('v' + IntToStr(I))));
  TAssert.AssertTrue('flushed', FProducer.Flush(10000));
  TAssert.AssertEquals('every callback ran before Flush returned', N, Length(Reports));
  for P := 0 to 2 do
    Seen[P] := 0;
  for I := 0 to N - 1 do
  begin
    TAssert.AssertTrue(F[I].IsDone);
    R := F[I].Get(0);
    TAssert.AssertEquals('v' + IntToStr(I),
      KafkaPartitionForKey(Value('key-' + IntToStr(I mod 7)), 3), R.Partition);
    // The I-th record of its partition got the I-th offset of its log.
    TAssert.AssertEquals(Int64(Seen[R.Partition]), R.Offset);
    Inc(Seen[R.Partition]);
  end;
  for P := 0 to 2 do
  begin
    Logged := Broker(LEADERS[P]).Logged(TOPIC, P);
    TAssert.AssertEquals('partition ' + IntToStr(P), Seen[P], Length(Logged));
  end;
  TAssert.AssertTrue('node 2 had a request', Broker(2).ProduceCount > 0);
  // The callbacks of each partition came in offset order.
  All := Reports;
  for P := 0 to 2 do
    Last[P] := -1;
  for I := 0 to High(All) do
  begin
    TAssert.AssertTrue(All[I].Offset > Last[All[I].Partition]);
    Last[All[I].Partition] := All[I].Offset;
  end;
end;

procedure TKafkaProducerTests.ExplicitPartition_IsKept_OutOfRange_FailsAtOnce;
var
  F: IKafkaDeliveryFuture;
  R: TKafkaDeliveryReport;
  Rec: TKafkaProducerRecord;
begin
  StartBrokers(1, [1, 1, 1]);
  OpenProducer;
  Rec := KafkaProducerRecord(TOPIC, Value('k'), Value('to 2'));
  Rec.Partition := 2;
  TAssert.AssertEquals(2, Send(Rec).Get(10000).Partition);
  Rec.Partition := 5;
  F := Send(Rec);
  TAssert.AssertTrue('failed in Send', F.IsDone);
  R := F.Report;
  TAssert.AssertFalse(R.Succeeded);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_UNKNOWN_TOPIC_OR_PARTITION), Integer(R.ErrorCode));
  TAssert.AssertTrue(R.ErrorClass = EKafkaBrokerError);
  TAssert.AssertEquals('callbacks', 2, FReportCount);
  TAssert.AssertTrue('on the caller''s thread',
    FCallbackThreads[1] = TThread.CurrentThread.ThreadID);
  TAssert.AssertFalse('the delivered one on the sender''s',
    FCallbackThreads[0] = TThread.CurrentThread.ThreadID);
end;

procedure TKafkaProducerTests.NoKey_StickyPartition_MovesAfterBatchSize;
const
  N = 40;
var
  I, Run, RunLength: Integer;
  Runs: array of Integer;
  F: TKafkaDeliveryFutureArray;
  All: TKafkaDeliveryReportArray;
begin
  StartBrokers(1, [1, 1, 1]);
  FParams.BatchSize := 1000;
  OpenProducer;
  SetLength(F, N);
  for I := 0 to N - 1 do
    F[I] := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('x', 60))));
  TAssert.AssertTrue(FProducer.Flush(10000));
  // In the order they were sent (callbacks come in each partition's order,
  // interleaved).
  SetLength(All, N);
  for I := 0 to N - 1 do
    All[I] := F[I].Report;
  // Runs of records on one partition: equal lengths (the same bytes each),
  // each on another partition than the one before.
  Runs := nil;
  RunLength := 0;
  for I := 0 to N - 1 do
  begin
    if (I > 0) and (All[I].Partition <> All[I - 1].Partition) then
    begin
      SetLength(Runs, Length(Runs) + 1);
      Runs[High(Runs)] := RunLength;
      RunLength := 0;
    end;
    Inc(RunLength);
  end;
  TAssert.AssertTrue('moved at least twice', Length(Runs) >= 2);
  TAssert.AssertTrue('several records per partition', Runs[0] >= 2);
  for Run := 1 to High(Runs) do
    TAssert.AssertEquals('run ' + IntToStr(Run), Runs[0], Runs[Run]);
  TAssert.AssertTrue('1000 bytes of 60-byte values: about 10 a run',
    (Runs[0] >= 8) and (Runs[0] <= 17));
end;

procedure TKafkaProducerTests.Linger_GathersRecordsIntoOneRequest;
var
  I: Integer;
  F: IKafkaDeliveryFuture;
begin
  StartBrokers(1, [1]);
  FParams.LingerMs := 300;
  OpenProducer;
  for I := 0 to 9 do
    F := Send(KafkaProducerRecord(TOPIC, Value('v' + IntToStr(I))));
  TAssert.AssertEquals(Int64(9), F.Get(10000).Offset);
  TAssert.AssertEquals('one request', 1, Broker(1).ProduceCount);
  TAssert.AssertEquals(10, Length(Broker(1).Logged(TOPIC, 0)));
end;

procedure TKafkaProducerTests.FullBatch_GoesWithoutWaitingForTheLinger;
var
  F: TKafkaDeliveryFutureArray;
  I: Integer;
  T0: UInt64;
begin
  StartBrokers(1, [1]);
  FParams.LingerMs := 60000;
  FParams.BatchSize := 300;
  OpenProducer;
  SetLength(F, 3);
  T0 := PcTickMs;
  // About 140 bytes each: the third doesn't fit in the first batch.
  for I := 0 to 2 do
    F[I] := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('x', 100))));
  TAssert.AssertTrue('the full batch went', F[0].Wait(10000));
  TAssert.AssertTrue('in the same batch', F[1].Wait(10000));
  TAssert.AssertTrue('long before the linger', PcTickMs - T0 < 30000);
  TAssert.AssertFalse('the third waits for its linger', F[2].IsDone);
  TAssert.AssertTrue(F[0].Report.Succeeded);
end;

procedure TKafkaProducerTests.NotLeader_RetriedAfterARefresh_OrderKept;
var
  I: Integer;
  Logged: TKafkaRecordArray;
  MetadataBefore: Integer;
begin
  StartBrokers(1, [1]);
  FParams.BatchSize := 1; // a batch per record
  OpenProducer;
  // A first record, so that the broker knows the (idempotent) producer.
  // Without it the race below has a third outcome no broker gives: the two
  // failed requests are the first two batches, the third batch, already in
  // flight, is the first the broker sees, and Kafka 4.4.0 takes an unknown
  // producer's batch at any sequence (the fake does the same). Sequences 0
  // and 1 then come back OUT_OF_ORDER for good, and the producer retries
  // them, as Java's does, until DeliveryTimeoutMs (one run in about twenty,
  // seen as a Flush that timed out). A real leader that moved refuses
  // every request after it, not two.
  TAssert.AssertTrue(Send(KafkaProducerRecord(TOPIC, Value('first'))).Get(10000).Succeeded);
  MetadataBefore := Broker(1).MetadataCount;
  Broker(1).ProduceErrorCode := KAFKA_ERROR_NOT_LEADER_OR_FOLLOWER;
  Broker(1).ProduceErrors := 2;
  for I := 0 to 4 do
    Send(KafkaProducerRecord(TOPIC, Value('v' + IntToStr(I))));
  TAssert.AssertTrue('flushed', FProducer.Flush(10000));
  for I := 0 to 5 do
    TAssert.AssertTrue(IntToStr(I) + ': ' + Reports[I].ErrorMessage, Reports[I].Succeeded);
  Logged := Broker(1).Logged(TOPIC, 0);
  TAssert.AssertEquals(6, Length(Logged));
  TAssert.AssertEquals('first', FromUtf8(Logged[0].Value));
  for I := 0 to 4 do
  begin
    TAssert.AssertEquals('v' + IntToStr(I), FromUtf8(Logged[1 + I].Value));
    TAssert.AssertEquals(Int64(1 + I), Reports[1 + I].Offset);
  end;
  TAssert.AssertTrue('refreshed', Broker(1).MetadataCount > MetadataBefore);
  TAssert.AssertTrue('sent again', Broker(1).ProduceCount >= 8);
end;

procedure TKafkaProducerTests.NoAnswer_AbandonedAfterTheRequestTimeout_SentAgain;
var
  R: TKafkaDeliveryReport;
begin
  StartBrokers(1, [1]);
  FParams.Cluster.Connection.RequestTimeoutMs := 400;
  OpenProducer;
  Broker(1).DropProduce := 1;
  R := Send(KafkaProducerRecord(TOPIC, Value('once'))).Get(10000);
  TAssert.AssertEquals(Int64(0), R.Offset);
  TAssert.AssertEquals(2, Broker(1).ProduceCount);
  TAssert.AssertEquals(1, Broker(1).LoggedCount);
end;

procedure TKafkaProducerTests.NonRetriableError_FailsWithoutRetry;
var
  F: IKafkaDeliveryFuture;
  R: TKafkaDeliveryReport;
  Raised: string;
begin
  StartBrokers(1, [1]);
  OpenProducer;
  Broker(1).ProduceErrorCode := KAFKA_ERROR_INVALID_RECORD;
  Broker(1).ProduceErrors := 1;
  F := Send(KafkaProducerRecord(TOPIC, Value('bad')));
  TAssert.AssertTrue(F.Wait(10000));
  R := F.Report;
  TAssert.AssertTrue(R.ErrorClass = EKafkaBrokerError);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_INVALID_RECORD), Integer(R.ErrorCode));
  TAssert.AssertTrue(R.ErrorMessage, Pos('INVALID_RECORD', R.ErrorMessage) > 0);
  TAssert.AssertEquals('no retry', 1, Broker(1).ProduceCount);
  Raised := '';
  try
    F.Get(0);
  except
    on E: EKafkaBrokerError do
      Raised := IntToStr(E.ErrorCode);
  end;
  TAssert.AssertEquals('Get raises it, with the code', IntToStr(KAFKA_ERROR_INVALID_RECORD), Raised);
end;

procedure TKafkaProducerTests.RetriesZero_FailsOnTheFirstRetriableError;
var
  R: TKafkaDeliveryReport;
  F: IKafkaDeliveryFuture;
begin
  StartBrokers(1, [1]);
  FParams.Retries := 0;
  OpenProducer;
  Broker(1).ProduceErrorCode := KAFKA_ERROR_NOT_ENOUGH_REPLICAS;
  Broker(1).ProduceErrors := 1;
  F := Send(KafkaProducerRecord(TOPIC, Value('v')));
  TAssert.AssertTrue(F.Wait(10000));
  R := F.Report;
  TAssert.AssertEquals(Integer(KAFKA_ERROR_NOT_ENOUGH_REPLICAS), Integer(R.ErrorCode));
  TAssert.AssertEquals(1, Broker(1).ProduceCount);
end;

procedure TKafkaProducerTests.PartitionWithoutLeader_ExpiresAfterDeliveryTimeout;
var
  Rec: TKafkaProducerRecord;
  F: IKafkaDeliveryFuture;
  R: TKafkaDeliveryReport;
  T0: UInt64;
begin
  StartBrokers(1, [1, -1]);
  FParams.Cluster.Connection.RequestTimeoutMs := 500;
  FParams.DeliveryTimeoutMs := 800;
  OpenProducer;
  Rec := KafkaProducerRecord(TOPIC, Value('nowhere'));
  Rec.Partition := 1;
  T0 := PcTickMs;
  F := Send(Rec);
  TAssert.AssertTrue(F.Wait(10000));
  R := F.Report;
  TAssert.AssertTrue(R.ErrorClass = EKafkaTimeout);
  TAssert.AssertTrue(R.ErrorMessage, Pos('Expiring 1 record(s) for orders-1', R.ErrorMessage) = 1);
  TAssert.AssertTrue('after the delivery timeout', PcTickMs - T0 >= 700);
  TAssert.AssertEquals(0, Broker(1).ProduceCount);
end;

procedure TKafkaProducerTests.RecordLargerThanMaxRequestSize_FailsAtOnce;
var
  F: IKafkaDeliveryFuture;
begin
  StartBrokers(1, [1]);
  FParams.MaxRequestSize := 1000;
  OpenProducer;
  F := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('x', 2000))));
  TAssert.AssertTrue(F.IsDone);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_MESSAGE_TOO_LARGE), Integer(F.Report.ErrorCode));
  // Records below the limit still go.
  TAssert.AssertTrue(Send(KafkaProducerRecord(TOPIC, Value('small'))).Get(10000).Succeeded);
end;

procedure TKafkaProducerTests.BufferFull_SendWaitsMaxBlockThenFails;
var
  A, B, C: IKafkaDeliveryFuture;
  T0, Waited: UInt64;
begin
  StartBrokers(1, [1]);
  FParams.BufferMemory := 1000;
  FParams.Cluster.MaxBlockMs := 300;
  OpenProducer;
  Broker(1).HoldProduce := True;
  // About 340 bytes each: two fit, the third waits for memory.
  A := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('a', 300))));
  B := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('b', 300))));
  T0 := PcTickMs;
  C := Send(KafkaProducerRecord(TOPIC, Value(StringOfChar('c', 300))));
  Waited := PcTickMs - T0;
  TAssert.AssertTrue('failed in Send', C.IsDone);
  TAssert.AssertTrue(C.Report.ErrorClass = EKafkaTimeout);
  TAssert.AssertTrue('waited MaxBlockMs: ' + IntToStr(Waited), Waited >= 250);
  TAssert.AssertTrue(Broker(1).WaitProduceCount(1, 10000));
  Broker(1).ReleaseHeldProduce;
  TAssert.AssertTrue(FProducer.Flush(10000));
  TAssert.AssertTrue(A.Report.Succeeded);
  TAssert.AssertTrue(B.Report.Succeeded);
end;

procedure TKafkaProducerTests.UnknownTopic_FailsAfterMaxBlock;
var
  F: IKafkaDeliveryFuture;
begin
  StartBrokers(1, [1]);
  FParams.Cluster.MaxBlockMs := 300;
  OpenProducer;
  F := FProducer.Send(KafkaProducerRecord('no-such-topic', Value('v')));
  TAssert.AssertTrue(F.IsDone);
  TAssert.AssertTrue(F.Report.ErrorMessage, F.Report.ErrorClass = EKafkaTimeout);
  TAssert.AssertEquals('no-such-topic', F.Report.Topic);
end;

procedure TKafkaProducerTests.AcksNone_DoneOnceWritten_WithoutOffsets;
var
  I: Integer;
  All: TKafkaDeliveryReportArray;
begin
  StartBrokers(1, [1]);
  FParams.Acks := kaNone;
  OpenProducer;
  for I := 0 to 2 do
    Send(KafkaProducerRecord(TOPIC, Value('v' + IntToStr(I))));
  TAssert.AssertTrue(FProducer.Flush(10000));
  All := Reports;
  TAssert.AssertEquals(3, Length(All));
  for I := 0 to 2 do
  begin
    TAssert.AssertTrue(All[I].Succeeded);
    TAssert.AssertEquals(Int64(-1), All[I].Offset);
  end;
  TAssert.AssertTrue('the broker has them', WaitLogged(Broker(1), 3, 10000));
end;

procedure TKafkaProducerTests.Gzip_Headers_Tombstone_Timestamp_Arrive;
var
  Rec: TKafkaProducerRecord;
  Logged: TKafkaRecordArray;
  R: TKafkaDeliveryReport;
begin
  StartBrokers(1, [1]);
  FParams.Compression := kcGzip;
  OpenProducer;
  Rec := KafkaProducerRecord(TOPIC, Value('k'), Value('São Paulo'));
  Rec.Timestamp := 1700000000123;
  SetLength(Rec.Headers, 2);
  Rec.Headers[0].Key := 'trace';
  Rec.Headers[0].Value := Value('abc');
  Rec.Headers[1].Key := 'empty';
  Rec.Headers[1].ValueIsNull := True;
  R := Send(Rec).Get(10000);
  TAssert.AssertEquals(Int64(1700000000123), R.Timestamp);
  Send(KafkaTombstone(TOPIC, Value('k'))).Get(10000);
  Logged := Broker(1).Logged(TOPIC, R.Partition);
  TAssert.AssertEquals(2, Length(Logged));
  TAssert.AssertEquals('gzip', Ord(kcGzip), Broker(1).LoggedCompression(0));
  TAssert.AssertEquals('São Paulo', FromUtf8(Logged[0].Value));
  TAssert.AssertEquals(Int64(1700000000123), Logged[0].Timestamp);
  TAssert.AssertEquals(2, Length(Logged[0].Headers));
  TAssert.AssertEquals('trace', Logged[0].Headers[0].Key);
  TAssert.AssertEquals('abc', FromUtf8(Logged[0].Headers[0].Value));
  TAssert.AssertTrue(Logged[0].Headers[1].ValueIsNull);
  TAssert.AssertFalse(Logged[1].KeyIsNull);
  TAssert.AssertTrue('a tombstone', Logged[1].ValueIsNull);
end;

procedure TKafkaProducerTests.SnappyAndLz4_LargeAndSmallRecordsArrive;
var
  Codec: TKafkaCompression;
  Big: TBytes;
  I, N, First: Integer;
  Logged: TKafkaRecordArray;
begin
  StartBrokers(1, [1]);
  Big := nil;
  SetLength(Big, 100000);
  for I := 0 to High(Big) do
    Big[I] := Byte(Ord('a') + (I div 7) mod 26);
  First := 0;
  for Codec := kcSnappy to kcLz4 do
  begin
    FParams.Compression := Codec;
    FParams.LingerMs := 50;
    OpenProducer;
    for I := 0 to 19 do
      Send(KafkaProducerRecord(TOPIC, Value('k' + IntToStr(I)),
        Value(KafkaCompressionName(Codec) + ' record ' + IntToStr(I))));
    TAssert.AssertTrue(Send(KafkaProducerRecord(TOPIC, Value('big'), Big)).Get(10000).Succeeded);
    TAssert.AssertTrue(FProducer.Flush(10000));
    FreeAndNil(FProducer);
    Logged := Broker(1).Logged(TOPIC, 0);
    N := Length(Logged);
    TAssert.AssertEquals(First + 21, N);
    for I := 0 to 19 do
    begin
      TAssert.AssertEquals(KafkaCompressionName(Codec) + ' record ' + IntToStr(I),
        FromUtf8(Logged[First + I].Value));
      TAssert.AssertEquals(KafkaCompressionName(Codec), Ord(Codec),
        Broker(1).LoggedCompression(First + I));
    end;
    TAssert.AssertTrue('the big one', SameBytes(Big, Logged[First + 20].Value));
    TAssert.AssertEquals(Ord(Codec), Broker(1).LoggedCompression(First + 20));
    First := N;
  end;
end;

procedure TKafkaProducerTests.Close_DeliversWhatWasSent;
var
  I: Integer;
  F: TKafkaDeliveryFutureArray;
begin
  StartBrokers(1, [1]);
  FParams.LingerMs := 60000;
  OpenProducer;
  SetLength(F, 3);
  for I := 0 to 2 do
    F[I] := Send(KafkaProducerRecord(TOPIC, Value('v' + IntToStr(I))));
  TAssert.AssertFalse('lingering', F[0].IsDone);
  FProducer.Close;
  for I := 0 to 2 do
    TAssert.AssertTrue(F[I].Report.ErrorMessage, F[I].Report.Succeeded);
  TAssert.AssertEquals(3, Broker(1).LoggedCount);
end;

procedure TKafkaProducerTests.Close_WithTimeout_FailsWhatIsLeft;
var
  A, B: IKafkaDeliveryFuture;
begin
  StartBrokers(1, [1]);
  OpenProducer;
  Broker(1).HoldProduce := True;
  A := Send(KafkaProducerRecord(TOPIC, Value('a')));
  TAssert.AssertTrue(Broker(1).WaitProduceCount(1, 10000));
  B := Send(KafkaProducerRecord(TOPIC, Value('b')));
  FProducer.Close(200);
  TAssert.AssertTrue(A.IsDone and B.IsDone);
  TAssert.AssertTrue(A.Report.ErrorClass = EKafka);
  TAssert.AssertTrue(A.Report.ErrorMessage, Pos('closed', A.Report.ErrorMessage) > 0);
  TAssert.AssertTrue(B.Report.ErrorClass = EKafka);
  TAssert.AssertEquals('callbacks', 2, FReportCount);
end;

procedure TKafkaProducerTests.Callback_CannotFlush;
begin
  StartBrokers(1, [1]);
  OpenProducer;
  FFlushInCallback := True;
  Send(KafkaProducerRecord(TOPIC, Value('v'))).Wait(10000);
  TAssert.AssertEquals('EKafka', FCallbackError);
end;

procedure TKafkaProducerTests.Send_BeforeOpenAndAfterClose_Raises;
begin
  StartBrokers(1, [1]);
  FProducer := TKafkaProducer.Create(FParams);
  TAssert.AssertException('before Open', EKafka, SendOne);
  FProducer.Open;
  SendOne;
  FProducer.Close;
  TAssert.AssertException('after Close', EKafka, SendOne);
end;

procedure TKafkaProducerTests.Params_DeliveryTimeoutTooShort_IsRefused;
begin
  FParams.Cluster.BootstrapServers := '127.0.0.1:1';
  FParams.LingerMs := 100;
  FParams.Cluster.Connection.RequestTimeoutMs := 1000;
  FParams.DeliveryTimeoutMs := 1099;
  TAssert.AssertException(EArgumentException, CreateWithParams);
  FParams.DeliveryTimeoutMs := 1100;
  CreateWithParams;
  FParams.Retries := -1;
  TAssert.AssertException(EArgumentException, CreateWithParams);
end;

procedure TKafkaProducerTests.Params_Zstd_IsRefused;
begin
  FParams.Cluster.BootstrapServers := '127.0.0.1:1';
  FParams.Compression := kcZstd;
  try
    CreateWithParams;
    TAssert.Fail('a zstd producer was created');
  except
    on E: EArgumentException do
      TAssert.AssertTrue(E.Message, Pos('zstd can''t be written yet', E.Message) > 0);
  end;
  FParams.Compression := kcLz4;
  CreateWithParams;
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaProducerTests);

