unit Kafka.ProduceFetchTests;

{ Tests for the generated Produce, Fetch and ListOffsets codecs together with
  the record batch (Kafka.Protocol.RecordBatch), against what a Kafka 4.4.0
  broker and the Java client of the same version sent and answered
  (docs/codec-captures.md).

  - tools/capture_versions.py built every version of the three requests by
    hand: Produce v3-v13, each with a record batch of two records written by
    Python (its own CRC-32C; gzip from Python's gzip module for v13), then
    ListOffsets v1-v11 and Fetch v4-v18 of the same partition. The same
    requests built with the generated records, and Produce's batches with
    TKafkaRecordBatch, must encode to the captured bytes (byte for byte for
    the uncompressed batches: the encoder writes what Python wrote).
  - What the broker answered: each Produce at the next offset, the partition
    ending at 22, every Fetch holding the eleven batches, and one Fetch cut
    short inside the third batch.
  - The Java console producer's gzip batch (keys, headers, a null key, a null
    header value, a non-ASCII value), as sent and as the Java console
    consumer fetched it back: the same records, and the same bytes but for
    the partition leader epoch, which the broker sets and the CRC doesn't
    cover.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Kafka.Protocol.Primitives,
  Kafka.Compression,
  Kafka.Protocol.RecordBatch,
  Kafka.Messages.Produce,
  Kafka.Messages.Fetch,
  Kafka.Messages.ListOffsets,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaProduceFetchTests = class
  public
    [Test] procedure HandBuiltProduceRequests_EncodeToTheCapturedBytes;
    [Test] procedure HandBuiltProduceRequestV13_GzipBatchHoldsTheSameRecords;
    [Test] procedure ProduceResponses_EveryVersion_AppendAtTheNextOffset;
    [Test] procedure HandBuiltListOffsetsRequests_EncodeToTheCapturedBytes;
    [Test] procedure ListOffsetsResponses_EveryVersion_ThePartitionEndsAt22;
    [Test] procedure HandBuiltFetchRequests_EncodeToTheCapturedBytes;
    [Test] procedure FetchResponses_EveryVersion_HoldTheProducedRecords;
    [Test] procedure FetchResponse_CutShort_KeepsTheWholeBatches;
    [Test] procedure JavaGzipBatch_TheConsumerFetchedWhatTheProducerSent;
    [Test] procedure JavaGzipBatch_IsStoredAsSentButForTheLeaderEpoch;
    [Test] procedure JavaConsumerListOffsets_AsksForTheEarliestOffset;
  end;

implementation

const
  RECORDS_TOPIC = 'captured-records';
  /// 2026-01-01T00:00:00Z, the base of capture_versions.py's timestamps.
  T0: Int64 = 1767225600000;

/// The batch capture_versions.py sent with Produce vAVersion.
function HandBuiltBatch(AVersion: Integer): TKafkaRecordBatch;
var
  R: TKafkaRecord;
begin
  Result.Init;
  R := KafkaRecord(Utf8('key-' + IntToStr(AVersion)),
    Utf8('value of produce v' + IntToStr(AVersion)), T0 + 1000 * AVersion);
  KafkaAddRecordHeader(R, 'trace', Utf8('t' + IntToStr(AVersion)));
  KafkaAddRecordHeader(R, 'empty', nil, True);
  Result.Append(R);
  R := KafkaRecord(nil, Utf8('no key'), T0 + 1000 * AVersion + 5);
  R.KeyIsNull := True;
  Result.Append(R);
  if AVersion = 13 then
    Result.SetCompression(kcGzip);
end;

function RecordsTopicId: TKafkaUuid;
var
  R: TKafkaProduceRequest;
begin
  R.FromBytes(CaptureRequestBody('produce-v13'), 13);
  Result := R.TopicData[0].TopicId;
end;

function DecodeBatches(const AData: TBytes; out ATrailing: Integer): TKafkaRecordBatchArray;
begin
  Result := KafkaDecodeRecordBatches(AData, 1 shl 20, ATrailing);
end;

procedure CheckRecord(const AWhat: string; const AExpected, AActual: TKafkaRecord);
var
  I: Integer;
begin
  TAssert.AssertEquals(AWhat + ' key null', AExpected.KeyIsNull, AActual.KeyIsNull);
  TAssert.AssertEquals(AWhat + ' key', BytesToHex(AExpected.Key), BytesToHex(AActual.Key));
  TAssert.AssertEquals(AWhat + ' value null', AExpected.ValueIsNull, AActual.ValueIsNull);
  TAssert.AssertEquals(AWhat + ' value', BytesToHex(AExpected.Value), BytesToHex(AActual.Value));
  TAssert.AssertEquals(AWhat + ' offset delta', AExpected.OffsetDelta, AActual.OffsetDelta);
  TAssert.AssertEquals(AWhat + ' timestamp delta', AExpected.TimestampDelta, AActual.TimestampDelta);
  TAssert.AssertEquals(AWhat + ' headers', Length(AExpected.Headers), Length(AActual.Headers));
  for I := 0 to High(AExpected.Headers) do
  begin
    TAssert.AssertEquals(AWhat + ' header key', AExpected.Headers[I].Key, AActual.Headers[I].Key);
    TAssert.AssertEquals(AWhat + ' header null', AExpected.Headers[I].ValueIsNull,
      AActual.Headers[I].ValueIsNull);
    TAssert.AssertEquals(AWhat + ' header value', BytesToHex(AExpected.Headers[I].Value),
      BytesToHex(AActual.Headers[I].Value));
  end;
end;

procedure CheckBatchRecords(const AWhat: string; const AExpected, AActual: TKafkaRecordBatch);
var
  I: Integer;
begin
  TAssert.AssertEquals(AWhat + ' records', Length(AExpected.Records), Length(AActual.Records));
  TAssert.AssertEquals(AWhat + ' codec', Ord(AExpected.Compression), Ord(AActual.Compression));
  TAssert.AssertEquals(AWhat + ' base timestamp', AExpected.BaseTimestamp, AActual.BaseTimestamp);
  TAssert.AssertEquals(AWhat + ' max timestamp', AExpected.MaxTimestamp, AActual.MaxTimestamp);
  for I := 0 to High(AExpected.Records) do
  begin
    CheckRecord(AWhat + ' record ' + IntToStr(I), AExpected.Records[I], AActual.Records[I]);
    TAssert.AssertEquals(AWhat + ' timestamp', AExpected.Records[I].Timestamp,
      AActual.Records[I].Timestamp);
  end;
end;

function ProduceRequestFor(AVersion: Integer; const ARecords: TBytes): TKafkaProduceRequest;
begin
  Result.Init;
  Result.Acks := -1;
  Result.TimeoutMs := 30000;
  SetLength(Result.TopicData, 1);
  Result.TopicData[0].Init;
  // Name until v12, TopicId from v13: both are ignorable, so setting both
  // serves every version.
  Result.TopicData[0].Name := RECORDS_TOPIC;
  Result.TopicData[0].TopicId := RecordsTopicId;
  SetLength(Result.TopicData[0].PartitionData, 1);
  Result.TopicData[0].PartitionData[0].Init;
  Result.TopicData[0].PartitionData[0].Index := 0;
  Result.TopicData[0].PartitionData[0].Records := ARecords;
  Result.TopicData[0].PartitionData[0].RecordsIsNull := False;
end;

{ TKafkaProduceFetchTests }

procedure TKafkaProduceFetchTests.HandBuiltProduceRequests_EncodeToTheCapturedBytes;
var
  V: Integer;
  Req: TKafkaProduceRequest;
begin
  for V := 3 to 12 do
  begin
    Req := ProduceRequestFor(V, HandBuiltBatch(V).Encode);
    TAssert.AssertEquals('produce-v' + IntToStr(V),
      BytesToHex(CaptureRequestBody('produce-v' + IntToStr(V))), BytesToHex(Req.ToBytes(V)));
  end;
end;

procedure TKafkaProduceFetchTests.HandBuiltProduceRequestV13_GzipBatchHoldsTheSameRecords;
var
  Records: TBytes;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
  Req: TKafkaProduceRequest;
begin
  // Python's gzip and zlib's in this library needn't give the same bytes:
  // the records must be the same, and the rest of the request too.
  Records := ProduceRecords('produce-v13');
  Batches := DecodeBatches(Records, Trailing);
  TAssert.AssertEquals(1, Length(Batches));
  TAssert.AssertEquals(0, Trailing);
  CheckBatchRecords('produce-v13', HandBuiltBatch(13), Batches[0]);
  Req := ProduceRequestFor(13, Records);
  TAssert.AssertEquals(BytesToHex(CaptureRequestBody('produce-v13')), BytesToHex(Req.ToBytes(13)));
end;

procedure TKafkaProduceFetchTests.ProduceResponses_EveryVersion_AppendAtTheNextOffset;
var
  V: Integer;
  Rsp: TKafkaProduceResponse;
  P: TKafkaProduceResponsePartitionProduceResponse;
begin
  for V := 3 to 13 do
  begin
    Rsp.FromBytes(CaptureResponseBody('produce-v' + IntToStr(V)), V);
    TAssert.AssertEquals('topics', 1, Length(Rsp.Responses));
    P := Rsp.Responses[0].PartitionResponses[0];
    TAssert.AssertEquals('error', 0, Integer(P.ErrorCode));
    TAssert.AssertEquals('index', 0, P.Index);
    // Two records per request, from offset 0.
    TAssert.AssertEquals('produce-v' + IntToStr(V) + ' base offset', Int64(2 * (V - 3)), P.BaseOffset);
    // CreateTime: no log append time.
    TAssert.AssertEquals(Int64(-1), P.LogAppendTimeMs);
    if V >= 13 then
      TAssert.AssertTrue('v13 names the topic by id', Rsp.Responses[0].TopicId.Equals(RecordsTopicId))
    else
      TAssert.AssertEquals(RECORDS_TOPIC, Rsp.Responses[0].Name);
  end;
end;

procedure TKafkaProduceFetchTests.HandBuiltListOffsetsRequests_EncodeToTheCapturedBytes;
var
  V: Integer;
  Req: TKafkaListOffsetsRequest;
begin
  for V := 1 to 11 do
  begin
    Req.Init;
    Req.ReplicaId := -1;
    // Ignorable before v10, where it is dropped.
    Req.TimeoutMs := 30000;
    SetLength(Req.Topics, 1);
    Req.Topics[0].Init;
    Req.Topics[0].Name := RECORDS_TOPIC;
    SetLength(Req.Topics[0].Partitions, 1);
    Req.Topics[0].Partitions[0].Init;
    Req.Topics[0].Partitions[0].PartitionIndex := 0;
    Req.Topics[0].Partitions[0].Timestamp := -1; // the end
    TAssert.AssertEquals('list-offsets-v' + IntToStr(V),
      BytesToHex(CaptureRequestBody('list-offsets-v' + IntToStr(V))), BytesToHex(Req.ToBytes(V)));
  end;
end;

procedure TKafkaProduceFetchTests.ListOffsetsResponses_EveryVersion_ThePartitionEndsAt22;
var
  V: Integer;
  Rsp: TKafkaListOffsetsResponse;
  P: TKafkaListOffsetsPartitionResponse;
begin
  for V := 1 to 11 do
  begin
    Rsp.FromBytes(CaptureResponseBody('list-offsets-v' + IntToStr(V)), V);
    TAssert.AssertEquals(RECORDS_TOPIC, Rsp.Topics[0].Name);
    P := Rsp.Topics[0].Partitions[0];
    TAssert.AssertEquals('error', 0, Integer(P.ErrorCode));
    TAssert.AssertEquals('list-offsets-v' + IntToStr(V) + ' offset', Int64(22), P.Offset);
  end;
end;

procedure TKafkaProduceFetchTests.HandBuiltFetchRequests_EncodeToTheCapturedBytes;
var
  V: Integer;
  Req: TKafkaFetchRequest;
  Name: string;
begin
  for V := 4 to 19 do
  begin
    Req.Init;
    Req.MaxWaitMs := 100;
    Req.MinBytes := 1;
    SetLength(Req.Topics, 1);
    Req.Topics[0].Init;
    Req.Topics[0].Topic := RECORDS_TOPIC;
    Req.Topics[0].TopicId := RecordsTopicId;
    SetLength(Req.Topics[0].Partitions, 1);
    Req.Topics[0].Partitions[0].Init;
    Req.Topics[0].Partitions[0].Partition := 0;
    Req.Topics[0].Partitions[0].FetchOffset := 0;
    if V = 19 then
    begin
      // fetch-v18-cut: v18 again, with a smaller partition limit.
      Name := 'fetch-v18-cut';
      Req.Topics[0].Partitions[0].PartitionMaxBytes := 300;
      TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(Req.ToBytes(18)));
    end
    else
    begin
      Name := 'fetch-v' + IntToStr(V);
      Req.Topics[0].Partitions[0].PartitionMaxBytes := 1 shl 20;
      TAssert.AssertEquals(Name, BytesToHex(CaptureRequestBody(Name)), BytesToHex(Req.ToBytes(V)));
    end;
  end;
end;

procedure TKafkaProduceFetchTests.FetchResponses_EveryVersion_HoldTheProducedRecords;
var
  V, I, K: Integer;
  Name: string;
  Rsp: TKafkaFetchResponse;
  P: TKafkaFetchResponsePartitionData;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
begin
  for V := 4 to 18 do
  begin
    Name := 'fetch-v' + IntToStr(V);
    Rsp := DecodeFetchResponse(Name);
    TAssert.AssertEquals(Name + ' error', 0, Integer(Rsp.ErrorCode));
    P := Rsp.Responses[0].Partitions[0];
    TAssert.AssertEquals(Name + ' partition error', 0, Integer(P.ErrorCode));
    TAssert.AssertEquals(Name + ' high watermark', Int64(22), P.HighWatermark);
    TAssert.AssertEquals(Name + ' last stable offset', Int64(22), P.LastStableOffset);
    TAssert.AssertFalse(Name + ' records null', P.RecordsIsNull);
    Batches := DecodeBatches(P.Records, Trailing);
    TAssert.AssertEquals(Name + ' batches', 11, Length(Batches));
    TAssert.AssertEquals(Name + ' trailing', 0, Trailing);
    for I := 0 to 10 do
    begin
      // Batch I came from Produce v(3 + I); the broker set its offsets.
      CheckBatchRecords(Name + ' batch ' + IntToStr(I), HandBuiltBatch(3 + I), Batches[I]);
      TAssert.AssertEquals(Int64(2 * I), Batches[I].BaseOffset);
      TAssert.AssertEquals(Int64(2 * I + 2), Batches[I].NextOffset);
      for K := 0 to 1 do
        TAssert.AssertEquals(Int64(2 * I + K), Batches[I].Records[K].Offset);
    end;
  end;
end;

procedure TKafkaProduceFetchTests.FetchResponse_CutShort_KeepsTheWholeBatches;
var
  Records: TBytes;
  Batches: TKafkaRecordBatchArray;
  Trailing: Integer;
begin
  Records := FetchRecords('fetch-v18-cut');
  TAssert.AssertEquals('the partition limit', 300, Length(Records));
  Batches := DecodeBatches(Records, Trailing);
  TAssert.AssertEquals(2, Length(Batches));
  TAssert.AssertEquals('bytes of the third batch', 300 - 2 * 121, Trailing);
  CheckBatchRecords('second batch', HandBuiltBatch(4), Batches[1]);
end;

function JavaRecord(const AKey, AValue: string; AKeyIsNull: Boolean): TKafkaRecord;
begin
  Result := KafkaRecord(Utf8(AKey), Utf8(AValue), 0);
  Result.KeyIsNull := AKeyIsNull;
end;

procedure TKafkaProduceFetchTests.JavaGzipBatch_TheConsumerFetchedWhatTheProducerSent;
var
  Sent, Fetched: TKafkaRecordBatchArray;
  Trailing, I: Integer;
  Expected: array[0..2] of TKafkaRecord;
begin
  // kafka-console-producer.sh --compression-codec gzip, three lines:
  //   trace:00-abc-01,lang:pt <TAB> k1 <TAB> olá mundo
  //   trace:00-def-01         <TAB> k2 <TAB> second value
  //   empty:NULL              <TAB> NULL <TAB> null key, null header value
  Expected[0] := JavaRecord('k1', 'olá mundo', False);
  KafkaAddRecordHeader(Expected[0], 'trace', Utf8('00-abc-01'));
  KafkaAddRecordHeader(Expected[0], 'lang', Utf8('pt'));
  Expected[1] := JavaRecord('k2', 'second value', False);
  KafkaAddRecordHeader(Expected[1], 'trace', Utf8('00-def-01'));
  Expected[2] := JavaRecord('', 'null key, null header value', True);
  KafkaAddRecordHeader(Expected[2], 'empty', nil, True);

  Sent := DecodeBatches(ProduceRecords('java-producer-gzip-produce-v13'), Trailing);
  Fetched := DecodeBatches(FetchRecords('java-consumer-fetch-v18'), Trailing);
  TAssert.AssertEquals(1, Length(Sent));
  TAssert.AssertEquals(1, Length(Fetched));
  TAssert.AssertEquals('gzip', Ord(kcGzip), Ord(Sent[0].Compression));
  TAssert.AssertEquals(Ord(kcGzip), Ord(Fetched[0].Compression));
  // Idempotent by default since Java 3.0: a producer id, the first sequence.
  TAssert.AssertTrue('producer id', Sent[0].ProducerId >= 0);
  TAssert.AssertEquals(0, Integer(Sent[0].ProducerEpoch));
  TAssert.AssertEquals(0, Sent[0].BaseSequence);
  TAssert.AssertEquals(Sent[0].ProducerId, Fetched[0].ProducerId);
  TAssert.AssertEquals(3, Length(Fetched[0].Records));
  for I := 0 to 2 do
  begin
    Expected[I].OffsetDelta := I;
    // The deltas Java chose: whatever was sent is what came back.
    Expected[I].TimestampDelta := Sent[0].Records[I].TimestampDelta;
    CheckRecord('sent ' + IntToStr(I), Expected[I], Sent[0].Records[I]);
    CheckRecord('fetched ' + IntToStr(I), Expected[I], Fetched[0].Records[I]);
    TAssert.AssertEquals(Int64(I), Fetched[0].Records[I].Offset);
    TAssert.AssertEquals(Sent[0].Records[I].Timestamp, Fetched[0].Records[I].Timestamp);
  end;
  TAssert.AssertEquals('olá mundo', FromUtf8(Fetched[0].Records[0].Value));
end;

procedure TKafkaProduceFetchTests.JavaGzipBatch_IsStoredAsSentButForTheLeaderEpoch;
var
  Sent, Fetched: TBytes;
  I: Integer;
begin
  Sent := ProduceRecords('java-producer-gzip-produce-v13');
  Fetched := FetchRecords('java-consumer-fetch-v18');
  TAssert.AssertEquals(Length(Sent), Length(Fetched));
  // Bytes 12-15, partitionLeaderEpoch: -1 from the producer, the leader's
  // epoch once stored. The CRC starts at byte 21, so it holds for both.
  TAssert.AssertEquals('ffffffff', BytesToHex(BytesFrom(Copy(Sent, 0, 16), 12)));
  for I := 12 to 15 do
    Sent[I] := Fetched[I];
  TAssert.AssertEquals(BytesToHex(Sent), BytesToHex(Fetched));
end;

procedure TKafkaProduceFetchTests.JavaConsumerListOffsets_AsksForTheEarliestOffset;
var
  Req: TKafkaListOffsetsRequest;
  Rsp: TKafkaListOffsetsResponse;
begin
  Req.FromBytes(CaptureRequestBody('java-consumer-list-offsets-v11'), 11);
  Rsp.FromBytes(CaptureResponseBody('java-consumer-list-offsets-v11'), 11);
  // --offset earliest: timestamp -2.
  TAssert.AssertEquals(Int64(-2), Req.Topics[0].Partitions[0].Timestamp);
  TAssert.AssertEquals(0, Integer(Rsp.Topics[0].Partitions[0].ErrorCode));
  TAssert.AssertEquals(Int64(0), Rsp.Topics[0].Partitions[0].Offset);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaProduceFetchTests);

end.
