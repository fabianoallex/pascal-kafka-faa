function Join(const AParts: array of TBytes): TBytes;
var
  I, N: Integer;
begin
  Result := nil;
  for I := 0 to High(AParts) do
  begin
    N := Length(Result);
    SetLength(Result, N + Length(AParts[I]));
    if Length(AParts[I]) > 0 then
      Move(AParts[I][0], Result[N], Length(AParts[I]));
  end;
end;

function Text(ACount: Integer): TBytes;
var
  I: Integer;
  S: string;
begin
  S := '';
  for I := 0 to ACount - 1 do
    S := S + Format('record %d of a batch, key=k%d; ', [I, I mod 17]);
  Result := Utf8(S);
end;

/// xorshift32 from 12345, each step's low byte or the step mod AMod plus
/// ABase (no multiplication to overflow under Delphi's $Q+).
function XorShift(ACount, AMod, ABase: Integer; ALowByte: Boolean): TBytes;
var
  I: Integer;
  X: Cardinal;
begin
  Result := nil;
  SetLength(Result, ACount);
  X := 12345;
  for I := 0 to ACount - 1 do
  begin
    X := X xor (X shl 13);
    X := X xor (X shr 17);
    X := X xor (X shl 5);
    if ALowByte then
      Result[I] := Byte(X)
    else
      Result[I] := Byte(ABase + Integer(X mod Cardinal(AMod)));
  end;
end;

function Pseudorandom(ACount: Integer): TBytes;
begin
  Result := XorShift(ACount, 0, 0, True);
end;

/// 'a' plus each step mod AKinds.
function Letters(ACount, AKinds: Integer): TBytes;
begin
  Result := XorShift(ACount, AKinds, Ord('a'), False);
end;

/// Each step mod AKinds.
function LowBytes(ACount, AKinds: Integer): TBytes;
begin
  Result := XorShift(ACount, AKinds, 0, False);
end;

function Repeated(const AText: string; ACount: Integer): TBytes;
var
  I: Integer;
  S: string;
begin
  S := '';
  for I := 1 to ACount do
    S := S + AText;
  Result := Utf8(S);
end;

function Filled(ACount: Integer; AValue: Byte): TBytes;
begin
  Result := nil;
  SetLength(Result, ACount);
  if ACount > 0 then
    FillChar(Result[0], ACount, AValue);
end;

function WithByte(const AData: TBytes; AIndex: Integer; AValue: Byte): TBytes;
begin
  Result := Copy(AData, 0, Length(AData));
  Result[AIndex] := AValue;
end;

/// The message of the EKafkaCompression decoding AData raises, or '' when
/// it decodes. Any other exception fails the test.
function ErrorOf(const AData: TBytes; AMax: Integer = LIMIT): string;
begin
  try
    KafkaZstdDecompress(AData, AMax);
    Result := '';
  except
    on E: EKafkaCompression do
      Result := E.Message;
  end;
end;

procedure CheckRefused(const AWhat: string; const AData: TBytes; const AWords: string;
  AMax: Integer = LIMIT);
var
  Msg: string;
begin
  Msg := ErrorOf(AData, AMax);
  TAssert.AssertTrue(AWhat + ': refused', Msg <> '');
  TAssert.AssertTrue(AWhat + ': "' + Msg + '" says "' + AWords + '"', Pos(AWords, Msg) > 0);
end;

procedure CheckGives(const AWhat: string; const AData, AExpected: TBytes);
var
  Got: TBytes;
begin
  Got := KafkaZstdDecompress(AData, LIMIT);
  TAssert.AssertEquals(AWhat + ': length', Length(AExpected), Length(Got));
  TAssert.AssertTrue(AWhat, SameBytes(AExpected, Got));
end;

/// A skippable frame of ASize bytes, with magic 184D2A5 and ANibble.
function Skippable(ANibble: Byte; ASize: Integer): TBytes;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, 8 + ASize);
  Result[0] := $50 or ANibble;
  Result[1] := $2A;
  Result[2] := $4D;
  Result[3] := $18;
  Result[4] := Byte(ASize);
  Result[5] := Byte(ASize shr 8);
  Result[6] := 0;
  Result[7] := 0;
  for I := 8 to High(Result) do
    Result[I] := Byte(I);
end;

/// A zstd frame of raw blocks holding AData: a single segment, a 4-byte
/// content size, blocks of at most 128 KiB.
function RawFrame(const AData: TBytes): TBytes;
var
  N, P, LCount, Q: Integer;
  H: Cardinal;
begin
  N := Length(AData);
  Result := HexToBytes('28b52ffda0');
  Result := Join([Result, Bytes([Byte(N), Byte(N shr 8), Byte(N shr 16), Byte(N shr 24)])]);
  P := 0;
  repeat
    LCount := N - P;
    if LCount > 131072 then
      LCount := 131072;
    H := Cardinal(LCount) shl 3;
    if P + LCount = N then
      H := H or 1;
    Q := Length(Result);
    Result := Join([Result, Bytes([Byte(H), Byte(H shr 8), Byte(H shr 16)]),
      Copy(AData, P, LCount)]);
    TAssert.AssertTrue(Length(Result) = Q + 3 + LCount);
    Inc(P, LCount);
  until P = N;
end;

procedure TKafkaZstdTests.XxHash64_KnownVectors;

  function H(const AText: string; ASeed: UInt64): string;
  var
    B: TBytes;
  begin
    B := Utf8(AText);
    Result := IntToHex(Int64(KafkaXxHash64(B, 0, Length(B), ASeed)), 16);
  end;

var
  B: TBytes;
begin
  TAssert.AssertEquals('EF46DB3751D8E999', H('', 0));
  TAssert.AssertEquals('D24EC4F1A98C6E5B', H('a', 0));
  TAssert.AssertEquals('44BC2CF5AD770999', H('abc', 0));
  TAssert.AssertEquals('FBCEA83C8A378BF1', H('Nobody inspects the spammish repetition', 0));
  // 35 bytes: a 32-byte stripe, then 3 bytes.
  TAssert.AssertEquals('654F6A2B39E4D8C1', H('0123456789abcdef0123456789abcdefXYZ', 0));
  // 72 bytes: two stripes, an 8-byte step.
  TAssert.AssertEquals('E597DB74E7CE323C',
    H('0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz', 0));
  TAssert.AssertEquals('AC75FDA2929B17EF', H('', $9E3779B1));
  TAssert.AssertEquals('56DB22DD5B051147', H('Nobody inspects the spammish repetition', $9E3779B1));
  TAssert.AssertEquals('A7CB2AAC405E36C7', H('abc', UInt64($9E3779B185EBCA87)));
  // An offset into a larger buffer.
  B := Utf8('--abc--');
  TAssert.AssertEquals('44BC2CF5AD770999', IntToHex(Int64(KafkaXxHash64(B, 2, 3, 0)), 16));
end;

procedure TKafkaZstdTests.ReadsTheReferenceFrames;
var
  Z: TBytes;
begin
  CheckGives('hello', HexToBytes(ZSTD_HELLO), Utf8('hello kafka'));
  CheckGives('empty', HexToBytes(ZSTD_EMPTY), nil);
  CheckGives('text, checksum', HexToBytes(ZSTD_TEXT), Text(200));
  CheckGives('text as Java writes it', HexToBytes(ZSTD_TEXT_AS_JAVA), Text(200));
  CheckGives('text, level 19', HexToBytes(ZSTD_TEXT_19), Text(200));
  CheckGives('one Huffman stream', HexToBytes(ZSTD_LETTERS_ONE_STREAM), Letters(50, 2));
  CheckGives('direct weights', HexToBytes(ZSTD_LOW_DIRECT), LowBytes(100, 5));
  CheckGives('FSE tables', HexToBytes(ZSTD_LETTERS_FSE), Letters(200, 2));
  CheckGives('RLE match lengths', HexToBytes(ZSTD_LETTERS_ML_RLE), Letters(100, 4));
  CheckGives('many sequences', HexToBytes(ZSTD_LETTERS_MANY), Letters(1000, 2));
  CheckGives('treeless', HexToBytes(ZSTD_LETTERS_TREELESS), Letters(1000, 2));
  CheckGives('repeated tables', HexToBytes(ZSTD_TEXT_REPEAT), Text(40));
  CheckGives('RLE tables', HexToBytes(ZSTD_TEXT_RLE), Text(40));
  CheckGives('repeated match lengths', HexToBytes(ZSTD_TEXT_ML_REPEAT), Text(20));
  CheckGives('zeros', HexToBytes(ZSTD_ZEROS), Filled(300000, 0));
  CheckGives('RLE blocks', HexToBytes(ZSTD_ZEROS_RLE), Filled(1000, 0));
  CheckGives('random', HexToBytes(ZSTD_RANDOM), Pseudorandom(300));
  CheckGives('literal and match lengths with extra bits', HexToBytes(ZSTD_RANDOM_THEN_RUN),
    Join([Pseudorandom(20), Repeated('abcdefgh', 10)]));
  // Java's shape: no single segment, no content size, no checksum.
  Z := HexToBytes(ZSTD_TEXT_AS_JAVA);
  TAssert.AssertEquals('frame header descriptor', 0, Integer(Z[4]));
  // 300 000 zeros in 29 bytes.
  TAssert.AssertEquals(29, Length(HexToBytes(ZSTD_ZEROS)));
end;

procedure TKafkaZstdTests.ReadsHandBuiltFrames;
var
  Expected: TBytes;
  Rep: array[0..2] of Integer;
  I, K, Off, N: Integer;
begin
  CheckGives('raw block', HexToBytes(HAND_RAW), Utf8('hello'));
  CheckGives('RLE block', HexToBytes(HAND_RLE_BLOCK), Filled(9, Ord('z')));
  CheckGives('8-byte content size', HexToBytes(HAND_FCS8), Utf8('hello'));
  CheckGives('2-byte content size', HexToBytes(HAND_FCS2), Filled(300, Ord('q')));
  CheckGives('dictionary id 0', HexToBytes(HAND_DICT_ID_0), Utf8('hello'));
  CheckGives('RLE literals', HexToBytes(HAND_RLE_LITERALS), Filled(200, Ord('r')));
  CheckGives('empty raw block', HexToBytes(HAND_EMPTY), nil);
  CheckGives('one sequence', HexToBytes(HAND_ONE_SEQUENCE), Utf8('abcdefghefg'));
  CheckGives('literals, then a match', HexToBytes(HAND_LITERALS_THEN_MATCH),
    Utf8('abcdefghxyyyy'));
  // 33 000 matches of 3, from the second repeat offset each time: the two
  // first swap at every step (RFC 8878, 3.1.1.5).
  N := 8 + 3 * 33000;
  Expected := Utf8('abcdefgh');
  SetLength(Expected, N);
  Rep[0] := 1;
  Rep[1] := 4;
  Rep[2] := 8;
  K := 8;
  for I := 1 to 33000 do
  begin
    Off := Rep[1];
    Rep[1] := Rep[0];
    Rep[0] := Off;
    Expected[K] := Expected[K - Off];
    Expected[K + 1] := Expected[K + 1 - Off];
    Expected[K + 2] := Expected[K + 2 - Off];
    Inc(K, 3);
  end;
  CheckGives('33 000 sequences', HexToBytes(HAND_33000_SEQUENCES), Expected);
end;

procedure TKafkaZstdTests.SeveralFrames_AndSkippableFrames;
var
  Hello, Text200: TBytes;
  Nibble: Byte;
begin
  Hello := HexToBytes(ZSTD_HELLO);
  Text200 := HexToBytes(ZSTD_TEXT);
  // Frames one after the other (Java's stream reads them all), each with
  // its own repeat offsets and tables.
  CheckGives('two frames', Join([Hello, Text200]), Join([Utf8('hello kafka'), Text(200)]));
  CheckGives('three frames', Join([Text200, HexToBytes(ZSTD_TEXT_REPEAT), Hello]),
    Join([Text(200), Text(40), Utf8('hello kafka')]));
  // Skippable frames (magic 184D2A50 to 184D2A5F), skipped wherever they are.
  for Nibble := 0 to 15 do
    CheckGives('skippable ' + IntToStr(Nibble), Join([Skippable(Nibble, 7), Hello,
      Skippable(15 - Nibble, 0)]), Utf8('hello kafka'));
  CheckGives('skippable between', Join([Hello, Skippable(3, 300), Hello]),
    Utf8('hello kafkahello kafka'));
  CheckGives('only skippable', Skippable(0, 10), nil);
  CheckGives('an empty frame between', Join([Hello, HexToBytes(ZSTD_EMPTY), Hello]),
    Utf8('hello kafkahello kafka'));
end;

procedure TKafkaZstdTests.WhatJavaRefuses_IsRefused;
begin
  CheckRefused('a dictionary', HexToBytes(BAD_DICTIONARY), 'a dictionary (id 7)');
  CheckRefused('a 256 MiB window', HexToBytes(BAD_WINDOW_256MB),
    'a window of 268435456 bytes, above the 134217728');
  CheckGives('a 128 MiB window', HexToBytes(OK_WINDOW_128MB), Utf8('hello'));
  CheckRefused('zstd 0.7', HexToBytes(BAD_LEGACY_07), 'legacy format (magic FD2FB527)');
  CheckRefused('zstd 0.1', Join([Bytes([$1E, $B5, $2F, $FD]), Filled(10, 0)]),
    'legacy format');
  CheckRefused('a reserved bit', HexToBytes(BAD_RESERVED_BIT), 'reserved bit');
end;

procedure TKafkaZstdTests.CorruptFrames_AreRefused;
var
  Hello, Text200: TBytes;
begin
  Hello := HexToBytes(ZSTD_HELLO);
  Text200 := HexToBytes(ZSTD_TEXT);
  CheckRefused('nothing', nil, 'shorter than a frame''s magic number');
  CheckRefused('3 bytes', Bytes([$28, $B5, $2F]), 'shorter than a frame''s magic number');
  CheckRefused('not zstd', Utf8('hello kafka'), 'not a zstd frame (magic 6C6C6568)');
  CheckRefused('gzip', HexToBytes('1f8b0800000000000003'), 'not a zstd frame');
  CheckRefused('the magic alone', Copy(Hello, 0, 4), 'frame header is cut short');
  CheckRefused('the header cut', Copy(Hello, 0, 5), 'frame header is cut short');
  CheckRefused('no block', Copy(Hello, 0, 6), 'block header is cut short');
  CheckRefused('a block cut', Copy(Hello, 0, Length(Hello) - 1), 'a raw block of 11 bytes with 10');
  CheckRefused('a compressed block cut', Copy(Text200, 0, 100), 'a compressed block of');
  CheckRefused('the checksum cut', Copy(Text200, 0, Length(Text200) - 1),
    'content checksum is cut short');
  CheckRefused('a wrong checksum', WithByte(Text200, Length(Text200) - 1,
    Text200[Length(Text200) - 1] xor 1), 'content checksum doesn''t match');
  // Java refuses bytes after the frame that aren't the start of a magic
  // number, and ignores those that are; this refuses both.
  CheckRefused('3 bytes after', Join([Hello, Bytes([1, 2, 3])]), '3 bytes after the last frame');
  CheckRefused('a magic''s start after', Join([Hello, Bytes([$28, $B5])]),
    '2 bytes after the last frame');
  CheckRefused('5 bytes after', Join([Hello, Bytes([1, 2, 3, 4, 5])]),
    '5 bytes after the last frame, not a frame');
  CheckRefused('a skippable frame cut', Join([Hello, Copy(Skippable(0, 4), 0, 10)]),
    'a skippable frame of 4 bytes with 2 left');
  CheckRefused('a skippable header cut', Join([Hello, Copy(Skippable(0, 4), 0, 6)]),
    'skippable frame''s header is cut short');
  CheckRefused('block type 3', HexToBytes(BAD_BLOCK_TYPE_3), 'reserved type 3');
  CheckRefused('a block above its frame''s maximum', HexToBytes(BAD_BLOCK_ABOVE_MAX),
    'a block of 6 bytes, above the frame''s 5');
  CheckRefused('less than the content size', HexToBytes(BAD_SIZE_MISMATCH),
    'the frame says 6 bytes and holds 5');
  CheckRefused('more than the content size', WithByte(HexToBytes(HAND_RLE_BLOCK), 5, 8),
    'a block of 9 bytes, above the frame''s 8');
  // A window of 1 KiB and a 2-byte content size of 256 (written 0), then
  // RLE blocks of 200 and 100.
  CheckRefused('more than the content size, two blocks', HexToBytes('28b52ffd' + '40' + '00' +
    '0000' + '420600' + '7a' + '230300' + '7a'), 'holds more than the 256 bytes it says');
  // Frames are independent: a match can't reach into the one before.
  CheckRefused('a match into the frame before', Join([Hello,
    HexToBytes(BAD_OFFSET_BEFORE_START)]), 'a match from 4 bytes back, with 0 bytes before it');
end;

procedure TKafkaZstdTests.CorruptBlocks_AreRefused;
var
  Z: TBytes;
begin
  CheckRefused('treeless literals first', HexToBytes(BAD_TREELESS_FIRST),
    'previous Huffman tree, and there was none');
  CheckRefused('a repeated table first', HexToBytes(BAD_REPEAT_FIRST),
    'literal lengths table repeated, and there was none');
  CheckRefused('a match before the start', HexToBytes(BAD_OFFSET_BEFORE_START),
    'a match from 4 bytes back, with 0 bytes before it in the frame');
  CheckRefused('a block above its 64 KiB', HexToBytes(HAND_33000_SMALL_WINDOW),
    'decompresses to more than its 65536 bytes');
  CheckRefused('4 streams of 5 literals', HexToBytes(BAD_4_STREAMS_5_LITERALS),
    '5 literals in 4 Huffman streams, at least 6');
  CheckRefused('weights with no power of 2 left', HexToBytes(BAD_WEIGHTS_NO_POWER_OF_2),
    'no power of 2 for the last symbol');
  CheckRefused('a weight of 13', HexToBytes(BAD_WEIGHT_13), 'a Huffman weight of 13');
  // The one Huffman stream of ZSTD_LETTERS_ONE_STREAM ends at byte 23 (the
  // block's last, 24, is its 0 sequences).
  Z := HexToBytes(ZSTD_LETTERS_ONE_STREAM);
  CheckRefused('a Huffman stream with no end mark', WithByte(Z, 23, 0),
    'Huffman stream whose last byte is 0');
  CheckRefused('a Huffman stream with bits over', WithByte(Z, 23, Z[23] or $80),
    'Huffman stream');
  CheckRefused('an accuracy log of 20', HexToBytes(BAD_FSE_LOG_20),
    'literal lengths table has accuracy log 20, at most 9');
  CheckRefused('an RLE symbol of 36', HexToBytes(BAD_RLE_SYMBOL_36),
    'literal lengths RLE symbol 36, at most 35');
  CheckRefused('reserved mode bits', HexToBytes(BAD_RESERVED_MODES),
    'reserved bits set in the sequences'' modes');
  CheckRefused('bytes after no sequences', HexToBytes(BAD_BYTES_AFTER_NO_SEQUENCES),
    '1 bytes after a block''s sequences section');
  CheckRefused('sequence bits left', HexToBytes(BAD_SEQUENCE_BITS_LEFT),
    'has 1 bits left after its sequences');
  CheckRefused('sequence bits short', HexToBytes(BAD_SEQUENCE_BITS_SHORT),
    'ends before its 1 sequences');
  CheckRefused('more literals than there are', HexToBytes(BAD_TOO_MANY_LITERALS),
    'a sequence takes 5 literals with 2 left');
  CheckRefused('a sequences bitstream with no end mark', HexToBytes(BAD_SEQUENCES_LAST_BYTE_0),
    'sequences bitstream whose last byte is 0');
end;

procedure TKafkaZstdTests.LargerThanTheLimit_IsRefused;
var
  Z: TBytes;
begin
  // The frame says 300 000: refused from its header.
  Z := HexToBytes(ZSTD_ZEROS);
  CheckRefused('the content size', Z, 'more than 299999 bytes (its frame says 300000)', 299999);
  TAssert.AssertEquals(300000, Length(KafkaZstdDecompress(Z, 300000)));
  // No content size: refused as the blocks come.
  Z := HexToBytes(ZSTD_ZEROS_RLE);
  CheckRefused('the blocks', Z, 'more than 999 bytes', 999);
  TAssert.AssertEquals(1000, Length(KafkaZstdDecompress(Z, 1000)));
  // An 8-byte content size far beyond anything.
  CheckRefused('an exabyte', HexToBytes('28b52ffdc000' + '0000000000000010' + '010000'),
    'its frame says 1152921504606846976');
  // The limit counts every frame.
  CheckRefused('two frames', Join([HexToBytes(ZSTD_HELLO), HexToBytes(ZSTD_HELLO)]),
    'more than 21 bytes (its frame says 11)', 21);
end;

procedure TKafkaZstdTests.CorruptInput_IsDecodedOrRefused_NothingElse;
var
  X: Cardinal;

  function Rnd(N: Integer): Integer;
  begin
    X := X xor (X shl 13);
    X := X xor (X shr 17);
    X := X xor (X shl 5);
    Result := Integer(X mod Cardinal(N));
  end;

const
  SOURCES: array[0..7] of string = (ZSTD_TEXT, ZSTD_TEXT_AS_JAVA, ZSTD_TEXT_19,
    ZSTD_LETTERS_TREELESS, ZSTD_TEXT_REPEAT, ZSTD_TEXT_RLE, ZSTD_LOW_DIRECT,
    ZSTD_LETTERS_MANY);
var
  S, I, K, N: Integer;
  Z, M: TBytes;
begin
  X := 2463534242;
  for S := 0 to High(SOURCES) do
  begin
    Z := HexToBytes(SOURCES[S]);
    for I := 1 to 250 do
    begin
      M := Copy(Z, 0, Length(Z));
      case Rnd(3) of
        0:
          for K := 0 to Rnd(3) do
            M[Rnd(Length(M))] := Byte(Rnd(256));
        1:
          SetLength(M, Rnd(Length(M)));
      else
        begin
          N := Rnd(Length(M));
          M := Join([Copy(M, 0, N), Bytes([$FF, Byte(Rnd(256))]), BytesFrom(M, N)]);
        end;
      end;
      // EKafkaCompression is caught; anything else fails the test.
      ErrorOf(M, 1 shl 20);
    end;
  end;
end;

procedure TKafkaZstdTests.ThroughKafkaCompression_ReadNotWritten;
var
  Codec: TKafkaCompression;
  Batch, Back: TKafkaRecordBatch;
  Plain, Repacked: TBytes;
  Batches: TKafkaRecordBatchArray;
  Trailing, I: Integer;
  N, Crc: Cardinal;
begin
  TAssert.AssertFalse('zstd is not written', KafkaCompressionSupported(kcZstd));
  for Codec := Low(TKafkaCompression) to High(TKafkaCompression) do
    TAssert.AssertTrue(KafkaCompressionName(Codec) + ' is read',
      KafkaDecompressionSupported(Codec));
  TAssert.AssertTrue(SameBytes(Text(200), KafkaDecompress(kcZstd, HexToBytes(ZSTD_TEXT), LIMIT)));
  try
    KafkaCompress(kcZstd, Utf8('x'));
    TAssert.Fail('zstd was written');
  except
    on E: EKafkaCompression do
      TAssert.AssertTrue(E.Message, Pos('zstd can''t be written yet', E.Message) > 0);
  end;
  // A batch encoded plain, its records section then put in a zstd frame
  // (raw blocks), the codec bits set to 4, the length and CRC made right.
  Batch.Init;
  for I := 0 to 49 do
    Batch.Append(KafkaRecord(Utf8('key-' + IntToStr(I)), Utf8(Format('value %d, olá', [I])),
      1000 + I));
  Plain := Batch.Encode;
  Repacked := Join([Copy(Plain, 0, KAFKA_RECORD_BATCH_HEADER_SIZE),
    RawFrame(BytesFrom(Plain, KAFKA_RECORD_BATCH_HEADER_SIZE))]);
  Repacked[22] := (Repacked[22] and $F8) or Ord(kcZstd);
  N := Cardinal(Length(Repacked) - 12);
  for I := 0 to 3 do
    Repacked[8 + I] := Byte(N shr (8 * (3 - I)));
  Crc := KafkaCrc32c(Repacked, 21, Length(Repacked) - 21);
  for I := 0 to 3 do
    Repacked[17 + I] := Byte(Crc shr (8 * (3 - I)));
  Batches := KafkaDecodeRecordBatches(Repacked, LIMIT, Trailing);
  TAssert.AssertEquals(1, Length(Batches));
  TAssert.AssertEquals(0, Trailing);
  Back := Batches[0];
  TAssert.AssertEquals(Ord(kcZstd), Ord(Back.Compression));
  TAssert.AssertEquals(50, Length(Back.Records));
  for I := 0 to 49 do
  begin
    TAssert.AssertEquals('key-' + IntToStr(I), FromUtf8(Back.Records[I].Key));
    TAssert.AssertEquals(Format('value %d, olá', [I]), FromUtf8(Back.Records[I].Value));
    TAssert.AssertEquals(Int64(1000 + I), Back.Records[I].Timestamp);
  end;
  // Writing it again needs a zstd encoder, which this library doesn't have.
  Back.SetCompression(kcZstd);
  try
    Back.Encode;
    TAssert.Fail('a zstd batch was written');
  except
    on E: EKafkaCompression do
      TAssert.AssertTrue(E.Message, Pos('can''t be written yet', E.Message) > 0);
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaZstdTests);

end.
