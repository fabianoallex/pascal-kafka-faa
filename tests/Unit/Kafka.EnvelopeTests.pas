unit Kafka.EnvelopeTests;

{ Tests for Kafka.Protocol.Envelope: the request header v1 and v2 and the
  response header v0 and v1, byte for byte; the header version chosen for a
  body (ApiVersions' response always v0); the size prefix of a whole frame;
  the peek helpers; and refused header versions.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Kafka.Types,
  Kafka.Protocol.Primitives,
  Kafka.Protocol.Envelope,
  Kafka.Messages.Apis,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaEnvelopeTests = class
  private
    procedure WriteRequestHeaderV0;
  public
    [Test] procedure HeaderVersions_FollowTheBody;
    [Test] procedure HeaderVersions_ApiVersionsResponseIsAlwaysV0;
    [Test] procedure RequestHeaderV1_Bytes;
    [Test] procedure RequestHeaderV2_ClientIdStaysClassic;
    [Test] procedure RequestHeader_NullClientId;
    [Test] procedure RequestHeader_ReadBack;
    [Test] procedure ResponseHeaderV0AndV1_Bytes;
    [Test] procedure RequestFrame_HasTheSizePrefix;
    [Test] procedure Peek_CorrelationAndApi;
    [Test] procedure RequestHeaderV0_IsRefused;
    [Test] procedure Apis_TableAndFlexibleVersions;
  end;

implementation

function Header(AKey, AVersion: Int16; ACorrelation: Int32; const AClientId: string): TKafkaRequestHeader;
begin
  Result := Default(TKafkaRequestHeader);
  Result.ApiKey := AKey;
  Result.ApiVersion := AVersion;
  Result.CorrelationId := ACorrelation;
  Result.ClientId := AClientId;
end;

function EncodeRequestHeader(const AHeader: TKafkaRequestHeader; AVersion: Int16): string;
var
  W: TKafkaWriter;
begin
  W := TKafkaWriter.Create;
  try
    KafkaWriteRequestHeader(W, AHeader, AVersion);
    Result := BytesToHex(W.ToBytes);
  finally
    W.Free;
  end;
end;

procedure TKafkaEnvelopeTests.WriteRequestHeaderV0;
begin
  EncodeRequestHeader(Header(3, 0, 1, 'x'), 0);
end;

procedure TKafkaEnvelopeTests.HeaderVersions_FollowTheBody;
begin
  TAssert.AssertEquals(1, Integer(KafkaRequestHeaderVersion(False)));
  TAssert.AssertEquals(2, Integer(KafkaRequestHeaderVersion(True)));
  TAssert.AssertEquals(0, Integer(KafkaResponseHeaderVersion(KAFKA_API_KEY_METADATA, False)));
  TAssert.AssertEquals(1, Integer(KafkaResponseHeaderVersion(KAFKA_API_KEY_METADATA, True)));
end;

procedure TKafkaEnvelopeTests.HeaderVersions_ApiVersionsResponseIsAlwaysV0;
begin
  TAssert.AssertEquals(0, Integer(KafkaResponseHeaderVersion(KAFKA_API_KEY_API_VERSIONS, True)));
  TAssert.AssertEquals(0, Integer(KafkaResponseHeaderVersion(KAFKA_API_KEY_API_VERSIONS, False)));
end;

procedure TKafkaEnvelopeTests.RequestHeaderV1_Bytes;
begin
  // Metadata v4, correlation 1004, client id "abc".
  TAssert.AssertEquals('0003' + '0004' + '000003ec' + '0003616263',
    EncodeRequestHeader(Header(3, 4, 1004, 'abc'), 1));
end;

procedure TKafkaEnvelopeTests.RequestHeaderV2_ClientIdStaysClassic;
begin
  // The INT16 length of the client id, then an empty tagged section.
  TAssert.AssertEquals('0012' + '0005' + '00000001' + '0003616263' + '00',
    EncodeRequestHeader(Header(18, 5, 1, 'abc'), 2));
end;

procedure TKafkaEnvelopeTests.RequestHeader_NullClientId;
var
  H: TKafkaRequestHeader;
begin
  H := Header(3, 9, 7, '');
  H.ClientIdIsNull := True;
  TAssert.AssertEquals('0003' + '0009' + '00000007' + 'ffff' + '00', EncodeRequestHeader(H, 2));
end;

procedure TKafkaEnvelopeTests.RequestHeader_ReadBack;
var
  R: TKafkaReader;
  H: TKafkaRequestHeader;
begin
  R := TKafkaReader.Create(HexToBytes('0003 000d 0000002a 0003616263 01 0701ff'));
  try
    H := KafkaReadRequestHeader(R, 2);
    TAssert.AssertEquals(3, Integer(H.ApiKey));
    TAssert.AssertEquals(13, Integer(H.ApiVersion));
    TAssert.AssertEquals(42, H.CorrelationId);
    TAssert.AssertEquals('abc', H.ClientId);
    TAssert.AssertFalse(H.ClientIdIsNull);
    TAssert.AssertEquals(1, Length(H.TaggedFields));
    TAssert.AssertEquals(Int64(7), Int64(H.TaggedFields[0].Tag));
    TAssert.AssertTrue(R.AtEnd);
  finally
    R.Free;
  end;
end;

procedure TKafkaEnvelopeTests.ResponseHeaderV0AndV1_Bytes;
var
  W: TKafkaWriter;
  H: TKafkaResponseHeader;
begin
  H := Default(TKafkaResponseHeader);
  H.CorrelationId := -2;
  W := TKafkaWriter.Create;
  try
    KafkaWriteResponseHeader(W, H, 0);
    KafkaWriteResponseHeader(W, H, 1);
    TAssert.AssertEquals('fffffffe' + 'fffffffe00', BytesToHex(W.ToBytes));
  finally
    W.Free;
  end;
end;

procedure TKafkaEnvelopeTests.RequestFrame_HasTheSizePrefix;
var
  F: TBytes;
begin
  F := KafkaEncodeRequestFrame(Header(18, 0, 1, 'a'), 1, Bytes([$AB]));
  // size 12 = 2 + 2 + 4 + (2 + 1) + 1
  TAssert.AssertEquals('0000000c' + '0012' + '0000' + '00000001' + '000161' + 'ab', BytesToHex(F));
end;

procedure TKafkaEnvelopeTests.Peek_CorrelationAndApi;
var
  Key, Version: Int16;
begin
  TAssert.AssertEquals(1004, KafkaPeekCorrelationId(HexToBytes('000003ec 00')));
  KafkaPeekRequestApi(HexToBytes('0003 0004 000003ec'), Key, Version);
  TAssert.AssertEquals(3, Integer(Key));
  TAssert.AssertEquals(4, Integer(Version));
end;

procedure TKafkaEnvelopeTests.RequestHeaderV0_IsRefused;
begin
  TAssert.AssertException(EKafkaUnsupportedVersion, WriteRequestHeaderV0);
end;

procedure TKafkaEnvelopeTests.Apis_TableAndFlexibleVersions;
var
  Info: TKafkaApiInfo;
begin
  TAssert.AssertTrue(KafkaFindApi(KAFKA_API_KEY_METADATA, Info));
  TAssert.AssertEquals('Metadata', Info.Name);
  TAssert.AssertEquals(0, Integer(Info.MinVersion));
  TAssert.AssertEquals(13, Integer(Info.MaxVersion));
  TAssert.AssertFalse(KafkaApiIsFlexible(KAFKA_API_KEY_METADATA, 8));
  TAssert.AssertTrue(KafkaApiIsFlexible(KAFKA_API_KEY_METADATA, 9));
  TAssert.AssertTrue(KafkaApiIsFlexible(KAFKA_API_KEY_API_VERSIONS, 3));
  TAssert.AssertFalse(KafkaApiIsFlexible(KAFKA_API_KEY_API_VERSIONS, 2));
  TAssert.AssertEquals('ApiVersions', KafkaApiName(18));
  TAssert.AssertEquals('ApiKey(0)', KafkaApiName(0));
  TAssert.AssertFalse(KafkaFindApi(0, Info));
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaEnvelopeTests);

end.
