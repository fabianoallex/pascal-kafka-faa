unit Kafka.SaslConnectionTests;

{ Tests for SASL inside Kafka.Connection's Open, against the in-process fake
  broker (Kafka.TestFakeBroker), whose SCRAM side is a server's, written
  apart from Kafka.Sasl's client.

  - PLAIN, SCRAM-SHA-256 and SCRAM-SHA-512 with the right credentials:
    Open authenticates after ApiVersions and Metadata works; SCRAM with a
    user name that needs escaping and a non-ASCII password; SCRAM over TLS
    (SASL_SSL). SCRAM-SHA-512's wrong password, wrong server signature and
    a broker that enables only SCRAM-SHA-256.
  - Failures are EKafkaAuthentication with the broker's code: a wrong
    password and an unknown user (SASL_AUTHENTICATION_FAILED, the broker's
    message, never the password), a mechanism the broker doesn't enable
    (UNSUPPORTED_SASL_MECHANISM, with the ones it does), a listener without
    SASL (ILLEGAL_SASL_STATE), and a broker whose SCRAM signature is wrong
    (code 0: the client's own check). The connection is closed afterwards.
  - A client without SASL on a SASL listener: Open (ApiVersions) works, and
    the broker hangs up on the first other request (EKafkaConnection).
  - KIP-368: the session lifetime the broker gives is kept; with none, or a
    long one, ReauthenticationDue stays False; with 1 ms it is due at once.
  - The cluster with wrong credentials raises EKafkaAuthentication at once,
    not EKafkaConnection after MaxBlockMs; a producer delivers through a
    SASL broker.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Threading,
  PascalCommon.Utf8,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Sasl,
  Kafka.Messages.Metadata,
  Kafka.Connection,
  Kafka.Cluster,
  Kafka.Producer,
  Kafka.TestHelpers,
  Kafka.TestFakeBroker;

type
  [TestFixture]
  TKafkaSaslConnectionTests = class
  private
    FBroker: TKafkaFakeBroker;
    FConnection: TKafkaConnection;
    FParams: TKafkaConnectionParams;
    procedure UseSasl(AMechanism: TKafkaSaslMechanism; const AUser, APassword: string);
    procedure Connect;
    procedure CallMetadata;
    /// Open, expecting EKafkaAuthentication; returns it (its message and
    /// code), the connection freed.
    function OpenFails(out ACode: Int16): string;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Plain_RightCredentials_Authenticates;
    [Test] procedure Plain_WrongPassword_IsAuthenticationFailed;
    [Test] procedure Scram_RightCredentials_EscapedUserAndNonAsciiPassword;
    [Test] procedure Scram_WrongPassword_IsAuthenticationFailed;
    [Test] procedure Scram_UnknownUser_IsAuthenticationFailed;
    [Test] procedure Scram_WrongServerSignature_IsRefusedByTheClient;
    [Test] procedure Scram_OverTls_Authenticates;
    [Test] procedure Scram512_RightCredentials_EscapedUserAndNonAsciiPassword;
    [Test] procedure Scram512_WrongPasswordOrSignature_AreRefused;
    [Test] procedure Scram512_OverTls_Authenticates;
    [Test] procedure Scram512_NotEnabled_ListsTheBrokers;
    [Test] procedure MechanismNotEnabled_ListsTheBrokers;
    [Test] procedure ListenerWithoutSasl_IsIllegalSaslState;
    [Test] procedure NoSaslOnASaslListener_BrokerHangsUp;
    [Test] procedure SessionLifetime_KeptAndReauthenticationDue;
    [Test] procedure Cluster_WrongPassword_RaisesAuthenticationAtOnce;
    [Test] procedure Producer_DeliversThroughSasl;
  end;

implementation

const
  USER = 'alice';
  PASSWORD = 'alice-secret';

function MetadataFor(const ATopic: string): TKafkaMetadataRequest;
begin
  Result.Init;
  SetLength(Result.Topics, 1);
  Result.Topics[0].Init;
  Result.Topics[0].Name := ATopic;
end;

{ TKafkaSaslConnectionTests }

procedure TKafkaSaslConnectionTests.Setup;
begin
  FBroker := TKafkaFakeBroker.Create;
  FBroker.SaslMechanisms := 'PLAIN,SCRAM-SHA-256,SCRAM-SHA-512';
  FBroker.SaslUser := USER;
  FBroker.SaslPassword := PASSWORD;
  FParams := KafkaConnectionParams('127.0.0.1', FBroker.Port);
  FParams.RequestTimeoutMs := 10000;
  FConnection := nil;
end;

procedure TKafkaSaslConnectionTests.TearDown;
begin
  FreeAndNil(FConnection);
  FreeAndNil(FBroker);
end;

procedure TKafkaSaslConnectionTests.UseSasl(AMechanism: TKafkaSaslMechanism;
  const AUser, APassword: string);
begin
  FParams.SaslMechanism := AMechanism;
  FParams.SaslUsername := AUser;
  FParams.SaslPassword := APassword;
end;

procedure TKafkaSaslConnectionTests.Connect;
begin
  FreeAndNil(FConnection);
  FConnection := TKafkaConnection.Create(FParams);
  FConnection.Open;
end;

procedure TKafkaSaslConnectionTests.CallMetadata;
begin
  FConnection.Metadata(MetadataFor('t'));
end;

function TKafkaSaslConnectionTests.OpenFails(out ACode: Int16): string;
begin
  Result := '';
  ACode := -1;
  try
    Connect;
    TAssert.Fail('Open authenticated');
  except
    on E: EKafkaAuthentication do
    begin
      Result := E.Message;
      ACode := E.ErrorCode;
    end;
  end;
  TAssert.AssertFalse('closed after the failure', FConnection.IsOpen);
  FreeAndNil(FConnection);
end;

procedure TKafkaSaslConnectionTests.Plain_RightCredentials_Authenticates;
var
  R: TKafkaMetadataResponse;
begin
  UseSasl(ksmPlain, USER, PASSWORD);
  Connect;
  TAssert.AssertTrue(FConnection.IsOpen);
  TAssert.AssertEquals('PLAIN', FBroker.LastSaslMechanism);
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  R := FConnection.Metadata(MetadataFor('after-sasl'));
  TAssert.AssertEquals('after-sasl', R.Topics[0].Name);
end;

procedure TKafkaSaslConnectionTests.Plain_WrongPassword_IsAuthenticationFailed;
var
  LCode: Int16;
  LMessage: string;
begin
  UseSasl(ksmPlain, USER, 'not-the-password');
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('Invalid username or password', LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('"alice"', LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('not-the-password', LMessage) = 0);
  TAssert.AssertEquals(0, FBroker.SaslAuthenticatedCount);
end;

procedure TKafkaSaslConnectionTests.Scram_RightCredentials_EscapedUserAndNonAsciiPassword;
var
  R: TKafkaMetadataResponse;
begin
  FBroker.SaslUser := 'svc=orders,eu';
  FBroker.SaslPassword := 'pässwörd São';
  UseSasl(ksmScramSha256, 'svc=orders,eu', 'pässwörd São');
  Connect;
  TAssert.AssertEquals('SCRAM-SHA-256', FBroker.LastSaslMechanism);
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  R := FConnection.Metadata(MetadataFor('after-scram'));
  TAssert.AssertEquals('after-scram', R.Topics[0].Name);
end;

procedure TKafkaSaslConnectionTests.Scram_WrongPassword_IsAuthenticationFailed;
var
  LCode: Int16;
  LMessage: string;
begin
  UseSasl(ksmScramSha256, USER, 'alice-secreT');
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('Invalid user credentials', LMessage) > 0);
  TAssert.AssertTrue(LMessage, Pos('alice-secreT', LMessage) = 0);
end;

procedure TKafkaSaslConnectionTests.Scram_UnknownUser_IsAuthenticationFailed;
var
  LCode: Int16;
begin
  UseSasl(ksmScramSha256, 'mallory', PASSWORD);
  OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
end;

procedure TKafkaSaslConnectionTests.Scram_WrongServerSignature_IsRefusedByTheClient;
var
  LCode: Int16;
  LMessage: string;
begin
  FBroker.SaslBadServerSignature := True;
  UseSasl(ksmScramSha256, USER, PASSWORD);
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals('the client''s own check', 0, Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('signature', LMessage) > 0);
end;

procedure TKafkaSaslConnectionTests.Scram_OverTls_Authenticates;
begin
  FreeAndNil(FBroker);
  FBroker := TKafkaFakeBroker.CreateTls;
  FBroker.SaslMechanisms := 'SCRAM-SHA-256';
  FBroker.SaslUser := USER;
  FBroker.SaslPassword := PASSWORD;
  FParams := KafkaConnectionParams('localhost', FBroker.Port);
  FParams.UseTls := True;
  FParams.TlsCaFile := KafkaTestPkiDir + 'ca_cert.pem';
  UseSasl(ksmScramSha256, USER, PASSWORD);
  Connect;
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  CallMetadata;
end;

procedure TKafkaSaslConnectionTests.Scram512_RightCredentials_EscapedUserAndNonAsciiPassword;
var
  R: TKafkaMetadataResponse;
begin
  FBroker.SaslUser := 'svc=orders,eu';
  FBroker.SaslPassword := 'pässwörd São';
  UseSasl(ksmScramSha512, 'svc=orders,eu', 'pässwörd São');
  Connect;
  TAssert.AssertEquals('SCRAM-SHA-512', FBroker.LastSaslMechanism);
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  R := FConnection.Metadata(MetadataFor('after-scram-512'));
  TAssert.AssertEquals('after-scram-512', R.Topics[0].Name);
end;

procedure TKafkaSaslConnectionTests.Scram512_WrongPasswordOrSignature_AreRefused;
var
  LCode: Int16;
  LMessage: string;
begin
  UseSasl(ksmScramSha512, USER, 'alice-secreT');
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('Invalid user credentials', LMessage) > 0);
  FBroker.SaslBadServerSignature := True;
  UseSasl(ksmScramSha512, USER, PASSWORD);
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals('the client''s own check', 0, Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('signature', LMessage) > 0);
end;

procedure TKafkaSaslConnectionTests.Scram512_OverTls_Authenticates;
begin
  FreeAndNil(FBroker);
  FBroker := TKafkaFakeBroker.CreateTls;
  FBroker.SaslMechanisms := 'SCRAM-SHA-512';
  FBroker.SaslUser := USER;
  FBroker.SaslPassword := PASSWORD;
  FParams := KafkaConnectionParams('localhost', FBroker.Port);
  FParams.UseTls := True;
  FParams.TlsCaFile := KafkaTestPkiDir + 'ca_cert.pem';
  UseSasl(ksmScramSha512, USER, PASSWORD);
  Connect;
  TAssert.AssertEquals(1, FBroker.SaslAuthenticatedCount);
  CallMetadata;
end;

procedure TKafkaSaslConnectionTests.Scram512_NotEnabled_ListsTheBrokers;
var
  LCode: Int16;
  LMessage: string;
begin
  FBroker.SaslMechanisms := 'PLAIN,SCRAM-SHA-256';
  UseSasl(ksmScramSha512, USER, PASSWORD);
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_UNSUPPORTED_SASL_MECHANISM), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('the broker enables: PLAIN, SCRAM-SHA-256', LMessage) > 0);
end;

procedure TKafkaSaslConnectionTests.MechanismNotEnabled_ListsTheBrokers;
var
  LCode: Int16;
  LMessage: string;
begin
  FBroker.SaslMechanisms := 'PLAIN';
  UseSasl(ksmScramSha256, USER, PASSWORD);
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_UNSUPPORTED_SASL_MECHANISM), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('the broker enables: PLAIN', LMessage) > 0);
end;

procedure TKafkaSaslConnectionTests.ListenerWithoutSasl_IsIllegalSaslState;
var
  LCode: Int16;
  LMessage: string;
begin
  FBroker.SaslMechanisms := '';
  UseSasl(ksmPlain, USER, PASSWORD);
  LMessage := OpenFails(LCode);
  TAssert.AssertEquals(Integer(KAFKA_ERROR_ILLEGAL_SASL_STATE), Integer(LCode));
  TAssert.AssertTrue(LMessage, Pos('SASL listener', LMessage) > 0);
end;

procedure TKafkaSaslConnectionTests.NoSaslOnASaslListener_BrokerHangsUp;
begin
  Connect; // ApiVersions is answered before authentication
  TAssert.AssertException(EKafkaConnection, CallMetadata);
  TAssert.AssertFalse(FConnection.IsOpen);
end;

procedure TKafkaSaslConnectionTests.SessionLifetime_KeptAndReauthenticationDue;
begin
  UseSasl(ksmPlain, USER, PASSWORD);
  Connect;
  TAssert.AssertEquals('none given', Int64(0), FConnection.SessionLifetimeMs);
  TAssert.AssertFalse(FConnection.ReauthenticationDue);

  FBroker.SaslSessionLifetimeMs := 3600000;
  Connect;
  TAssert.AssertEquals(Int64(3600000), FConnection.SessionLifetimeMs);
  TAssert.AssertFalse(FConnection.ReauthenticationDue);

  // 85% to 95% of 1 ms rounds down to the moment it was sent.
  FBroker.SaslSessionLifetimeMs := 1;
  UseSasl(ksmScramSha256, USER, PASSWORD);
  Connect;
  TAssert.AssertEquals(Int64(1), FConnection.SessionLifetimeMs);
  TAssert.AssertTrue(FConnection.ReauthenticationDue);
  TAssert.AssertTrue('still open', FConnection.IsOpen);
end;

procedure TKafkaSaslConnectionTests.Cluster_WrongPassword_RaisesAuthenticationAtOnce;
var
  P: TKafkaClusterParams;
  C: TKafkaCluster;
  LStart: UInt64;
  LRaised: string;
begin
  P := KafkaClusterParams('127.0.0.1:' + IntToStr(FBroker.Port));
  P.Connection.SaslMechanism := ksmScramSha256;
  P.Connection.SaslUsername := USER;
  P.Connection.SaslPassword := 'wrong';
  P.MaxBlockMs := 20000;
  C := TKafkaCluster.Create(P);
  try
    LStart := PcTickMs;
    LRaised := '';
    try
      C.Open;
    except
      on E: Exception do
        LRaised := E.ClassName;
    end;
    TAssert.AssertEquals('EKafkaAuthentication', LRaised);
    TAssert.AssertTrue('without waiting for MaxBlockMs', PcTickMs - LStart < 10000);
  finally
    C.Free;
  end;
end;

procedure TKafkaSaslConnectionTests.Producer_DeliversThroughSasl;
var
  P: TKafkaProducerParams;
  LProducer: TKafkaProducer;
  LBrokers: TKafkaFakeBrokerArray;
  R: TKafkaDeliveryReport;
  LText: string;
begin
  SetLength(LBrokers, 1);
  LBrokers[0] := FBroker;
  KafkaFakeUseView(LBrokers, KafkaFakeClusterView(LBrokers, 'secured', [1]));
  P := KafkaProducerParams('127.0.0.1:' + IntToStr(FBroker.Port));
  P.Cluster.Connection.SaslMechanism := ksmScramSha256;
  P.Cluster.Connection.SaslUsername := USER;
  P.Cluster.Connection.SaslPassword := PASSWORD;
  P.Cluster.MaxBlockMs := 10000;
  P.LingerMs := 0;
  LProducer := TKafkaProducer.Create(P);
  try
    LProducer.Open;
    R := LProducer.Send(KafkaProducerRecord('secured', PcStringToUtf8Bytes('hello'))).Get(10000);
    TAssert.AssertEquals(Int64(0), R.Offset);
  finally
    LProducer.Free;
  end;
  // The bootstrap connection and the leader's: each authenticated.
  TAssert.AssertEquals(2, FBroker.SaslAuthenticatedCount);
  TAssert.AssertTrue(PcTryUtf8BytesToString(FBroker.Logged('secured', 0)[0].Value, LText));
  TAssert.AssertEquals('hello', LText);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaSaslConnectionTests);

end.
