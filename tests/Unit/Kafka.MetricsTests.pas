unit Kafka.MetricsTests;

{ Tests for the producer's and the consumer's metrics (Kafka.Metrics), read
  from the process-wide PcMetrics registry (Kafka.TestTracing), against the
  fake broker in process (Kafka.TestFakeBroker, Kafka.TestFakeGroup).

  - Producer: records sent and bytes on success, a failure counted with its
    error.type, records sent again after a retriable error, the batches in
    flight while the fake holds the answer and back after it, an epoch bump.
  - Consumer: the records Poll returned, the lag (high watermark minus
    position) while records wait and 0 once read, given back when the
    consumer goes; in a group, the rebalance events and the commits by kind.

  The registry is shared and never drops a series: each test uses a topic
  (and a group) no other test uses, or compares with the value read before
  it acted.

  No Sleep: futures, the fake's waits and Poll, each with a deadline.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Protocol.RecordBatch,
  Kafka.Group,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestFakeBroker,
  Kafka.TestMessages,
  Kafka.TestHelpers,
  Kafka.TestTracing;

type
  [TestFixture]
  TKafkaMetricsTests = class
  private
    FBrokers: TKafkaFakeBrokerArray;
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FTopic: string;
    FCommitDone: Boolean;
    procedure StartBroker(APartitions: Integer);
    procedure OpenProducer(AIdempotent: Boolean);
    function ConsumerParams(const AGroupId: string): TKafkaConsumerParams;
    procedure CommitDone(const AReport: TKafkaCommitReport);
    function Sent(const AErrorType: string): Double;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Producer_RecordsBytesAndFailures;
    [Test] procedure Producer_RetriesAndBatchesInFlight;
    [Test] procedure Producer_EpochBump;
    [Test] procedure Consumer_RecordsAndLag_GivenBackOnClose;
    [Test] procedure ConsumerGroup_RebalancesAndCommitsByKind;
  end;

implementation

{ TKafkaMetricsTests }

procedure TKafkaMetricsTests.Setup;
begin
  FBrokers := nil;
  FProducer := nil;
  FConsumer := nil;
  FCommitDone := False;
  // A topic of its own: the registry outlives every test.
  FTopic := 'metrics-' + KafkaTestUniqueId;
end;

procedure TKafkaMetricsTests.TearDown;
var
  I: Integer;
begin
  FreeAndNil(FProducer);
  FreeAndNil(FConsumer);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
end;

procedure TKafkaMetricsTests.StartBroker(APartitions: Integer);
var
  LLeaders: array of Int32;
  I: Integer;
begin
  SetLength(FBrokers, 1);
  FBrokers[0] := TKafkaFakeBroker.Create;
  SetLength(LLeaders, APartitions);
  for I := 0 to APartitions - 1 do
    LLeaders[I] := 1;
  KafkaFakeUseView(FBrokers, KafkaFakeClusterView(FBrokers, FTopic, LLeaders));
end;

procedure TKafkaMetricsTests.OpenProducer(AIdempotent: Boolean);
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams('127.0.0.1:' + IntToStr(FBrokers[0].Port));
  P.Cluster.Connection.ClientId := 'metrics-producer';
  P.Cluster.Connection.ConnectTimeoutMs := 2000;
  P.Cluster.Connection.RequestTimeoutMs := 5000;
  P.Cluster.MaxBlockMs := 5000;
  P.Cluster.RetryBackoffMs := 20;
  P.LingerMs := 0;
  if not AIdempotent then
    P.Idempotence := kidOff;
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
end;

function TKafkaMetricsTests.ConsumerParams(const AGroupId: string): TKafkaConsumerParams;
begin
  Result := KafkaConsumerParams('127.0.0.1:' + IntToStr(FBrokers[0].Port));
  Result.Cluster.Connection.ClientId := 'metrics-consumer';
  Result.Cluster.Connection.ConnectTimeoutMs := 2000;
  Result.Cluster.Connection.RequestTimeoutMs := 5000;
  Result.Cluster.MaxBlockMs := 5000;
  Result.Cluster.RetryBackoffMs := 20;
  Result.RetryBackoffMaxMs := 80;
  Result.FetchMaxWaitMs := 100;
  Result.AutoOffsetReset := korEarliest;
  Result.GroupId := AGroupId;
  Result.DefaultApiTimeoutMs := 10000;
  Result.AutoCommitIntervalMs := 600000;
end;

procedure TKafkaMetricsTests.CommitDone(const AReport: TKafkaCommitReport);
begin
  FCommitDone := True;
end;

function TKafkaMetricsTests.Sent(const AErrorType: string): Double;
begin
  Result := KafkaTestMetric('messaging.client.sent.messages', ['kafka', FTopic, AErrorType]);
end;

procedure TKafkaMetricsTests.Producer_RecordsBytesAndFailures;
var
  R: TKafkaProducerRecord;
  F: IKafkaDeliveryFuture;
begin
  StartBroker(1);
  OpenProducer(True);
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('a'))).Get(10000);
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('b'))).Get(10000);
  TAssert.AssertEquals(2.0, Sent(''), 0.0);
  TAssert.AssertTrue('the batches'' bytes',
    KafkaTestMetric('pascalkafka.producer.bytes', [FTopic]) > 2 * KAFKA_RECORD_BATCH_HEADER_SIZE);
  // A failure from the broker, by the Kafka error's name...
  FBrokers[0].ProduceErrorCode := KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED;
  FBrokers[0].ProduceErrors := 1;
  F := FProducer.Send(KafkaProducerRecord(FTopic, Utf8('refused')));
  TAssert.AssertTrue(F.Wait(10000));
  TAssert.AssertEquals(1.0, Sent('TOPIC_AUTHORIZATION_FAILED'), 0.0);
  // ...and one before a batch (a partition the topic doesn't have).
  R := KafkaProducerRecord(FTopic, Utf8('nowhere'));
  R.Partition := 7;
  TAssert.AssertTrue(FProducer.Send(R).Wait(10000));
  TAssert.AssertEquals(1.0, Sent('UNKNOWN_TOPIC_OR_PARTITION'), 0.0);
  TAssert.AssertEquals('successes unchanged', 2.0, Sent(''), 0.0);
end;

procedure TKafkaMetricsTests.Producer_RetriesAndBatchesInFlight;
var
  LBase: Double;
  F: IKafkaDeliveryFuture;
begin
  StartBroker(1);
  OpenProducer(False);
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('warm'))).Get(10000);
  LBase := KafkaTestMetric('pascalkafka.producer.batches.in_flight', []);
  FBrokers[0].HoldProduce := True;
  F := FProducer.Send(KafkaProducerRecord(FTopic, Utf8('held')));
  TAssert.AssertTrue(FBrokers[0].WaitProduceCount(2, 10000));
  TAssert.AssertEquals('one batch in flight', LBase + 1,
    KafkaTestMetric('pascalkafka.producer.batches.in_flight', []), 0.0);
  FBrokers[0].ReleaseHeldProduce;
  F.Get(10000);
  TAssert.AssertEquals('back after the answer', LBase,
    KafkaTestMetric('pascalkafka.producer.batches.in_flight', []), 0.0);
  FBrokers[0].ProduceErrorCode := KAFKA_ERROR_NOT_LEADER_OR_FOLLOWER;
  FBrokers[0].ProduceErrors := 1;
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('retried'))).Get(10000);
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.producer.retries', [FTopic]), 0.0);
  TAssert.AssertEquals(3.0, Sent(''), 0.0);
end;

procedure TKafkaMetricsTests.Producer_EpochBump;
var
  LBase: Double;
begin
  StartBroker(1);
  OpenProducer(True);
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('a'))).Get(10000);
  LBase := KafkaTestMetric('pascalkafka.producer.epoch_bumps', []);
  FBrokers[0].ProduceErrorCode := KAFKA_ERROR_UNKNOWN_PRODUCER_ID;
  FBrokers[0].ProduceErrors := 1;
  FProducer.Send(KafkaProducerRecord(FTopic, Utf8('b'))).Get(10000);
  TAssert.AssertEquals(1, FProducer.EpochBumps);
  TAssert.AssertEquals(LBase + 1, KafkaTestMetric('pascalkafka.producer.epoch_bumps', []), 0.0);
end;

procedure TKafkaMetricsTests.Consumer_RecordsAndLag_GivenBackOnClose;
var
  B: TKafkaRecordBatch;
  I, N: Integer;
  P: TKafkaConsumerParams;
  LDeadline: UInt64;
begin
  StartBroker(1);
  B.Init;
  for I := 0 to 4 do
    B.Append(KafkaRecord(Utf8('k'), Utf8('v' + IntToStr(I)), 1000 + I));
  FBrokers[0].AppendBatch(FTopic, 0, B);
  P := ConsumerParams('');
  P.MaxPollRecords := 2;
  FConsumer := TKafkaConsumer.Create(P);
  FConsumer.Open;
  FConsumer.Assign([KafkaTopicPartition(FTopic, 0)]);
  N := 0;
  LDeadline := PcTickMs + 10000;
  while (N = 0) and (PcTickMs < LDeadline) do
    N := Length(FConsumer.Poll(500));
  TAssert.AssertEquals(2, N);
  TAssert.AssertEquals(2.0, KafkaTestMetric('messaging.client.consumed.messages',
    ['kafka', FTopic, '']), 0.0);
  TAssert.AssertEquals('5 written, 2 read', 3.0,
    KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, '0', '']), 0.0);
  while (N < 5) and (PcTickMs < LDeadline) do
    Inc(N, Length(FConsumer.Poll(500)));
  TAssert.AssertEquals(5, N);
  TAssert.AssertEquals(5.0, KafkaTestMetric('messaging.client.consumed.messages',
    ['kafka', FTopic, '']), 0.0);
  TAssert.AssertEquals(0.0, KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, '0', '']), 0.0);
  // More written, nothing read: the next Fetch answer's high watermark.
  FBrokers[0].AppendBatch(FTopic, 0, B);
  while (KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, '0', '']) = 0) and
    (PcTickMs < LDeadline) do
  begin
    // MaxPollRecords 2: the lag is at least 3 after the first Poll.
    FConsumer.Poll(500);
  end;
  TAssert.AssertTrue(KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, '0', '']) >= 3);
  FreeAndNil(FConsumer);
  TAssert.AssertEquals('given back', 0.0,
    KafkaTestMetric('pascalkafka.consumer.lag', [FTopic, '0', '']), 0.0);
end;

procedure TKafkaMetricsTests.ConsumerGroup_RebalancesAndCommitsByKind;
var
  LGroup: string;
  B: TKafkaRecordBatch;
  LDeadline: UInt64;
  N: Integer;
  P: TKafkaConsumerParams;
  F: IKafkaCommitFuture;
begin
  StartBroker(1);
  B.Init;
  B.Append(KafkaRecord(Utf8('k'), Utf8('v'), 1000));
  FBrokers[0].AppendBatch(FTopic, 0, B);
  LGroup := 'group-' + FTopic;
  P := ConsumerParams(LGroup);
  P.EnableAutoCommit := False;
  FConsumer := TKafkaConsumer.Create(P);
  FConsumer.Open;
  FConsumer.Subscribe([FTopic]);
  N := 0;
  LDeadline := PcTickMs + 10000;
  while (N = 0) and (PcTickMs < LDeadline) do
    N := Length(FConsumer.Poll(200));
  TAssert.AssertEquals(1, N);
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.consumer.rebalances',
    [LGroup, 'assigned']), 0.0);
  TAssert.AssertEquals(1.0, KafkaTestMetric('messaging.client.consumed.messages',
    ['kafka', FTopic, LGroup]), 0.0);
  FConsumer.Commit;
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.consumer.commits',
    [LGroup, 'sync', '']), 0.0);
  F := FConsumer.CommitAsync(CommitDone);
  TAssert.AssertTrue(F.Wait(10000));
  // The outcome is counted where its callback runs: inside a later Poll.
  while not FCommitDone and (PcTickMs < LDeadline) do
    FConsumer.Poll(50);
  TAssert.AssertTrue(FCommitDone);
  TAssert.AssertEquals(1.0, KafkaTestMetric('pascalkafka.consumer.commits',
    [LGroup, 'async', '']), 0.0);
  FConsumer.Close;
  TAssert.AssertEquals('the leave revokes', 1.0, KafkaTestMetric('pascalkafka.consumer.rebalances',
    [LGroup, 'revoked']), 0.0);
  TAssert.AssertEquals(0.0, KafkaTestMetric('pascalkafka.consumer.rebalances',
    [LGroup, 'lost']), 0.0);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaMetricsTests);

end.
