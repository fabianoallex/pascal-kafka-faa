unit Kafka.ConsumerTests;

{ Tests for Kafka.Consumer against fake brokers in process
  (Kafka.TestFakeBroker, which keeps batches per partition and answers
  Fetch, with a long poll, and ListOffsets).

  - Positions: AutoOffsetReset earliest, latest and none; Seek, also into
    the middle of a compressed batch; SeekToBeginning and SeekToEnd; a
    position past the log start's reset on OFFSET_OUT_OF_RANGE; Assign
    keeping the position of a partition it keeps.
  - Poll: records of two partitions on two brokers, each in order;
    MaxPollRecords; a control batch skipped; the long poll answered as soon
    as a record arrives; a timeout with nothing; Wakeup from another thread;
    a second thread inside the consumer refused.
  - Errors: NOT_LEADER_OR_FOLLOWER retried after a refresh;
    TOPIC_AUTHORIZATION_FAILED raised.
  - BeginningOffsets and EndOffsets.

  No Sleep: the waits are the consumer's own, and helper threads start
  their action when the fake broker has parked the Fetch (WaitParked).

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  Classes,
  PascalCommon.Threading,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Compression,
  Kafka.Protocol.Primitives,
  Kafka.Protocol.RecordBatch,
  Kafka.Cluster,
  Kafka.Consumer,
  Kafka.TestFakeBroker,
  Kafka.TestMessages;

type
  [TestFixture]
  TKafkaConsumerTests = class
  private
    FBrokers: TKafkaFakeBrokerArray;
    FConsumer: TKafkaConsumer;
    FParams: TKafkaConsumerParams;
    procedure StartBrokers(ACount: Integer; const ALeaders: array of Int32);
    function Broker(ANodeId: Integer): TKafkaFakeBroker;
    procedure OpenConsumer;
    /// Polls until ACount records came (or 10 s).
    function PollFor(ACount: Integer): TKafkaConsumerRecordArray;
    procedure PollOnce;
    procedure CallPosition;
    procedure SeekUnassigned;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Earliest_TwoPartitionsOnTwoBrokers_EachInOrder;
    [Test] procedure Latest_OnlyRecordsWrittenAfter;
    [Test] procedure ResetNone_RaisesUntilSeek;
    [Test] procedure Seek_IntoACompressedBatch_StartsThere;
    [Test] procedure SeekToBeginningAndEnd;
    [Test] procedure OutOfRange_ResetsToEarliest;
    [Test] procedure MaxPollRecords_SplitsAcrossPolls;
    [Test] procedure ControlBatch_IsSkipped;
    [Test] procedure LongPoll_AnsweredWhenARecordArrives;
    [Test] procedure Poll_NothingToRead_ReturnsEmptyAfterTheTimeout;
    [Test] procedure Wakeup_EndsAPollOnAnotherThread_AndASecondThreadIsRefused;
    [Test] procedure NotLeader_RetriedAfterARefresh;
    [Test] procedure AuthorizationError_Raises;
    [Test] procedure Assign_KeepsThePositionOfAKeptPartition;
    [Test] procedure BeginningAndEndOffsets;
    [Test] procedure Poll_WithoutAssignOrOpen_Raises;
  end;

implementation

const
  TOPIC = 'orders';

type
  /// Runs Poll on its own thread.
  TPollThread = class(TThread)
  private
    FConsumer: TKafkaConsumer;
    FTimeoutMs: Cardinal;
  protected
    procedure Execute; override;
  public
    ErrorClass: string;
    Count: Integer;
    constructor Create(AConsumer: TKafkaConsumer; ATimeoutMs: Cardinal);
  end;

  /// Once ABroker has a Fetch parked: appends a batch, or calls Wakeup.
  TWhenParked = class(TThread)
  private
    FBroker: TKafkaFakeBroker;
    FConsumer: TKafkaConsumer;
    FBatch: TKafkaRecordBatch;
    FWakeup: Boolean;
  protected
    procedure Execute; override;
  public
    Parked: Boolean;
    constructor Create(ABroker: TKafkaFakeBroker; AConsumer: TKafkaConsumer;
      const ABatch: TKafkaRecordBatch; AWakeup: Boolean);
  end;

constructor TPollThread.Create(AConsumer: TKafkaConsumer; ATimeoutMs: Cardinal);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FConsumer := AConsumer;
  FTimeoutMs := ATimeoutMs;
end;

procedure TPollThread.Execute;
begin
  try
    Count := Length(FConsumer.Poll(FTimeoutMs));
    ErrorClass := 'none';
  except
    on E: Exception do
      ErrorClass := E.ClassName;
  end;
end;

constructor TWhenParked.Create(ABroker: TKafkaFakeBroker; AConsumer: TKafkaConsumer;
  const ABatch: TKafkaRecordBatch; AWakeup: Boolean);
begin
  inherited Create(True);
  FreeOnTerminate := False;
  FBroker := ABroker;
  FConsumer := AConsumer;
  FBatch := ABatch;
  FWakeup := AWakeup;
end;

procedure TWhenParked.Execute;
begin
  Parked := FBroker.WaitParked(1, 10000);
  if FWakeup then
    FConsumer.Wakeup
  else
    FBroker.AppendBatch(TOPIC, 0, FBatch);
end;

/// A batch of AValues, keys 'k0', 'k1'..., timestamps from 1000.
function Batch(const AValues: array of string; ACodec: TKafkaCompression = kcNone): TKafkaRecordBatch;
var
  I: Integer;
  R: TKafkaRecord;
begin
  Result.Init;
  for I := 0 to High(AValues) do
  begin
    R := KafkaRecord(Utf8('k' + IntToStr(I)), Utf8(AValues[I]), 1000 + I);
    if I = 0 then
      KafkaAddRecordHeader(R, 'h', Utf8('first'));
    Result.Append(R);
  end;
  Result.SetCompression(ACodec);
end;

function Values(const ARecords: TKafkaConsumerRecordArray): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ARecords) do
  begin
    if I > 0 then
      Result := Result + ',';
    Result := Result + FromUtf8(ARecords[I].Value);
  end;
end;

{ TKafkaConsumerTests }

procedure TKafkaConsumerTests.Setup;
begin
  FBrokers := nil;
  FConsumer := nil;
  FParams := KafkaConsumerParams('');
  FParams.Cluster.Connection.ClientId := 'consumer-test';
  FParams.Cluster.Connection.ConnectTimeoutMs := 2000;
  FParams.Cluster.Connection.RequestTimeoutMs := 5000;
  FParams.Cluster.MaxBlockMs := 5000;
  FParams.Cluster.RetryBackoffMs := 20;
  FParams.FetchMaxWaitMs := 200;
end;

procedure TKafkaConsumerTests.TearDown;
var
  I: Integer;
begin
  FreeAndNil(FConsumer);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
end;

procedure TKafkaConsumerTests.StartBrokers(ACount: Integer; const ALeaders: array of Int32);
var
  I: Integer;
begin
  SetLength(FBrokers, ACount);
  for I := 0 to ACount - 1 do
    FBrokers[I] := TKafkaFakeBroker.Create;
  KafkaFakeUseView(FBrokers, KafkaFakeClusterView(FBrokers, TOPIC, ALeaders));
  FParams.Cluster.BootstrapServers := '127.0.0.1:' + IntToStr(FBrokers[0].Port);
end;

function TKafkaConsumerTests.Broker(ANodeId: Integer): TKafkaFakeBroker;
begin
  Result := FBrokers[ANodeId - 1];
end;

procedure TKafkaConsumerTests.OpenConsumer;
begin
  FConsumer := TKafkaConsumer.Create(FParams);
  FConsumer.Open;
end;

function TKafkaConsumerTests.PollFor(ACount: Integer): TKafkaConsumerRecordArray;
var
  Deadline: UInt64;
  Got: TKafkaConsumerRecordArray;
  I, N: Integer;
begin
  Result := nil;
  Deadline := PcTickMs + 10000;
  while (Length(Result) < ACount) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(500);
    N := Length(Result);
    SetLength(Result, N + Length(Got));
    for I := 0 to High(Got) do
      Result[N + I] := Got[I];
  end;
end;

procedure TKafkaConsumerTests.PollOnce;
begin
  FConsumer.Poll(0);
end;

procedure TKafkaConsumerTests.CallPosition;
begin
  FConsumer.Position(TOPIC, 0);
end;

procedure TKafkaConsumerTests.SeekUnassigned;
begin
  FConsumer.Seek(TOPIC, 2, 0);
end;

procedure TKafkaConsumerTests.Earliest_TwoPartitionsOnTwoBrokers_EachInOrder;
var
  R: TKafkaConsumerRecordArray;
  I: Integer;
  Next: array[0..1] of Int64;
  Text: array[0..1] of string;
begin
  StartBrokers(2, [1, 2]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a0', 'a1', 'a2']));
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a3', 'a4'], kcGzip));
  Broker(2).AppendBatch(TOPIC, 1, Batch(['b0', 'b1', 'b2', 'b3']));
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0), KafkaTopicPartition(TOPIC, 1)]);
  R := PollFor(9);
  TAssert.AssertEquals(9, Length(R));
  Next[0] := 0;
  Next[1] := 0;
  Text[0] := '';
  Text[1] := '';
  for I := 0 to High(R) do
  begin
    TAssert.AssertEquals(TOPIC, R[I].Topic);
    TAssert.AssertEquals('in order', Next[R[I].Partition], R[I].Offset);
    Next[R[I].Partition] := R[I].Offset + 1;
    Text[R[I].Partition] := Text[R[I].Partition] + FromUtf8(R[I].Value);
  end;
  TAssert.AssertEquals('a0a1a2a3a4', Text[0]);
  TAssert.AssertEquals('b0b1b2b3', Text[1]);
  TAssert.AssertEquals(Int64(5), FConsumer.Position(TOPIC, 0));
  TAssert.AssertEquals(Int64(4), FConsumer.Position(TOPIC, 1));
  // What travels with a record.
  for I := 0 to High(R) do
    if (R[I].Partition = 0) and (R[I].Offset = 0) then
    begin
      TAssert.AssertEquals('k0', FromUtf8(R[I].Key));
      TAssert.AssertEquals(Int64(1000), R[I].Timestamp);
      TAssert.AssertTrue(R[I].TimestampType = kttCreateTime);
      TAssert.AssertEquals(1, Length(R[I].Headers));
      TAssert.AssertEquals('first', FromUtf8(R[I].Headers[0].Value));
    end;
  TAssert.AssertTrue('node 2 was fetched from', Broker(2).FetchCount > 0);
end;

procedure TKafkaConsumerTests.Latest_OnlyRecordsWrittenAfter;
var
  R: TKafkaConsumerRecordArray;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['old0', 'old1', 'old2']));
  OpenConsumer; // latest: Java's default
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(3), FConsumer.Position(TOPIC, 0));
  Broker(1).AppendBatch(TOPIC, 0, Batch(['new0', 'new1']));
  R := PollFor(2);
  TAssert.AssertEquals('new0,new1', Values(R));
  TAssert.AssertEquals(Int64(3), R[0].Offset);
end;

procedure TKafkaConsumerTests.ResetNone_RaisesUntilSeek;
var
  Raised: string;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a', 'b']));
  FParams.AutoOffsetReset := korNone;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  Raised := '';
  try
    FConsumer.Poll(0);
  except
    on E: EKafkaBrokerError do
      Raised := IntToStr(E.ErrorCode);
  end;
  TAssert.AssertEquals(IntToStr(KAFKA_ERROR_OFFSET_OUT_OF_RANGE), Raised);
  FConsumer.Seek(TOPIC, 0, 1);
  TAssert.AssertEquals('b', Values(PollFor(1)));
end;

procedure TKafkaConsumerTests.Seek_IntoACompressedBatch_StartsThere;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['r0', 'r1', 'r2', 'r3', 'r4', 'r5'], kcGzip));
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  FConsumer.Seek(TOPIC, 0, 4);
  // The broker returns the whole batch; the records before 4 are dropped.
  TAssert.AssertEquals('r4,r5', Values(PollFor(2)));
  TAssert.AssertEquals(Int64(6), FConsumer.Position(TOPIC, 0));
end;

procedure TKafkaConsumerTests.SeekToBeginningAndEnd;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a', 'b', 'c']));
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  FConsumer.SeekToBeginning([]);
  TAssert.AssertEquals(Int64(0), FConsumer.Position(TOPIC, 0));
  TAssert.AssertEquals('a,b,c', Values(PollFor(3)));
  FConsumer.Seek(TOPIC, 0, 1);
  FConsumer.SeekToEnd([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(3), FConsumer.Position(TOPIC, 0));
  TAssert.AssertException(EKafka, SeekUnassigned);
end;

procedure TKafkaConsumerTests.OutOfRange_ResetsToEarliest;
var
  R: TKafkaConsumerRecordArray;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['r0', 'r1']));
  Broker(1).AppendBatch(TOPIC, 0, Batch(['r2', 'r3']));
  Broker(1).SetLogStart(TOPIC, 0, 2);
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  FConsumer.Seek(TOPIC, 0, 0); // deleted since
  R := PollFor(2);
  TAssert.AssertEquals('r2,r3', Values(R));
  TAssert.AssertEquals(Int64(2), R[0].Offset);
end;

procedure TKafkaConsumerTests.MaxPollRecords_SplitsAcrossPolls;
var
  R: TKafkaConsumerRecordArray;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['0', '1', '2', '3', '4']));
  FParams.AutoOffsetReset := korEarliest;
  FParams.MaxPollRecords := 2;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  R := PollFor(1);
  TAssert.AssertEquals('0,1', Values(R));
  TAssert.AssertEquals(Int64(2), FConsumer.Position(TOPIC, 0));
  TAssert.AssertEquals('2,3', Values(FConsumer.Poll(5000)));
  TAssert.AssertEquals('4', Values(FConsumer.Poll(5000)));
  TAssert.AssertEquals(Int64(5), FConsumer.Position(TOPIC, 0));
end;

procedure TKafkaConsumerTests.ControlBatch_IsSkipped;
var
  C: TKafkaRecordBatch;
  R: TKafkaConsumerRecordArray;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['before']));
  // A transaction marker: a control batch of one record.
  C := Batch(['marker']);
  C.Attributes := C.Attributes or KAFKA_BATCH_ATTR_CONTROL or KAFKA_BATCH_ATTR_TRANSACTIONAL;
  Broker(1).AppendBatch(TOPIC, 0, C);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['after']));
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  R := PollFor(2);
  TAssert.AssertEquals('before,after', Values(R));
  TAssert.AssertEquals('the marker takes its offset', Int64(2), R[1].Offset);
  TAssert.AssertEquals(Int64(3), FConsumer.Position(TOPIC, 0));
end;

procedure TKafkaConsumerTests.LongPoll_AnsweredWhenARecordArrives;
var
  Helper: TWhenParked;
  R: TKafkaConsumerRecordArray;
  T0: UInt64;
begin
  StartBrokers(1, [1]);
  FParams.FetchMaxWaitMs := 8000;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(0), FConsumer.Position(TOPIC, 0));
  Helper := TWhenParked.Create(Broker(1), FConsumer, Batch(['late']), False);
  try
    Helper.Start;
    T0 := PcTickMs;
    R := FConsumer.Poll(9000);
    Helper.WaitFor;
    TAssert.AssertTrue('the fetch was parked', Helper.Parked);
    TAssert.AssertEquals('late', Values(R));
    TAssert.AssertTrue('long before FetchMaxWaitMs', PcTickMs - T0 < 6000);
  finally
    Helper.Free;
  end;
end;

procedure TKafkaConsumerTests.Poll_NothingToRead_ReturnsEmptyAfterTheTimeout;
var
  T0, Took: UInt64;
begin
  StartBrokers(1, [1]);
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  T0 := PcTickMs;
  TAssert.AssertEquals(0, Length(FConsumer.Poll(300)));
  Took := PcTickMs - T0;
  TAssert.AssertTrue('waited: ' + IntToStr(Took), Took >= 250);
  TAssert.AssertTrue('not much more: ' + IntToStr(Took), Took < 3000);
end;

procedure TKafkaConsumerTests.Wakeup_EndsAPollOnAnotherThread_AndASecondThreadIsRefused;
var
  Poller: TPollThread;
  Dummy: TKafkaRecordBatch;
begin
  StartBrokers(1, [1]);
  FParams.FetchMaxWaitMs := 8000;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(0), FConsumer.Position(TOPIC, 0));
  Poller := TPollThread.Create(FConsumer, 30000);
  try
    Poller.Start;
    TAssert.AssertTrue(Broker(1).WaitParked(1, 10000));
    // The poller is inside the consumer.
    TAssert.AssertException(EKafka, CallPosition);
    FConsumer.Wakeup;
    Poller.WaitFor;
    TAssert.AssertEquals('EKafkaWakeup', Poller.ErrorClass);
  finally
    Poller.Free;
  end;
  // Usable again.
  Dummy := Batch(['x']);
  Broker(1).AppendBatch(TOPIC, 0, Dummy);
  TAssert.AssertEquals('x', Values(PollFor(1)));
end;

procedure TKafkaConsumerTests.NotLeader_RetriedAfterARefresh;
var
  MetadataBefore: Integer;
begin
  StartBrokers(1, [1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a', 'b']));
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(0), FConsumer.Position(TOPIC, 0));
  MetadataBefore := Broker(1).MetadataCount;
  Broker(1).FetchErrorCode := KAFKA_ERROR_NOT_LEADER_OR_FOLLOWER;
  Broker(1).FetchErrors := 2;
  TAssert.AssertEquals('a,b', Values(PollFor(2)));
  TAssert.AssertTrue('refreshed', Broker(1).MetadataCount > MetadataBefore);
  TAssert.AssertTrue(Broker(1).FetchCount >= 3);
end;

procedure TKafkaConsumerTests.AuthorizationError_Raises;
var
  Raised: string;
begin
  StartBrokers(1, [1]);
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertEquals(Int64(0), FConsumer.Position(TOPIC, 0));
  Broker(1).FetchErrorCode := KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED;
  Broker(1).FetchErrors := 1;
  Raised := '';
  try
    FConsumer.Poll(5000);
  except
    on E: EKafkaBrokerError do
      Raised := IntToStr(E.ErrorCode);
  end;
  TAssert.AssertEquals(IntToStr(KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED), Raised);
end;

procedure TKafkaConsumerTests.Assign_KeepsThePositionOfAKeptPartition;
var
  A: TKafkaTopicPartitionArray;
begin
  StartBrokers(1, [1, 1]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a', 'b', 'c']));
  Broker(1).AppendBatch(TOPIC, 1, Batch(['x', 'y']));
  FParams.AutoOffsetReset := korEarliest;
  OpenConsumer;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  FConsumer.Seek(TOPIC, 0, 2);
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 1), KafkaTopicPartition(TOPIC, 0)]);
  A := FConsumer.Assignment;
  TAssert.AssertEquals(2, Length(A));
  TAssert.AssertEquals(1, A[0].Partition);
  TAssert.AssertEquals('kept', Int64(2), FConsumer.Position(TOPIC, 0));
  TAssert.AssertEquals('new: earliest', Int64(0), FConsumer.Position(TOPIC, 1));
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 1)]);
  TAssert.AssertException(EKafka, CallPosition);
end;

procedure TKafkaConsumerTests.BeginningAndEndOffsets;
var
  B, E: TKafkaInt64Array;
begin
  StartBrokers(2, [1, 2]);
  Broker(1).AppendBatch(TOPIC, 0, Batch(['a', 'b', 'c']));
  Broker(1).SetLogStart(TOPIC, 0, 1);
  Broker(2).AppendBatch(TOPIC, 1, Batch(['x']));
  OpenConsumer;
  B := FConsumer.BeginningOffsets([KafkaTopicPartition(TOPIC, 0), KafkaTopicPartition(TOPIC, 1)]);
  E := FConsumer.EndOffsets([KafkaTopicPartition(TOPIC, 0), KafkaTopicPartition(TOPIC, 1)]);
  TAssert.AssertEquals(Int64(1), B[0]);
  TAssert.AssertEquals(Int64(0), B[1]);
  TAssert.AssertEquals(Int64(3), E[0]);
  TAssert.AssertEquals(Int64(1), E[1]);
end;

procedure TKafkaConsumerTests.Poll_WithoutAssignOrOpen_Raises;
begin
  StartBrokers(1, [1]);
  FConsumer := TKafkaConsumer.Create(FParams);
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
  TAssert.AssertException('before Open', EKafka, PollOnce);
  FConsumer.Open;
  FConsumer.Assign([]);
  TAssert.AssertException('nothing assigned', EKafka, PollOnce);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaConsumerTests);

end.
