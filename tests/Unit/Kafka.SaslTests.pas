unit Kafka.SaslTests;

{ Tests for Kafka.Sasl's mechanisms on their own, without a broker.

  - SCRAM-SHA-256 against RFC 7677's example (section 3): with the RFC's
    client nonce, the client-first and client-final messages are the RFC's
    byte for byte, and the RFC's server-final completes the exchange. Then
    what a client must refuse: a wrong server signature (a broker that
    doesn't know the password), an "e=" answer, a server nonce that doesn't
    extend the client's, an iteration count outside 4096..16384 or not a
    number, a mandatory extension, a salt that isn't Base64. A random nonce
    differs from one client to the next.
  - PLAIN: authzid (empty), user and password separated by NUL, in UTF-8; the
    broker's empty answer completes it, anything else is refused; a NUL in the
    user name is refused.
  - Standard Base64 (RFC 4648 section 10's vectors) over the common's
    Base64url, and what decoding refuses; SCRAM's escaping of user names.
  - Against the captures of Kafka.TestCaptures (docs/codec-captures.md):
    the Java client 4.4.0's exchanges with the broker. PLAIN: the initial
    response is Java's, byte for byte. SCRAM: given the nonce Java chose,
    this client writes Java's client-first and client-final (the same
    proof), and the broker's signature in that exchange verifies. The
    hand-built SaslHandshake and SaslAuthenticate requests, every version,
    which the broker accepted, encode from the generated records to the same
    bytes; the broker's answers decode: the mechanisms it enables, the
    session lifetime (2000 ms on the REAUTH listener, v1 and v2), an
    unsupported mechanism, a failed authentication with its message.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Utf8,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Sasl,
  Kafka.Messages.SaslHandshake,
  Kafka.Messages.SaslAuthenticate,
  Kafka.TestMessages,
  Kafka.TestHelpers;

type
  [TestFixture]
  TKafkaSaslTests = class
  private
    FClient: TKafkaSaslClient;
    FChallenge: TBytes;
    FMechanism: TKafkaSaslMechanism;
    FUser: string;
    procedure Evaluate;
    procedure InitialResponse;
    procedure CreateClient;
    procedure CreatePlainWithNul;
    function ScramAfterFirst(const AServerFirst: string): TKafkaSaslClient;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Base64_Rfc4648Vectors;
    [Test] procedure Base64_RefusesUrlAlphabetMissingPadAndBadLength;
    [Test] procedure ScramEscapeName_EqualsAndComma;
    [Test] procedure MechanismNames;
    [Test] procedure Create_NoMechanismOrEmptyUser_IsRefused;
    [Test] procedure Plain_InitialResponse_IsNulSeparatedUtf8;
    [Test] procedure Plain_EmptyAnswerCompletes_AnythingElseIsRefused;
    [Test] procedure Plain_NulInUserName_IsRefused;
    [Test] procedure Scram_Rfc7677_ClientMessagesAndServerSignature;
    [Test] procedure Scram_WrongServerSignature_IsRefused;
    [Test] procedure Scram_ServerError_IsRefusedWithItsText;
    [Test] procedure Scram_NonceNotExtended_IsRefused;
    [Test] procedure Scram_IterationsOutOfRangeOrNotANumber_AreRefused;
    [Test] procedure Scram_MandatoryExtensionOrBadSalt_IsRefused;
    [Test] procedure Scram_RandomNonce_DiffersEachTime;
    [Test] procedure Java_Plain_SameInitialResponse;
    [Test] procedure Java_Scram_SameNonce_SameMessages_TheBrokersSignatureVerifies;
    [Test] procedure HandBuiltRequests_EncodeToTheCapturedBytes;
    [Test] procedure BrokerAnswers_Decode;
  end;

implementation

const
  // RFC 7677, section 3.
  RFC_NONCE = 'rOprNGfwEbeRWgbNEkqO';
  RFC_SERVER_FIRST = 'r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,' +
    's=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096';
  RFC_CLIENT_FINAL = 'c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,' +
    'p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=';
  RFC_SERVER_FINAL = 'v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=';
  RFC_SERVER_NONCE = 'rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0';

function Text(const ABytes: TBytes): string;
begin
  if not PcTryUtf8BytesToString(ABytes, Result) then
    Result := '<not UTF-8>';
end;

function Utf8Of(const AText: string): TBytes;
begin
  Result := PcStringToUtf8Bytes(AText);
end;

{ TKafkaSaslTests }

procedure TKafkaSaslTests.Setup;
begin
  FClient := nil;
  FChallenge := nil;
end;

procedure TKafkaSaslTests.TearDown;
begin
  FreeAndNil(FClient);
end;

procedure TKafkaSaslTests.Evaluate;
begin
  FClient.Evaluate(FChallenge);
end;

procedure TKafkaSaslTests.InitialResponse;
begin
  FClient.InitialResponse;
end;

procedure TKafkaSaslTests.CreateClient;
begin
  FreeAndNil(FClient);
  FClient := KafkaCreateSaslClient(FMechanism, FUser, 'secret');
end;

procedure TKafkaSaslTests.CreatePlainWithNul;
begin
  FreeAndNil(FClient);
  FClient := TKafkaSaslPlainClient.Create('al' + #0 + 'ice', 'secret');
end;

function TKafkaSaslTests.ScramAfterFirst(const AServerFirst: string): TKafkaSaslClient;
begin
  FreeAndNil(FClient);
  FClient := TKafkaScramSha256Client.CreateWithNonce('user', 'pencil', RFC_NONCE);
  FClient.InitialResponse;
  FChallenge := Utf8Of(AServerFirst);
  Result := FClient;
end;

procedure TKafkaSaslTests.Base64_Rfc4648Vectors;
var
  B: TBytes;
begin
  TAssert.AssertEquals('', KafkaBase64Encode(nil));
  TAssert.AssertEquals('Zg==', KafkaBase64Encode(Utf8Of('f')));
  TAssert.AssertEquals('Zm8=', KafkaBase64Encode(Utf8Of('fo')));
  TAssert.AssertEquals('Zm9v', KafkaBase64Encode(Utf8Of('foo')));
  TAssert.AssertEquals('Zm9vYg==', KafkaBase64Encode(Utf8Of('foob')));
  TAssert.AssertEquals('Zm9vYmE=', KafkaBase64Encode(Utf8Of('fooba')));
  TAssert.AssertEquals('Zm9vYmFy', KafkaBase64Encode(Utf8Of('foobar')));
  // The two characters where the alphabets differ.
  TAssert.AssertEquals('+/8=', KafkaBase64Encode(Bytes([$FB, $FF])));
  TAssert.AssertTrue(KafkaTryBase64Decode('Zm9vYmE=', B));
  TAssert.AssertEquals('fooba', Text(B));
  TAssert.AssertTrue(KafkaTryBase64Decode('Zg==', B));
  TAssert.AssertEquals('f', Text(B));
  TAssert.AssertTrue(KafkaTryBase64Decode('+/8=', B));
  TAssert.AssertEquals('fbff', BytesToHex(B));
  TAssert.AssertTrue(KafkaTryBase64Decode('', B));
  TAssert.AssertEquals(0, Length(B));
end;

procedure TKafkaSaslTests.Base64_RefusesUrlAlphabetMissingPadAndBadLength;
var
  B: TBytes;
begin
  TAssert.AssertFalse('URL alphabet', KafkaTryBase64Decode('-_8=', B));
  TAssert.AssertFalse('no padding', KafkaTryBase64Decode('Zg', B));
  TAssert.AssertFalse('length', KafkaTryBase64Decode('Zm9vY', B));
  TAssert.AssertFalse('three pads', KafkaTryBase64Decode('Z===', B));
  TAssert.AssertFalse('pad inside', KafkaTryBase64Decode('Zg==Zg==', B));
  TAssert.AssertFalse('not Base64', KafkaTryBase64Decode('Zm9*', B));
  TAssert.AssertEquals(0, Length(B));
end;

procedure TKafkaSaslTests.ScramEscapeName_EqualsAndComma;
begin
  TAssert.AssertEquals('user', KafkaScramEscapeName('user'));
  TAssert.AssertEquals('a=3Db=2Cc=3D=3D', KafkaScramEscapeName('a=b,c=='));
end;

procedure TKafkaSaslTests.MechanismNames;
begin
  TAssert.AssertEquals('PLAIN', KafkaSaslMechanismName(ksmPlain));
  TAssert.AssertEquals('SCRAM-SHA-256', KafkaSaslMechanismName(ksmScramSha256));
  TAssert.AssertEquals('', KafkaSaslMechanismName(ksmNone));
end;

procedure TKafkaSaslTests.Create_NoMechanismOrEmptyUser_IsRefused;
begin
  FMechanism := ksmNone;
  FUser := 'alice';
  TAssert.AssertException(EKafka, CreateClient);
  FMechanism := ksmPlain;
  FUser := '';
  TAssert.AssertException(EKafkaAuthentication, CreateClient);
  FMechanism := ksmScramSha256;
  TAssert.AssertException(EKafkaAuthentication, CreateClient);
  FUser := 'alice';
  CreateClient;
  TAssert.AssertEquals('SCRAM-SHA-256', FClient.Mechanism);
end;

procedure TKafkaSaslTests.Plain_InitialResponse_IsNulSeparatedUtf8;
begin
  FClient := TKafkaSaslPlainClient.Create('alice', 'São Paulo');
  TAssert.AssertEquals('PLAIN', FClient.Mechanism);
  // "" NUL "alice" NUL "São Paulo", the ã in two bytes.
  TAssert.AssertEquals('00616c6963650053c3a36f205061756c6f', BytesToHex(FClient.InitialResponse));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertException(EKafkaAuthentication, InitialResponse);
end;

procedure TKafkaSaslTests.Plain_EmptyAnswerCompletes_AnythingElseIsRefused;
begin
  FClient := TKafkaSaslPlainClient.Create('alice', 'secret');
  FChallenge := nil;
  TAssert.AssertException('before the initial response', EKafkaAuthentication, Evaluate);
  FClient.InitialResponse;
  FChallenge := Bytes([1]);
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  TAssert.AssertFalse(FClient.IsComplete);
  FChallenge := nil;
  TAssert.AssertEquals(0, Length(FClient.Evaluate(FChallenge)));
  TAssert.AssertTrue(FClient.IsComplete);
  TAssert.AssertException('after completing', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Plain_NulInUserName_IsRefused;
begin
  TAssert.AssertException(EKafkaAuthentication, CreatePlainWithNul);
end;

procedure TKafkaSaslTests.Scram_Rfc7677_ClientMessagesAndServerSignature;
var
  LFinal: TBytes;
begin
  FClient := TKafkaScramSha256Client.CreateWithNonce('user', 'pencil', RFC_NONCE);
  TAssert.AssertEquals('SCRAM-SHA-256', FClient.Mechanism);
  TAssert.AssertEquals('n,,n=user,r=' + RFC_NONCE, Text(FClient.InitialResponse));
  LFinal := FClient.Evaluate(Utf8Of(RFC_SERVER_FIRST));
  TAssert.AssertEquals(RFC_CLIENT_FINAL, Text(LFinal));
  TAssert.AssertFalse(FClient.IsComplete);
  TAssert.AssertEquals(0, Length(FClient.Evaluate(Utf8Of(RFC_SERVER_FINAL))));
  TAssert.AssertTrue(FClient.IsComplete);
  FChallenge := nil;
  TAssert.AssertException('after completing', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_WrongServerSignature_IsRefused;
begin
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  // The RFC's signature with its first character changed.
  FChallenge := Utf8Of('v=7rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  TAssert.AssertFalse(FClient.IsComplete);
  // Not Base64 at all.
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('v=***');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Neither v= nor e=.
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('x=1');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_ServerError_IsRefusedWithItsText;
begin
  ScramAfterFirst(RFC_SERVER_FIRST);
  FClient.Evaluate(FChallenge);
  FChallenge := Utf8Of('e=invalid-proof');
  try
    FClient.Evaluate(FChallenge);
    TAssert.Fail('no exception');
  except
    on E: EKafkaAuthentication do
      TAssert.AssertTrue(E.Message, Pos('invalid-proof', E.Message) > 0);
  end;
  TAssert.AssertFalse(FClient.IsComplete);
end;

procedure TKafkaSaslTests.Scram_NonceNotExtended_IsRefused;
begin
  // The client's nonce alone, not extended.
  ScramAfterFirst('r=' + RFC_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Another nonce.
  ScramAfterFirst('r=XOprNGfwEbeRWgbNEkqOabc,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
  // Attributes out of order.
  ScramAfterFirst('s=W22ZaJ0SNY7soEsUEjb6gQ==,r=' + RFC_SERVER_NONCE + ',i=4096');
  TAssert.AssertException(EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_IterationsOutOfRangeOrNotANumber_AreRefused;
const
  BASE = 'r=' + RFC_SERVER_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ==,i=';
begin
  ScramAfterFirst(BASE + '4095');
  TAssert.AssertException('4095', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '16385');
  TAssert.AssertException('16385', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '99999999999');
  TAssert.AssertException('too long', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE + '$1000');
  TAssert.AssertException('hex', EKafkaAuthentication, Evaluate);
  ScramAfterFirst(BASE);
  TAssert.AssertException('empty', EKafkaAuthentication, Evaluate);
  // 16384 is accepted (extensions after it are ignored).
  ScramAfterFirst(BASE + '16384,x=ext');
  TAssert.AssertTrue(Pos(',p=', Text(FClient.Evaluate(FChallenge))) > 0);
end;

procedure TKafkaSaslTests.Scram_MandatoryExtensionOrBadSalt_IsRefused;
begin
  ScramAfterFirst('m=ext,' + RFC_SERVER_FIRST);
  TAssert.AssertException('m=', EKafkaAuthentication, Evaluate);
  ScramAfterFirst('r=' + RFC_SERVER_NONCE + ',s=W22ZaJ0SNY7soEsUEjb6gQ,i=4096');
  TAssert.AssertException('salt without its pad', EKafkaAuthentication, Evaluate);
  ScramAfterFirst('r=' + RFC_SERVER_NONCE + ',s=,i=4096');
  TAssert.AssertException('empty salt', EKafkaAuthentication, Evaluate);
  FreeAndNil(FClient);
  FClient := TKafkaScramSha256Client.CreateWithNonce('user', 'pencil', RFC_NONCE);
  FClient.InitialResponse;
  FChallenge := Bytes([$72, $3D, $FF]); // "r=" and a byte that isn't UTF-8
  TAssert.AssertException('not UTF-8', EKafkaAuthentication, Evaluate);
end;

procedure TKafkaSaslTests.Scram_RandomNonce_DiffersEachTime;
var
  A, B: string;
begin
  FClient := TKafkaScramSha256Client.Create('a=b,c', 'x');
  A := Text(FClient.InitialResponse);
  FreeAndNil(FClient);
  FClient := TKafkaScramSha256Client.Create('a=b,c', 'x');
  B := Text(FClient.InitialResponse);
  TAssert.AssertEquals('n,,n=a=3Db=2Cc,r=', Copy(A, 1, 17));
  // 24 random bytes in Base64: 32 characters.
  TAssert.AssertEquals(17 + 32, Length(A));
  TAssert.AssertTrue(A <> B);
end;

function AuthRequestBytes(const AName: string): TBytes;
var
  R: TKafkaSaslAuthenticateRequest;
begin
  R.FromBytes(CaptureRequestBody(AName), CaptureVersion(AName));
  Result := R.AuthBytes;
end;

function AuthResponse(const AName: string): TKafkaSaslAuthenticateResponse;
begin
  Result.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
end;

function HandshakeResponse(const AName: string): TKafkaSaslHandshakeResponse;
begin
  Result.FromBytes(CaptureResponseBody(AName), CaptureVersion(AName));
end;

procedure TKafkaSaslTests.Java_Plain_SameInitialResponse;
var
  H: TKafkaSaslHandshakeRequest;
  A: TKafkaSaslAuthenticateResponse;
begin
  H.FromBytes(CaptureRequestBody('java-plain-sasl-handshake-v1'), 1);
  TAssert.AssertEquals('PLAIN', H.Mechanism);
  FClient := TKafkaSaslPlainClient.Create('alice', 'alice-secret');
  TAssert.AssertEquals(BytesToHex(AuthRequestBytes('java-plain-sasl-authenticate-v2-step1')),
    BytesToHex(FClient.InitialResponse));
  A := AuthResponse('java-plain-sasl-authenticate-v2-step1');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals(0, Length(FClient.Evaluate(A.AuthBytes)));
  TAssert.AssertTrue(FClient.IsComplete);
end;

procedure TKafkaSaslTests.Java_Scram_SameNonce_SameMessages_TheBrokersSignatureVerifies;
var
  H: TKafkaSaslHandshakeRequest;
  JavaFirst, Nonce: string;
  P: Integer;
  A1, A2: TKafkaSaslAuthenticateResponse;
begin
  H.FromBytes(CaptureRequestBody('java-scram-sasl-handshake-v1'), 1);
  TAssert.AssertEquals('SCRAM-SHA-256', H.Mechanism);
  JavaFirst := Text(AuthRequestBytes('java-scram-sasl-authenticate-v2-step1'));
  P := Pos(',r=', JavaFirst);
  TAssert.AssertEquals('n,,n=bob,r=', Copy(JavaFirst, 1, P + 2));
  Nonce := Copy(JavaFirst, P + 3, MaxInt);
  FClient := TKafkaScramSha256Client.CreateWithNonce('bob', 'bob-secret', Nonce);
  TAssert.AssertEquals('client-first', JavaFirst, Text(FClient.InitialResponse));
  A1 := AuthResponse('java-scram-sasl-authenticate-v2-step1');
  TAssert.AssertEquals(0, Integer(A1.ErrorCode));
  // The broker's salt and iteration count (8192, docker/kafka-start.sh).
  TAssert.AssertTrue(Text(A1.AuthBytes), Pos(',i=8192', Text(A1.AuthBytes)) > 0);
  TAssert.AssertEquals('client-final, the proof included',
    Text(AuthRequestBytes('java-scram-sasl-authenticate-v2-step2')),
    Text(FClient.Evaluate(A1.AuthBytes)));
  A2 := AuthResponse('java-scram-sasl-authenticate-v2-step2');
  TAssert.AssertEquals(0, Integer(A2.ErrorCode));
  TAssert.AssertEquals(0, Length(FClient.Evaluate(A2.AuthBytes)));
  TAssert.AssertTrue('the broker''s signature verified', FClient.IsComplete);
end;

procedure TKafkaSaslTests.HandBuiltRequests_EncodeToTheCapturedBytes;
const
  NAMES: array[0..2] of string = ('sasl-authenticate-v0', 'sasl-authenticate-v1',
    'sasl-authenticate-v2');
var
  H: TKafkaSaslHandshakeRequest;
  A: TKafkaSaslAuthenticateRequest;
  V: Int16;
begin
  H.Init;
  H.Mechanism := 'PLAIN';
  for V := 0 to 1 do
    TAssert.AssertEquals('handshake v' + IntToStr(V),
      BytesToHex(CaptureRequestBody('sasl-handshake-v' + IntToStr(V))), BytesToHex(H.ToBytes(V)));
  FClient := TKafkaSaslPlainClient.Create('alice', 'alice-secret');
  A.Init;
  A.AuthBytes := FClient.InitialResponse;
  for V := 0 to 2 do
    TAssert.AssertEquals(NAMES[V], BytesToHex(CaptureRequestBody(NAMES[V])),
      BytesToHex(A.ToBytes(V)));
end;

procedure TKafkaSaslTests.BrokerAnswers_Decode;
var
  H: TKafkaSaslHandshakeResponse;
  A: TKafkaSaslAuthenticateResponse;
begin
  H := HandshakeResponse('sasl-handshake-v1');
  TAssert.AssertEquals(0, Integer(H.ErrorCode));
  TAssert.AssertEquals(2, Length(H.Mechanisms));
  TAssert.AssertEquals('PLAIN', H.Mechanisms[0]);
  TAssert.AssertEquals('SCRAM-SHA-256', H.Mechanisms[1]);
  H := HandshakeResponse('sasl-handshake-v1-unsupported');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_UNSUPPORTED_SASL_MECHANISM), Integer(H.ErrorCode));
  TAssert.AssertEquals(2, Length(H.Mechanisms));

  A := AuthResponse('sasl-authenticate-v0');
  TAssert.AssertEquals(0, Integer(A.ErrorCode));
  TAssert.AssertEquals(0, Length(A.AuthBytes));
  TAssert.AssertEquals('v0 has no lifetime', Int64(0), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2');
  TAssert.AssertEquals('no connections.max.reauth.ms', Int64(0), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v1-lifetime');
  TAssert.AssertEquals(Int64(2000), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2-lifetime');
  TAssert.AssertEquals(Int64(2000), A.SessionLifetimeMs);
  A := AuthResponse('sasl-authenticate-v2-failed');
  TAssert.AssertEquals(Integer(KAFKA_ERROR_SASL_AUTHENTICATION_FAILED), Integer(A.ErrorCode));
  TAssert.AssertFalse(A.ErrorMessageIsNull);
  TAssert.AssertEquals('Authentication failed: Invalid username or password', A.ErrorMessage);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaSaslTests);

end.
