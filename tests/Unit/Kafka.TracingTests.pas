unit Kafka.TracingTests;

{ Tests for Kafka.Tracing and the spans the producer and the consumer open,
  against the fake broker in process (Kafka.TestFakeBroker), with an exporter
  that keeps the spans (Kafka.TestTracing).

  - The headers: traceparent (and tracestate) added in a copy, the caller's
    array untouched, the application's traceparent kept; the last header
    counts when reading, a null or non-UTF-8 value is absent.
  - Send: a producer span, a child of the current span, ended with the
    outcome (partition, offset, the broker), its context in the record's
    traceparent; a failure gives the error status and the Kafka error's
    name as error.type.
  - Poll and process: the poll span with the batch's count, none for an
    empty Poll; StartProcessSpan a child of the record's traceparent, in the
    producer's trace.
  - The tracer off: no span, no header added.

  No Sleep: the producer's futures and the consumer's Poll wait, with
  deadlines.

  DUnitX master: the FPCUnit mirror in tests/Unit/fpc is generated by
  tools/gen_fpc_mirror.py. }

interface

uses
  DUnitX.TestFramework,
  Kafka.DUnitXCompat,
  SysUtils,
  PascalCommon.Threading,
  PascalCommon.Tracing,
  PascalCommon.TraceContext,
  Kafka.Types,
  Kafka.Errors,
  Kafka.Protocol.RecordBatch,
  Kafka.Tracing,
  Kafka.Producer,
  Kafka.Consumer,
  Kafka.TestFakeBroker,
  Kafka.TestMessages,
  Kafka.TestHelpers,
  Kafka.TestTracing;

type
  [TestFixture]
  TKafkaTracingTests = class
  private
    FBrokers: TKafkaFakeBrokerArray;
    FProducer: TKafkaProducer;
    FConsumer: TKafkaConsumer;
    FExporter: TKafkaTestSpanExporter;
    procedure StartBroker;
    procedure OpenProducer;
    procedure OpenConsumer;
    function PollFor(ACount: Integer): TKafkaConsumerRecordArray;
    function LoggedHeader(AIndex: Integer; const AKey: string): string;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Inject_AddsTheContextInACopy_KeepsTheApplications;
    [Test] procedure TraceParentOf_LastWins_NullAndInvalidAreAbsent;
    [Test] procedure Send_ChildOfTheCurrentSpan_EndsWithTheOutcome_HeaderCarriesIt;
    [Test] procedure Send_Failure_ErrorStatusAndKafkaErrorName;
    [Test] procedure Send_ApplicationsTraceParent_IsKept;
    [Test] procedure PollAndProcess_JoinTheProducersTrace_EmptyPollExportsNothing;
    [Test] procedure TracerOff_NoSpanNoHeader;
  end;

implementation

const
  TOPIC = 'orders';

function Header(const AKey, AValue: string): TKafkaRecordHeader;
begin
  Result.Key := AKey;
  Result.Value := Utf8(AValue);
  Result.ValueIsNull := False;
end;

{ TKafkaTracingTests }

procedure TKafkaTracingTests.Setup;
begin
  FBrokers := nil;
  FProducer := nil;
  FConsumer := nil;
  FExporter := KafkaTestStartTracing;
end;

procedure TKafkaTracingTests.TearDown;
var
  I: Integer;
begin
  FreeAndNil(FProducer);
  FreeAndNil(FConsumer);
  for I := 0 to High(FBrokers) do
    FBrokers[I].Free;
  FBrokers := nil;
  FExporter := nil;
  KafkaTestStopTracing;
end;

procedure TKafkaTracingTests.StartBroker;
begin
  SetLength(FBrokers, 1);
  FBrokers[0] := TKafkaFakeBroker.Create;
  KafkaFakeUseView(FBrokers, KafkaFakeClusterView(FBrokers, TOPIC, [1]));
end;

procedure TKafkaTracingTests.OpenProducer;
var
  P: TKafkaProducerParams;
begin
  P := KafkaProducerParams('127.0.0.1:' + IntToStr(FBrokers[0].Port));
  P.Cluster.Connection.ClientId := 'tracing-producer';
  P.Cluster.Connection.ConnectTimeoutMs := 2000;
  P.Cluster.Connection.RequestTimeoutMs := 5000;
  P.Cluster.MaxBlockMs := 5000;
  P.Cluster.RetryBackoffMs := 20;
  P.LingerMs := 0;
  FProducer := TKafkaProducer.Create(P);
  FProducer.Open;
end;

procedure TKafkaTracingTests.OpenConsumer;
var
  P: TKafkaConsumerParams;
begin
  P := KafkaConsumerParams('127.0.0.1:' + IntToStr(FBrokers[0].Port));
  P.Cluster.Connection.ClientId := 'tracing-consumer';
  P.Cluster.Connection.ConnectTimeoutMs := 2000;
  P.Cluster.Connection.RequestTimeoutMs := 5000;
  P.Cluster.MaxBlockMs := 5000;
  P.Cluster.RetryBackoffMs := 20;
  P.FetchMaxWaitMs := 100;
  P.AutoOffsetReset := korEarliest;
  FConsumer := TKafkaConsumer.Create(P);
  FConsumer.Open;
  FConsumer.Assign([KafkaTopicPartition(TOPIC, 0)]);
end;

function TKafkaTracingTests.PollFor(ACount: Integer): TKafkaConsumerRecordArray;
var
  Deadline: UInt64;
  Got: TKafkaConsumerRecordArray;
  I, N: Integer;
begin
  Result := nil;
  Deadline := PcTickMs + 10000;
  while (Length(Result) < ACount) and (PcTickMs < Deadline) do
  begin
    Got := FConsumer.Poll(500);
    N := Length(Result);
    SetLength(Result, N + Length(Got));
    for I := 0 to High(Got) do
      Result[N + I] := Got[I];
  end;
end;

function TKafkaTracingTests.LoggedHeader(AIndex: Integer; const AKey: string): string;
var
  R: TKafkaRecordArray;
  I: Integer;
begin
  Result := '';
  R := FBrokers[0].Logged(TOPIC, 0);
  for I := 0 to High(R[AIndex].Headers) do
    if R[AIndex].Headers[I].Key = AKey then
      Result := FromUtf8(R[AIndex].Headers[I].Value);
end;

procedure TKafkaTracingTests.Inject_AddsTheContextInACopy_KeepsTheApplications;
var
  LSpan: IPcSpan;
  LIn, LOut: TKafkaRecordHeaderArray;
begin
  LSpan := TPcTracing.StartSpanFromParent(
    '00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01', 'vendor=x', 'work', skInternal);
  try
    SetLength(LIn, 1);
    LIn[0] := Header('app', 'v');
    LOut := KafkaInjectTraceContext(LIn, LSpan);
    TAssert.AssertEquals('the caller''s array', 1, Length(LIn));
    TAssert.AssertEquals(3, Length(LOut));
    TAssert.AssertEquals('app', LOut[0].Key);
    TAssert.AssertEquals(KAFKA_TRACEPARENT_HEADER, LOut[1].Key);
    TAssert.AssertEquals(LSpan.TraceParent, FromUtf8(LOut[1].Value));
    TAssert.AssertEquals(KAFKA_TRACESTATE_HEADER, LOut[2].Key);
    TAssert.AssertEquals('vendor=x', FromUtf8(LOut[2].Value));
    // The application's traceparent: nothing added, not even tracestate.
    SetLength(LIn, 2);
    LIn[1] := Header(KAFKA_TRACEPARENT_HEADER, 'mine');
    LOut := KafkaInjectTraceContext(LIn, LSpan);
    TAssert.AssertEquals(2, Length(LOut));
    TAssert.AssertEquals('mine', FromUtf8(LOut[1].Value));
    TAssert.AssertEquals('no span', 2, Length(KafkaInjectTraceContext(LIn, nil)));
  finally
    LSpan.Finish;
  end;
end;

procedure TKafkaTracingTests.TraceParentOf_LastWins_NullAndInvalidAreAbsent;
var
  H: TKafkaRecordHeaderArray;
  LParent, LState: string;
begin
  TAssert.AssertFalse('no headers', KafkaTraceParentOf(nil, LParent, LState));
  SetLength(H, 3);
  H[0] := Header(KAFKA_TRACEPARENT_HEADER, 'first');
  H[1] := Header(KAFKA_TRACESTATE_HEADER, 'a=1');
  H[2] := Header(KAFKA_TRACEPARENT_HEADER, 'last');
  TAssert.AssertTrue(KafkaTraceParentOf(H, LParent, LState));
  TAssert.AssertEquals('last', LParent);
  TAssert.AssertEquals('a=1', LState);
  H[2].ValueIsNull := True;
  H[2].Value := nil;
  TAssert.AssertFalse('the last is null', KafkaTraceParentOf(H, LParent, LState));
  TAssert.AssertEquals('', LState);
  H[2] := Header(KAFKA_TRACEPARENT_HEADER, '');
  H[2].Value := Bytes([$FF, $FE]);
  TAssert.AssertFalse('not UTF-8', KafkaTraceParentOf(H, LParent, LState));
  TAssert.AssertEquals('', LParent);
end;

procedure TKafkaTracingTests.Send_ChildOfTheCurrentSpan_EndsWithTheOutcome_HeaderCarriesIt;
var
  LParent: IPcSpan;
  LTraceId, LParentId: string;
  R: TKafkaProducerRecord;
  LSpans: TPcSpanDataArray;
  I: Integer;
begin
  StartBroker;
  OpenProducer;
  R := KafkaProducerRecord(TOPIC, Utf8('k'), Utf8('hello'));
  R.Partition := 0;
  SetLength(R.Headers, 1);
  R.Headers[0] := Header('app', 'v');
  LParent := TPcTracing.StartSpan('GET /orders', skServer);
  try
    LTraceId := LParent.TraceId;
    LParentId := LParent.SpanId;
    TAssert.AssertEquals(Int64(0), FProducer.Send(R).Get(10000).Offset);
  finally
    LParent.Finish;
  end;
  TAssert.AssertEquals('the caller''s headers', 1, Length(R.Headers));
  LSpans := FExporter.Spans;
  I := KafkaTestFindSpan(LSpans, 'send orders');
  TAssert.AssertTrue('the send span', I >= 0);
  TAssert.AssertTrue(LSpans[I].Kind = skProducer);
  TAssert.AssertEquals(LTraceId, LSpans[I].TraceId);
  TAssert.AssertEquals(LParentId, LSpans[I].ParentSpanId);
  TAssert.AssertTrue(LSpans[I].Status = ssUnset);
  TAssert.AssertEquals('kafka', KafkaTestAttribute(LSpans[I], 'messaging.system'));
  TAssert.AssertEquals('send', KafkaTestAttribute(LSpans[I], 'messaging.operation.type'));
  TAssert.AssertEquals('send', KafkaTestAttribute(LSpans[I], 'messaging.operation.name'));
  TAssert.AssertEquals(TOPIC, KafkaTestAttribute(LSpans[I], 'messaging.destination.name'));
  TAssert.AssertEquals('0', KafkaTestAttribute(LSpans[I], 'messaging.destination.partition.id'));
  TAssert.AssertEquals('0', KafkaTestAttribute(LSpans[I], 'messaging.kafka.offset'));
  TAssert.AssertEquals('5', KafkaTestAttribute(LSpans[I], 'messaging.message.body.size'));
  TAssert.AssertEquals('tracing-producer', KafkaTestAttribute(LSpans[I], 'messaging.client.id'));
  TAssert.AssertEquals('127.0.0.1', KafkaTestAttribute(LSpans[I], 'server.address'));
  TAssert.AssertEquals(IntToStr(FBrokers[0].Port), KafkaTestAttribute(LSpans[I], 'server.port'));
  TAssert.AssertEquals('no key attribute', '', KafkaTestAttribute(LSpans[I], 'messaging.kafka.message.key'));
  TAssert.AssertEquals('the span''s context in the record',
    PcFormatTraceParent(LTraceId, LSpans[I].SpanId, True), LoggedHeader(0, KAFKA_TRACEPARENT_HEADER));
  TAssert.AssertEquals('v', LoggedHeader(0, 'app'));
end;

procedure TKafkaTracingTests.Send_Failure_ErrorStatusAndKafkaErrorName;
var
  F: IKafkaDeliveryFuture;
  LSpans: TPcSpanDataArray;
  I: Integer;
begin
  StartBroker;
  OpenProducer;
  FBrokers[0].ProduceErrorCode := KAFKA_ERROR_TOPIC_AUTHORIZATION_FAILED;
  FBrokers[0].ProduceErrors := 1;
  F := FProducer.Send(KafkaProducerRecord(TOPIC, Utf8('refused')));
  TAssert.AssertTrue(F.Wait(10000));
  TAssert.AssertFalse(F.Report.Succeeded);
  LSpans := FExporter.Spans;
  I := KafkaTestFindSpan(LSpans, 'send orders');
  TAssert.AssertTrue(I >= 0);
  TAssert.AssertTrue(LSpans[I].Status = ssError);
  TAssert.AssertEquals('TOPIC_AUTHORIZATION_FAILED', KafkaTestAttribute(LSpans[I], 'error.type'));
  TAssert.AssertTrue(LSpans[I].StatusMessage <> '');
  TAssert.AssertEquals('a new trace', '', LSpans[I].ParentSpanId);
end;

procedure TKafkaTracingTests.Send_ApplicationsTraceParent_IsKept;
const
  MINE = '00-11111111111111111111111111111111-2222222222222222-01';
var
  R: TKafkaProducerRecord;
  L: TKafkaRecordArray;
begin
  StartBroker;
  OpenProducer;
  R := KafkaProducerRecord(TOPIC, Utf8('v'));
  SetLength(R.Headers, 1);
  R.Headers[0] := Header(KAFKA_TRACEPARENT_HEADER, MINE);
  FProducer.Send(R).Get(10000);
  L := FBrokers[0].Logged(TOPIC, 0);
  TAssert.AssertEquals(1, Length(L[0].Headers));
  TAssert.AssertEquals(MINE, LoggedHeader(0, KAFKA_TRACEPARENT_HEADER));
end;

procedure TKafkaTracingTests.PollAndProcess_JoinTheProducersTrace_EmptyPollExportsNothing;
var
  LParent, LProcess: IPcSpan;
  LTraceId: string;
  LRecords: TKafkaConsumerRecordArray;
  LSpans: TPcSpanDataArray;
  S, P, X: Integer;
begin
  StartBroker;
  OpenProducer;
  LParent := TPcTracing.StartSpan('job', skInternal);
  try
    LTraceId := LParent.TraceId;
    FProducer.Send(KafkaProducerRecord(TOPIC, Utf8('a'))).Get(10000);
    FProducer.Send(KafkaProducerRecord(TOPIC, Utf8('b'))).Get(10000);
  finally
    LParent.Finish;
  end;
  OpenConsumer;
  LRecords := PollFor(2);
  TAssert.AssertEquals(2, Length(LRecords));
  LProcess := FConsumer.StartProcessSpan(LRecords[1]);
  TAssert.AssertTrue('the current span', TPcTracing.Current = LProcess);
  KafkaFinishSpan(LProcess, nil);
  LProcess := nil;
  LSpans := FExporter.Spans;
  S := KafkaTestFindSpan(LSpans, 'send orders');
  P := KafkaTestFindSpan(LSpans, 'poll orders');
  X := KafkaTestFindSpan(LSpans, 'process orders');
  TAssert.AssertTrue('send', S >= 0);
  TAssert.AssertTrue('poll', P >= 0);
  TAssert.AssertTrue('process', X >= 0);
  TAssert.AssertTrue(LSpans[P].Kind = skClient);
  TAssert.AssertEquals('receive', KafkaTestAttribute(LSpans[P], 'messaging.operation.type'));
  TAssert.AssertEquals('poll', KafkaTestAttribute(LSpans[P], 'messaging.operation.name'));
  TAssert.AssertEquals('tracing-consumer', KafkaTestAttribute(LSpans[P], 'messaging.client.id'));
  TAssert.AssertTrue(StrToInt(KafkaTestAttribute(LSpans[P], 'messaging.batch.message_count')) >= 1);
  TAssert.AssertTrue(LSpans[X].Kind = skConsumer);
  TAssert.AssertEquals('the producer''s trace', LTraceId, LSpans[X].TraceId);
  TAssert.AssertEquals('a child of the second send', LSpans[S].SpanId, LSpans[X].ParentSpanId);
  TAssert.AssertEquals('1', KafkaTestAttribute(LSpans[X], 'messaging.kafka.offset'));
  TAssert.AssertEquals('0', KafkaTestAttribute(LSpans[X], 'messaging.destination.partition.id'));
  TAssert.AssertEquals('1', KafkaTestAttribute(LSpans[X], 'messaging.message.body.size'));
  TAssert.AssertEquals('no group', '', KafkaTestAttribute(LSpans[X], 'messaging.consumer.group.name'));
  // An empty Poll: no span exported, and none left as the current one.
  TAssert.AssertEquals(0, Length(FConsumer.Poll(50)));
  TAssert.AssertTrue('no current span', TPcTracing.Current = nil);
  TAssert.AssertEquals(Length(LSpans), Length(FExporter.Spans));
end;

procedure TKafkaTracingTests.TracerOff_NoSpanNoHeader;
var
  L: TKafkaRecordArray;
  LRecords: TKafkaConsumerRecordArray;
begin
  FExporter := nil;
  KafkaTestStopTracing;
  TAssert.AssertTrue(KafkaStartSendSpan(TOPIC, 0, 1, False, '') = nil);
  TAssert.AssertTrue(KafkaStartPollSpan('', '') = nil);
  StartBroker;
  OpenProducer;
  FProducer.Send(KafkaProducerRecord(TOPIC, Utf8('plain'))).Get(10000);
  L := FBrokers[0].Logged(TOPIC, 0);
  TAssert.AssertEquals('no header', 0, Length(L[0].Headers));
  OpenConsumer;
  LRecords := PollFor(1);
  TAssert.AssertEquals(1, Length(LRecords));
  TAssert.AssertTrue(FConsumer.StartProcessSpan(LRecords[0]) = nil);
end;

initialization
  TDUnitX.RegisterTestFixture(TKafkaTracingTests);

end.
